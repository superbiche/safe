{
  "defaults": {
    "node_version": "24",
    "python_version": "3.14"
  },
  "runners": {
    "npx_real": null,
    "bunx_real": null,
    "uvx_real": null,
    "pipx_real": null
  },
  "sandbox": {
    "pids_limit": 256,
    "memory": "2g",
    "cpus": "2",
    "ulimit_nofile": "1024:1024",
    "timeout_seconds": 300
  },
  "warn_env_files": true,
  "linked_targets": [],
  "install": {
    "auto_allow": true,
    "auto_allow_tolerate": [],
    "auto_allow_ttl_days": 30,
    "block_severities": ["critical"]
  }
}
