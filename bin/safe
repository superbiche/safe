#!/usr/bin/env bash
set -euo pipefail

SAFE_VERSION="1.1.3"
SAFE_SELF="$(readlink -f "$0")"
SAFE_DIR="$(dirname "$SAFE_SELF")"
SAFE_CONFIG_ROOT="${SAFE_CONFIG_DIR:-$HOME/.config/safe}"
SAFE_DATA_ROOT="${SAFE_DATA_DIR:-$HOME/.local/share/safe}"
SAFE_RUN_PATH="$SAFE_DIR/safe-run"
SAFE_AUDIT_PATH="$SAFE_DIR/safe-audit"
SAFE_ZSH_COMPLETION_DIR="${SAFE_ZSH_COMPLETION_DIR:-$HOME/.local/share/zsh/site-functions}"

err() { printf 'safe: %s\n' "$*" >&2; }
die() { err "$@"; exit 1; }
# Policy refusal: legible one-line contract + dedicated exit code (see safe explain).
refuse() { local code="$1"; shift; err "$@"; exit "$code"; }

show_usage() {
  cat <<'EOF'
safe: consolidated safe run, safe audit, and install wrapper tooling

USAGE
  safe run <args...>
  safe audit <args...>
  safe install [-g|--global] [--yes] <pkg> [...]
  safe install --manager npm|pnpm|yarn|bun|composer -g [--yes] [--trust-host] <pkg> [...]
  safe install --sandbox [--allow-scripts] <pkg> [...]
  safe vendor update --name NAME --path PATH --reason TEXT -- COMMAND...
  safe setup [<machine> | --all | --machine <csv>]
  safe status
  safe doctor [--json]
  safe explain
  safe version
  safe help
EOF
}

cmd_explain() {
  cat <<'EOF'
safe: agent contract — what is gated, how refusals look, how to get unblocked

This machine routes package execution and installation through `safe`, a
supply-chain safety net. If a package-manager command fails with a message
starting with `safe:` or `safe run:`, it was refused BY POLICY — the
toolchain is not broken. Do not work around a refusal (no direct
node_modules/.bin calls of packages that failed to install, no alternate
installers, no curl|sh). Surface the refusal to the operator instead.

WHAT IS GATED
  npx / bunx / uvx        Binaries are symlinked to `safe run`: packages run
                          from a project node_modules/.bin (bare unversioned
                          names, current or parent dir), an allowlist, a Podman
                          sandbox, or not at all.
  npm / pnpm / yarn / bun / pip / pip3 / uv / cargo / go / composer / volta
                          zsh wrapper functions audit install, update, and
                          exec subcommands with `safe audit` before
                          delegating to the real tool: install/add/ci/require
                          (and global variants), update/up/upgrade families,
                          and exec-style fetch-and-run (npm exec|x, pnpm dlx,
                          yarn dlx, bun x, uv run --with|-w, uv tool run,
                          go run <module>@<version>). Project-local commands
                          pass through, including npm exec of a bare-named
                          installed ./node_modules/.bin tool (versioned specs
                          are still audited), pnpm exec, composer exec (vendor
                          binaries only), and volta run (official runtimes
                          only).
  safe install <pkg>      Audited, confirmed install path (multi-manager).

HOW A REFUSAL LOOKS
  One stderr line starting with `safe: BLOCKED` or `safe run: BLOCKED`,
  stating what was blocked, why, and the operator command that allows it.

EXIT CODES (policy refusals; 127 means a genuinely missing command)
  100  blocked by policy (blocklist, degraded wrappers, fail-closed audit, unrecognized/unsupported runner-native flags)
  101  host-allow version pin mismatch
  102  interactive operator confirmation required (non-TTY refusal)
  103  invalid package name rejected
  104  safe audit BLOCK verdict

WHAT AN AGENT SHOULD DO
  1. Treat any BLOCKED line as policy, not breakage; do not retry blind.
  2. Relay the refusal line and its `to allow:` command to the operator
     verbatim. Trust escalations (safe run host-allow add/update) only work
     in the operator's interactive terminal — never attempt them yourself.
  3. After the operator allows, retry the original command unchanged.
  4. Exit 127 from a wrapped tool means a genuinely missing command, never
     a policy block — partial wrapper loads refuse legibly with exit 100.
     A silent 127 would be a safe bug: report it, don't bypass.

OPERATOR ALLOW FLOWS
  safe run host-allow add <pkg>@<version> --reason "..."   trusted host exec (npm)
  safe run -y <pkg>@<version> -- <args>                    one-off sandbox run
  safe install [-g] <pkg>@<version>                        audited install
  safe run block list / safe run audit --blocked           review refusals
EOF
}

cmd_version() {
  echo "safe $SAFE_VERSION"
  "$SAFE_RUN_PATH" version
  "$SAFE_AUDIT_PATH" --version
}

cmd_status() {
  echo "safe $SAFE_VERSION"
  echo
  echo "=== run ==="
  "$SAFE_RUN_PATH" status
  echo
  echo "=== audit ==="
  "$SAFE_AUDIT_PATH" status
  echo
  echo "=== install ==="
  if [[ -n "${ZSH_VERSION:-}" && -n "${functions[safe_install_check]:-}" ]]; then
    echo "wrappers:       loaded"
  elif [[ -f "$SAFE_CONFIG_ROOT/install-wrappers.zsh" ]]; then
    echo "wrappers:       installed"
  else
    echo "wrappers:       not installed"
  fi
}

sha256_file_or_null() {
  local path="$1"
  if [[ -f "$path" ]]; then
    sha256sum "$path" | awk '{print $1}'
  else
    printf 'null'
  fi
}

version_output_json() {
  local path="$1" version_args="$2"
  if [[ -z "$version_args" || ! -x "$path" ]]; then
    jq -n 'null'
    return
  fi

  # shellcheck disable=SC2206
  local args=($version_args)
  local output="" rc=0
  set +e
  output="$("$path" "${args[@]}" 2>&1 | head -n 1)"
  rc=$?
  set -e

  jq -n --arg output "$output" --argjson rc "$rc" '{exit_code:$rc, output:$output}'
}

cmd_vendor() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    update) cmd_vendor_update "$@" ;;
    -h|--help|help|"") cat <<'EOF'
usage: safe vendor update --name NAME --path PATH --reason TEXT [--rollback TEXT] [--version-cmd ARGS] -- COMMAND...

Runs a vendor-native update command while recording before/after binary hashes
under ~/.local/share/safe/vendor/audit.log.
EOF
      ;;
    *) die "unknown vendor subcommand: ${sub:-}" ;;
  esac
}

cmd_vendor_update() {
  local name="" path="" reason="" rollback="" version_cmd=""
  local -a update_cmd=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="${2:-}"; shift 2 ;;
      --name=*) name="${1#--name=}"; shift ;;
      --path) path="${2:-}"; shift 2 ;;
      --path=*) path="${1#--path=}"; shift ;;
      --reason) reason="${2:-}"; shift 2 ;;
      --reason=*) reason="${1#--reason=}"; shift ;;
      --rollback) rollback="${2:-}"; shift 2 ;;
      --rollback=*) rollback="${1#--rollback=}"; shift ;;
      --version-cmd) version_cmd="${2:-}"; shift 2 ;;
      --version-cmd=*) version_cmd="${1#--version-cmd=}"; shift ;;
      --)
        shift
        update_cmd=("$@")
        break
        ;;
      *) die "unknown vendor update flag: $1" ;;
    esac
  done

  [[ -n "$name" ]] || die "vendor update requires --name"
  [[ -n "$path" ]] || die "vendor update requires --path"
  [[ -n "$reason" ]] || die "vendor update requires --reason"
  [[ ${#update_cmd[@]} -gt 0 ]] || die "vendor update requires -- COMMAND..."

  local resolved_path before_sha after_sha before_version_json after_version_json log_dir log_file timestamp rc
  resolved_path="$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")"
  before_sha="$(sha256_file_or_null "$resolved_path")"
  before_version_json="$(version_output_json "$resolved_path" "$version_cmd")"

  set +e
  "${update_cmd[@]}"
  rc=$?
  set -e

  after_sha="$(sha256_file_or_null "$resolved_path")"
  after_version_json="$(version_output_json "$resolved_path" "$version_cmd")"
  timestamp="$(date -Iseconds)"
  log_dir="$SAFE_DATA_ROOT/vendor"
  log_file="$log_dir/audit.log"
  mkdir -p "$log_dir"

  jq -c -n \
    --arg timestamp "$timestamp" \
    --arg name "$name" \
    --arg path "$resolved_path" \
    --arg before_sha "$before_sha" \
    --arg after_sha "$after_sha" \
    --arg reason "$reason" \
    --arg rollback "$rollback" \
    --argjson before_version "$before_version_json" \
    --argjson after_version "$after_version_json" \
    --argjson exit_code "$rc" \
    '{
      timestamp: $timestamp,
      name: $name,
      path: $path,
      reason: $reason,
      rollback: (if $rollback == "" then null else $rollback end),
      command: $ARGS.positional,
      exit_code: $exit_code,
      before: {sha256: (if $before_sha == "null" then null else $before_sha end), version: $before_version},
      after: {sha256: (if $after_sha == "null" then null else $after_sha end), version: $after_version}
    }' \
    --args "${update_cmd[@]}" >> "$log_file"

  if [[ "$rc" -ne 0 ]]; then
    err "vendor update command exited $rc; audit log: $log_file"
    return "$rc"
  fi

  if [[ "$before_sha" == "$after_sha" ]]; then
    err "vendor update completed; tracked binary hash unchanged; audit log: $log_file"
  else
    printf 'safe: vendor update recorded %s -> %s\n' "$before_sha" "$after_sha" >&2
    printf 'safe: audit log: %s\n' "$log_file" >&2
  fi
}

capture_command() {
  local __out_var="$1"
  shift
  local output="" rc=0
  set +e
  output="$("$@" 2>/dev/null)"
  rc=$?
  set -e
  printf -v "$__out_var" '%s' "$output"
  return "$rc"
}

command_presence_json() {
  local cmd="$1"
  local version_cmd="${2:-}"
  local path="" version=""
  path=$(command -v "$cmd" 2>/dev/null || true)
  if [[ -n "$path" ]]; then
    path=$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")
  fi
  if [[ -n "$path" && -n "$version_cmd" ]]; then
    set +e
    version="$($cmd $version_cmd 2>/dev/null | head -n 1)"
    set -e
  fi
  jq -n \
    --arg path "$path" \
    --arg version "$version" \
    '{
      present: ($path != ""),
      path: (if $path == "" then null else $path end)
    } + (if $version == "" then {} else {version: $version} end)'
}

component_path_json() {
  local path="$1"
  local argv0="${2:-}"
  local resolved exists executable
  resolved=$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")
  [[ -e "$resolved" ]] && exists=true || exists=false
  [[ -x "$resolved" ]] && executable=true || executable=false
  jq -n \
    --arg resolved "$resolved" \
    --arg argv0 "$argv0" \
    --argjson exists "$exists" \
    --argjson executable "$executable" \
    '{
      resolved: $resolved,
      exists: $exists,
      executable: $executable
    } + (if $argv0 == "" then {} else {argv0: $argv0} end)'
}

dispatch_parity_json() {
  local direct_label="$1"
  shift
  local routed_label="$1"
  shift
  local direct_out="" routed_out="" direct_rc=0 routed_rc=0
  capture_command direct_out "$@" || direct_rc=$?
  capture_command routed_out "${PARITY_ROUTED_CMD[@]}" || routed_rc=$?
  jq -n \
    --arg direct_label "$direct_label" \
    --arg routed_label "$routed_label" \
    --arg direct_out "$direct_out" \
    --arg routed_out "$routed_out" \
    --argjson direct_rc "$direct_rc" \
    --argjson routed_rc "$routed_rc" \
    '{
      supported: ($direct_rc == 0 and $routed_rc == 0),
      ok: ($direct_rc == 0 and $routed_rc == 0 and $direct_out == $routed_out),
      ($direct_label): (if $direct_rc == 0 then $direct_out else null end),
      ($routed_label): (if $routed_rc == 0 then $routed_out else null end)
    }'
}

safe_run_linked_runner() {
  local key="$1"
  local config_file="$SAFE_CONFIG_ROOT/run/config.json"
  local path=""
  if [[ -r "$config_file" ]] && command -v jq >/dev/null 2>&1; then
    path=$(jq -r --arg k "${key}_real" '.runners[$k] // empty' "$config_file" 2>/dev/null || true)
  fi
  [[ -n "$path" && -x "$path" ]] && printf 'true' || printf 'false'
}

doctor_feature_json() {
  local supported="$1"
  local ready="$2"
  shift 2
  jq -n \
    --argjson supported "$supported" \
    --argjson ready "$ready" \
    --argjson missing "$(printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    '{supported: $supported, ready: $ready, missing: $missing}'
}

doctor_payload_json() {
  command -v jq >/dev/null 2>&1 || die "doctor requires jq"

  local base_config="$SAFE_CONFIG_ROOT"
  local base_data="$SAFE_DATA_ROOT"
  local run_config_dir="$base_config/run"
  local audit_config_dir="$base_config/audit"
  local install_wrapper="$base_config/install-wrappers.zsh"
  local completion_file="$SAFE_ZSH_COMPLETION_DIR/_safe"

  local paths_safe_json paths_run_json paths_audit_json
  paths_safe_json=$(component_path_json "$SAFE_SELF" "$0")
  paths_run_json=$(component_path_json "$SAFE_RUN_PATH")
  paths_audit_json=$(component_path_json "$SAFE_AUDIT_PATH")

  local PARITY_ROUTED_CMD=(env SAFE_AUDIT_NO_INIT=1 "$SAFE_SELF" audit --version)
  local audit_parity_json
  audit_parity_json=$(dispatch_parity_json "safe_audit_version" "safe_audit_via_dispatcher" env SAFE_AUDIT_NO_INIT=1 "$SAFE_AUDIT_PATH" --version)

  PARITY_ROUTED_CMD=(env SAFE_RUN_NO_INIT=1 "$SAFE_SELF" run --version)
  local run_parity_json
  run_parity_json=$(dispatch_parity_json "safe_run_version" "safe_run_via_dispatcher" env SAFE_RUN_NO_INIT=1 "$SAFE_RUN_PATH" version)

  local core_bash_json core_jq_json core_zsh_json
  local audit_curl_json audit_tar_json audit_ssh_json
  local verify_cosign_json verify_sha256sum_json verify_shasum_json verify_python3_json verify_python_json
  local sandbox_podman_json sandbox_timeout_json
  core_bash_json=$(command_presence_json bash)
  core_jq_json=$(command_presence_json jq)
  core_zsh_json=$(command_presence_json zsh)
  audit_curl_json=$(command_presence_json curl)
  audit_tar_json=$(command_presence_json tar)
  audit_ssh_json=$(command_presence_json ssh)
  verify_cosign_json=$(command_presence_json cosign)
  verify_sha256sum_json=$(command_presence_json sha256sum)
  verify_shasum_json=$(command_presence_json shasum)
  verify_python3_json=$(command_presence_json python3 --version)
  verify_python_json=$(command_presence_json python --version)
  sandbox_podman_json=$(command_presence_json podman --version)
  sandbox_timeout_json=$(command_presence_json timeout)

  local capabilities_json="" capabilities_available=false
  local capabilities_version=""
  local capability_verify_release_asset=false
  local capability_verify_sigstore_bundle=false
  local capability_verify_tuf_bootstrap=false
  local capability_binary_exec=false
  if capture_command capabilities_json "$SAFE_SELF" audit capabilities --json; then
    if jq -e . >/dev/null 2>&1 <<<"$capabilities_json"; then
      capabilities_available=true
      capabilities_version=$(jq -r '.version // empty' <<<"$capabilities_json")
      capability_verify_release_asset=$(jq -r '.capabilities["verify.release-asset"] // false' <<<"$capabilities_json")
      capability_verify_sigstore_bundle=$(jq -r '.capabilities["verify.sigstore-bundle"] // false' <<<"$capabilities_json")
      capability_verify_tuf_bootstrap=$(jq -r '.capabilities["verify.tuf-bootstrap"] // false' <<<"$capabilities_json")
      capability_binary_exec=$(jq -r '.capabilities["binary.exec"] // false' <<<"$capabilities_json")
    fi
  fi

  local has_cosign has_sha256sum has_shasum has_checksum has_python3 has_python has_python_bridge has_podman has_timeout
  has_cosign=$(jq -r '.present' <<<"$verify_cosign_json")
  has_sha256sum=$(jq -r '.present' <<<"$verify_sha256sum_json")
  has_shasum=$(jq -r '.present' <<<"$verify_shasum_json")
  has_python3=$(jq -r '.present' <<<"$verify_python3_json")
  has_python=$(jq -r '.present' <<<"$verify_python_json")
  has_podman=$(jq -r '.present' <<<"$sandbox_podman_json")
  has_timeout=$(jq -r '.present' <<<"$sandbox_timeout_json")
  if [[ "$has_sha256sum" == "true" || "$has_shasum" == "true" ]]; then
    has_checksum=true
  else
    has_checksum=false
  fi
  if [[ "$has_python3" == "true" || "$has_python" == "true" ]]; then
    has_python_bridge=true
  else
    has_python_bridge=false
  fi

  local feature_capabilities_json
  if [[ "$capabilities_available" == "true" ]]; then
    feature_capabilities_json=$(
      jq -n \
        --arg version "$capabilities_version" \
        --argjson caps "$(jq -c '.capabilities' <<<"$capabilities_json")" \
        '{
          available: true,
          command: "safe audit capabilities",
          version: $version,
          capabilities: $caps
        }'
    )
  else
    feature_capabilities_json='{"available":false,"command":"safe audit capabilities","version":null,"capabilities":{}}'
  fi

  local verify_release_asset_json verify_sigstore_bundle_json verify_tuf_bootstrap_json
  local binary_exec_json safe_run_sandbox_json
  if [[ "$capabilities_available" != "true" ]]; then
    verify_release_asset_json=$(doctor_feature_json false false "safe audit capabilities")
  elif [[ "$capability_verify_release_asset" != "true" ]]; then
    verify_release_asset_json=$(doctor_feature_json false false)
  elif [[ "$has_checksum" != "true" ]]; then
    verify_release_asset_json=$(doctor_feature_json true false "sha256sum|shasum")
  else
    verify_release_asset_json=$(doctor_feature_json true true)
  fi

  if [[ "$capabilities_available" != "true" ]]; then
    verify_sigstore_bundle_json=$(doctor_feature_json false false "safe audit capabilities")
  elif [[ "$capability_verify_sigstore_bundle" != "true" ]]; then
    verify_sigstore_bundle_json=$(doctor_feature_json false false)
  elif [[ "$has_cosign" != "true" ]]; then
    verify_sigstore_bundle_json=$(doctor_feature_json true false "cosign")
  else
    verify_sigstore_bundle_json=$(doctor_feature_json true true)
  fi

  if [[ "$capabilities_available" != "true" ]]; then
    verify_tuf_bootstrap_json=$(doctor_feature_json false false "safe audit capabilities")
  elif [[ "$capability_verify_tuf_bootstrap" != "true" ]]; then
    verify_tuf_bootstrap_json=$(doctor_feature_json false false)
  else
    local tuf_missing=()
    [[ "$has_checksum" == "true" ]] || tuf_missing+=("sha256sum|shasum")
    [[ "$has_cosign" == "true" ]] || tuf_missing+=("cosign")
    [[ "$has_python_bridge" == "true" ]] || tuf_missing+=("python3|python")
    if [[ ${#tuf_missing[@]} -eq 0 ]]; then
      verify_tuf_bootstrap_json=$(doctor_feature_json true true)
    else
      verify_tuf_bootstrap_json=$(doctor_feature_json true false "${tuf_missing[@]}")
    fi
  fi

  if [[ "$capabilities_available" != "true" ]]; then
    binary_exec_json=$(doctor_feature_json false false "safe audit capabilities")
  elif [[ "$capability_binary_exec" != "true" ]]; then
    binary_exec_json=$(doctor_feature_json false false)
  else
    local binary_missing=()
    [[ "$has_podman" == "true" ]] || binary_missing+=("podman")
    [[ "$has_timeout" == "true" ]] || binary_missing+=("timeout")
    if [[ ${#binary_missing[@]} -eq 0 ]]; then
      binary_exec_json=$(doctor_feature_json true true)
    else
      binary_exec_json=$(doctor_feature_json true false "${binary_missing[@]}")
    fi
  fi

  local run_missing=()
  [[ "$has_podman" == "true" ]] || run_missing+=("podman")
  if [[ ${#run_missing[@]} -eq 0 ]]; then
    safe_run_sandbox_json=$(doctor_feature_json true true)
  else
    safe_run_sandbox_json=$(doctor_feature_json true false "${run_missing[@]}")
  fi

  local linked_npx linked_bunx linked_uvx linked_pipx
  linked_npx=$(safe_run_linked_runner npx)
  linked_bunx=$(safe_run_linked_runner bunx)
  linked_uvx=$(safe_run_linked_runner uvx)
  linked_pipx=$(safe_run_linked_runner pipx)

  jq -n \
    --arg version "$SAFE_VERSION" \
    --arg config_dir "$base_config" \
    --arg data_dir "$base_data" \
    --argjson safe_path "$paths_safe_json" \
    --argjson safe_run_path "$paths_run_json" \
    --argjson safe_audit_path "$paths_audit_json" \
    --argjson audit_parity "$audit_parity_json" \
    --argjson run_parity "$run_parity_json" \
    --argjson core_bash "$core_bash_json" \
    --argjson core_jq "$core_jq_json" \
    --argjson core_zsh "$core_zsh_json" \
    --argjson audit_curl "$audit_curl_json" \
    --argjson audit_tar "$audit_tar_json" \
    --argjson audit_ssh "$audit_ssh_json" \
    --argjson verify_cosign "$verify_cosign_json" \
    --argjson verify_sha256sum "$verify_sha256sum_json" \
    --argjson verify_shasum "$verify_shasum_json" \
    --argjson verify_python3 "$verify_python3_json" \
    --argjson verify_python "$verify_python_json" \
    --argjson sandbox_podman "$sandbox_podman_json" \
    --argjson sandbox_timeout "$sandbox_timeout_json" \
    --argjson feature_capabilities "$feature_capabilities_json" \
    --argjson verify_release_asset "$verify_release_asset_json" \
    --argjson verify_sigstore_bundle "$verify_sigstore_bundle_json" \
    --argjson verify_tuf_bootstrap "$verify_tuf_bootstrap_json" \
    --argjson binary_exec "$binary_exec_json" \
    --argjson safe_run_sandbox "$safe_run_sandbox_json" \
    --argjson safe_run_config_present "$( [[ -f "$run_config_dir/config.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_run_host_allow_file "$( [[ -f "$run_config_dir/host-allow.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_run_sandbox_known_file "$( [[ -f "$run_config_dir/sandbox-known.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_run_blocked_file "$( [[ -f "$run_config_dir/blocked.json" ]] && printf 'true' || printf 'false' )" \
    --argjson linked_npx "$linked_npx" \
    --argjson linked_bunx "$linked_bunx" \
    --argjson linked_uvx "$linked_uvx" \
    --argjson linked_pipx "$linked_pipx" \
    --argjson safe_audit_config_present "$( [[ -d "$audit_config_dir" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_audit_machines_file "$( [[ -f "$audit_config_dir/machines.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_audit_tools_file "$( [[ -f "$audit_config_dir/tools.json" ]] && printf 'true' || printf 'false' )" \
    --argjson wrapper_present "$( [[ -f "$install_wrapper" ]] && printf 'true' || printf 'false' )" \
    --argjson completion_present "$( [[ -f "$completion_file" ]] && printf 'true' || printf 'false' )" \
    '{
      command: "safe doctor",
      version: $version,
      paths: {
        safe: $safe_path,
        safe_run: $safe_run_path,
        safe_audit: $safe_audit_path,
        config_dir: $config_dir,
        data_dir: $data_dir
      },
      dispatch: {
        audit_version_parity: $audit_parity,
        run_version_parity: $run_parity
      },
      dependencies: {
        core: {
          bash: $core_bash,
          jq: $core_jq,
          zsh: $core_zsh
        },
        audit: {
          curl: $audit_curl,
          tar: $audit_tar,
          ssh: $audit_ssh
        },
        verify: {
          cosign: $verify_cosign,
          sha256sum: $verify_sha256sum,
          shasum: $verify_shasum,
          python3: $verify_python3,
          python: $verify_python
        },
        sandbox: {
          podman: $sandbox_podman,
          timeout: $sandbox_timeout
        }
      },
      features: {
        safe_audit_capabilities: $feature_capabilities,
        verify_release_asset: $verify_release_asset,
        verify_sigstore_bundle: $verify_sigstore_bundle,
        verify_tuf_bootstrap: $verify_tuf_bootstrap,
        binary_exec: $binary_exec,
        safe_run_sandbox: $safe_run_sandbox
      },
      environment: {
        safe_run: {
          config_present: $safe_run_config_present,
          host_allow_file: $safe_run_host_allow_file,
          sandbox_known_file: $safe_run_sandbox_known_file,
          blocked_file: $safe_run_blocked_file,
          linked_runners: {
            npx: $linked_npx,
            bunx: $linked_bunx,
            uvx: $linked_uvx,
            pipx: $linked_pipx
          }
        },
        safe_audit: {
          config_present: $safe_audit_config_present,
          machines_file: $safe_audit_machines_file,
          tools_file: $safe_audit_tools_file
        },
        install_wrappers: {
          script_present: $wrapper_present,
          completion_present: $completion_present
        }
      }
    }'
}

print_doctor_human() {
  local payload_json="$1"
  printf 'safe %s\n' "$SAFE_VERSION"
  printf 'command: safe doctor\n\n'
  jq -r '
    "paths:",
    "  safe: " + .paths.safe.resolved,
    "  safe run binary: " + .paths.safe_run.resolved,
    "  safe audit binary: " + .paths.safe_audit.resolved,
    "",
    "dispatch:",
    "  audit version parity: " + (if .dispatch.audit_version_parity.supported then (if .dispatch.audit_version_parity.ok then "ok" else "mismatch" end) else "unavailable" end),
    "  run version parity: " + (if .dispatch.run_version_parity.supported then (if .dispatch.run_version_parity.ok then "ok" else "mismatch" end) else "unavailable" end),
    "",
    "feature readiness:",
    "  safe audit capabilities: " + (if .features.safe_audit_capabilities.available then "available" else "unavailable" end),
    "  verify release-asset: " + (if .features.verify_release_asset.ready then "ready" else "not ready" end),
    "  verify sigstore-bundle: " + (if .features.verify_sigstore_bundle.ready then "ready" else "not ready" end),
    "  verify tuf-bootstrap: " + (if .features.verify_tuf_bootstrap.ready then "ready" else "not ready" end),
    "  binary exec: " + (if .features.binary_exec.ready then "ready" else "not ready" end),
    "  safe run sandbox: " + (if .features.safe_run_sandbox.ready then "ready" else "not ready" end),
    "",
    "missing prerequisites:",
    (
      [
        .features.verify_release_asset.missing[],
        .features.verify_sigstore_bundle.missing[],
        .features.verify_tuf_bootstrap.missing[],
        .features.binary_exec.missing[],
        .features.safe_run_sandbox.missing[]
      ]
      | unique
      | if length == 0 then ["  none"] else map("  " + .) end
      | .[]
    )
  ' <<<"$payload_json"
}

cmd_doctor() {
  local json_mode=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json_mode=1
        shift
        ;;
      -*)
        die "unknown doctor flag: $1"
        ;;
      *)
        die "unexpected argument for doctor: $1"
        ;;
    esac
  done

  local payload_json
  payload_json=$(doctor_payload_json)
  if [[ "$json_mode" == "1" ]]; then
    printf '%s\n' "$payload_json"
  else
    print_doctor_human "$payload_json"
  fi
}

quote_command() {
  local arg first=1
  for arg in "$@"; do
    if [[ "$first" == "0" ]]; then
      printf ' '
    fi
    printf '%q' "$arg"
    first=0
  done
}

cmd_install_usage() {
  cat <<'EOF'
usage:
  safe install [-g|--global] [--yes] <pkg> [...]
  safe install --manager npm|pnpm|yarn|bun|composer -g [--yes] [--trust-host] <pkg> [...]
  safe install --host [--yes] [package-manager flags...] <pkg> [...]
  safe install --sandbox [safe run install flags...] <pkg> [...]

Host installs are audited with `safe audit check` before the package manager runs.
`--yes` skips the final confirmation prompt after a successful audit.
`--trust-host` adds exact npm versions to safe run host-allow after install.
EOF
}

safe_install_normalize_manager() {
  case "$1" in
    npm|pnpm|yarn|bun|composer) printf '%s\n' "$1" ;;
    *) die "unsupported install manager: $1" ;;
  esac
}

safe_install_has_arg() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    [[ "$arg" == "$needle" ]] && return 0
  done
  return 1
}

safe_install_npm_packages() {
  local -a packages=()
  local arg skip_next=0 after_double_dash=0

  for arg in "$@"; do
    if [[ "$skip_next" == "1" ]]; then
      skip_next=0
      continue
    fi

    if [[ "$after_double_dash" == "1" ]]; then
      packages+=("$arg")
      continue
    fi

    case "$arg" in
      --)
        after_double_dash=1
        continue
        ;;
      -g|--global|-f|--force|-D|--dev|-P|--peer|-O|--optional|-E|--exact|-T|--tilde|--cached|--save|--save-prod|--save-dev|--save-optional|--save-peer|--no-save|--prefer-offline|--prefer-online|--legacy-peer-deps|--strict-peer-deps|--dry-run|--package-lock-only|--workspace-root|--ignore-scripts|--foreground-scripts)
        continue
        ;;
      --tag|--registry|--cache|--prefix|--userconfig|--globalconfig|--workspace|-w|--filter|--omit|--include|--install-strategy|--save-prefix|--mode|--cwd)
        skip_next=1
        continue
        ;;
      --tag=*|--registry=*|--cache=*|--prefix=*|--userconfig=*|--globalconfig=*|--workspace=*|--filter=*|--omit=*|--include=*|--install-strategy=*|--save-prefix=*|--mode=*|--cwd=*|--ignore-scripts=*)
        continue
        ;;
      -*)
        continue
        ;;
      *)
        packages+=("$arg")
        ;;
    esac
  done

  printf '%s\n' "${packages[@]}"
}

safe_install_npm_spec() {
  local spec="$1" name version

  if [[ "$spec" == *@npm:* ]]; then
    spec="${spec#*@npm:}"
  fi

  if [[ "$spec" == @*/*:* ]]; then
    name="${spec%:*}"
    version="${spec##*:}"
  elif [[ "$spec" != @* && "$spec" == *:* ]]; then
    name="${spec%:*}"
    version="${spec##*:}"
  elif [[ "$spec" == @*/*@* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  elif [[ "$spec" == *@* && "$spec" != @* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  else
    name="$spec"
    version="latest"
  fi

  printf '%s@%s\n' "$name" "$version"
}

safe_install_colon_spec() {
  local spec="$1" name version

  if [[ "$spec" == *":"* ]]; then
    name="${spec%%:*}"
    version="${spec#*:}"
  else
    name="$spec"
    version="latest"
  fi

  printf '%s@%s\n' "$name" "$version"
}

safe_install_composer_packages() {
  local -a packages=()
  local arg skip_next=0

  for arg in "$@"; do
    if [[ "$skip_next" == "1" ]]; then
      skip_next=0
      continue
    fi

    case "$arg" in
      --dev|--update-no-dev|--update-with-dependencies|--update-with-all-dependencies|--ignore-platform-reqs|--no-update|--no-scripts|--no-progress|--no-install|--prefer-source|--prefer-dist|--prefer-install|--sort-packages|--optimize-autoloader|--classmap-authoritative|--apcu-autoloader)
        continue
        ;;
      --working-dir|--repository)
        skip_next=1
        continue
        ;;
      --working-dir=*|--repository=*|--prefer-install=*)
        continue
        ;;
      -*)
        continue
        ;;
      *)
        packages+=("$(safe_install_colon_spec "$arg")")
        ;;
    esac
  done

  printf '%s\n' "${packages[@]}"
}

safe_install_audit_specs() {
  local manager="$1"
  shift

  case "$manager" in
    npm|pnpm|yarn|bun)
      safe_install_npm_packages "$@" | while IFS= read -r raw_package; do
        [[ -n "$raw_package" ]] && safe_install_npm_spec "$raw_package"
      done
      ;;
    composer)
      safe_install_composer_packages "$@"
      ;;
  esac
}

safe_install_ecosystem() {
  case "$1" in
    npm|pnpm|yarn|bun) printf 'npm\n' ;;
    composer) printf 'composer\n' ;;
  esac
}

safe_install_build_command() {
  local __out_var="$1" manager="$2" global_mode="$3"
  shift 3
  local -n out_ref="$__out_var"
  local -a cmd=()

  case "$manager:$global_mode" in
    npm:1) cmd=(npm install -g "$@") ;;
    npm:0) cmd=(npm install "$@") ;;
    pnpm:1) cmd=(pnpm add -g "$@") ;;
    pnpm:0) cmd=(pnpm add "$@") ;;
    yarn:1) cmd=(yarn global add "$@") ;;
    yarn:0) cmd=(yarn add "$@") ;;
    bun:1) cmd=(bun add -g "$@") ;;
    bun:0) cmd=(bun add "$@") ;;
    composer:1) cmd=(composer global require "$@") ;;
    composer:0) cmd=(composer require "$@") ;;
  esac

  out_ref=("${cmd[@]}")
}

safe_install_split_spec() {
  local spec="$1" name version

  if [[ "$spec" == @*/*@* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  elif [[ "$spec" == *@* && "$spec" != @* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  else
    name="$spec"
    version="latest"
  fi

  printf '%s\t%s\n' "$name" "$version"
}

safe_install_version_is_exact() {
  local version="$1"
  [[ "$version" =~ ^[0-9]+[.][0-9]+[.][0-9]+([-][0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?$ ]]
}

safe_install_trustable_package() {
  local package="$1" ecosystem="$2"
  local name version

  [[ "$ecosystem" == "npm" ]] || return 1
  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  [[ -n "$name" && -n "$version" ]] || return 1
  safe_install_version_is_exact "$version"
}

safe_install_host_allow_file() {
  printf '%s/run/host-allow.json\n' "${SAFE_CONFIG_DIR:-$HOME/.config/safe}"
}

safe_install_ensure_host_allow_file() {
  local host_allow_file
  command -v jq >/dev/null 2>&1 || die "--trust-host requires jq"
  host_allow_file="$(safe_install_host_allow_file)"
  mkdir -p "$(dirname "$host_allow_file")"
  if [[ ! -f "$host_allow_file" ]]; then
    printf '{"packages":{}}\n' > "$host_allow_file"
  fi
}

safe_install_write_host_allow() {
  local package="$1" reason="$2"
  local name version host_allow_file tmp

  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  safe_install_ensure_host_allow_file
  host_allow_file="$(safe_install_host_allow_file)"
  tmp="$(mktemp)"
  jq --arg p "$name" --arg v "$version" --arg r "$reason" --arg d "$(date -I)" '
    .packages[$p] = {
      version: $v,
      sha: "",
      ecosystem: "npm",
      added: $d,
      reason: $r
    }' "$host_allow_file" > "$tmp"
  mv "$tmp" "$host_allow_file"
  printf 'safe: added %s to safe run host-allow\n' "$package" >&2
}

safe_install_host_allow_matches() {
  local package="$1"
  local host_allow_file="${SAFE_CONFIG_DIR:-$HOME/.config/safe}/run/host-allow.json"
  local name version entry_version entry_ecosystem

  command -v jq >/dev/null 2>&1 || return 1
  [[ -r "$host_allow_file" ]] || return 1

  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  [[ -n "$name" && -n "$version" && "$version" != "latest" ]] || return 1

  entry_version="$(jq -r --arg p "$name" '.packages[$p].version // empty' "$host_allow_file" 2>/dev/null || true)"
  entry_ecosystem="$(jq -r --arg p "$name" '.packages[$p].ecosystem // "npm"' "$host_allow_file" 2>/dev/null || true)"

  [[ "$entry_version" == "$version" && "$entry_ecosystem" == "npm" ]]
}

safe_install_audit_package() {
  local package="$1"
  local ecosystem="$2"
  local audit_status

  [[ -x "$SAFE_AUDIT_PATH" ]] || die "safe install requires safe audit at $SAFE_AUDIT_PATH"

  set +e
  "$SAFE_AUDIT_PATH" check "$package" --ecosystem "$ecosystem"
  audit_status=$?
  set -e

  case "$audit_status" in
    0)
      return 0
      ;;
    1|10)
      if [[ "$ecosystem" == "npm" ]] && safe_install_host_allow_matches "$package"; then
        err "safe audit warned for $package; exact host-allow entry permits install"
        return 0
      fi
      refuse 100 "BLOCKED ${ecosystem} install of ${package} — safe audit verdict WARN; $(safe_install_allow_hint "$package" "$ecosystem"); details: safe explain"
      ;;
    2|20)
      refuse 104 "BLOCKED ${ecosystem} install of ${package} — safe audit verdict BLOCK; $(safe_install_allow_hint "$package" "$ecosystem"); details: safe explain"
      ;;
    *)
      refuse 100 "BLOCKED ${ecosystem} install of ${package} — safe audit failed with exit ${audit_status} (fail closed); ask the operator; details: safe explain"
      ;;
  esac
}

safe_install_allow_hint() {
  local package="$1"
  local ecosystem="$2"

  if [[ "$ecosystem" == "npm" ]]; then
    printf 'to allow: ask the operator to run: safe run host-allow add %s --reason "..." — then retry' "$package"
  else
    printf 'to allow: operator review — safe audit check %s --ecosystem %s' "$package" "$ecosystem"
  fi
}

safe_install_confirm() {
  local -a install_cmd=("$@")
  local reply

  if [[ ! -t 0 || ! -t 1 ]]; then
    refuse 102 "BLOCKED install — interactive confirmation required and this shell is non-interactive; to allow: ask the operator to run it interactively, or re-run with --yes after operator review; details: safe explain"
  fi

  printf 'safe: install with `%s`? [y/N] ' "$(quote_command "${install_cmd[@]}")" >&2
  if ! IFS= read -r reply </dev/tty; then
    return 1
  fi

  [[ "$reply" == "y" || "$reply" == "Y" || "$reply" == "yes" || "$reply" == "YES" ]]
}

safe_install_confirm_trust() {
  local package="$1"
  local reply

  if [[ ! -t 0 || ! -t 1 ]]; then
    return 1
  fi

  printf 'safe: trust %s for future safe run host execution? [y/N] ' "$package" >&2
  if ! IFS= read -r reply </dev/tty; then
    return 1
  fi

  [[ "$reply" == "y" || "$reply" == "Y" || "$reply" == "yes" || "$reply" == "YES" ]]
}

cmd_install() {
  local host_mode=0 sandbox_mode=0 yes=0
  local trust_host=0
  local manager=npm global_mode=0
  local -a manager_args=()
  local arg audit_package ecosystem
  local -a audit_packages=()
  local -a trust_packages=()
  local -a install_cmd=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --sandbox)
        sandbox_mode=1
        shift
        ;;
      --host|--npm)
        host_mode=1
        if [[ "$1" == "--npm" ]]; then
          manager=npm
        fi
        shift
        ;;
      --manager|--tool)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        manager="$(safe_install_normalize_manager "$2")"
        host_mode=1
        shift 2
        ;;
      --manager=*|--tool=*)
        manager="$(safe_install_normalize_manager "${1#*=}")"
        host_mode=1
        shift
        ;;
      --pnpm|--yarn|--bun|--composer)
        manager="$(safe_install_normalize_manager "${1#--}")"
        host_mode=1
        shift
        ;;
      --yes|-y)
        yes=1
        shift
        ;;
      --trust-host)
        trust_host=1
        host_mode=1
        shift
        ;;
      --help|-h)
        cmd_install_usage
        return 0
        ;;
      -g|--global)
        global_mode=1
        host_mode=1
        shift
        ;;
      --allow-scripts|--strict|-w|--write|-n|--network|-s|--allow-secrets|--proxy)
        sandbox_mode=1
        manager_args+=("$1")
        shift
        ;;
      *)
        manager_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ "$sandbox_mode" == "1" && "$host_mode" == "0" ]]; then
    exec "$SAFE_RUN_PATH" install "${manager_args[@]}"
  fi

  [[ "$sandbox_mode" == "1" && "$trust_host" == "1" ]] && die "--trust-host cannot be used with --sandbox"

  if [[ "$host_mode" != "1" ]]; then
    exec "$SAFE_RUN_PATH" install "${manager_args[@]}"
  fi

  command -v "$manager" >/dev/null 2>&1 || die "safe install --host requires $manager"

  mapfile -t audit_packages < <(safe_install_audit_specs "$manager" "${manager_args[@]}")

  [[ "${#audit_packages[@]}" -gt 0 ]] || die "usage: safe install --host [package-manager flags...] <pkg> [...]"

  ecosystem="$(safe_install_ecosystem "$manager")"
  for audit_package in "${audit_packages[@]}"; do
    safe_install_audit_package "$audit_package" "$ecosystem"
    if safe_install_trustable_package "$audit_package" "$ecosystem"; then
      trust_packages+=("$audit_package")
    elif [[ "$trust_host" == "1" ]]; then
      die "--trust-host requires exact npm versions; refusing to trust $audit_package"
    fi
  done

  safe_install_build_command install_cmd "$manager" "$global_mode" "${manager_args[@]}"
  if [[ "$yes" != "1" ]]; then
    safe_install_confirm "${install_cmd[@]}" || die "install cancelled"
  fi

  local install_rc
  set +e
  "${install_cmd[@]}"
  install_rc=$?
  set -e
  [[ "$install_rc" -eq 0 ]] || return "$install_rc"

  if [[ "${#trust_packages[@]}" -gt 0 ]]; then
    local reason="trusted after safe install"
    for audit_package in "${trust_packages[@]}"; do
      if [[ "$trust_host" == "1" ]] || { [[ "$yes" != "1" ]] && safe_install_confirm_trust "$audit_package"; }; then
        safe_install_write_host_allow "$audit_package" "$reason"
      fi
    done
  fi
}

argv0="$(basename "$0")"
if [[ "$argv0" == safe-* && "$argv0" != "safe-run" && "$argv0" != "safe-audit" ]]; then
  exec -a "$argv0" "$SAFE_RUN_PATH" "$@"
fi

case "${1:-}" in
  run)      shift; exec "$SAFE_RUN_PATH" "$@" ;;
  audit)
    shift
    if [[ "${1:-}" == "help" ]]; then
      exec "$SAFE_AUDIT_PATH" --help
    fi
    exec "$SAFE_AUDIT_PATH" "$@"
    ;;
  install)  shift; cmd_install "$@" ;;
  vendor)   shift; cmd_vendor "$@" ;;
  status)   shift; cmd_status "$@" ;;
  setup)    shift; exec "$SAFE_AUDIT_PATH" setup "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  explain)  shift; cmd_explain ;;
  version|--version|-v) cmd_version ;;
  help|-h|--help|"") show_usage ;;
  *)        exec "$SAFE_RUN_PATH" "$@" ;;
esac
