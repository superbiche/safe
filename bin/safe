#!/usr/bin/env bash
set -euo pipefail

SAFE_VERSION="1.34.0"
# Exported at the top level, not per-subcommand: safe-audit pins itself to
# this version, and every route that reaches it — the gate, `safe audit ...`,
# `safe install`, the safe-audit compatibility command — must carry it or the
# pin silently does not apply (review F2).
export SAFE_VERSION
SAFE_SELF="$(readlink -f "$0")"
SAFE_DIR="$(dirname "$SAFE_SELF")"
SAFE_CONFIG_ROOT="${SAFE_CONFIG_DIR:-$HOME/.config/safe}"
SAFE_DATA_ROOT="${SAFE_DATA_DIR:-$HOME/.local/share/safe}"
SAFE_RUN_PATH="$SAFE_DIR/safe-run"
# Env override so a test harness (or a side-by-side build) can point the
# dispatcher and the install gate at a specific safe-audit.
SAFE_AUDIT_PATH="${SAFE_AUDIT_PATH:-$SAFE_DIR/safe-audit}"
SAFE_BIN_ROOT="${SAFE_BIN_DIR:-$HOME/.local/bin}"
SAFE_ZSH_COMPLETION_DIR="${SAFE_ZSH_COMPLETION_DIR:-$HOME/.local/share/zsh/site-functions}"

err() { printf 'safe: %s\n' "$*" >&2; }
die() { err "$@"; exit 1; }
# Policy refusal: legible one-line contract + dedicated exit code (see safe explain).
refuse() { local code="$1"; shift; err "$@"; exit "$code"; }

show_usage() {
  cat <<'EOF'
safe: consolidated safe run, safe audit, and install wrapper tooling

USAGE
  safe run <args...>
  safe audit <args...>
  safe gate <tool> -- <args...>
  safe install [-g|--global] [--yes] <pkg> [...]
  safe install --manager npm|pnpm|yarn|bun|composer -g [--yes] [--trust-host] <pkg> [...]
  safe install --sandbox [--allow-scripts] <pkg> [...]
  safe vendor update --name NAME --path PATH --reason TEXT -- COMMAND...
  safe setup [<machine> | --all | --machine <csv>]
  safe status
  safe doctor [--json]
  safe explain [--json]
  safe report-fp <spec> [--ecosystem <eco>] [--source <agent>]
  safe version
  safe help
EOF
}

# The agent contract has ONE source: docs/contract/agent-contract.json. The
# text below, `safe explain --json`, and the tables in docs/agents.md are all
# rendered from it. They used to be hand-duplicated, and they drifted — an
# agent reading the docs and an agent reading `safe explain` were told
# different things about the same gate.
agent_contract_path() {
  local candidate
  for candidate in \
    "${SAFE_AGENT_CONTRACT:-}" \
    "$SAFE_DIR/../docs/contract/agent-contract.json" \
    "$SAFE_CONFIG_ROOT/agent-contract.json"; do
    [[ -n "$candidate" && -r "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}

cmd_explain() {
  local json=0
  case "${1:-}" in
    --json) json=1 ;;
    "") ;;
    *) printf 'usage: safe explain [--json]\n' >&2; return 2 ;;
  esac

  local contract
  if ! contract="$(agent_contract_path)"; then
    printf 'safe: agent contract not found (looked beside safe and in %s); repair the install — safe doctor\n' \
      "$SAFE_CONFIG_ROOT" >&2
    return 1
  fi
  if ! jq -e . >/dev/null 2>&1 < "$contract"; then
    printf 'safe: agent contract at %s is not readable JSON; repair the install — safe doctor\n' "$contract" >&2
    return 1
  fi

  if (( json )); then
    jq . < "$contract"
    return 0
  fi

  jq -r '
    # Greedy wrap. The indent counts against the width, or every indented
    # block overruns the column it was supposed to respect.
    def wrap($width; $indent):
      ($width - ($indent | length)) as $room
      | [splits(" ")] | reduce .[] as $w ([[]];
        (.[-1] | map(length) | add // -1) + 1 + ($w | length) as $len
        | if ($len > $room) then . + [[$w]] else .[0:-1] + [.[-1] + [$w]] end)
      | map($indent + join(" ")) | join("\n");

    "safe: " + (.title | sub("^safe: "; "")),
    "",
    (.intro | wrap(72; "")),
    "",
    (.one_rule | wrap(72; "")),
    "",
    "WHAT IS GATED",
    (.gated_surfaces[] | "  " + .surface, (.mechanism | wrap(68; "    "))),
    "",
    "  audited subcommands",
    (.audited_subcommands | wrap(68; "    ")),
    "",
    "  passthrough",
    (.passthrough | wrap(68; "    ")),
    "",
    "HOW A REFUSAL LOOKS",
    "  " + .refusal_format,
    (if .refusal_note then (.refusal_note | wrap(70; "  ")) else empty end),
    "",
    (if .preflight then "PREFLIGHT", (.preflight | wrap(70; "  ")), "" else empty end),
    "EXIT CODES (0/10/20 are package-audit verdicts; 100-104 policy refusals; 127 a genuinely missing command)",
    (.exit_codes[] | "  \(.code)  \(.meaning)"),
    "",
    "VERSION RESOLUTION",
    (.version_resolution.rule | wrap(70; "  ")),
    (.version_resolution.never_latest | wrap(70; "  ")),
    "",
    "WHAT AN AGENT SHOULD DO",
    (to_entries[] | select(.key == "agent_rules") | .value | to_entries[]
      | "  \(.key + 1). " + (.value | wrap(66; "     ") | sub("^ +"; ""))),
    "",
    "WHEN TO ESCALATE",
    (.escalation[] | "  " + .situation, (.action | wrap(68; "    "))),
    "",
    "SUSPECTED FALSE POSITIVE",
    "  " + .report_fp.command,
    (.report_fp.contract | wrap(70; "  ")),
    "",
    "OPERATOR ALLOW FLOWS",
    (.allow_flows[] | "  \(.command)\n      \(.purpose)")
  ' < "$contract"
}

# A false-positive report is an ESCALATION, not a fix: it re-runs the check,
# captures the evidence while it is still true, and writes a dated note for the
# operator to validate. Nothing here changes a verdict, touches an allowlist, or
# alters behaviour — an agent that could quiet the gate by filing a report would
# be an agent that can bypass it.
cmd_report_fp() {
  local spec="" ecosystem="" source="agent"
  while (( $# )); do
    case "$1" in
      --ecosystem) ecosystem="${2:-}"; shift 2 ;;
      --source) source="${2:-}"; shift 2 ;;
      -h|--help)
        printf 'usage: safe report-fp <spec> [--ecosystem <eco>] [--source <agent>]\n'
        return 0
        ;;
      -*) printf 'safe: report-fp: unknown flag: %s\n' "$1" >&2; return 2 ;;
      *)
        [[ -z "$spec" ]] || { printf 'safe: report-fp takes one spec\n' >&2; return 2; }
        spec="$1"; shift
        ;;
    esac
  done
  [[ -n "$spec" ]] || { printf 'usage: safe report-fp <spec> [--ecosystem <eco>] [--source <agent>]\n' >&2; return 2; }

  local repo_dir
  repo_dir="$(report_fp_repo_dir)" || {
    printf 'safe: report-fp: safe'\''s repo is not on this machine (set SAFE_REPO_DIR); nothing was written\n' >&2
    return 1
  }

  local -a args=(package-audit "$spec" --json)
  [[ -n "$ecosystem" ]] && args+=(--ecosystem "$ecosystem")

  local payload status=0
  payload="$("$SAFE_AUDIT_PATH" "${args[@]}" 2>/dev/null)" || status=$?
  # Parseable is not the same as usable. `jq -e .` accepts the scalar
  # `"not-an-object"`, and the renderer below then dies indexing it — AFTER the
  # note has been created, leaving a truncated half-report and breaking the
  # "nothing was written" guarantee this command makes. Validate the shape the
  # renderer actually consumes, before anything is created.
  if ! jq -e '
    type == "object"
    and ((.osv? // {}) | type == "object")
    and (((.osv? // {}).classification? // {}) | type == "object")
    and ((.resolution? // {}) | type == "object")
    and ((.socket? // {}) | type == "object")
    and ((.resolved_versions? // []) | type == "array")
    and ((.warn_causes? // []) | type == "array")
  ' >/dev/null 2>&1 <<<"$payload"; then
    printf 'safe: report-fp: the check produced no readable JSON (exit %s); nothing was written\n' "$status" >&2
    return 1
  fi

  local slug date_str inbox
  slug="$(printf '%s' "$spec" | tr '[:upper:]' '[:lower:]' | sed -e 's|^@||' -e 's|[/@]|-|g' -e 's|[^a-z0-9.-]|-|g' -e 's|-\{2,\}|-|g' -e 's|^-||' -e 's|-$||')"
  date_str="$(date +%F)"
  inbox="$repo_dir/inbox"
  mkdir -p "$inbox"

  # The note is rendered to a temp file IN THE DESTINATION DIRECTORY and then
  # published with a hard link. `ln` fails if the target exists and never
  # follows a symlink, so the existence check, the symlink check and the
  # exclusive create are the same syscall that does the publish — there is no
  # window between deciding the name is free and taking it.
  #
  # This replaced four cooperating mechanisms (a collision loop, an -e/-L test,
  # a `set -C` create, then a second non-exclusive open to copy the body). That
  # arrangement had a race of its own: the exclusive create closed the file and
  # the copy re-opened the path, so a symlink swapped in between them was
  # followed with the full report. Publishing what is already complete, in one
  # operation, is both smaller and correct.
  local body
  body="$(mktemp "$inbox/.report-fp.XXXXXX")" || {
    printf 'safe: report-fp: cannot write to %s; nothing was written\n' "$inbox" >&2
    return 1
  }
  # Removed on every path out of here, including the failures below.
  trap 'rm -f "$body"' RETURN

  jq -r --arg spec "$spec" --arg source "$source" --arg date "$date_str" --arg status "$status" '
      def bounds:
        [ .[]? | "- `\(.id)` (\(.severity // "unknown")) — fixed at `\(.fixed // "no fixed version")`" ] | join("\n");
      "# Suspected false positive: \($spec)",
      "",
      "**Date:** \($date)",
      "**Source:** \($source)",
      "**Affects:** safe audit verdict logic",
      "",
      "## What was checked",
      "",
      "```",
      "safe audit package-audit \($spec)" + (if .ecosystem then " --ecosystem \(.ecosystem)" else "" end),
      "```",
      "",
      "Exit code: `\($status)`  ·  Verdict: **\(.verdict // "unknown")**",
      "",
      "## Resolution",
      "",
      "Requested spec: `\($spec)`",
      "Resolved to: `\((.resolved_versions // []) | join(", ") | if . == "" then "unresolved" else . end)`",
      "Method: `\(.resolution.method // "unknown")` (status `\(.resolution.status // "unknown")`)",
      "",
      "## Why this looks wrong",
      "",
      (if ((.osv.classification.affecting // []) | length) > 0 then
        "OSV advisories reported as AFFECTING the resolved version:\n\n"
          + ((.osv.classification.affecting) | bounds)
          + "\n\nIf every fixed bound above is at or below the resolved version, none of "
          + "them affect it and the verdict is wrong."
       else
        "No advisory is classified as affecting the resolved version, yet the "
          + "command was refused — so the verdict did not come from the OSV "
          + "classification. Check the Socket and blocklist sections of the receipt."
       end),
      "",
      (if ((.osv.classification.remediated // []) | length) > 0 then
        "Advisories already remediated at this version (correctly not counted):\n\n"
          + ((.osv.classification.remediated) | bounds) + "\n"
       else empty end),
      (if ((.warn_causes // []) | length) > 0 then
        "Recorded WARN causes: " + ((.warn_causes | map("`\(.)`")) | join(", ")) + "\n"
       else empty end),
      "## Verdict inputs",
      "",
      "- Socket: `\(.socket.status // "n/a")`" +
        (if (.socket.status // "") == "skipped"
         then " — deliberately disabled by policy; not a failure"
         elif ((.socket.status // "ok") != "ok")
         then " — the check failed; its raw error text is in the receipt, not here"
         elif ((.socket.raw.data.self.alerts // []) | length) > 0
         then " — alerts: " + ((.socket.raw.data.self.alerts
           | map("\(.name // "unknown") [\(.severity // "unknown")/\(.category // "unknown")]")
           | join(", ")))
         else "" end),
      "- OSV: `\(.osv.status // "n/a")`, \((.osv.vulns // []) | length) advisories fetched",
      ""
    ' <<<"$payload" > "$body" || {
    # Checked on its own. Inside a brace group the renderer's status was the
    # group's only until the next command ran, so a failed jq was masked by the
    # trailing printfs and a note holding nothing but the static tail got
    # published — with exit 0 and a "wrote" line.
    printf 'safe: report-fp: could not render the evidence; nothing was written\n' >&2
    return 1
  }
  {
    printf '## Receipt\n\n'
    printf 'Full evidence: `%s`\n\n' "${SAFE_DATA_ROOT:-$HOME/.local/share/safe}/audit/checks/${date_str}-${slug}.json"
    printf '## Contract\n\n'
    printf 'This note IS the escalation. Nothing was auto-applied: no allowlist entry was\n'
    printf 'written, no verdict was changed, and the gate still refuses. The operator\n'
    printf 'validates before any behaviour changes.\n'
  } >> "$body" || {
    printf 'safe: report-fp: could not finish the note; nothing was written\n' >&2
    return 1
  }

  # Publish. Suffix on collision — the retry IS the existence check, so there is
  # no separate counter to get off by one. The bound is on attempts, and the
  # last attempt is a real one.
  local note="" candidate n=1
  while (( n <= 100 )); do
    if (( n == 1 )); then
      candidate="$inbox/${date_str}-${source}-fp-${slug}.md"
    else
      candidate="$inbox/${date_str}-${source}-fp-${slug}-${n}.md"
    fi
    # -T: never treat the destination as a directory. Without it, a candidate
    # that is a symlink to a directory makes ln create the link INSIDE that
    # directory — the report lands outside the inbox and this loop reports
    # success. (GNU coreutils, already assumed throughout: stat -c, sed -i.)
    if ln -T -- "$body" "$candidate" 2>/dev/null; then
      note="$candidate"
      break
    fi
    n=$((n + 1))
  done
  if [[ -z "$note" ]]; then
    printf 'safe: report-fp: could not claim a filename for %s in %s; nothing was written\n' \
      "$slug" "$inbox" >&2
    return 1
  fi

  printf 'safe: report-fp: wrote %s\n' "$note"
  printf 'safe: report-fp: nothing was allowed or changed — the operator validates this note\n'
}

report_fp_repo_dir() {
  # An explicitly configured SAFE_REPO_DIR is authoritative: if it is set and
  # wrong, that is an error, not a licence to fall back. Silently writing the
  # report into a DIFFERENT checkout than the operator named would file the
  # escalation where nobody is looking for it.
  if [[ -n "${SAFE_REPO_DIR:-}" ]]; then
    [[ -d "$SAFE_REPO_DIR/.git" && -d "$SAFE_REPO_DIR/bin" ]] || return 1
    (cd "$SAFE_REPO_DIR" && pwd)
    return 0
  fi
  local candidate
  for candidate in \
    "$SAFE_DIR/.." \
    "$HOME/dev/personal/safe"; do
    [[ -d "$candidate/.git" && -d "$candidate/bin" ]] || continue
    (cd "$candidate" && pwd)
    return 0
  done
  return 1
}

cmd_gate_usage() {
  cat <<'EOF'
usage: safe gate <tool> -- <args...>

Audits the install, update, and exec-style subcommands of <tool> with
`safe audit`, then delegates to the real <tool> on PATH. Called by the
generated wrappers in ~/.local/bin (see install.sh); not normally run by hand.

Supported tools: npm pnpm pnpx yarn bun pip pip3 uv cargo go composer mise
EOF
}

# Installed layout keeps the library beside the other safe config
# (~/.config/safe/gate-lib.sh); a dev checkout runs it straight from lib/.
gate_lib_path() {
  local candidate
  for candidate in \
    "${SAFE_GATE_LIB:-}" \
    "$SAFE_DIR/../lib/gate-lib.sh" \
    "$SAFE_CONFIG_ROOT/gate-lib.sh"; do
    [[ -n "$candidate" && -r "$candidate" ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}

cmd_gate() {
  local tool="${1:-}"

  case "$tool" in
    ""|-h|--help)
      cmd_gate_usage
      return 0
      ;;
  esac
  shift

  if [[ "${1:-}" == "--" ]]; then
    shift
  fi

  local lib
  # Fail closed: without the routing tables nothing can vouch for the command.
  lib="$(gate_lib_path)" || refuse 100 "BLOCKED ${tool} — safe gate library not found (looked beside safe and in $SAFE_CONFIG_ROOT); to allow: ask the operator to re-run safe's install.sh; details: safe explain"

  # gate-lib uses the sibling safe-core built and installed with this exact
  # dispatcher release. Export explicitly instead of trusting a PATH helper:
  # a shadow/stale lockdiff binary must fail closed, never vouch for an empty
  # projection.
  export SAFE_DIR SAFE_VERSION

  # shellcheck source=/dev/null
  source "$lib"

  local rc=0
  set +e
  safe_gate_main "$tool" "$@"
  rc=$?
  set -e
  exit "$rc"
}

cmd_version() {
  echo "safe $SAFE_VERSION"
  "$SAFE_RUN_PATH" version
  "$SAFE_AUDIT_PATH" --version
}

# Keep in sync with GATE_TOOLS in install.sh and the gate-lib routing table.
SAFE_GATE_TOOL_LIST=(npm pnpm pnpx yarn bun pip pip3 uv cargo go composer mise)

# A generated install wrapper: regular (never symlinked) file whose second
# line is EXACTLY the per-tool marker (loose substring matching let foreign
# files pass as ours — PR#30 review finding 5).
gate_wrapper_marked() {
  local path="$1" tool="$2"
  [[ -f "$path" && ! -L "$path" ]] || return 1
  # Byte-stream comparison, never a command substitution: these paths hold
  # arbitrary foreign executables, and capturing an ELF second line into a
  # shell variable made bash emit "ignored null byte in input" warnings from
  # status/doctor/install (PR#30 round regression R1). Same exact whole-line
  # test, no capture.
  LC_ALL=C sed -n '2p' -- "$path" 2>/dev/null \
    | LC_ALL=C grep -qxF -- "# safe-gate-wrapper v1 tool=${tool}"
}

# Per-tool wrapper state: installed | shadowed | not-on-path | missing | foreign.
# The wrapper set is healthy only when EVERY tool resolves to its owned
# wrapper — one ungated tool defeats the seatbelt (PR#30 review finding 3).
# An owned wrapper that resolves to NOTHING is not installed in any useful
# sense: invoked from a cron/service PATH without $SAFE_BIN_ROOT the file
# exists but gates nothing, and reporting it as installed made doctor claim
# health for a fully ungated machine (PR#30 delta finding 3).
gate_wrapper_state() {
  local tool="$1" wrapper="$SAFE_BIN_ROOT/$1" resolved=""
  if [[ -e "$wrapper" || -L "$wrapper" ]]; then
    if ! gate_wrapper_marked "$wrapper" "$tool"; then
      printf 'foreign'
      return 0
    fi
  else
    printf 'missing'
    return 0
  fi
  resolved="$(command -v "$tool" 2>/dev/null || true)"
  if [[ -z "$resolved" ]]; then
    printf 'not-on-path'
    return 0
  fi
  # Anchor both operands (SAFE_BIN_DIR is operator-settable and a relative
  # dash-leading value reads as readlink options) and require BOTH
  # canonicalizations to succeed — empty==empty would otherwise report a
  # falsely healthy `installed` (PR#30 delta-2 finding N2).
  local resolved_canon wrapper_canon
  resolved_canon="$(readlink -f -- "$resolved" 2>/dev/null || true)"
  wrapper_canon="$(readlink -f -- "$wrapper" 2>/dev/null || true)"
  if [[ -z "$resolved_canon" || -z "$wrapper_canon" ]]; then
    printf 'not-on-path'
    return 0
  fi
  if [[ "$resolved_canon" != "$wrapper_canon" ]]; then
    printf 'shadowed'
    return 0
  fi
  printf 'installed'
}

cmd_status() {
  echo "safe $SAFE_VERSION"
  echo
  echo "=== run ==="
  "$SAFE_RUN_PATH" status
  echo
  echo "=== audit ==="
  "$SAFE_AUDIT_PATH" status
  echo
  echo "=== install ==="
  # Probe EVERY PATH wrapper, not shell state and not just npm: gating is
  # executable-based and one ungated tool defeats the seatbelt.
  local tool state healthy=0 unhealthy=()
  for tool in "${SAFE_GATE_TOOL_LIST[@]}"; do
    state="$(gate_wrapper_state "$tool")"
    if [[ "$state" == "installed" ]]; then
      healthy=$((healthy + 1))
    else
      unhealthy+=("$tool:$state")
    fi
  done
  if [[ "${#unhealthy[@]}" -eq 0 ]]; then
    echo "wrappers:       ok (${healthy}/${#SAFE_GATE_TOOL_LIST[@]} installed in $SAFE_BIN_ROOT)"
  else
    echo "wrappers:       DEGRADED (${healthy}/${#SAFE_GATE_TOOL_LIST[@]} healthy) — ${unhealthy[*]}"
    echo "                foreign/shadowed/missing/not-on-path tools are NOT gated; fix and re-run install.sh"
    echo "                not-on-path means the wrapper exists but $SAFE_BIN_ROOT is not on PATH here"
  fi
}

sha256_file_or_null() {
  local path="$1"
  if [[ -f "$path" ]]; then
    sha256sum "$path" | awk '{print $1}'
  else
    printf 'null'
  fi
}

version_output_json() {
  local path="$1" version_args="$2"
  if [[ -z "$version_args" || ! -x "$path" ]]; then
    jq -n 'null'
    return
  fi

  # shellcheck disable=SC2206
  local args=($version_args)
  local output="" rc=0
  set +e
  output="$("$path" "${args[@]}" 2>&1 | head -n 1)"
  rc=$?
  set -e

  jq -n --arg output "$output" --argjson rc "$rc" '{exit_code:$rc, output:$output}'
}

cmd_vendor() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    update) cmd_vendor_update "$@" ;;
    -h|--help|help|"") cat <<'EOF'
usage: safe vendor update [--preset NAME] --name NAME --path PATH --reason TEXT \
                          [--rollback TEXT] [--version-cmd ARGS] -- COMMAND...

Runs a vendor-native update command while recording before/after binary hashes
under ~/.local/share/safe/vendor/audit.log.

--preset fills --name, --path (auto-detected on PATH), and --version-cmd for a
known vendor so you only supply --reason and the command. Explicit flags still
override the preset. Presets: claude, gh, op, uv, codex.

  safe vendor update --preset claude --reason "unlock /run-skill-generator" \
    -- claude install 2.1.205

Native vendor binaries are outside safe audit's registry scope; this is an
audit trail, not a gate. Disable each tool's in-app auto-update where possible
and run deliberate updates through this command. See docs/vendor.md.
EOF
      ;;
    *) die "unknown vendor subcommand: ${sub:-}" ;;
  esac
}

# Known-vendor presets: set name / path (auto-detected) / version-cmd so the
# caller supplies only --reason and the command. Path is resolved on PATH at
# call time; an empty result means the caller must pass --path explicitly.
safe_vendor_apply_preset() {
  local preset="$1"
  case "$preset" in
    claude|gh|op|uv|codex)
      PRESET_NAME="$preset"
      PRESET_PATH="$(command -v "$preset" 2>/dev/null || printf '')"
      PRESET_VERSION_CMD="--version"
      ;;
    *) die "unknown vendor preset: $preset (known: claude, gh, op, uv, codex)" ;;
  esac
}

cmd_vendor_update() {
  local name="" path="" reason="" rollback="" version_cmd="" preset=""
  local -a update_cmd=()
  local PRESET_NAME="" PRESET_PATH="" PRESET_VERSION_CMD=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --preset) preset="${2:-}"; shift 2 ;;
      --preset=*) preset="${1#--preset=}"; shift ;;
      --name) name="${2:-}"; shift 2 ;;
      --name=*) name="${1#--name=}"; shift ;;
      --path) path="${2:-}"; shift 2 ;;
      --path=*) path="${1#--path=}"; shift ;;
      --reason) reason="${2:-}"; shift 2 ;;
      --reason=*) reason="${1#--reason=}"; shift ;;
      --rollback) rollback="${2:-}"; shift 2 ;;
      --rollback=*) rollback="${1#--rollback=}"; shift ;;
      --version-cmd) version_cmd="${2:-}"; shift 2 ;;
      --version-cmd=*) version_cmd="${1#--version-cmd=}"; shift ;;
      --)
        shift
        update_cmd=("$@")
        break
        ;;
      *) die "unknown vendor update flag: $1" ;;
    esac
  done

  # A preset fills any field the caller did not set explicitly.
  if [[ -n "$preset" ]]; then
    safe_vendor_apply_preset "$preset"
    [[ -n "$name" ]] || name="$PRESET_NAME"
    [[ -n "$path" ]] || path="$PRESET_PATH"
    [[ -n "$version_cmd" ]] || version_cmd="$PRESET_VERSION_CMD"
    [[ -n "$path" ]] || die "vendor preset '$preset' could not find '$PRESET_NAME' on PATH; pass --path explicitly"
  fi

  [[ -n "$name" ]] || die "vendor update requires --name (or --preset)"
  [[ -n "$path" ]] || die "vendor update requires --path (or --preset)"
  [[ -n "$reason" ]] || die "vendor update requires --reason"
  [[ ${#update_cmd[@]} -gt 0 ]] || die "vendor update requires -- COMMAND..."

  local resolved_path before_sha after_sha before_version_json after_version_json log_dir log_file timestamp rc
  resolved_path="$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")"
  before_sha="$(sha256_file_or_null "$resolved_path")"
  before_version_json="$(version_output_json "$resolved_path" "$version_cmd")"

  set +e
  "${update_cmd[@]}"
  rc=$?
  set -e

  after_sha="$(sha256_file_or_null "$resolved_path")"
  after_version_json="$(version_output_json "$resolved_path" "$version_cmd")"
  timestamp="$(date -Iseconds)"
  log_dir="$SAFE_DATA_ROOT/vendor"
  log_file="$log_dir/audit.log"
  mkdir -p "$log_dir"

  jq -c -n \
    --arg timestamp "$timestamp" \
    --arg name "$name" \
    --arg path "$resolved_path" \
    --arg before_sha "$before_sha" \
    --arg after_sha "$after_sha" \
    --arg reason "$reason" \
    --arg rollback "$rollback" \
    --argjson before_version "$before_version_json" \
    --argjson after_version "$after_version_json" \
    --argjson exit_code "$rc" \
    '{
      timestamp: $timestamp,
      name: $name,
      path: $path,
      reason: $reason,
      rollback: (if $rollback == "" then null else $rollback end),
      command: $ARGS.positional,
      exit_code: $exit_code,
      before: {sha256: (if $before_sha == "null" then null else $before_sha end), version: $before_version},
      after: {sha256: (if $after_sha == "null" then null else $after_sha end), version: $after_version}
    }' \
    --args "${update_cmd[@]}" >> "$log_file"

  if [[ "$rc" -ne 0 ]]; then
    err "vendor update command exited $rc; audit log: $log_file"
    return "$rc"
  fi

  if [[ "$before_sha" == "$after_sha" ]]; then
    err "vendor update completed; tracked binary hash unchanged; audit log: $log_file"
  else
    printf 'safe: vendor update recorded %s -> %s\n' "$before_sha" "$after_sha" >&2
    printf 'safe: audit log: %s\n' "$log_file" >&2
  fi
}

capture_command() {
  local __out_var="$1"
  shift
  local output="" rc=0
  set +e
  output="$("$@" 2>/dev/null)"
  rc=$?
  set -e
  printf -v "$__out_var" '%s' "$output"
  return "$rc"
}

command_presence_json() {
  local cmd="$1"
  local version_cmd="${2:-}"
  local path="" version=""
  path=$(command -v "$cmd" 2>/dev/null || true)
  if [[ -n "$path" ]]; then
    path=$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")
  fi
  if [[ -n "$path" && -n "$version_cmd" ]]; then
    set +e
    version="$($cmd $version_cmd 2>/dev/null | head -n 1)"
    set -e
  fi
  jq -n \
    --arg path "$path" \
    --arg version "$version" \
    '{
      present: ($path != ""),
      path: (if $path == "" then null else $path end)
    } + (if $version == "" then {} else {version: $version} end)'
}

component_path_json() {
  local path="$1"
  local argv0="${2:-}"
  local resolved exists executable
  resolved=$(readlink -f "$path" 2>/dev/null || printf '%s' "$path")
  [[ -e "$resolved" ]] && exists=true || exists=false
  [[ -x "$resolved" ]] && executable=true || executable=false
  jq -n \
    --arg resolved "$resolved" \
    --arg argv0 "$argv0" \
    --argjson exists "$exists" \
    --argjson executable "$executable" \
    '{
      resolved: $resolved,
      exists: $exists,
      executable: $executable
    } + (if $argv0 == "" then {} else {argv0: $argv0} end)'
}

dispatch_parity_json() {
  local direct_label="$1"
  shift
  local routed_label="$1"
  shift
  local direct_out="" routed_out="" direct_rc=0 routed_rc=0
  capture_command direct_out "$@" || direct_rc=$?
  capture_command routed_out "${PARITY_ROUTED_CMD[@]}" || routed_rc=$?
  jq -n \
    --arg direct_label "$direct_label" \
    --arg routed_label "$routed_label" \
    --arg direct_out "$direct_out" \
    --arg routed_out "$routed_out" \
    --argjson direct_rc "$direct_rc" \
    --argjson routed_rc "$routed_rc" \
    '{
      supported: ($direct_rc == 0 and $routed_rc == 0),
      ok: ($direct_rc == 0 and $routed_rc == 0 and $direct_out == $routed_out),
      ($direct_label): (if $direct_rc == 0 then $direct_out else null end),
      ($routed_label): (if $routed_rc == 0 then $routed_out else null end)
    }'
}

safe_run_linked_runner() {
  local key="$1"
  local config_file="$SAFE_CONFIG_ROOT/run/config.json"
  local path=""
  if [[ -r "$config_file" ]] && command -v jq >/dev/null 2>&1; then
    path=$(jq -r --arg k "${key}_real" '.runners[$k] // empty' "$config_file" 2>/dev/null || true)
  fi
  [[ -n "$path" && -x "$path" ]] && printf 'true' || printf 'false'
}

doctor_feature_json() {
  local supported="$1"
  local ready="$2"
  shift 2
  jq -n \
    --argjson supported "$supported" \
    --argjson ready "$ready" \
    --argjson missing "$(printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    '{supported: $supported, ready: $ready, missing: $missing}'
}

doctor_payload_json() {
  command -v jq >/dev/null 2>&1 || die "doctor requires jq"

  local base_config="$SAFE_CONFIG_ROOT"
  local base_data="$SAFE_DATA_ROOT"
  local run_config_dir="$base_config/run"
  local audit_config_dir="${SAFE_AUDIT_CONFIG_DIR:-$base_config/audit}"
  local install_wrapper="$base_config/install-wrappers.zsh"

  # Per-tool wrapper states for the executable gate (finding: an aggregate
  # derived from npm alone concealed missing/shadowed siblings).
  local gate_wrappers_json='{}' gate_wrappers_healthy=true
  local gw_tool gw_state
  for gw_tool in "${SAFE_GATE_TOOL_LIST[@]}"; do
    gw_state="$(gate_wrapper_state "$gw_tool")"
    [[ "$gw_state" == "installed" ]] || gate_wrappers_healthy=false
    gate_wrappers_json=$(jq -cn --argjson acc "$gate_wrappers_json" --arg t "$gw_tool" --arg s "$gw_state" '$acc + {($t): $s}')
  done
  local completion_file="$SAFE_ZSH_COMPLETION_DIR/_safe"

  # mise shims bound to the gate wrapper (a reshim ran while the wrapper sat
  # first on PATH). The wrapper's argv0-dispatch branch keeps them working,
  # but each shimmed call pays an extra exec; surface the drift for repair.
  local mise_shim_dir="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
  local mise_shims_bound=0 mise_wrapper="$SAFE_BIN_ROOT/mise" shim shim_real wrapper_real
  if [[ -d "$mise_shim_dir" ]] && [[ "$(gate_wrapper_state mise)" == "installed" ]]; then
    wrapper_real="$(readlink -f "$mise_wrapper" 2>/dev/null || true)"
    for shim in "$mise_shim_dir"/*; do
      [[ -L "$shim" ]] || continue
      shim_real="$(readlink -f "$shim" 2>/dev/null || true)"
      [[ -n "$shim_real" && "$shim_real" == "$wrapper_real" ]] && mise_shims_bound=$((mise_shims_bound + 1))
    done
  fi

  local paths_safe_json paths_run_json paths_audit_json
  paths_safe_json=$(component_path_json "$SAFE_SELF" "$0")
  paths_run_json=$(component_path_json "$SAFE_RUN_PATH")
  paths_audit_json=$(component_path_json "$SAFE_AUDIT_PATH")

  local PARITY_ROUTED_CMD=(env SAFE_AUDIT_NO_INIT=1 "$SAFE_SELF" audit --version)
  local audit_parity_json
  audit_parity_json=$(dispatch_parity_json "safe_audit_version" "safe_audit_via_dispatcher" env SAFE_AUDIT_NO_INIT=1 "$SAFE_AUDIT_PATH" --version)

  PARITY_ROUTED_CMD=(env SAFE_RUN_NO_INIT=1 "$SAFE_SELF" run --version)
  local run_parity_json
  run_parity_json=$(dispatch_parity_json "safe_run_version" "safe_run_via_dispatcher" env SAFE_RUN_NO_INIT=1 "$SAFE_RUN_PATH" version)

  local core_bash_json core_jq_json core_zsh_json core_safe_core_json
  local audit_curl_json audit_tar_json audit_ssh_json
  local verify_cosign_json verify_sha256sum_json verify_shasum_json verify_python3_json verify_python_json
  local sandbox_podman_json sandbox_timeout_json
  core_bash_json=$(command_presence_json bash)
  core_jq_json=$(command_presence_json jq)
  core_zsh_json=$(command_presence_json zsh)
  core_safe_core_json=$(command_presence_json safe-core --version)
  audit_curl_json=$(command_presence_json curl)
  audit_tar_json=$(command_presence_json tar)
  audit_ssh_json=$(command_presence_json ssh)
  verify_cosign_json=$(command_presence_json cosign)
  verify_sha256sum_json=$(command_presence_json sha256sum)
  verify_shasum_json=$(command_presence_json shasum)
  verify_python3_json=$(command_presence_json python3 --version)
  verify_python_json=$(command_presence_json python --version)
  # Exec'ing podman from a no-new-privs process (Codex/bwrap sandboxes) needs
  # an SELinux domain transition that nnp/nosuid forbids: every probe is
  # denied and logs an AVC (setroubleshoot storms during sandboxed test
  # runs), and the failed exec made doctor report podman as broken. Presence
  # comes from PATH lookup alone there, with the reason disclosed.
  if grep -q '^NoNewPrivs:[[:space:]]*1' /proc/self/status 2>/dev/null; then
    sandbox_podman_json=$(command_presence_json podman | jq -c \
      'if .present then . + {probed: false, note: "present but not probed: this process runs no-new-privs (sandbox) and podman needs a privilege transition the sandbox denies"} else . end')
  else
    sandbox_podman_json=$(command_presence_json podman --version)
  fi
  sandbox_timeout_json=$(command_presence_json timeout)

  # Ecosystem auditors are conditional prerequisites: each is needed only when
  # a project of that ecosystem is audited, so a machine that never touches Go
  # cannot owe govulncheck. Listing them under "missing prerequisites" would
  # cry wolf on every box; a repo-audit already WARNs and names the tool it
  # could not run. Doctor still reports their presence as an advisory so the
  # gap is visible before a scan needs them — reported, never a health failure.
  local eco_govulncheck_json eco_pip_audit_json eco_cargo_audit_json eco_composer_json
  eco_govulncheck_json=$(command_presence_json govulncheck)
  eco_pip_audit_json=$(command_presence_json pip-audit)
  eco_cargo_audit_json=$(command_presence_json cargo-audit)
  eco_composer_json=$(command_presence_json composer)

  # Socket wiring: a failing socket score WARN-refuses installs, so the
  # doctor must make the auth/injection chain verifiable in one command.
  local socket_cmd socket_mapping="$HOME/.config/setup-new-machines/bw-env.d/socket.env"
  socket_cmd=$(PATH="$HOME/.npm-global/bin:$HOME/.local/bin:$PATH" command -v socket 2>/dev/null || true)
  local socket_cli_present=false socket_token_env_set=false socket_vault_mapping_present=false
  [[ -n "$socket_cmd" ]] && socket_cli_present=true
  [[ -n "${SOCKET_SECURITY_API_TOKEN:-}" ]] && socket_token_env_set=true
  [[ -f "$socket_mapping" ]] && socket_vault_mapping_present=true

  local capabilities_json="" capabilities_available=false
  local capabilities_version=""
  local capability_release_review=false
  if capture_command capabilities_json "$SAFE_SELF" audit capabilities --json; then
    if jq -e . >/dev/null 2>&1 <<<"$capabilities_json"; then
      capabilities_available=true
      capabilities_version=$(jq -r '.version // empty' <<<"$capabilities_json")
      capability_release_review=$(jq -r '.capabilities["binary-audit.release-review"] // false' <<<"$capabilities_json")
    fi
  fi

  # An installed scanner is not a working scanner: osv-scanner 2.3.x dropped
  # the go.sum path safe was feeding it, and one file it cannot read aborts the
  # whole batch, so the OSV tier vanished while every presence check stayed
  # green. Probe what the INSTALLED scanner actually reads.
  local lockfile_support_json='{"scanner":null,"version":null,"ok":false,"formats":[],"unsupported":[],"note":"probe unavailable"}'
  local lockfile_support_raw=""
  if capture_command lockfile_support_raw "$SAFE_SELF" audit lockfile-support --json; then
    if jq -e . >/dev/null 2>&1 <<<"$lockfile_support_raw"; then
      lockfile_support_json=$(jq -c '.' <<<"$lockfile_support_raw")
    fi
  fi

  # The composite's only external tools are cosign (signature + tuf checks) and
  # podman (exec check); checksum, tuf mirror, release and vuln are pure Go, and
  # the timeout/python dependencies the bash sub-lanes needed are gone. The
  # remaining verify/sandbox probes are still reported under `dependencies`.
  local has_cosign has_podman
  has_cosign=$(jq -r '.present' <<<"$verify_cosign_json")
  has_podman=$(jq -r '.present' <<<"$sandbox_podman_json")

  local feature_capabilities_json
  if [[ "$capabilities_available" == "true" ]]; then
    feature_capabilities_json=$(
      jq -n \
        --arg version "$capabilities_version" \
        --argjson caps "$(jq -c '.capabilities' <<<"$capabilities_json")" \
        '{
          available: true,
          command: "safe audit capabilities",
          version: $version,
          capabilities: $caps
        }'
    )
  else
    feature_capabilities_json='{"available":false,"command":"safe audit capabilities","version":null,"capabilities":{}}'
  fi

  # release-review is one composite capability now, not six granular lanes. It
  # is ready when safe-core advertises it AND both external tools its checks
  # shell out to are present: cosign (signature + tuf) and podman (exec).
  local release_review_json safe_run_sandbox_json
  if [[ "$capabilities_available" != "true" ]]; then
    release_review_json=$(doctor_feature_json false false "safe audit capabilities")
  elif [[ "$capability_release_review" != "true" ]]; then
    release_review_json=$(doctor_feature_json false false)
  else
    local rr_missing=()
    [[ "$has_cosign" == "true" ]] || rr_missing+=("cosign")
    [[ "$has_podman" == "true" ]] || rr_missing+=("podman")
    if [[ ${#rr_missing[@]} -eq 0 ]]; then
      release_review_json=$(doctor_feature_json true true)
    else
      release_review_json=$(doctor_feature_json true false "${rr_missing[@]}")
    fi
  fi

  local run_missing=()
  [[ "$has_podman" == "true" ]] || run_missing+=("podman")
  if [[ ${#run_missing[@]} -eq 0 ]]; then
    safe_run_sandbox_json=$(doctor_feature_json true true)
  else
    safe_run_sandbox_json=$(doctor_feature_json true false "${run_missing[@]}")
  fi

  local linked_npx linked_bunx linked_uvx linked_pipx
  linked_npx=$(safe_run_linked_runner npx)
  linked_bunx=$(safe_run_linked_runner bunx)
  linked_uvx=$(safe_run_linked_runner uvx)
  linked_pipx=$(safe_run_linked_runner pipx)

  local safe_core_version_matches=false safe_core_warning=""
  if [[ "$(jq -r '.present' <<<"$core_safe_core_json")" == "true" ]]; then
    if [[ "$(jq -r '.version // empty' <<<"$core_safe_core_json")" == "$SAFE_VERSION" ]]; then
      safe_core_version_matches=true
    else
      safe_core_warning="installed safe-core version differs from safe ${SAFE_VERSION}; rerun install.sh"
    fi
  else
    safe_core_warning="safe-core is missing from PATH; rerun install.sh"
  fi

  jq -n \
    --arg version "$SAFE_VERSION" \
    --arg config_dir "$base_config" \
    --arg data_dir "$base_data" \
    --argjson safe_path "$paths_safe_json" \
    --argjson safe_run_path "$paths_run_json" \
    --argjson safe_audit_path "$paths_audit_json" \
    --argjson audit_parity "$audit_parity_json" \
    --argjson run_parity "$run_parity_json" \
    --argjson core_bash "$core_bash_json" \
    --argjson core_jq "$core_jq_json" \
    --argjson core_zsh "$core_zsh_json" \
    --argjson core_safe_core "$core_safe_core_json" \
    --argjson safe_core_version_matches "$safe_core_version_matches" \
    --arg safe_core_warning "$safe_core_warning" \
    --argjson audit_curl "$audit_curl_json" \
    --argjson audit_tar "$audit_tar_json" \
    --argjson audit_ssh "$audit_ssh_json" \
    --argjson verify_cosign "$verify_cosign_json" \
    --argjson verify_sha256sum "$verify_sha256sum_json" \
    --argjson verify_shasum "$verify_shasum_json" \
    --argjson verify_python3 "$verify_python3_json" \
    --argjson verify_python "$verify_python_json" \
    --argjson sandbox_podman "$sandbox_podman_json" \
    --argjson sandbox_timeout "$sandbox_timeout_json" \
    --argjson feature_capabilities "$feature_capabilities_json" \
    --argjson release_review "$release_review_json" \
    --argjson safe_run_sandbox "$safe_run_sandbox_json" \
    --argjson osv_lockfile_support "$lockfile_support_json" \
    --argjson eco_govulncheck "$eco_govulncheck_json" \
    --argjson eco_pip_audit "$eco_pip_audit_json" \
    --argjson eco_cargo_audit "$eco_cargo_audit_json" \
    --argjson eco_composer "$eco_composer_json" \
    --argjson safe_run_config_present "$( [[ -f "$run_config_dir/config.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_run_host_allow_file "$( [[ -f "$run_config_dir/host-allow.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_run_sandbox_known_file "$( [[ -f "$run_config_dir/sandbox-known.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_run_install_known_file "$( [[ -f "$run_config_dir/install-known.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_run_blocked_file "$( [[ -f "$run_config_dir/blocked.json" ]] && printf 'true' || printf 'false' )" \
    --arg socket_cli_path "${socket_cmd:-}" \
    --argjson socket_cli_present "$socket_cli_present" \
    --argjson socket_token_env_set "$socket_token_env_set" \
    --argjson socket_vault_mapping_present "$socket_vault_mapping_present" \
    --argjson linked_npx "$linked_npx" \
    --argjson linked_bunx "$linked_bunx" \
    --argjson linked_uvx "$linked_uvx" \
    --argjson linked_pipx "$linked_pipx" \
    --argjson safe_audit_config_present "$( [[ -d "$audit_config_dir" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_audit_machines_file "$( [[ -f "$audit_config_dir/machines.json" ]] && printf 'true' || printf 'false' )" \
    --argjson safe_audit_tools_file "$( [[ -f "$audit_config_dir/tools.json" ]] && printf 'true' || printf 'false' )" \
    --argjson wrapper_present "$( [[ -f "$install_wrapper" ]] && printf 'true' || printf 'false' )" \
    --argjson gate_wrappers "$gate_wrappers_json" \
    --argjson gate_wrappers_healthy "$gate_wrappers_healthy" \
    --argjson mise_shims_bound "$mise_shims_bound" \
    --arg gate_bin_root "$SAFE_BIN_ROOT" \
    --argjson completion_present "$( [[ -f "$completion_file" ]] && printf 'true' || printf 'false' )" \
    '{
      command: "safe doctor",
      version: $version,
      paths: {
        safe: $safe_path,
        safe_run: $safe_run_path,
        safe_audit: $safe_audit_path,
        config_dir: $config_dir,
        data_dir: $data_dir
      },
      dispatch: {
        audit_version_parity: $audit_parity,
        run_version_parity: $run_parity
      },
      dependencies: {
        core: {
          bash: $core_bash,
          jq: $core_jq,
          zsh: $core_zsh,
          safe_core: $core_safe_core
        },
        audit: {
          curl: $audit_curl,
          tar: $audit_tar,
          ssh: $audit_ssh
        },
        verify: {
          cosign: $verify_cosign,
          sha256sum: $verify_sha256sum,
          shasum: $verify_shasum,
          python3: $verify_python3,
          python: $verify_python
        },
        sandbox: {
          podman: $sandbox_podman,
          timeout: $sandbox_timeout
        }
      },
      features: {
        safe_audit_capabilities: $feature_capabilities,
        release_review: $release_review,
        safe_run_sandbox: $safe_run_sandbox,
        osv_lockfile_support: $osv_lockfile_support,
        ecosystem_auditors: {
          govulncheck: $eco_govulncheck,
          pip_audit: $eco_pip_audit,
          cargo_audit: $eco_cargo_audit,
          composer: $eco_composer
        }
      },
      environment: {
        safe_core: {
          version_matches: $safe_core_version_matches,
          warning: (if $safe_core_warning == "" then null else $safe_core_warning end)
        },
        safe_run: {
          config_present: $safe_run_config_present,
          host_allow_file: $safe_run_host_allow_file,
          sandbox_known_file: $safe_run_sandbox_known_file,
          install_known_file: $safe_run_install_known_file,
          blocked_file: $safe_run_blocked_file,
          linked_runners: {
            npx: $linked_npx,
            bunx: $linked_bunx,
            uvx: $linked_uvx,
            pipx: $linked_pipx
          }
        },
        safe_audit: {
          config_present: $safe_audit_config_present,
          machines_file: $safe_audit_machines_file,
          tools_file: $safe_audit_tools_file
        },
        install_wrappers: {
          gate_wrappers: $gate_wrappers,
          gate_wrappers_healthy: $gate_wrappers_healthy,
          mise_shims_bound_to_wrapper: $mise_shims_bound,
          bin_root: $gate_bin_root,
          script_present: $wrapper_present,
          completion_present: $completion_present
        },
        socket: {
          cli_present: $socket_cli_present,
          cli_path: $socket_cli_path,
          token_env_set: $socket_token_env_set,
          vault_mapping_present: $socket_vault_mapping_present
        }
      }
    }'
}

print_doctor_human() {
  local payload_json="$1"
  printf 'safe %s\n' "$SAFE_VERSION"
  printf 'command: safe doctor\n\n'
  jq -r '
    "paths:",
    "  safe: " + .paths.safe.resolved,
    "  safe run binary: " + .paths.safe_run.resolved,
    "  safe audit binary: " + .paths.safe_audit.resolved,
    "  safe core: " + (if .dependencies.core.safe_core.present then
      (if .environment.safe_core.version_matches then
        "ready (" + (.dependencies.core.safe_core.version // "unknown") + ")"
      else
        "DRIFT — " + (.environment.safe_core.warning // "rerun install.sh")
      end)
    else "MISSING — rerun install.sh" end),
    "",
    "dispatch:",
    "  audit version parity: " + (if .dispatch.audit_version_parity.supported then (if .dispatch.audit_version_parity.ok then "ok" else "mismatch" end) else "unavailable" end),
    "  run version parity: " + (if .dispatch.run_version_parity.supported then (if .dispatch.run_version_parity.ok then "ok" else "mismatch" end) else "unavailable" end),
    "",
    "feature readiness:",
    "  safe audit capabilities: " + (if .features.safe_audit_capabilities.available then "available" else "unavailable" end),
    ((if .dependencies.sandbox.podman.probed == false
      then " (podman present but unprobed: this doctor runs no-new-privs — sandboxed execs fail from THIS process, unaffected outside it)"
      else "" end) as $podman_caveat
    | "  release-review: " + (if .features.release_review.ready then "ready" else "not ready" end) + $podman_caveat,
      "  safe run sandbox: " + (if .features.safe_run_sandbox.ready then "ready" else "not ready" end) + $podman_caveat),
    "  osv lockfile formats: " + (
      if .features.osv_lockfile_support.scanner == null then "osv-scanner unavailable"
      elif .features.osv_lockfile_support.ok then
        "all " + ((.features.osv_lockfile_support.formats | length) | tostring) + " readable"
      else
        ([(if ((.features.osv_lockfile_support.unsupported // []) | length) > 0 then
            "UNREADABLE — " + (.features.osv_lockfile_support.unsupported | join(", "))
            + " (the scanner dropped these extractors; those repos lose their OSV tier)"
          else empty end),
          (if ((.features.osv_lockfile_support.unknown // []) | length) > 0 then
            "INCONCLUSIVE — " + (.features.osv_lockfile_support.unknown | join(", "))
            + " (the probe could not tell; treat coverage as unverified"
            + (if (.features.osv_lockfile_support.note // "") != "" then " — " + .features.osv_lockfile_support.note else "" end)
            + ")"
          else empty end)]
         | join("; "))
      end),
    "",
    "ecosystem auditors (present only matters when auditing that ecosystem):",
    "  govulncheck (Go):   " + (if .features.ecosystem_auditors.govulncheck.present then "present" else "absent — Go repos lose their govulncheck tier (repo-audit still WARNs and says so)" end),
    "  pip-audit (Python): " + (if .features.ecosystem_auditors.pip_audit.present then "present" else "absent — Python repos lose their pip-audit tier (repo-audit still WARNs and says so)" end),
    "  cargo-audit (Rust): " + (if .features.ecosystem_auditors.cargo_audit.present then "present" else "absent — Rust repos lose their cargo-audit tier (repo-audit still WARNs and says so)" end),
    "  composer (PHP):     " + (if .features.ecosystem_auditors.composer.present then "present" else "absent — PHP repos lose their composer-audit tier (repo-audit still WARNs and says so)" end),
    "",
    "socket wiring (install gate scoring):",
    "  cli: " + (if .environment.socket.cli_present then .environment.socket.cli_path else "MISSING — install socket CLI" end),
    "  token: " + (if .environment.socket.token_env_set then "env" elif .environment.socket.vault_mapping_present then "vault mapping" else "MISSING — socket login or add bw-env socket mapping" end),
    (if (.environment.install_wrappers.mise_shims_bound_to_wrapper // 0) > 0 then
      "\nmise shims: " + (.environment.install_wrappers.mise_shims_bound_to_wrapper | tostring)
      + " bound to the gate wrapper — dispatch still works (argv0 branch) but pays an extra exec per call."
      + "\n  repair: PATH=\"$(printf %s \"$PATH\" | tr : \"\\n\" | grep -vxF "
      + ((.environment.install_wrappers.bin_root // "") | @sh)
      + " | paste -sd:)\" mise reshim"
      + "\n  (drops the safe bin dir so mise relinks the shims to the real binary; a plain mise reshim would rebind them to the wrapper)"
    else empty end),
    "",
    "missing prerequisites:",
    (
      [
        .features.release_review.missing[],
        .features.safe_run_sandbox.missing[],
        (.features.osv_lockfile_support.unsupported[]?
         | "osv-scanner extractor for " + . + " (repos using it lose their OSV tier)"),
        (.features.osv_lockfile_support.unknown[]?
         | "osv-scanner probe for " + . + " was inconclusive (coverage unverified)")
      ]
      | unique
      | if length == 0 then ["  none"] else map("  " + .) end
      | .[]
    )
  ' <<<"$payload_json"
}

cmd_doctor() {
  local json_mode=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json_mode=1
        shift
        ;;
      -*)
        die "unknown doctor flag: $1"
        ;;
      *)
        die "unexpected argument for doctor: $1"
        ;;
    esac
  done

  local payload_json
  payload_json=$(doctor_payload_json)
  if [[ "$json_mode" == "1" ]]; then
    printf '%s\n' "$payload_json"
  else
    print_doctor_human "$payload_json"
  fi
}

quote_command() {
  local arg first=1
  for arg in "$@"; do
    if [[ "$first" == "0" ]]; then
      printf ' '
    fi
    printf '%q' "$arg"
    first=0
  done
}

cmd_install_usage() {
  cat <<'EOF'
usage:
  safe install [--project] [--yes]
  safe install [-g|--global] [--yes] <pkg> [...]
  safe install --manager npm|pnpm|yarn|bun|composer -g [--yes] [--trust-host] <pkg> [...]
  safe install --host [--yes] [package-manager flags...] <pkg> [...]
  safe install --sandbox [safe run install flags...] <pkg> [...]

With no package and a manifest in the current directory (or with `--project`),
safe bulk-audits the project's dependency evidence and reports; it audits only
and never runs a package manager, so it takes no package arguments and no
install flags. Critical findings refuse with exit 104 even under `--yes`; a
WARN verdict needs `--yes` or an interactive accept (exit 102 in a
non-interactive shell); a scanner that ran and failed refuses with exit 100.

Host installs are audited with `safe audit package-audit` before the package manager runs.
`--yes` skips the final confirmation prompt after a successful audit.
`--trust-host` adds exact npm versions to safe run host-allow after install.
EOF
}

safe_install_normalize_manager() {
  case "$1" in
    npm|pnpm|yarn|bun|composer) printf '%s\n' "$1" ;;
    *) die "unsupported install manager: $1" ;;
  esac
}

safe_install_has_arg() {
  local needle="$1"
  shift
  local arg
  for arg in "$@"; do
    [[ "$arg" == "$needle" ]] && return 0
  done
  return 1
}

safe_install_npm_packages() {
  local -a packages=()
  local arg skip_next=0 after_double_dash=0

  for arg in "$@"; do
    if [[ "$skip_next" == "1" ]]; then
      skip_next=0
      continue
    fi

    if [[ "$after_double_dash" == "1" ]]; then
      packages+=("$arg")
      continue
    fi

    case "$arg" in
      --)
        after_double_dash=1
        continue
        ;;
      -g|--global|-f|--force|-D|--dev|-P|--peer|-O|--optional|-E|--exact|-T|--tilde|--cached|--save|--save-prod|--save-dev|--save-optional|--save-peer|--no-save|--prefer-offline|--prefer-online|--legacy-peer-deps|--strict-peer-deps|--dry-run|--package-lock-only|--workspace-root|--ignore-scripts|--foreground-scripts)
        continue
        ;;
      --tag|--registry|--@*:registry|--cache|--prefix|--userconfig|--globalconfig|--workspace|-w|--filter|--omit|--include|--install-strategy|--save-prefix|--mode|--cwd)
        skip_next=1
        continue
        ;;
      --tag=*|--registry=*|--cache=*|--prefix=*|--userconfig=*|--globalconfig=*|--workspace=*|--filter=*|--omit=*|--include=*|--install-strategy=*|--save-prefix=*|--mode=*|--cwd=*|--ignore-scripts=*)
        continue
        ;;
      -*)
        continue
        ;;
      *)
        packages+=("$arg")
        ;;
    esac
  done

  printf '%s\n' "${packages[@]}"
}

safe_install_npm_spec() {
  local spec="$1" name version

  if [[ "$spec" == *@npm:* ]]; then
    spec="${spec#*@npm:}"
  fi

  if [[ "$spec" == @*/*:* ]]; then
    name="${spec%:*}"
    version="${spec##*:}"
  elif [[ "$spec" != @* && "$spec" == *:* ]]; then
    name="${spec%:*}"
    version="${spec##*:}"
  elif [[ "$spec" == @*/*@* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  elif [[ "$spec" == *@* && "$spec" != @* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  else
    name="$spec"
    version="latest"
  fi

  safe_install_print_spec "$name" "$version"
}

safe_install_colon_spec() {
  local spec="$1" name version

  if [[ "$spec" == *":"* ]]; then
    name="${spec%%:*}"
    version="${spec#*:}"
  else
    name="$spec"
    version="latest"
  fi

  safe_install_print_spec "$name" "$version"
}

# An unpinned request is audited as the bare name: safe audit resolves the
# real target version itself (a fabricated @latest is version-blind and made
# pinned host-allow entries unmatchable).
safe_install_print_spec() {
  local name="$1" version="$2"

  if [[ -z "$version" || "$version" == "latest" ]]; then
    printf '%s\n' "$name"
  else
    printf '%s@%s\n' "$name" "$version"
  fi
}

safe_install_composer_packages() {
  local -a packages=()
  local arg skip_next=0

  for arg in "$@"; do
    if [[ "$skip_next" == "1" ]]; then
      skip_next=0
      continue
    fi

    case "$arg" in
      --dev|--update-no-dev|--update-with-dependencies|--update-with-all-dependencies|--ignore-platform-reqs|--no-update|--no-scripts|--no-progress|--no-install|--prefer-source|--prefer-dist|--prefer-install|--sort-packages|--optimize-autoloader|--classmap-authoritative|--apcu-autoloader)
        continue
        ;;
      --working-dir|--repository)
        skip_next=1
        continue
        ;;
      --working-dir=*|--repository=*|--prefer-install=*)
        continue
        ;;
      -*)
        continue
        ;;
      *)
        packages+=("$(safe_install_colon_spec "$arg")")
        ;;
    esac
  done

  printf '%s\n' "${packages[@]}"
}

safe_install_audit_specs() {
  local manager="$1"
  shift

  case "$manager" in
    npm|pnpm|yarn|bun)
      safe_install_npm_packages "$@" | while IFS= read -r raw_package; do
        [[ -n "$raw_package" ]] && safe_install_npm_spec "$raw_package"
      done
      ;;
    composer)
      safe_install_composer_packages "$@"
      ;;
  esac
}

safe_install_ecosystem() {
  case "$1" in
    npm|pnpm|yarn|bun) printf 'npm\n' ;;
    composer) printf 'composer\n' ;;
  esac
}

safe_install_build_command() {
  local __out_var="$1" manager="$2" global_mode="$3"
  shift 3
  local -n out_ref="$__out_var"
  local -a cmd=()

  case "$manager:$global_mode" in
    npm:1) cmd=(npm install -g "$@") ;;
    npm:0) cmd=(npm install "$@") ;;
    pnpm:1) cmd=(pnpm add -g "$@") ;;
    pnpm:0) cmd=(pnpm add "$@") ;;
    yarn:1) cmd=(yarn global add "$@") ;;
    yarn:0) cmd=(yarn add "$@") ;;
    bun:1) cmd=(bun add -g "$@") ;;
    bun:0) cmd=(bun add "$@") ;;
    composer:1) cmd=(composer global require "$@") ;;
    composer:0) cmd=(composer require "$@") ;;
  esac

  out_ref=("${cmd[@]}")
}

safe_install_split_spec() {
  local spec="$1" name version

  if [[ "$spec" == @*/*@* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  elif [[ "$spec" == *@* && "$spec" != @* ]]; then
    name="${spec%@*}"
    version="${spec##*@}"
  else
    name="$spec"
    version="latest"
  fi

  printf '%s\t%s\n' "$name" "$version"
}

safe_install_version_is_exact() {
  local version="$1"
  [[ "$version" =~ ^[0-9]+[.][0-9]+[.][0-9]+([-][0-9A-Za-z.-]+)?([+][0-9A-Za-z.-]+)?$ ]]
}

safe_install_trustable_package() {
  local package="$1" ecosystem="$2"
  local name version

  [[ "$ecosystem" == "npm" ]] || return 1
  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  [[ -n "$name" && -n "$version" ]] || return 1
  safe_install_version_is_exact "$version"
}

safe_install_host_allow_file() {
  printf '%s/run/host-allow.json\n' "${SAFE_CONFIG_DIR:-$HOME/.config/safe}"
}

safe_install_ensure_host_allow_file() {
  local host_allow_file
  command -v jq >/dev/null 2>&1 || die "--trust-host requires jq"
  host_allow_file="$(safe_install_host_allow_file)"
  mkdir -p "$(dirname "$host_allow_file")"
  if [[ ! -f "$host_allow_file" ]]; then
    printf '{"packages":{}}\n' > "$host_allow_file"
  fi
}

safe_install_write_host_allow() {
  local package="$1" reason="$2"
  local name version host_allow_file tmp

  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  safe_install_ensure_host_allow_file
  host_allow_file="$(safe_install_host_allow_file)"
  tmp="$(mktemp)"
  jq --arg p "$name" --arg v "$version" --arg r "$reason" --arg d "$(date -I)" '
    .packages[$p] = {
      version: $v,
      sha: "",
      ecosystem: "npm",
      added: $d,
      reason: $r
    }' "$host_allow_file" > "$tmp"
  mv "$tmp" "$host_allow_file"
  printf 'safe: added %s to safe run host-allow\n' "$package" >&2
}

# Grant-time spellings (py|uv|pipx…) and audit-time spellings (python) must
# compare equal, or an operator grant goes silently inert.
safe_install_canonical_eco() {
  case "$1" in
    py|python|uv|pipx|pypi) printf 'python' ;;
    npm|bun) printf 'npm' ;;
    *) printf '%s' "$1" ;;
  esac
}

safe_install_host_allow_matches() {
  local package="$1"
  local ecosystem="${2:-npm}"
  local host_allow_file="${SAFE_CONFIG_DIR:-$HOME/.config/safe}/run/host-allow.json"
  local name version entry_version entry_ecosystem

  command -v jq >/dev/null 2>&1 || return 1
  [[ -r "$host_allow_file" ]] || return 1

  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  [[ -n "$name" && -n "$version" && "$version" != "latest" ]] || return 1

  entry_version="$(jq -r --arg p "$name" '.packages[$p].version // empty' "$host_allow_file" 2>/dev/null || true)"
  entry_ecosystem="$(jq -r --arg p "$name" '.packages[$p].ecosystem // "npm"' "$host_allow_file" 2>/dev/null || true)"

  [[ "$entry_version" == "$version" ]] || return 1
  # Only grantable ecosystems are matchable: hand-edited entries for
  # unsupported ecosystems carry no authority (review PR#61 F3).
  local canon_eco
  canon_eco="$(safe_install_canonical_eco "$ecosystem")"
  case "$canon_eco" in npm|python) ;; *) return 1 ;; esac
  [[ "$(safe_install_canonical_eco "$entry_ecosystem")" == "$canon_eco" ]]
}

# Persistent record of install-gate decisions, mirroring safe-run's audit_log
# field format (ts | runner | pkg | tier | context | decision | extra).
safe_install_gate_log() {
  local ecosystem="$1" package="$2" decision="$3" extra="${4:-}"
  local data_dir="${SAFE_RUN_DATA_DIR:-${SAFE_DATA_DIR:-$HOME/.local/share/safe}/run}"
  local context="non-tty"
  [[ -t 0 && -t 1 ]] && context="interactive"
  mkdir -p "$data_dir" 2>/dev/null || return 0
  local line
  line="$(date -Iseconds) | install:${ecosystem} | ${package} | GATE | ${context} | ${decision}${extra:+ | ${extra}}"
  # stderr is redirected FIRST: if the log file cannot be opened, the shell
  # reports that failure on stderr, and a best-effort log must never add a
  # second line to a refusal that is contractually one line.
  printf '%s\n' "${line//[$'\r\n']/ }" 2>/dev/null >> "$data_dir/audit.log" || true
}

safe_install_known_matches() {
  local package="$1" ecosystem="$2"
  local known_file name version first_allowed ttl_days entry_epoch now_epoch
  # install-known entries are keyed by the canonical resolver ecosystem.
  case "$ecosystem" in
    cargo) ecosystem="rust" ;;
    composer) ecosystem="php" ;;
    pip|uv) ecosystem="python" ;;
  esac
  known_file="${SAFE_RUN_CONFIG_DIR:-${SAFE_CONFIG_DIR:-$HOME/.config/safe}/run}/install-known.json"

  command -v jq >/dev/null 2>&1 || return 1
  [[ -r "$known_file" ]] || return 1

  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  [[ -n "$name" && -n "$version" && "$version" != "latest" ]] || return 1

  # Only fully clean GO evidence may satisfy the offline fallback — a
  # tolerated-WARN record is not clean evidence (PR#29 review finding 5).
  # The source identity (implicit-default vs explicit:<set>, delta-3
  # finding 5) must be byte-identical to what safe-audit's receipt writer
  # recorded; the derivation (argv + env + rc precedence, per ecosystem) is
  # centralized in safe-audit — ask it instead of mirroring (delta-4
  # findings 3.2 and N1). Local-only plumbing, no network. No identity ->
  # fail closed: stale evidence never applies without a trustworthy match.
  [[ -x "$SAFE_AUDIT_PATH" ]] || return 1
  local -a es_args=("$name" --ecosystem "$ecosystem")
  [[ -n "${SAFE_INSTALL_INSTALLER:-}" ]] && es_args+=(--installer "$SAFE_INSTALL_INSTALLER")
  [[ -n "${SAFE_INSTALL_REGISTRY:-}" ]] && es_args+=(--registry "$SAFE_INSTALL_REGISTRY")
  [[ -n "${SAFE_INSTALL_PROJECT_DIR:-}" ]] && es_args+=(--project-dir "$SAFE_INSTALL_PROJECT_DIR")
  [[ -n "${SAFE_INSTALL_NPM_USERCONFIG:-}" ]] && es_args+=(--npm-userconfig "$SAFE_INSTALL_NPM_USERCONFIG")
  [[ -n "${SAFE_INSTALL_NPM_GLOBALCONFIG:-}" ]] && es_args+=(--npm-globalconfig "$SAFE_INSTALL_NPM_GLOBALCONFIG")
  local current_source
  current_source="$("$SAFE_AUDIT_PATH" effective-sources "${es_args[@]}" 2>/dev/null)" || return 1
  [[ -n "$current_source" ]] || return 1
  first_allowed="$(jq -r --arg k "${ecosystem}:${name}" --arg v "$version" --arg src "$current_source" \
    '.packages[$k] | select(.version == $v and .verdict == "GO" and ((.source // "implicit-default") == $src)) | .first_allowed // empty' "$known_file" 2>/dev/null || true)"
  [[ -n "$first_allowed" ]] || return 1

  ttl_days="$(jq -r '.install.auto_allow_ttl_days // 30' \
    "${SAFE_RUN_CONFIG_DIR:-${SAFE_CONFIG_DIR:-$HOME/.config/safe}/run}/config.json" 2>/dev/null || echo 30)"
  [[ "$ttl_days" =~ ^[0-9]+$ ]] || ttl_days=30
  entry_epoch="$(date -d "$first_allowed" +%s 2>/dev/null || true)"
  [[ -n "$entry_epoch" ]] || return 1
  now_epoch="$(date +%s)"
  (( now_epoch - entry_epoch <= ttl_days * 86400 ))
}

# Source selectors are cumulative: accumulate every one — a later trusted
# selector must never erase an earlier untrusted one (delta-2 finding 3).
# A REPEATED selector moves to the END: npm options are last-wins and the
# resolver reads the last word (delta-4 finding 3.1); trailing slashes
# normalize away so writer and readers derive identical identities (N1).
safe_install_add_source() {
  local value="$1"
  while [[ "$value" == */ ]]; do value="${value%/}"; done
  # The accumulated set stays OPERATIONAL (credentials included): safe-audit
  # fetches packuments from it, and pre-redacting here broke authenticated
  # registries (delta-6 finding N2). Redaction happens centrally in
  # safe-audit at every identity/receipt/display sink.
  [[ -n "$value" ]] || return 0
  local out="" w
  for w in ${SAFE_INSTALL_REGISTRY}; do
    [[ "$w" == "$value" ]] || out="${out:+$out }$w"
  done
  SAFE_INSTALL_REGISTRY="${out:+$out }$value"
}

# Alternate npm config files are threaded to safe-audit AS PATHS, never
# flattened into the source set: extracting their values here lost the
# key/scope and npm's config-tier precedence (wrong-registry resolution),
# and copied any inline credentials out of the protected file into argv
# (delta-7 findings 3.2b and N2). safe-audit resolves the effective
# endpoint from the file itself.

# Target-altering selectors in the manager args must reach the audit
# (PR#29 delta finding 3): scan and thread exactly like the shell wrappers.
safe_install_scan_target_flags() {
  local family="$1"
  shift
  SAFE_INSTALL_DIST_TAG=""
  SAFE_INSTALL_REGISTRY=""
  SAFE_INSTALL_PROJECT_DIR=""
  SAFE_INSTALL_NPM_USERCONFIG=""
  SAFE_INSTALL_NPM_GLOBALCONFIG=""
  local prev="" arg
  for arg in "$@"; do
    case "$family" in
      npm)
        case "$prev" in
          --tag) SAFE_INSTALL_DIST_TAG="$arg" ;;
          # --@scope:registry is a scoped source selector npm accepts on the
          # command line (delta-5 finding 3.2). It is threaded as a KEYED
          # token (@scope:registry=URL) — flattening the bare URL loses the
          # key and lets the resolver pick a different scope's registry
          # (delta-6 finding 3.2b). --userconfig/--globalconfig swap in
          # whole config files whose registry keys become effective.
          --registry) safe_install_add_source "$arg" ;;
          --@*:registry) safe_install_add_source "${prev#--}=${arg}" ;;
          --userconfig) SAFE_INSTALL_NPM_USERCONFIG="$arg" ;;
          --globalconfig) SAFE_INSTALL_NPM_GLOBALCONFIG="$arg" ;;
          --prefix|-C|--cwd|--dir) SAFE_INSTALL_PROJECT_DIR="$arg" ;;
        esac
        case "$arg" in
          --tag=*) SAFE_INSTALL_DIST_TAG="${arg#*=}" ;;
          --registry=*) safe_install_add_source "${arg#*=}" ;;
          --@*:registry=*) safe_install_add_source "${arg#--}" ;;
          --userconfig=*) SAFE_INSTALL_NPM_USERCONFIG="${arg#*=}" ;;
          --globalconfig=*) SAFE_INSTALL_NPM_GLOBALCONFIG="${arg#*=}" ;;
          --prefix=*|--cwd=*|--dir=*) SAFE_INSTALL_PROJECT_DIR="${arg#*=}" ;;
        esac
        ;;
      composer)
        case "$prev" in
          --repository) safe_install_add_source "$arg" ;;
          --working-dir|-d) SAFE_INSTALL_PROJECT_DIR="$arg" ;;
        esac
        case "$arg" in
          --repository=*) safe_install_add_source "${arg#*=}" ;;
          --working-dir=*) SAFE_INSTALL_PROJECT_DIR="${arg#*=}" ;;
        esac
        ;;
    esac
    prev="$arg"
  done
}

safe_install_audit_package() {
  local package="$1"
  local ecosystem="$2"
  local audit_status

  [[ -x "$SAFE_AUDIT_PATH" ]] || die "safe install requires safe audit at $SAFE_AUDIT_PATH"

  local -a extra=()
  [[ -n "${SAFE_INSTALL_DIST_TAG:-}" ]] && extra+=(--dist-tag "$SAFE_INSTALL_DIST_TAG")
  [[ -n "${SAFE_INSTALL_INSTALLER:-}" ]] && extra+=(--installer "$SAFE_INSTALL_INSTALLER")
  [[ -n "${SAFE_INSTALL_REGISTRY:-}" ]] && extra+=(--registry "$SAFE_INSTALL_REGISTRY")
  [[ -n "${SAFE_INSTALL_PROJECT_DIR:-}" ]] && extra+=(--project-dir "$SAFE_INSTALL_PROJECT_DIR")
  [[ -n "${SAFE_INSTALL_NPM_USERCONFIG:-}" ]] && extra+=(--npm-userconfig "$SAFE_INSTALL_NPM_USERCONFIG")
  [[ -n "${SAFE_INSTALL_NPM_GLOBALCONFIG:-}" ]] && extra+=(--npm-globalconfig "$SAFE_INSTALL_NPM_GLOBALCONFIG")

  set +e
  "$SAFE_AUDIT_PATH" package-audit "$package" --ecosystem "$ecosystem" --gate install --op install ${extra[@]+"${extra[@]}"}
  audit_status=$?
  set -e

  case "$audit_status" in
    0)
      safe_install_gate_log "$ecosystem" "$package" "PROCEED"
      return 0
      ;;
    1|10)
      if safe_install_host_allow_matches "$package" "$ecosystem"; then
        err "safe audit warned for $package; exact host-allow entry permits install"
        safe_install_gate_log "$ecosystem" "$package" "HOST_ALLOW_OVERRIDE"
        return 0
      fi
      safe_install_gate_log "$ecosystem" "$package" "REFUSED_WARN"
      refuse 100 "BLOCKED ${ecosystem} install of ${package} — safe audit verdict WARN; $(safe_install_allow_hint "$package" "$ecosystem"); details: safe explain"
      ;;
    2|20)
      # No allow hint on BLOCK: host-allow only clears WARN, and for a
      # known-malware record the hint would contradict the audit's own
      # "do not pin around it" (review PR#55 F2).
      safe_install_gate_log "$ecosystem" "$package" "REFUSED_BLOCK"
      refuse 104 "BLOCKED ${ecosystem} install of ${package} — safe audit verdict BLOCK; operator review required: safe audit package-audit ${package} --ecosystem ${ecosystem} --json; details: safe explain"
      ;;
    30)
      # The audit could not compute a verdict at all. That is breakage to
      # repair, not a finding about the package, so the refusal names it and
      # offers no allow hint: there is no evidence to allow around. Mirrors
      # the wrapper gate's arm in lib/gate-lib.sh.
      safe_install_gate_log "$ecosystem" "$package" "REFUSED_AUDIT_INFRA"
      refuse 100 "BLOCKED ${ecosystem} install of ${package} — safe audit could not run (audit-infrastructure breakage, not a package finding); rerun install.sh or run safe doctor; details: safe explain"
      ;;
    124|137)
      if safe_install_known_matches "$package" "$ecosystem"; then
        err "safe audit timed out; proceeding on recorded clean check for $package (stale evidence)"
        safe_install_gate_log "$ecosystem" "$package" "STALE_EVIDENCE"
        return 0
      fi
      safe_install_gate_log "$ecosystem" "$package" "TIMEOUT_FAILCLOSED"
      refuse 100 "BLOCKED ${ecosystem} install of ${package} — safe audit timed out (fail closed); retry or ask the operator; details: safe explain"
      ;;
    *)
      safe_install_gate_log "$ecosystem" "$package" "REFUSED_AUDIT_ERROR" "exit=${audit_status}"
      refuse 100 "BLOCKED ${ecosystem} install of ${package} — safe audit failed with exit ${audit_status} (fail closed); ask the operator; details: safe explain"
      ;;
  esac
}

# Fallback hint when the audit could not supply a pinned suggestion (the gate
# prints resolved-version hints itself). Never renders an @latest shape.
safe_install_allow_hint() {
  local package="$1"
  local ecosystem="$2"
  local name version

  IFS=$'\t' read -r name version <<< "$(safe_install_split_spec "$package")"
  case "$(safe_install_canonical_eco "$ecosystem")" in
    npm)
      if [[ -n "$version" && "$version" != "latest" ]]; then
        printf 'to allow: ask the operator to run: safe run host-allow add %s --reason "..." — then retry' "$package"
      else
        printf 'to allow: pin an exact version first (see the resolved-version hint above) — allow entries are never @latest'
      fi
      ;;
    python)
      if [[ -n "$version" && "$version" != "latest" ]]; then
        printf 'to allow: ask the operator to run: safe run host-allow add %s --ecosystem python --reason "..." — then retry' "$package"
      else
        printf 'to allow: pin an exact version first (see the resolved-version hint above) — allow entries are never @latest'
      fi
      ;;
    *)
      printf 'to allow: operator review — safe audit package-audit %s --ecosystem %s' "$package" "$ecosystem"
      ;;
  esac
}

safe_install_confirm() {
  local -a install_cmd=("$@")
  local reply

  if [[ ! -t 0 || ! -t 1 ]]; then
    refuse 102 "BLOCKED install — interactive confirmation required and this shell is non-interactive; to allow: ask the operator to run it interactively, or re-run with --yes after operator review; details: safe explain"
  fi

  printf 'safe: install with `%s`? [y/N] ' "$(quote_command "${install_cmd[@]}")" >&2
  if ! IFS= read -r reply </dev/tty; then
    return 1
  fi

  [[ "$reply" == "y" || "$reply" == "Y" || "$reply" == "yes" || "$reply" == "YES" ]]
}

safe_install_confirm_trust() {
  local package="$1"
  local reply

  if [[ ! -t 0 || ! -t 1 ]]; then
    return 1
  fi

  printf 'safe: trust %s for future safe run host execution? [y/N] ' "$package" >&2
  if ! IFS= read -r reply </dev/tty; then
    return 1
  fi

  [[ "$reply" == "y" || "$reply" == "Y" || "$reply" == "yes" || "$reply" == "YES" ]]
}

# Manifests that make a directory a project worth bulk-auditing. Order is the
# display order in the project-mode summary.
SAFE_INSTALL_PROJECT_MANIFESTS=(package.json requirements.txt pyproject.toml Cargo.toml composer.json go.mod)

safe_install_project_manifests() {
  local manifest
  for manifest in "${SAFE_INSTALL_PROJECT_MANIFESTS[@]}"; do
    [[ -f "$manifest" ]] && printf '%s\n' "$manifest"
  done
  return 0
}

safe_install_project_manifest_present() {
  local manifest
  for manifest in "${SAFE_INSTALL_PROJECT_MANIFESTS[@]}"; do
    [[ -f "$manifest" ]] && return 0
  done
  return 1
}

# Where a project scan's own output is kept. Refusals name this file instead
# of echoing a scanner's diagnostics: the refusal contract is one stderr line.
safe_install_project_log_path() {
  local dir="${SAFE_DATA_DIR:-$HOME/.local/share/safe}/install/project-scans"
  if mkdir -p "$dir" 2>/dev/null; then
    printf '%s/%s-%s.log' "$dir" "$(date +%Y%m%dT%H%M%S)" "$$"
  else
    mktemp "${TMPDIR:-/tmp}/safe-project-scan.XXXXXX.log"
  fi
}

safe_install_project_confirm() {
  local reply

  printf 'safe: accept these audit results for this project? [y/N] ' >&2
  if ! IFS= read -r reply </dev/tty; then
    return 1
  fi

  [[ "$reply" == "y" || "$reply" == "Y" || "$reply" == "yes" || "$reply" == "YES" ]]
}

# Bulk audit of the current project's dependency evidence. This mode AUDITS
# ONLY — it never runs a package manager, so there is nothing to delegate to
# after a confirmation; the confirmation records that an operator saw the
# findings.
cmd_install_project() {
  local yes="$1"
  local -a manifests=()
  mapfile -t manifests < <(safe_install_project_manifests)

  [[ "${#manifests[@]}" -gt 0 ]] || die "safe install --project found no manifest in $(pwd) (looked for: ${SAFE_INSTALL_PROJECT_MANIFESTS[*]})"
  if [[ ! -x "$SAFE_AUDIT_PATH" ]]; then
    safe_install_gate_log "project" "$(pwd)" "REFUSED_AUDIT_MISSING"
    refuse 100 "BLOCKED project audit — safe audit is not executable at ${SAFE_AUDIT_PATH}, so nothing was checked; to allow: repair the install — safe doctor; details: safe explain"
  fi

  # The scan hands us our own copy of the result document. The published
  # per-day file is shared: a concurrent scan of another project can replace
  # it between the scan and this read, and we would grade the wrong project.
  local result_path scan_log
  result_path="$(mktemp "${TMPDIR:-/tmp}/safe-project-scan.XXXXXX")"
  scan_log="$(safe_install_project_log_path)"

  local scan_rc=0
  set +e
  # --allow-missing-tools: an ecosystem auditor that is not installed comes
  # back as a "not run" record this mode reports, rather than aborting the
  # scan and leaving a Rust or Go project unauditable from any script.
  "$SAFE_AUDIT_PATH" repo-audit . --deps-only --allow-missing-tools \
    --result-out "$result_path" > "$scan_log" 2>&1
  scan_rc=$?
  set -e

  local scan_output=""
  [[ -r "$scan_log" ]] && scan_output="$(cat "$scan_log")"

  # No readable result means we cannot claim the project is clean -> fail
  # closed. The scanner's own diagnostics go to a file, not to stderr: a
  # refusal is one line, and a broken scanner can print hundreds.
  if [[ "$scan_rc" -ne 0 || ! -r "$result_path" || ! -s "$result_path" ]]; then
    # Name the actual failure: "produced no result" is false when the scan
    # wrote one and then exited nonzero, and a wrong cause sends whoever
    # reads this refusal to the wrong place.
    local cause
    if [[ "$scan_rc" -ne 0 && -s "$result_path" ]]; then
      cause="safe audit repo-audit exited ${scan_rc} after writing its result"
    elif [[ "$scan_rc" -ne 0 ]]; then
      cause="safe audit repo-audit failed (exit ${scan_rc}) and produced no result"
    else
      cause="safe audit repo-audit reported success but produced no result document"
    fi
    rm -f "$result_path"
    safe_install_gate_log "project" "$(pwd)" "REFUSED_SCAN_UNREADABLE" "exit=${scan_rc}"
    refuse 100 "BLOCKED project audit — ${cause}, so nothing was checked; to allow: fix the scanner — safe doctor, output in ${scan_log}; details: safe explain"
  fi

  local verdict packages critical high medium low cve_critical
  verdict="$(jq -r '.verdict // "UNKNOWN"' "$result_path" 2>/dev/null || printf 'UNKNOWN')"
  packages="$(jq -r '.summary.packages_total // 0' "$result_path" 2>/dev/null || printf '0')"
  # audit_totals aggregates the CVE scan AND every ecosystem audit that ran;
  # cve_scan alone misses an advisory only npm audit or composer audit saw.
  critical="$(jq -r '.audit_totals.critical // .cve_scan.critical // "x"' "$result_path" 2>/dev/null || printf 'x')"
  high="$(jq -r '.audit_totals.high // .cve_scan.high // "x"' "$result_path" 2>/dev/null || printf 'x')"
  medium="$(jq -r '.audit_totals.medium // .cve_scan.medium // "x"' "$result_path" 2>/dev/null || printf 'x')"
  low="$(jq -r '.audit_totals.low // .cve_scan.low // "x"' "$result_path" 2>/dev/null || printf 'x')"
  cve_critical="$(jq -r '.cve_scan.critical // 0' "$result_path" 2>/dev/null || printf '0')"

  # An unparseable or unknown verdict is not a clean one.
  if [[ ! "$critical" =~ ^[0-9]+$ || ! "$high" =~ ^[0-9]+$ ]] ||
     [[ "$verdict" != "GO" && "$verdict" != "WARN" && "$verdict" != "BLOCK" ]]; then
    safe_install_gate_log "project" "$(pwd)" "REFUSED_SCAN_UNPARSEABLE" "verdict=${verdict}"
    rm -f "$result_path"
    refuse 100 "BLOCKED project audit — the safe audit result is not readable as a verdict (got '${verdict}'), so nothing was checked; to allow: fix the scanner — safe doctor, output in ${scan_log}; details: safe explain"
  fi

  # A scanner whose status is "error" produced nothing usable: its silence is
  # not evidence of a clean project, and --yes must not accept it. "broken" is
  # a STRUCTURAL signal (status == "error"), never the prose of a free-form
  # note — matching /fail|error/ over a note misread a "partial" run (some
  # coverage, one target failed) as total breakage and hard-refused a project
  # that was in fact audited. "partial", "unsupported" and "absent" are
  # disclosed below and already WARN the verdict; only "error" refuses.
  local broken_tools
  broken_tools="$(jq -r '
    def broken: (.status // "ok") == "error";
    [ (.tool_status // {} | to_entries[]? | select(.value | broken) | .key),
      (.ecosystem_audits[]? | select(broken) | (.scanner // "unknown"))
    ] | unique | join(", ")
  ' "$result_path" 2>/dev/null || printf '')"
  if [[ -n "$broken_tools" ]]; then
    safe_install_gate_log "project" "$(pwd)" "REFUSED_SCANNER_BROKEN" "tools=${broken_tools}"
    rm -f "$result_path"
    refuse 100 "BLOCKED project audit — scanner failure (${broken_tools}); the project was not fully checked; to allow: fix the scanner — safe doctor, output in ${scan_log}; details: safe explain"
  fi

  # Scanners that are absent, unsupported, or only partially completed — not
  # broken. Not a refusal — the operator is told what was NOT fully looked at,
  # and the verdict is already WARN. A "partial" run is disclosed here by its
  # own note, whatever words that note contains; it is no longer second-guessed
  # by a /fail|error/ match, which is what wrongly promoted it to a refusal.
  # Core tiers belong here too: a lockfile format the scanner cannot read is
  # coverage the operator never asked to lose, and reporting it only inside the
  # result JSON is how it stayed invisible.
  local unrun_tools
  unrun_tools="$(jq -r '
    [ (.ecosystem_audits[]?
       | select((.status // "ok") != "ok")
       | select((.status // "") != "error")
       | (.scanner // "unknown") + " (" + ((.note // "not run")) + ")"),
      (.tool_status // {} | to_entries[]?
       | select((.value.status // "ok") != "ok")
       | select((.value.status // "") != "error")
       | .key + " (" + ((.value.note // "not run")) + ")")
    ] | unique | join(", ")
  ' "$result_path" 2>/dev/null || printf '')"

  # One-screen summary. The scan's own render is not echoed: it says the same
  # thing at ten times the length.
  local cve_high cve_medium cve_low
  cve_high="$(jq -r '.cve_scan.high // 0' "$result_path" 2>/dev/null || printf '0')"
  cve_medium="$(jq -r '.cve_scan.medium // 0' "$result_path" 2>/dev/null || printf '0')"
  cve_low="$(jq -r '.cve_scan.low // 0' "$result_path" 2>/dev/null || printf '0')"
  printf 'safe install: project audit — %s\n' "$(pwd)"
  printf '  manifests: %s\n' "${manifests[*]}"
  printf '  packages:  %s\n' "$packages"
  # Per source, because only osv and grype carry advisory ids: the same
  # advisory reported by three scanners is three reports, not three
  # vulnerabilities, and one summed number would say the wrong thing.
  printf '  cve scan:  critical %s, high %s, medium %s, low %s\n' \
    "$cve_critical" "$cve_high" "$cve_medium" "$cve_low"
  local eco_line
  # Every bucket, always: a lone medium advisory rendered as "critical 0,
  # high 0, unknown 0" reads as an empty finding list that still warns.
  eco_line="$(jq -r '
    [ .audit_totals.ecosystem[]?
      | select(.total > 0)
      | .scanner + " (" + (.total | tostring) + ": critical " + (.critical | tostring)
        + ", high " + (.high | tostring)
        + ", medium " + (.medium | tostring)
        + ", low " + (.low | tostring)
        + ", unknown " + ((.unknown // 0) | tostring) + ")"
    ] | join(", ")
  ' "$result_path" 2>/dev/null || printf '')"
  [[ -n "$eco_line" ]] && printf '  ecosystem: %s\n' "$eco_line"
  printf '  verdict:   %s\n' "$verdict"
  [[ -n "$unrun_tools" ]] && printf '  not run:   %s\n' "$unrun_tools"
  local cache_note
  cache_note="$(printf '%s\n' "$scan_output" | grep -F '[safe audit] scan cache hit' | tail -n 1 || true)"
  [[ -n "$cache_note" ]] && printf '  %s\n' "${cache_note#\[safe audit\] }"
  if [[ "$cve_critical" -gt 0 ]] || [[ "$cve_high" -gt 0 ]]; then
    printf '  top findings:\n'
    jq -r '
      [.cve_scan.findings[]? | select((.severity // "") | ascii_downcase | test("critical|high"))]
      | sort_by(if ((.severity // "") | ascii_downcase | test("critical")) then 0 else 1 end)
      | .[:5][]
      | "    - [" + (.severity // "unknown") + "] " + (.package // "unknown") + "@" + (.version // "unknown") + "  " + (.id // "unknown") + " (" + (.source // "?") + ")"
    ' "$result_path" 2>/dev/null || true
  fi
  # Display only: the published result path is read out of the rendered text
  # purely so a human can open it. Nothing is decided from it.
  local published=""
  published="$(printf '%s\n' "$scan_output" | sed -n 's/^Details: //p' | tail -n 1)"
  [[ -n "$published" ]] && printf '  details:   %s\n' "$published"
  printf '  scan log:  %s\n' "$scan_log"

  # Critical findings are the project-scale equivalent of a BLOCK verdict:
  # --yes accepts WARNs, never these.
  if [[ "$critical" -gt 0 || "$verdict" == "BLOCK" ]]; then
    local critical_sources
    critical_sources="$(jq -r '
      [ (if (.cve_scan.critical // 0) > 0 then "osv/grype " + ((.cve_scan.critical) | tostring) else empty end),
        (.audit_totals.ecosystem[]? | select((.critical // 0) > 0) | .scanner + " " + ((.critical) | tostring))
      ] | join(", ")
    ' "$result_path" 2>/dev/null || printf '')"
    safe_install_gate_log "project" "$(pwd)" "REFUSED_BLOCK" "critical=${critical} verdict=${verdict}"
    rm -f "$result_path"
    refuse 104 "BLOCKED project audit — critical advisories in this project's dependencies (${critical_sources:-verdict ${verdict}}); to allow: operator review — safe audit repo-audit .; details: safe explain"
  fi
  rm -f "$result_path"

  if [[ "$verdict" == "GO" ]]; then
    safe_install_gate_log "project" "$(pwd)" "PROCEED" "verdict=GO"
    if [[ "$yes" == "1" || ! -t 0 || ! -t 1 ]]; then
      return 0
    fi
    safe_install_project_confirm || { err "project audit not accepted"; return 1; }
    return 0
  fi

  if [[ "$yes" == "1" ]]; then
    safe_install_gate_log "project" "$(pwd)" "ACCEPTED_WARN" "verdict=${verdict}"
    return 0
  fi

  if [[ ! -t 0 || ! -t 1 ]]; then
    safe_install_gate_log "project" "$(pwd)" "REFUSED_WARN" "verdict=${verdict}"
    refuse 102 "BLOCKED project audit — verdict ${verdict} needs operator review and this shell is non-interactive; to allow: ask the operator to re-run it interactively, or re-run with --yes after review; details: safe explain"
  fi

  if safe_install_project_confirm; then
    safe_install_gate_log "project" "$(pwd)" "ACCEPTED_WARN" "verdict=${verdict}"
    return 0
  fi

  safe_install_gate_log "project" "$(pwd)" "DECLINED" "verdict=${verdict}"
  err "project audit not accepted"
  return 1
}

cmd_install() {
  local host_mode=0 sandbox_mode=0 yes=0
  local project_mode=0
  local trust_host=0
  local manager=npm global_mode=0
  local -a manager_args=()
  local arg audit_package ecosystem
  local -a audit_packages=()
  local -a trust_packages=()
  local -a install_cmd=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --sandbox)
        sandbox_mode=1
        shift
        ;;
      --host|--npm)
        host_mode=1
        if [[ "$1" == "--npm" ]]; then
          manager=npm
        fi
        shift
        ;;
      --manager|--tool)
        [[ $# -ge 2 ]] || die "$1 requires a value"
        manager="$(safe_install_normalize_manager "$2")"
        host_mode=1
        shift 2
        ;;
      --manager=*|--tool=*)
        manager="$(safe_install_normalize_manager "${1#*=}")"
        host_mode=1
        shift
        ;;
      --pnpm|--yarn|--bun|--composer)
        manager="$(safe_install_normalize_manager "${1#--}")"
        host_mode=1
        shift
        ;;
      --yes|-y)
        yes=1
        shift
        ;;
      --project)
        project_mode=1
        shift
        ;;
      --trust-host)
        trust_host=1
        host_mode=1
        shift
        ;;
      --help|-h)
        cmd_install_usage
        return 0
        ;;
      -g|--global)
        global_mode=1
        host_mode=1
        shift
        ;;
      --allow-scripts|--strict|-w|--write|-n|--network|-s|--allow-secrets|--proxy)
        sandbox_mode=1
        manager_args+=("$1")
        shift
        ;;
      *)
        manager_args+=("$1")
        shift
        ;;
    esac
  done

  # Project mode audits what the project already depends on and installs
  # NOTHING. It therefore cannot absorb an install request: combining it with
  # packages or install-mode flags would end in "exit 0, nothing installed,
  # user believes it was".
  if [[ "$project_mode" == "1" ]]; then
    [[ "$sandbox_mode" == "0" ]] || die "--project cannot be used with --sandbox"
    if [[ "$host_mode" == "1" || "$global_mode" == "1" || "$trust_host" == "1" ]]; then
      die "--project audits this project and installs nothing; it cannot be combined with -g/--host/--manager/--trust-host"
    fi
    if [[ "${#manager_args[@]}" -gt 0 ]]; then
      die "--project takes no package arguments (got: ${manager_args[*]}); drop --project to install them"
    fi
    cmd_install_project "$yes"
    return $?
  fi

  # Auto-detection: a bare `safe install` inside a project bulk-audits it.
  # Any install-mode flag means the caller asked for an install, so the usual
  # usage error is the right answer — never a silent audit-only success.
  if [[ "$sandbox_mode" == "0" && "$host_mode" == "0" && "$global_mode" == "0" &&
        "$trust_host" == "0" && "${#manager_args[@]}" -eq 0 ]] &&
     safe_install_project_manifest_present; then
    cmd_install_project "$yes"
    return $?
  fi

  if [[ "$sandbox_mode" == "1" && "$host_mode" == "0" ]]; then
    exec "$SAFE_RUN_PATH" install "${manager_args[@]}"
  fi

  [[ "$sandbox_mode" == "1" && "$trust_host" == "1" ]] && die "--trust-host cannot be used with --sandbox"

  if [[ "$host_mode" != "1" ]]; then
    exec "$SAFE_RUN_PATH" install "${manager_args[@]}"
  fi

  command -v "$manager" >/dev/null 2>&1 || die "safe install --host requires $manager"

  mapfile -t audit_packages < <(safe_install_audit_specs "$manager" "${manager_args[@]}")

  [[ "${#audit_packages[@]}" -gt 0 ]] || die "usage: safe install --host [package-manager flags...] <pkg> [...]"

  ecosystem="$(safe_install_ecosystem "$manager")"
  case "$manager" in
    composer) safe_install_scan_target_flags composer "${manager_args[@]}" ;;
    *) safe_install_scan_target_flags npm "${manager_args[@]}" ;;
  esac
  # bun reads its own source config for the npm ecosystem; the audit models
  # it only when told which installer runs.
  SAFE_INSTALL_INSTALLER=""
  [[ "$manager" == "bun" ]] && SAFE_INSTALL_INSTALLER="bun"
  for audit_package in "${audit_packages[@]}"; do
    safe_install_audit_package "$audit_package" "$ecosystem"
    if safe_install_trustable_package "$audit_package" "$ecosystem"; then
      trust_packages+=("$audit_package")
    elif [[ "$trust_host" == "1" ]]; then
      die "--trust-host requires exact npm versions; refusing to trust $audit_package"
    fi
  done

  safe_install_build_command install_cmd "$manager" "$global_mode" "${manager_args[@]}"
  if [[ "$yes" != "1" ]]; then
    safe_install_confirm "${install_cmd[@]}" || die "install cancelled"
  fi

  local install_rc
  set +e
  "${install_cmd[@]}"
  install_rc=$?
  set -e
  [[ "$install_rc" -eq 0 ]] || return "$install_rc"

  if [[ "${#trust_packages[@]}" -gt 0 ]]; then
    local reason="trusted after safe install"
    for audit_package in "${trust_packages[@]}"; do
      if [[ "$trust_host" == "1" ]] || { [[ "$yes" != "1" ]] && safe_install_confirm_trust "$audit_package"; }; then
        safe_install_write_host_allow "$audit_package" "$reason"
      fi
    done
  fi
}

argv0="$(basename "$0")"
if [[ "$argv0" == safe-* && "$argv0" != "safe-run" && "$argv0" != "safe-audit" ]]; then
  exec -a "$argv0" "$SAFE_RUN_PATH" "$@"
fi

case "${1:-}" in
  run)      shift; exec "$SAFE_RUN_PATH" "$@" ;;
  audit)
    shift
    if [[ "${1:-}" == "help" ]]; then
      exec "$SAFE_AUDIT_PATH" --help
    fi
    exec "$SAFE_AUDIT_PATH" "$@"
    ;;
  gate)     shift; cmd_gate "$@" ;;
  install)  shift; cmd_install "$@" ;;
  vendor)   shift; cmd_vendor "$@" ;;
  status)   shift; cmd_status "$@" ;;
  setup)    shift; exec "$SAFE_AUDIT_PATH" setup "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  explain)  shift; cmd_explain "$@" ;;
  report-fp) shift; cmd_report_fp "$@" ;;
  version|--version|-v) cmd_version ;;
  help|-h|--help|"") show_usage ;;
  *)        exec "$SAFE_RUN_PATH" "$@" ;;
esac
