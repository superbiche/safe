def cvss4_max_composed: {
  eq1: {
    "0": ["AV:N/PR:N/UI:N/"],
    "1": ["AV:A/PR:N/UI:N/", "AV:N/PR:L/UI:N/", "AV:N/PR:N/UI:P/"],
    "2": ["AV:P/PR:N/UI:N/", "AV:A/PR:L/UI:P/"]
  },
  eq2: {
    "0": ["AC:L/AT:N/"],
    "1": ["AC:H/AT:N/", "AC:L/AT:P/"]
  },
  eq3: {
    "0": {
      "0": ["VC:H/VI:H/VA:H/CR:H/IR:H/AR:H/"],
      "1": ["VC:H/VI:H/VA:L/CR:M/IR:M/AR:H/", "VC:H/VI:H/VA:H/CR:M/IR:M/AR:M/"]
    },
    "1": {
      "0": ["VC:L/VI:H/VA:H/CR:H/IR:H/AR:H/", "VC:H/VI:L/VA:H/CR:H/IR:H/AR:H/"],
      "1": ["VC:L/VI:H/VA:L/CR:H/IR:M/AR:H/", "VC:L/VI:H/VA:H/CR:H/IR:M/AR:M/", "VC:H/VI:L/VA:H/CR:M/IR:H/AR:M/", "VC:H/VI:L/VA:L/CR:M/IR:H/AR:H/", "VC:L/VI:L/VA:H/CR:H/IR:H/AR:M/"]
    },
    "2": {"1": ["VC:L/VI:L/VA:L/CR:H/IR:H/AR:H/"]}
  },
  eq4: {
    "0": ["SC:H/SI:S/SA:S/"],
    "1": ["SC:H/SI:H/SA:H/"],
    "2": ["SC:L/SI:L/SA:L/"]
  },
  eq5: {"0": ["E:A/"], "1": ["E:P/"], "2": ["E:U/"]}
};
def cvss4_max_severity: {
  eq1: {"0": 1, "1": 4, "2": 5},
  eq2: {"0": 1, "1": 2},
  eq3eq6: {"0": {"0": 7, "1": 6}, "1": {"0": 8, "1": 8}, "2": {"1": 10}},
  eq4: {"0": 6, "1": 5, "2": 4}
};
def cvss4_order: [
  "AV", "AC", "AT", "PR", "UI", "VC", "VI", "VA", "SC", "SI", "SA",
  "E", "CR", "IR", "AR", "MAV", "MAC", "MAT", "MPR", "MUI", "MVC", "MVI", "MVA", "MSC", "MSI", "MSA",
  "S", "AU", "R", "V", "RE", "U"
];
def cvss4_values: {
  AV: ["N", "A", "L", "P"], AC: ["L", "H"], AT: ["N", "P"], PR: ["N", "L", "H"], UI: ["N", "P", "A"],
  VC: ["H", "L", "N"], VI: ["H", "L", "N"], VA: ["H", "L", "N"],
  SC: ["H", "L", "N"], SI: ["H", "L", "N"], SA: ["H", "L", "N"],
  E: ["X", "A", "P", "U"], CR: ["X", "H", "M", "L"], IR: ["X", "H", "M", "L"], AR: ["X", "H", "M", "L"],
  MAV: ["X", "N", "A", "L", "P"], MAC: ["X", "L", "H"], MAT: ["X", "N", "P"],
  MPR: ["X", "N", "L", "H"], MUI: ["X", "N", "P", "A"],
  MVC: ["X", "H", "L", "N"], MVI: ["X", "H", "L", "N"], MVA: ["X", "H", "L", "N"],
  MSC: ["X", "H", "L", "N"], MSI: ["X", "S", "H", "L", "N"], MSA: ["X", "S", "H", "L", "N"],
  S: ["X", "N", "P"], AU: ["X", "N", "Y"], R: ["X", "A", "U", "I"], V: ["X", "D", "C"],
  RE: ["X", "L", "M", "H"], U: ["X", "Clear", "Green", "Amber", "Red"]
};
def cvss4_parse:
  select(type == "string")
  | split("/") as $parts
  | select(($parts | length) >= 12 and $parts[0] == "CVSS:4.0")
  | ($parts[1:] | map(split(":"))) as $pairs
  | select(all($pairs[]; length == 2))
  | cvss4_order as $order
  | cvss4_values as $values
  | ($pairs | map(.[0])) as $keys
  | select($keys[0:11] == $order[0:11])
  | select(($keys | length) == ($keys | unique | length))
  | select([ $pairs[] as $p | (($values[$p[0]] // []) | index($p[1])) != null ] | all)
  | [ $pairs[] as $p | ($order | index($p[0])) ] as $positions
  | select([ $positions[] | . != null ] | all)
  | select([ range(1; $positions | length) as $i | $positions[$i] > $positions[$i - 1] ] | all)
  | reduce $pairs[] as $p (
      {E: "X", CR: "X", IR: "X", AR: "X", MAV: "X", MAC: "X", MAT: "X", MPR: "X", MUI: "X",
       MVC: "X", MVI: "X", MVA: "X", MSC: "X", MSI: "X", MSA: "X",
       S: "X", AU: "X", R: "X", V: "X", RE: "X", U: "X"};
      .[$p[0]] = $p[1]
    );
def cvss4_m($metric):
  . as $m
  | ("M" + $metric) as $modified
  | if $metric == "E" and $m[$metric] == "X" then "A"
    elif ($metric == "CR" or $metric == "IR" or $metric == "AR") and $m[$metric] == "X" then "H"
    elif $m[$modified]? != null and $m[$modified] != "X" then $m[$modified]
    else $m[$metric]
    end;
def cvss4_macro:
  . as $m
  | ($m | cvss4_m("AV")) as $av
  | ($m | cvss4_m("AC")) as $ac
  | ($m | cvss4_m("AT")) as $at
  | ($m | cvss4_m("PR")) as $pr
  | ($m | cvss4_m("UI")) as $ui
  | ($m | cvss4_m("VC")) as $vc
  | ($m | cvss4_m("VI")) as $vi
  | ($m | cvss4_m("VA")) as $va
  | ($m | cvss4_m("SC")) as $sc
  | ($m | cvss4_m("SI")) as $si
  | ($m | cvss4_m("SA")) as $sa
  | ($m | cvss4_m("MSI")) as $msi
  | ($m | cvss4_m("MSA")) as $msa
  | ($m | cvss4_m("E")) as $e
  | ($m | cvss4_m("CR")) as $cr
  | ($m | cvss4_m("IR")) as $ir
  | ($m | cvss4_m("AR")) as $ar
  | (if $av == "N" and $pr == "N" and $ui == "N" then "0"
     elif ($av == "N" or $pr == "N" or $ui == "N") and $av != "P" then "1"
     else "2" end) as $eq1
  | (if $ac == "L" and $at == "N" then "0" else "1" end) as $eq2
  | (if $vc == "H" and $vi == "H" then "0"
     elif $vc == "H" or $vi == "H" or $va == "H" then "1"
     else "2" end) as $eq3
  | (if $msi == "S" or $msa == "S" then "0"
     elif $sc == "H" or $si == "H" or $sa == "H" then "1"
     else "2" end) as $eq4
  | (if $e == "A" then "0" elif $e == "P" then "1" else "2" end) as $eq5
  | (if ($cr == "H" and $vc == "H") or ($ir == "H" and $vi == "H") or ($ar == "H" and $va == "H")
     then "0" else "1" end) as $eq6
  | $eq1 + $eq2 + $eq3 + $eq4 + $eq5 + $eq6;
def cvss4_piece_metrics:
  [ split("/")[] | select(length > 0) | split(":") | {(.[0]): .[1]} ] | add // {};
def cvss4_levels: {
  AV: {N: 0, A: 0.1, L: 0.2, P: 0.3}, PR: {N: 0, L: 0.1, H: 0.2}, UI: {N: 0, P: 0.1, A: 0.2},
  AC: {L: 0, H: 0.1}, AT: {N: 0, P: 0.1},
  VC: {H: 0, L: 0.1, N: 0.2}, VI: {H: 0, L: 0.1, N: 0.2}, VA: {H: 0, L: 0.1, N: 0.2},
  SC: {H: 0.1, L: 0.2, N: 0.3}, SI: {S: 0, H: 0.1, L: 0.2, N: 0.3}, SA: {S: 0, H: 0.1, L: 0.2, N: 0.3},
  CR: {H: 0, M: 0.1, L: 0.2}, IR: {H: 0, M: 0.1, L: 0.2}, AR: {H: 0, M: 0.1, L: 0.2}
};
def cvss4_distances($m; $max):
  cvss4_levels as $levels
  | reduce ["AV", "PR", "UI", "AC", "AT", "VC", "VI", "VA", "SC", "SI", "SA", "CR", "IR", "AR"][] as $metric
      ({}; .[$metric] = ($levels[$metric][($m | cvss4_m($metric))] - $levels[$metric][$max[$metric]]));
def cvss4_key($parts): $parts | map(tostring) | join("");
def cvss4_score_with($lookup; $max_composed; $max_severity):
  cvss4_parse as $m
  | if (["VC", "VI", "VA", "SC", "SI", "SA"] | all(. as $metric | ($m | cvss4_m($metric)) == "N")) then 0
    else
      ($m | cvss4_macro) as $macro
      | $lookup[$macro] as $value
      | select($value != null)
      | $macro[0:1] as $eq1 | $macro[1:2] as $eq2 | $macro[2:3] as $eq3
      | $macro[3:4] as $eq4 | $macro[4:5] as $eq5 | $macro[5:6] as $eq6
      | [
          $max_composed.eq1[$eq1][] as $a
          | $max_composed.eq2[$eq2][] as $b
          | $max_composed.eq3[$eq3][$eq6][] as $c
          | $max_composed.eq4[$eq4][] as $d
          | $max_composed.eq5[$eq5][] as $e
          | $a + $b + $c + $d + $e
        ] as $max_vectors
      | ([ $max_vectors[]
           | cvss4_piece_metrics as $max
           | cvss4_distances($m; $max) as $dist
           | select([ $dist[] | . >= 0 ] | all)
           | $dist ] | first) as $dist
      | select($dist != null)
      | ($dist.AV + $dist.PR + $dist.UI) as $distance_eq1
      | ($dist.AC + $dist.AT) as $distance_eq2
      | ($dist.VC + $dist.VI + $dist.VA + $dist.CR + $dist.IR + $dist.AR) as $distance_eq3eq6
      | ($dist.SC + $dist.SI + $dist.SA) as $distance_eq4
      | (if $eq3 == "0" and $eq6 == "0" then
           ([ $lookup[cvss4_key([$eq1, $eq2, $eq3, $eq4, $eq5, 1])],
              $lookup[cvss4_key([$eq1, $eq2, 1, $eq4, $eq5, $eq6])] ]
            | map(select(. != null)) | max // null)
         elif ($eq3 == "0" and $eq6 == "1") or ($eq3 == "1" and $eq6 == "1") then
           $lookup[cvss4_key([$eq1, $eq2, ($eq3 | tonumber) + 1, $eq4, $eq5, $eq6])]
         elif $eq3 == "1" and $eq6 == "0" then
           $lookup[cvss4_key([$eq1, $eq2, $eq3, $eq4, $eq5, 1])]
         else
           $lookup[cvss4_key([$eq1, $eq2, ($eq3 | tonumber) + 1, $eq4, $eq5, ($eq6 | tonumber) + 1])]
         end) as $lower_eq3eq6
      | [
          {score: $lookup[cvss4_key([($eq1 | tonumber) + 1, $eq2, $eq3, $eq4, $eq5, $eq6])], distance: $distance_eq1, depth: ($max_severity.eq1[$eq1] * 0.1)},
          {score: $lookup[cvss4_key([$eq1, ($eq2 | tonumber) + 1, $eq3, $eq4, $eq5, $eq6])], distance: $distance_eq2, depth: ($max_severity.eq2[$eq2] * 0.1)},
          {score: $lower_eq3eq6, distance: $distance_eq3eq6, depth: ($max_severity.eq3eq6[$eq3][$eq6] * 0.1)},
          {score: $lookup[cvss4_key([$eq1, $eq2, $eq3, ($eq4 | tonumber) + 1, $eq5, $eq6])], distance: $distance_eq4, depth: ($max_severity.eq4[$eq4] * 0.1)},
          {score: $lookup[cvss4_key([$eq1, $eq2, $eq3, $eq4, ($eq5 | tonumber) + 1, $eq6])], distance: 0, depth: 1}
        ]
      | map(select(.score != null) | (($value - .score) * (.distance / .depth))) as $normalized
      | ($value - (if ($normalized | length) == 0 then 0 else (($normalized | add) / ($normalized | length)) end)) as $score
      | (if $score < 0 then 0 elif $score > 10 then 10 else $score end)
      | ((. * 10) | round) / 10
    end;
def cvss4_score:
  cvss4_lookup as $lookup
  | cvss4_max_composed as $max_composed
  | cvss4_max_severity as $max_severity
  | cvss4_score_with($lookup; $max_composed; $max_severity);
def cvss4_score_band:
  if . >= 9 then "critical"
  elif . >= 7 then "high"
  elif . >= 4 then "moderate"
  elif . > 0 then "low"
  else "none"
  end;
def cvss4_band: cvss4_score | cvss4_score_band;
'

# Severity + classification jq program (single-quoted: no shell escaping).
# Severity ladder, most-severe candidate wins (fail-closed): the qualitative
# database_specific/ecosystem_specific labels AND every standard CVSS v3/v4
# score are all candidates. An invalid CVSS v4 vector is an explicit "high"
# candidate, preserving the fail-closed floor. Nothing parsable -> "unknown".
# shellcheck disable=SC2016
JQ_OSV_CLASSIFY="$JQ_SEVERITY_DEFS"'
def std_sev_entries($aff): (.severity // []) + ([ $aff[].severity? // empty ] | add // []);
def vuln_sev($aff):
  (
    [ .database_specific.severity? // empty | norm_qual ]
    + [ std_sev_entries($aff)[] | select(.type == "CVSS_V3") | (.score // empty) | cvss3_band ]
    + [ std_sev_entries($aff)[] | select(.type == "CVSS_V4")
        | ((try ((.score // "") | cvss4_band) catch empty) // "high") ]
    + [ $aff[].ecosystem_specific.severity? // empty | norm_qual ]
  ) as $cands
  | if ($cands | length) > 0 then ($cands | max_by(band_rank(.)))
    else "unknown"
    end;
def matching_affected: [ .affected[]? | select((.package.ecosystem // "") == $eco and (.package.name // "") == $name) ];
def usable_ranges: [ .[].ranges[]? | select(.type == "SEMVER" or .type == "ECOSYSTEM") | select((.events | length) > 0) ];
def range_affected($r):
  reduce ($r.events // [])[] as $e (false;
    if ($e.introduced? != null) and vge($ver; $e.introduced) then true
    elif ($e.fixed? != null) and vge($ver; $e.fixed) then false
    elif ($e.last_affected? != null) and vgt($ver; $e.last_affected) then false
    else .
    end);
def range_fixed_events($r): [ ($r.events // [])[] | .fixed? | select(. != null) ];
[ .vulns[]?
  # One malformed record must degrade ITSELF, never its siblings: a whole-
  # program jq failure here used to erase an already-received MAL/critical
  # classification and demote the check to a host-allowable WARN (PR#55
  # delta-1 F1). The catch record fails closed: version-scoped hits stay
  # affecting (the server matched them), severity floors at unknown, and a
  # string MAL id keeps its malware flag.
  | . as $v
  | try (
      matching_affected as $aff
      | ($aff | usable_ranges) as $ranges
      | ([ $aff[].versions[]? ]) as $version_list
      | (($ranges | length) > 0 or ($version_list | length) > 0) as $parseable
      | (
          ($version_list | index($ver) != null)
          or ([ $ranges[] | range_affected(.) ] | any)
        ) as $range_hit
      | (if $trust == 1 then true else ($parseable and $range_hit) end) as $affects
      | ([ $ranges[] | range_fixed_events(.)[] ] | sort_by(vparse) | last) as $fixed_max
      | {
          id: .id,
          severity: vuln_sev($aff),
          malware: ((.id // "" | tostring) | test("^MAL-")),
          affects: $affects,
          ambiguous: ($parseable | not),
          unfixed: ($affects and (($fixed_max // "") == "")),
          fixed: ($fixed_max // null),
          remediated: (($trust == 0) and ($affects | not) and $parseable and $fixed_max != null and vle($fixed_max; $ver))
        }
    ) catch ($v | {
        id: ((.id? // "unknown") | tostring),
        severity: "unknown",
        malware: (((.id? // "") | tostring) | test("^MAL-")),
        affects: ($trust == 1),
        ambiguous: ($trust != 1),
        unfixed: false,
        fixed: null,
        remediated: false
      })
]
| {
    affecting:  [ .[] | select(.affects) ],
    remediated: [ .[] | select(.remediated) ],
    ambiguous:  [ .[] | select(.ambiguous) ],
    unaffected: [ .[] | select((.affects or .remediated or .ambiguous) | not) ]
  }
'

# Classify OSV advisories against a resolved version.
# trust_server=1: the OSV query was version-scoped, so the server already
# matched every returned advisory against this exact version — each one is
# AUTHORITATIVELY affecting. Local range data is annotation only and can
# never downgrade a server hit (a local comparator disagreement was a
# GO-on-vulnerable bypass; PR#29 review finding 1).
# trust_server=0 (package-only query): local range matching applies;
# unparseable advisories stay ambiguous, never affecting.
osv_classify() {
  local osv_file="$1" osv_eco="$2" name="$3" version="$4" trust_server="$5"
  jq -c --arg eco "$osv_eco" --arg name "$name" --arg ver "$version" --argjson trust "$trust_server" \
    "$JQ_VSEMVER $JQ_OSV_CLASSIFY" "$osv_file"
}

# A later adverse check supersedes recorded clean evidence: drop the entry
# when its pinned version is among the versions this check just judged
# (PR#29 review finding 5 — stale evidence must never outlive a newer
# WARN/BLOCK for the same version).
revoke_install_known() {
  local ecosystem="$1" name="$2"
  shift 2
  [[ -f "$INSTALL_KNOWN_FILE" ]] || return 0
  local key="$ecosystem:$name" entry_version tmp v
  entry_version=$(jq -r --arg k "$key" '.packages[$k].version // empty' "$INSTALL_KNOWN_FILE" 2>/dev/null || true)
  [[ -n "$entry_version" ]] || return 0
  for v in "$@"; do
    if [[ "$v" == "$entry_version" ]]; then
      # Staged beside the receipts file, not in $TMPDIR: this is a shared path
      # every gated install reads, and a cross-device `mv` would leave it
      # truncated mid-replace. A staging failure is fatal, never a skip:
      # silently not revoking would leave clean evidence standing against the
      # adverse knowledge that just superseded it (PR#29 finding 5).
      tmp=$(mktemp "$INSTALL_KNOWN_FILE.XXXXXX") \
        || die "cannot stage a write next to $INSTALL_KNOWN_FILE — audit-infrastructure breakage, not a package finding; check the config directory and rerun"
      jq --arg k "$key" 'del(.packages[$k])' "$INSTALL_KNOWN_FILE" > "$tmp" && mv "$tmp" "$INSTALL_KNOWN_FILE"
      return 0
    fi
  done
  return 0
}

mark_install_known() {
  local ecosystem="$1" name="$2" version="$3" verdict="$4" reasons_json="$5" evidence="$6"
  local tmp key source_id
  key="$ecosystem:$name"
  # Evidence is scoped to the source it was gathered against: a receipt from
  # the default registry must never satisfy a later custom-index request
  # (delta-2 finding 5). Discriminated identity: a literal selector spelled
  # "default" (cargo named registries) must never collide with the
  # implicit-default sentinel (delta-3 finding 5). Legacy receipts with no
  # source field map to implicit-default only. CHECK_EFFECTIVE_SOURCES was
  # derived at the trust floor; the same identity is served to the stale
  # readers by the effective-sources plumbing command (delta-4 finding N1).
  source_id=$(source_identity)
  mkdir -p "$SAFE_RUN_CONFIG_DIR"
  [[ -f "$INSTALL_KNOWN_FILE" ]] || printf '{"packages":{}}\n' > "$INSTALL_KNOWN_FILE"
  # Staged beside the receipts file, fatal on failure — see revoke_install_known.
  tmp=$(mktemp "$INSTALL_KNOWN_FILE.XXXXXX") \
    || die "cannot stage a write next to $INSTALL_KNOWN_FILE — audit-infrastructure breakage, not a package finding; check the config directory and rerun"
  jq --arg k "$key" --arg v "$version" --arg verdict "$verdict" \
    --argjson reasons "$reasons_json" --arg ev "$evidence" \
    --arg src "$source_id" \
    --arg now "$(now_iso)" --arg d "$(today_date)" '
    (.packages[$k] // {}) as $old |
    .packages[$k] = {
      version: $v,
      verdict: $verdict,
      reasons: $reasons,
      evidence: $ev,
      source: $src,
      first_allowed: (if ($old.version // "") == $v then ($old.first_allowed // $now) else $now end),
      last_used: $d,
      times_used: (if ($old.version // "") == $v then (($old.times_used // 0) + 1) else 1 end)
    }' "$INSTALL_KNOWN_FILE" > "$tmp" && mv "$tmp" "$INSTALL_KNOWN_FILE"
}

# Operator-pinned host-allow entry matching every version whose evidence the
# caller asks it to override. The schema stores one exact version, so a single
# pin can never authorize adverse evidence attached to multiple versions.
# Ecosystem spellings differ between grant time (--ecosystem py|uv|pipx…) and
# audit time (python); collapse both to one canonical name before comparing so
# an operator grant never goes silently inert on a spelling mismatch.
host_allow_canonical_eco() {
  case "$1" in
    py|python|uv|pipx|pypi) printf 'python' ;;
    npm|bun) printf 'npm' ;;
    *) printf '%s' "$1" ;;
  esac
}

host_allow_matches_resolved() {
  local ecosystem="$1" name="$2"
  shift 2
  # #87: a host-allow grant is authority only from the canonical store (or a
  # token-blessed redirect); a redirected root is declined so a forged pin
  # cannot turn a WARN into GO on the install lane.
  trust_grant_ok "host-allow" || return 1
  local ha_file
  ha_file="$(trust_store_file host-allow.json)"
  [[ -f "$ha_file" ]] || return 1
  local entry_version entry_ecosystem
  entry_version=$(jq -r --arg p "$name" '.packages[$p].version // empty' "$ha_file" 2>/dev/null || true)
  entry_ecosystem=$(jq -r --arg p "$name" '.packages[$p].ecosystem // "npm"' "$ha_file" 2>/dev/null || true)
  [[ -n "$entry_version" ]] || return 1
  # Only ecosystems `host-allow add` can actually grant are matchable
  # (review PR#61 F3): a hand-edited entry for an unsupported ecosystem must
  # not gain authority the TTY-gated add path would refuse to record.
  local canon_eco
  canon_eco=$(host_allow_canonical_eco "$ecosystem")
  case "$canon_eco" in npm|python) ;; *) return 1 ;; esac
  [[ "$(host_allow_canonical_eco "$entry_ecosystem")" == "$canon_eco" ]] || return 1
  (( $# > 0 )) || return 1
  local v
  for v in "$@"; do
    [[ "$v" == "$entry_version" ]] || return 1
  done
  HOST_ALLOW_RESOLVED_VERSION="$entry_version"
  return 0
}

# Derive the exact artifact versions a host-allow would override, deny-by-
# default. OSV retains per-version evidence, so the ONLY per-version WARN cause
# is `osv_affecting` — it requires just the affected versions ($osv_versions).
# EVERY other cause — Socket results/outages, blocklist-unreadable, OSV/custom-
# source outages, release age — carries NO per-version attribution (`warn_causes`
# is a flat aggregate list with no record of WHICH resolved version raised it),
# so any one of them requires the WHOLE resolved set. Enumerating a per-version
# allowlist (osv_affecting) rather than an aggregate denylist is deliberate: an
# unknown or future cause is treated as aggregate, failing closed rather than
# silently narrowing the pin (review F1 — socket_disabled and blocklist_unreadable
# were exactly such omissions). A single-version install collapses $resolved to
# [primary] (no-op); a ranged op carrying any aggregate cause becomes
# non-matchable under the one-pin schema and routes to
# install.auto_allow_tolerate as its aggregate override (Fibery #106). The caller
# then requires one exact pin to equal this complete set.
host_allow_required_versions_json() {
  local classifications_json="$1" causes_json="$2"
  local primary_version="$3" resolved_versions_json="$4"
  jq -cn --argjson osv "$classifications_json" --argjson causes "$causes_json" \
    --arg primary "$primary_version" --argjson resolved "$resolved_versions_json" '
    ($osv | map(select((.classification.affecting | length) > 0) | .version)) as $osv_versions
    | ([$causes[] | select(. != "osv_affecting")] | length > 0) as $aggregate_applies
    | ($osv_versions
       + (if $aggregate_applies then $resolved else [] end)
       | unique) as $required
    | if ($required | length) == 0 then $resolved else $required end'
}

# Operator scripts grant (safe run scripts-allow) matching the resolved
# version exactly. Read-only here: the audit only decides whether the
# install-scripts hint is needed — the grant is consumed by the gate.
scripts_allow_matches_resolved() {
  local name="$1" version="$2"
  [[ -f "$SAFE_RUN_SCRIPTS_ALLOW_FILE" ]] || return 1
  local entry_version
  entry_version=$(jq -r --arg p "$name" '.packages[$p].version // empty' "$SAFE_RUN_SCRIPTS_ALLOW_FILE" 2>/dev/null || true)
  [[ -n "$entry_version" && "$entry_version" == "$version" ]]
}

# Plumbing for the stale-evidence readers (install wrappers, bin/safe,
# gate-lib): print the discriminated source identity this invocation would
# audit under. Local-only — env + rc files, no network. Keeping the readers
# on this single derivation is what prevents writer/reader identity drift
# (delta-4 findings 3.2 and N1).
effective_sources_command() {
  local ecosystem="" spec=""
  local CHECK_DIST_TAG="" CHECK_REGISTRY="" CHECK_PROJECT_DIR=""
  local CHECK_NPM_USERCONFIG="" CHECK_NPM_GLOBALCONFIG=""
  local CHECK_EFFECTIVE_SOURCES="" CHECK_INSTALLER=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ecosystem)
        [[ $# -lt 2 ]] && die "--ecosystem requires a value"
        ecosystem="$2"
        shift 2
        ;;
      --installer)
        [[ $# -lt 2 ]] && die "--installer requires a value"
        CHECK_INSTALLER="$2"
        shift 2
        ;;
      --npm-userconfig)
        [[ $# -lt 2 ]] && die "--npm-userconfig requires a value"
        CHECK_NPM_USERCONFIG="$2"
        [[ "$CHECK_NPM_USERCONFIG" == -* ]] && CHECK_NPM_USERCONFIG="./${CHECK_NPM_USERCONFIG}"
        shift 2
        ;;
      --npm-globalconfig)
        [[ $# -lt 2 ]] && die "--npm-globalconfig requires a value"
        CHECK_NPM_GLOBALCONFIG="$2"
        [[ "$CHECK_NPM_GLOBALCONFIG" == -* ]] && CHECK_NPM_GLOBALCONFIG="./${CHECK_NPM_GLOBALCONFIG}"
        shift 2
        ;;
      --registry)
        [[ $# -lt 2 ]] && die "--registry requires a value"
        CHECK_REGISTRY="$2"
        shift 2
        ;;
      --project-dir)
        [[ $# -lt 2 ]] && die "--project-dir requires a value"
        CHECK_PROJECT_DIR="$2"
        [[ "$CHECK_PROJECT_DIR" == -* ]] && CHECK_PROJECT_DIR="./${CHECK_PROJECT_DIR}"
        shift 2
        ;;
      -*)
        die "unknown effective-sources flag: $1"
        ;;
      *)
        spec="$1"
        shift
        ;;
    esac
  done
  [[ -z "$spec" ]] && die "usage: safe audit effective-sources <pkg> [--ecosystem <name>] [--installer <name>] [--registry <set>] [--project-dir <dir>]"
  parse_pkg_spec "$spec"
  [[ -z "$ecosystem" ]] && ecosystem=$(guess_ecosystem_from_spec "$spec")
  case "$ecosystem" in
    cargo) ecosystem="rust" ;;
    composer) ecosystem="php" ;;
    pip|pypi|uv) ecosystem="python" ;;
    maven|Maven|gradle|java) ecosystem="java" ;;
  esac
  if [[ -n "$CHECK_INSTALLER" ]]; then
    validate_installer "$CHECK_INSTALLER" || die "unknown --installer: $CHECK_INSTALLER"
  else
    CHECK_INSTALLER=$(default_installer_for "$ecosystem")
  fi
  derive_effective_sources "$ecosystem" "$PKG_NAME"
  source_identity
  printf '\n'
}

package_audit_command() {
  local ecosystem="" json_mode=0 spec="" op="install" gate=""
  # Target-context selectors from the audited command line (dynamically
  # scoped: the resolver helpers read them). CHECK_EFFECTIVE_SOURCES is the
  # argv set plus any env/npmrc-configured npm source, computed at the trust
  # floor; the receipt writer derives evidence identity from it.
  local CHECK_DIST_TAG="" CHECK_REGISTRY="" CHECK_PROJECT_DIR=""
  local CHECK_NPM_USERCONFIG="" CHECK_NPM_GLOBALCONFIG=""
  local CHECK_EFFECTIVE_SOURCES="" CHECK_INSTALLER=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ecosystem)
        [[ $# -lt 2 ]] && die "--ecosystem requires a value"
        ecosystem="$2"
        shift 2
        ;;
      --installer)
        [[ $# -lt 2 ]] && die "--installer requires a value"
        CHECK_INSTALLER="$2"
        shift 2
        ;;
      --npm-userconfig)
        [[ $# -lt 2 ]] && die "--npm-userconfig requires a value"
        CHECK_NPM_USERCONFIG="$2"
        [[ "$CHECK_NPM_USERCONFIG" == -* ]] && CHECK_NPM_USERCONFIG="./${CHECK_NPM_USERCONFIG}"
        shift 2
        ;;
      --npm-globalconfig)
        [[ $# -lt 2 ]] && die "--npm-globalconfig requires a value"
        CHECK_NPM_GLOBALCONFIG="$2"
        [[ "$CHECK_NPM_GLOBALCONFIG" == -* ]] && CHECK_NPM_GLOBALCONFIG="./${CHECK_NPM_GLOBALCONFIG}"
        shift 2
        ;;
      --json)
        json_mode=1
        shift
        ;;
      --op)
        [[ $# -lt 2 ]] && die "--op requires a value"
        op="$2"
        shift 2
        ;;
      --gate)
        [[ $# -lt 2 ]] && die "--gate requires a value"
        gate="$2"
        shift 2
        ;;
      --dist-tag)
        [[ $# -lt 2 ]] && die "--dist-tag requires a value"
        CHECK_DIST_TAG="$2"
        shift 2
        ;;
      --registry)
        [[ $# -lt 2 ]] && die "--registry requires a value"
        CHECK_REGISTRY="$2"
        shift 2
        ;;
      --project-dir)
        [[ $# -lt 2 ]] && die "--project-dir requires a value"
        CHECK_PROJECT_DIR="$2"
        # A path starting with '-' would be parsed as an option by the jq/
        # grep readers downstream; anchor it.
        [[ "$CHECK_PROJECT_DIR" == -* ]] && CHECK_PROJECT_DIR="./${CHECK_PROJECT_DIR}"
        shift 2
        ;;
      -*)
        die "unknown package-audit flag: $1"
        ;;
      *)
        spec="$1"
        shift
        ;;
    esac
  done
  [[ -z "$spec" ]] && die "usage: safe audit package-audit <pkg>[@<version>] [--ecosystem <name>] [--installer <name>] [--op install|update] [--gate install] [--dist-tag <t>] [--registry <url>] [--project-dir <dir>] [--json]"
  [[ "$op" == "install" || "$op" == "update" ]] || die "--op must be install or update"
  [[ -z "$gate" || "$gate" == "install" ]] || die "--gate supports only: install"

  parse_pkg_spec "$spec"
  [[ -z "$ecosystem" ]] && ecosystem=$(guess_ecosystem_from_spec "$spec")
  # Public manager labels normalize to the internal resolver names; the
  # wrappers send their tool-flavored ecosystem (cargo/composer/pip), which
  # previously never reached the rust/php/python resolvers or valid OSV
  # ecosystem names (PR#29 review finding 7).
  case "$ecosystem" in
    cargo) ecosystem="rust" ;;
    composer) ecosystem="php" ;;
    pip|pypi|uv) ecosystem="python" ;;
    maven|Maven|gradle|java) ecosystem="java" ;;
  esac
  if [[ -n "$CHECK_INSTALLER" ]]; then
    validate_installer "$CHECK_INSTALLER" || die "unknown --installer: $CHECK_INSTALLER"
  else
    CHECK_INSTALLER=$(default_installer_for "$ecosystem")
  fi

  local scratch socket_json osv_json block_reason verdict socket_line osv_line block_line
  new_scratch_dir scratch
  socket_json="$scratch/socket.json"
  osv_json="$scratch/osv.json"

  # The effective sources are derived BEFORE resolution: an env/rc-selected
  # custom source must degrade the rust/php default-registry lookups the
  # same way an argv selector always has, and the npm resolver reads the
  # bun-effective registry through the same derivation inputs. Env + rc +
  # parseable config only, no network.
  derive_effective_sources "$ecosystem" "$PKG_NAME"

  # --- resolve the version(s) the package manager would actually install
  local resolution_ok=1 primary_version resolved_label=""
  RESOLVED_VERSIONS=()
  RESOLUTION_METHOD=""
  RESOLUTION_SOURCE=""
  RESOLUTION_RANGE=""
  if ! resolve_target_versions "$ecosystem" "$PKG_NAME" "$PKG_VERSION" "$op" "$scratch"; then
    resolution_ok=0
  fi
  if (( resolution_ok )); then
    primary_version="${RESOLVED_VERSIONS[0]}"
    resolved_label=$(printf '%s, ' "${RESOLVED_VERSIONS[@]}")
    resolved_label="${resolved_label%, }"
  else
    primary_version="$PKG_VERSION"
  fi

  # The aggregate youngest age drives the cooldown. Socket patience is about
  # the scored primary version, so it uses that version's own age from the
  # same release map — a young sibling must not create patience for an old
  # primary score.
  local cooldown_days cooldown_security_fix release_line="" release_age="" release_version="" release_published=""
  local release_security_fix_ids="" release_exempt=0 release_ages_json='{}' primary_release_age="" release_info="" release_rc=2
  cooldown_days=$(install_policy_json | jq -r '.cooldown_days // 3')
  [[ "$cooldown_days" =~ ^[0-9]+$ ]] || cooldown_days=3
  cooldown_security_fix=$(install_policy_json | jq -r '.cooldown_security_fix // "exempt"')
  case "$cooldown_security_fix" in exempt|enforce) ;; *) cooldown_security_fix="exempt" ;; esac
  if (( resolution_ok )) && (( cooldown_days > 0 )); then
    release_rc=0
    release_info=$(release_min_age_days "$ecosystem" "$PKG_NAME" "$scratch" "${RESOLVED_VERSIONS[@]}") || release_rc=$?
    if (( release_rc == 0 )); then
      IFS=$'\t' read -r release_age release_version release_published release_ages_json <<<"$release_info"
      [[ -n "$release_ages_json" ]] || release_ages_json='{}'
      primary_release_age=$(jq -er --arg version "$primary_version" '
        .[$version] | select(type == "number" and . >= 0 and . == floor)
      ' <<<"$release_ages_json" 2>/dev/null) || primary_release_age=""
    fi
  fi

  # Whether the resolved version declares install-time lifecycle scripts
  # (abbreviated-packument hasInstallScript). Known only when the packument
  # was fetched — exact-version specs skip that fetch, and "" means unknown.
  local has_install_script=""
  if (( resolution_ok )) && [[ "$ecosystem" == "npm" && -f "$scratch/packument.json" ]]; then
    has_install_script=$(jq -r --arg v "$primary_version" \
      'if (.versions[$v] | type) == "object" then ((.versions[$v].hasInstallScript // false) | tostring) else "" end' \
      "$scratch/packument.json" 2>/dev/null) || has_install_script=""
  fi

  # Socket is the primary behavioral tier. Existing auto and always spellings
  # both consult it; only the explicit never mode skips it.
  local socket_mode socket_skip_reason=""
  socket_mode=$(install_policy_json | jq -r '.socket.mode // "auto"')
  case "$socket_mode" in always|auto|never) ;; *) socket_mode="auto" ;; esac
  if [[ "$socket_mode" == "never" ]]; then
    socket_skip_reason="disabled by install.socket.mode=never"
    jq -n --arg reason "$socket_skip_reason" \
      '{available:null,status:"skipped",note:$reason}' > "$socket_json"
  else
    local socket_spec="$spec"
    (( resolution_ok )) && socket_spec="${PKG_NAME}@${primary_version}"
    if (( resolution_ok )); then
      socket_score_json "$ecosystem" "$socket_spec" "$socket_json" "" "$PKG_NAME" "$primary_version"
    else
      socket_score_json "$ecosystem" "$socket_spec" "$socket_json"
    fi
    # Socket computes an unseen release's score on demand. For a release still
    # inside the existing cooldown window, give that first computation one
    # longer bounded chance before deciding whether the score is pending.
    # Do not retry a 404, auth, rate-limit, or arbitrary backend failure.
    if (( release_rc == 0 )) && [[ "$primary_release_age" =~ ^[0-9]+$ ]] \
      && (( primary_release_age < cooldown_days )) \
      && jq -e '(.status == "error") and (.timeout == true)' "$socket_json" >/dev/null 2>&1; then
      local fresh_socket_budget
      fresh_socket_budget=$(socket_fresh_scan_budget_seconds)
      socket_score_json "$ecosystem" "$socket_spec" "$socket_json" "$fresh_socket_budget" \
        "$PKG_NAME" "$primary_version"
      if jq -e '(.status == "error") and (.timeout == true)' "$socket_json" >/dev/null 2>&1; then
        jq -n --arg version "$primary_version" --argjson age_days "$primary_release_age" \
          --argjson timeout_seconds "$fresh_socket_budget" \
          '{available:true,status:"pending",
            note:("Socket scan not yet complete for fresh release " + $version),
            fresh_release:{version:$version,age_days:$age_days,timeout_seconds:$timeout_seconds}}' > "$socket_json"
      fi
    fi
  fi

  # --- behavioral tier: gather, do not decide -------------------------------
  # Socket is the only behavioral tier since GuardDog was removed. Its envelope
  # is normalized into evidence here; every judgment it implies belongs to the
  # decision layer — that a policy skip and an outage carry the same (absent)
  # evidence under different causes, and that an unrecognized reason degrades
  # to an error rather than to clean.
  local socket_class="" socket_score_text=""
  if [[ "$(jq -r '.status // empty' "$socket_json" 2>/dev/null)" == "ok" ]]; then
    socket_class=$(socket_classify "$socket_json")
    socket_score_text=$(jq -r '.raw.data.self.score.overall // empty' "$socket_json" 2>/dev/null || true)
  fi

  # A malformed envelope yields {}, which the decision layer reads as an
  # unavailable tier and warns on — never as clean.
  local socket_evidence
  socket_evidence=$(jq -c \
    --arg class "$socket_class" --arg score "$socket_score_text" \
    --arg stale_score "$SOCKET_CACHE_STALE_SCORE" \
    --arg stale_age "$SOCKET_CACHE_STALE_AGE_DAYS" '
    {status: (.status // ""), available: (.available // false),
     note: (.note // ""), reason: (.reason // ""),
     score: $score, class: $class,
     cache_stale_score: $stale_score, cache_stale_age_days: $stale_age}' \
    "$socket_json" 2>/dev/null) || socket_evidence=""
  if [[ -z "$socket_evidence" ]]; then
    # A malformed envelope still produces a SHAPE-COMPLETE document: the
    # decision reads it as an unavailable tier and warns, which is the intended
    # fail-closed behavior. An incomplete document would instead be refused as
    # infrastructure breakage, which is a different (and wrong) answer here.
    socket_evidence='{"status":"","available":false,"note":"","reason":"","score":"","class":"","cache_stale_score":"","cache_stale_age_days":""}'
  fi

  # --- sibling resolved versions -------------------------------------------
  # The behavioral tier must cover every version the operation can install,
  # not just the primary: a clean 1.5.0 could otherwise carry a malicious
  # 2.5.0 in on a ranged update. Cheap by construction — each exact version
  # reads its own cache entry, so re-auditing an unchanged set costs no API
  # calls. Scoring happens here; what an unscorable sibling MEANS is decided
  # by the decision layer, which never assumes it clean.
  local siblings_json='[]'
  if (( resolution_ok )) && (( ${#RESOLVED_VERSIONS[@]} > 1 )) \
    && [[ "$socket_mode" != "never" ]]; then
    local sib sib_json sib_idx=0 sib_status sib_reason sib_class sib_score
    for sib in "${RESOLVED_VERSIONS[@]}"; do
      [[ "$sib" == "$primary_version" ]] && continue
      sib_idx=$(( sib_idx + 1 ))
      sib_json="$scratch/socket-sibling-${sib_idx}.json"
      socket_score_json "$ecosystem" "${PKG_NAME}@${sib}" "$sib_json" "" "$PKG_NAME" "$sib"
      sib_status=$(jq -r '.status // empty' "$sib_json" 2>/dev/null || true)
      sib_reason=$(jq -r '.reason // empty' "$sib_json" 2>/dev/null || true)
      sib_class=""
      sib_score=""
      if [[ "$sib_status" == "ok" ]]; then
        sib_class=$(socket_classify "$sib_json")
        sib_score=$(jq -r '.raw.data.self.score.overall // empty' "$sib_json" 2>/dev/null || true)
      fi
      siblings_json=$(jq -cn --argjson acc "$siblings_json" \
        --arg v "$sib" --arg s "$sib_status" --arg c "$sib_class" --arg sc "$sib_score" --arg r "$sib_reason" \
        '$acc + [{version: $v, status: $s, class: $c, score: $sc, reason: $r}]')
    done
  fi

  # --- version-aware OSV evaluation
  local osv_eco
  case "$ecosystem" in
    npm) osv_eco="npm" ;;
    python) osv_eco="PyPI" ;;
    php) osv_eco="Packagist" ;;
    rust) osv_eco="crates.io" ;;
    go) osv_eco="Go" ;;
    java) osv_eco="Maven" ;;
    *) osv_eco="$ecosystem" ;;
  esac

  local osv_status="ok" classifications='[]' combined='{"affecting":[],"remediated":[],"ambiguous":[],"unaffected":[]}'
  local aff_count=0 rem_count=0 amb_count=0 total_count=0 osv_primary_file=""
  if (( resolution_ok )); then
    local v idx=0 cls vfile
    for v in "${RESOLVED_VERSIONS[@]}"; do
      vfile="$scratch/osv-$idx.json"
      osv_query_package_json "$ecosystem" "$PKG_NAME" "$v" "$vfile"
      [[ "$(jq -r '.status' "$vfile" 2>/dev/null)" == "ok" ]] || osv_status="error"
      cls=$(osv_classify "$vfile" "$osv_eco" "$PKG_NAME" "$v" 1 2>/dev/null) || cls=""
      if [[ -z "$cls" ]]; then
        # Classification failure is advisory-data failure: fail closed.
        osv_status="error"
        cls='{"affecting":[],"remediated":[],"ambiguous":[],"unaffected":[]}'
        # Backstop (delta-1 F1): even a whole-program classification failure
        # must not erase authoritative malware evidence. This response was
        # version-scoped — every record in it was server-matched against
        # $v — so retain raw string MAL-* ids as affecting.
        local raw_mal
        raw_mal=$(jq -c '[.vulns[]? | .id? | strings | select(test("^MAL-"))
          | {id: ., severity: "unknown", malware: true, affects: true,
             ambiguous: false, unfixed: false, fixed: null, remediated: false}]' \
          "$vfile" 2>/dev/null) || raw_mal='[]'
        if [[ -n "$raw_mal" && "$raw_mal" != "[]" ]]; then
          cls=$(jq -cn --argjson m "$raw_mal" \
            '{affecting: $m, remediated: [], ambiguous: [], unaffected: []}')
        fi
      fi
      classifications=$(jq -cn --argjson acc "$classifications" --argjson c "$cls" --arg v "$v" '$acc + [{version: $v, classification: $c}]')
      idx=$((idx + 1))
    done
    osv_primary_file="$scratch/osv-0.json"
    cp "$osv_primary_file" "$osv_json"
    combined=$(jq -cn --argjson cs "$classifications" '{
      affecting:  ([ $cs[].classification.affecting[] ]  | unique_by(.id)),
      remediated: ([ $cs[].classification.remediated[] ] | unique_by(.id)),
      ambiguous:  ([ $cs[].classification.ambiguous[] ]  | unique_by(.id)),
      unaffected: ([ $cs[].classification.unaffected[] ] | unique_by(.id))
    }')
    aff_count=$(jq -r '.affecting | length' <<<"$combined")
    rem_count=$(jq -r '.remediated | length' <<<"$combined")
    amb_count=$(jq -r '.ambiguous | length' <<<"$combined")
    total_count=$(jq -r '[.affecting, .remediated, .ambiguous, .unaffected] | map(length) | add' <<<"$combined")
  else
    osv_query_package_json "$ecosystem" "$PKG_NAME" "" "$osv_json"
    [[ "$(jq -r '.status' "$osv_json" 2>/dev/null)" == "ok" ]] || osv_status="error"
    total_count=$(jq '[.vulns[]?] | length' "$osv_json" 2>/dev/null || echo 0)
  fi

  local block_severities
  block_severities=$(install_policy_json | jq -c '.block_severities // ["critical"]')

  # The unresolved-version path additionally needs package-history signals.
  # Per-record guards (`?` + strings): one malformed sibling record must not
  # cancel a valid critical/MAL escalation by failing the whole jq program.
  local osv_hist_critical=false osv_hist_malware=""
  if (( ! resolution_ok )); then
    if jq -e '[.vulns[]? | .database_specific?.severity? | strings
      | ascii_downcase | select(. == "critical")] | length > 0' "$osv_json" >/dev/null 2>&1; then
      osv_hist_critical=true
    fi
    osv_hist_malware=$(jq -r '[.vulns[]? | .id? | strings | select(test("^MAL-"))] | join(", ")' \
      "$osv_json" 2>/dev/null || true)
  fi

  local osv_evidence
  # No affecting count is sent: the decision derives it from the list, so the
  # two cannot disagree (review F1).
  osv_evidence=$(jq -cn --argjson combined "$combined" --arg status "$osv_status" \
    --argjson rem "$rem_count" --argjson total "$total_count" \
    --argjson hist_critical "$osv_hist_critical" --arg hist_malware "$osv_hist_malware" '
    {status: $status,
     affecting: [$combined.affecting[]?
                 | {id: ((.id // "") | tostring),
                    severity: ((.severity // "unknown") | tostring),
                    malware: ((.malware // false) == true)}],
     remediated_count: $rem, total_count: $total,
     historical_critical: $hist_critical,
     historical_malware_ids: $hist_malware}') || osv_evidence=""

  # --- release-age cooldown: a brand-new release is the compromised-publish
  # window (malicious versions are usually caught and yanked within days).
  # WARN-tier and overridable; a failed lookup is disclosed and skipped,
  # never a refusal — the cooldown is a heuristic, not advisory evidence.
  # A cooldown that blocks the release fixing a published CVE recreates the
  # exact catch-22 this gate was built to end: safe used to WARN-refuse the
  # very bump that remediated the advisory it was warning about. So when the
  # resolved version IS the fix — an advisory's fixed version equals it —
  # the cooldown is waived by default and says so. `enforce` keeps the wait
  # (compromised-maintainer releases can carry a real fix as cover); the
  # operator picks which risk they prefer.
  if (( resolution_ok )) && (( cooldown_days > 0 )); then
    if (( release_rc == 0 )); then
      if (( release_age < cooldown_days )); then
        # Is this young release the remediation itself? The version-scoped
        # OSV query only returns advisories AFFECTING the version, so a
        # release that fixes a CVE returns nothing there. Ask the
        # package-level question instead — but only inside the cooldown
        # window, so the extra query stays off the common path.
        # Fail-closed shape (review PR#61 F1+F2): the waiver requires EVERY
        # resolved version inside the window to be a fix target — an old
        # fix must not launder an unrelated young sibling — and a `fixed`
        # event only counts when its range also opened an affected interval
        # (`introduced`); a bare fixed token is not remediation evidence.
        local cooldown_young_json cooldown_osv="$scratch/osv-cooldown.json" cooldown_fix_json=""
        cooldown_young_json=$(jq -cn --argjson ages "$release_ages_json" --argjson d "$cooldown_days" \
          '$ages | to_entries | map(select(.value < $d) | .key)' 2>/dev/null) || cooldown_young_json='[]'
        if [[ "$cooldown_young_json" != "[]" ]] \
          && osv_query_package_json "$ecosystem" "$PKG_NAME" "" "$cooldown_osv" \
          && [[ "$(jq -r '.status' "$cooldown_osv" 2>/dev/null)" == "ok" ]]; then
          cooldown_fix_json=$(jq -c \
            --argjson young "$cooldown_young_json" --arg eco "$osv_eco" --arg name "$PKG_NAME" '
            [ .vulns[]?
              | . as $v
              | [ $v.affected[]?
                  | select((.package.ecosystem // "") == $eco and (.package.name // "") == $name)
                  | .ranges[]? | select(.type == "SEMVER" or .type == "ECOSYSTEM")
                  | select([.events[]? | .introduced? | strings] | length > 0)
                  | .events[]? | .fixed? | strings ] as $fixes
              | select([ $fixes[] | select(. as $f | $young | index($f) != null) ] | length > 0)
              | {id: (($v.id? // "" | tostring) | select(length > 0)), fixes: $fixes} ]
            | {ids: ([.[].id] | unique | join(", ")),
               covered: ((([.[].fixes[]] | unique) // []) as $all
                         | ($young | length > 0)
                           and ($young | all(. as $y | $all | index($y) != null)))}' \
            "$cooldown_osv" 2>/dev/null || true)
          if [[ -n "$cooldown_fix_json" ]] \
            && [[ "$(jq -r '.covered' <<<"$cooldown_fix_json" 2>/dev/null)" == "true" ]]; then
            release_security_fix_ids=$(jq -r '.ids // ""' <<<"$cooldown_fix_json" 2>/dev/null || true)
          fi
        fi
      fi
    fi
  fi

  # A custom source is gathered as a fact here and floored to WARN by the
  # decision layer: OSV/Socket evidence covers the public registry identity,
  # not whatever a private index serves under that name@version.
  # CHECK_REGISTRY may carry MULTIPLE space-separated sources (pip/uv selectors
  # are cumulative — a later trusted selector must never erase an earlier
  # untrusted one): every source must be trusted. The EFFECTIVE source can also
  # come from env/rc config with no argv selector at all, and exact pins skip
  # resolution entirely, so it was derived before resolution, above.
  # Operator escape hatches: install.trusted_registries, or a pinned host-allow.
  local custom_source=0 check_src
  for check_src in ${CHECK_EFFECTIVE_SOURCES}; do
    # Trust applies to the endpoint; a scoped token carries its key inline.
    if ! registry_is_trusted "$(source_element_url "$check_src")" "$ecosystem"; then
      custom_source=1
      break
    fi
  done

  # Blocklist state is gathered here; what an unreadable file MEANS — that it
  # is not the same as "not blocked" — is decided by the decision layer.
  # #87 N2: validate EVERY authority member actually searched (canonical always,
  # plus the redirected store on a non-canonical root), not just the single
  # trust_store_file selection. Otherwise, under a blessed redirect, a malformed
  # or unreadable CANONICAL file would pass a redirected-only validity check and
  # let blocked_entry_reason treat a hidden canonical block as "not blocked".
  local blocklist_readable=1 blocklist_reason="" \
    blocklist_file="$SAFE_RUN_CANONICAL_CONFIG_DIR/blocked.json"
  if ! blocklist_authority_readable; then
    blocklist_readable=0
    blocklist_file="$BLOCKLIST_UNREADABLE_FILE"
  elif block_reason=$(blocked_entry_reason "$PKG_NAME"); then
    blocklist_reason="$block_reason"
  fi

  # --- decide ---------------------------------------------------------------
  # Everything above gathered evidence; nothing above decided. safe-core owns
  # the verdict (internal/verdict), so the policy has exactly one
  # implementation rather than a bash copy that drifts away from it.
  #
  # A missing or version-skewed safe-core is audit-infrastructure breakage, not
  # a package finding: it refuses with a recovery path and never produces a
  # verdict. install.sh rebuilds and reinstalls safe-core on every run and safe
  # doctor reports skew, so the recovery is always "rerun install.sh".
  local safe_core_bin safe_core_reported
  safe_core_bin="${SAFE_CORE_BIN:-}"
  if [[ -z "$safe_core_bin" ]]; then
    safe_core_bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/safe-core"
  fi

  local resolution_ok_json="false"
  if (( resolution_ok )); then
    resolution_ok_json="true"
  fi

  # jq needs JSON booleans; the shell flags above stay numeric because other
  # call sites evaluate them arithmetically.
  local custom_source_json="false" blocklist_readable_json="false"
  if (( custom_source )); then
    custom_source_json="true"
  fi
  if (( blocklist_readable )); then
    blocklist_readable_json="true"
  fi

  local evidence_json verdict_json
  evidence_json=$(jq -cn \
    --argjson res_ok "$resolution_ok_json" \
    --arg primary "$primary_version" \
    --arg label "$resolved_label" \
    --argjson socket "$socket_evidence" \
    --argjson siblings "$siblings_json" \
    --argjson osv "$osv_evidence" \
    --argjson release_rc "$release_rc" \
    --arg release_age "$release_age" \
    --arg primary_age "$primary_release_age" \
    --arg release_version "$release_version" \
    --argjson cooldown_days "$cooldown_days" \
    --arg fix_ids "$release_security_fix_ids" \
    --arg cooldown_fix "$cooldown_security_fix" \
    --argjson custom_source "$custom_source_json" \
    --argjson blocklist_readable "$blocklist_readable_json" \
    --arg blocklist_reason "$blocklist_reason" \
    --arg blocklist_path "$blocklist_file" \
    --argjson block_severities "$block_severities" '
    {resolution: {ok: $res_ok, primary_version: $primary, label: $label},
     socket: $socket,
     socket_siblings: $siblings,
     osv: $osv,
     release: {rc: $release_rc,
               age: ($release_age | if . == "" then 0 else tonumber end),
               primary_age: $primary_age,
               version: $release_version,
               cooldown_days: $cooldown_days,
               security_fix_ids: $fix_ids,
               cooldown_security_fix: $cooldown_fix},
     custom_source: $custom_source,
     blocklist: {readable: $blocklist_readable,
                 reason: $blocklist_reason,
                 path: $blocklist_path},
     block_severities: $block_severities}') || evidence_json=""

  if [[ -z "$evidence_json" ]]; then
    printf 'safe audit: could not assemble audit evidence — audit-infrastructure breakage, not a package finding; run safe doctor\n' >&2
    rm -rf "$scratch"
    return 30
  fi
  if [[ ! -x "$safe_core_bin" ]]; then
    printf 'safe audit: verdict engine missing (safe-core is not installed) — audit-infrastructure breakage, not a package finding; rerun install.sh\n' >&2
    rm -rf "$scratch"
    return 30
  fi
  # Unconditional: safe-audit carries its own expected version, so every route
  # that reaches it is pinned — the dispatcher, the gate, and direct invocation
  # of the installed safe-audit executable alike.
  safe_core_reported=$("$safe_core_bin" --version 2>/dev/null) || safe_core_reported=""
  if [[ "$safe_core_reported" != "${SAFE_VERSION}" ]]; then
    printf 'safe audit: verdict engine version %s does not match safe %s — audit-infrastructure breakage, not a package finding; rerun install.sh\n' \
      "${safe_core_reported:-unknown}" "${SAFE_VERSION}" >&2
    rm -rf "$scratch"
    return 30
  fi

  verdict_json=$(printf '%s' "$evidence_json" | "$safe_core_bin" package-verdict 2>/dev/null) \
    || verdict_json=""
  if [[ -z "$verdict_json" ]]; then
    printf 'safe audit: verdict engine failed to decide — audit-infrastructure breakage, not a package finding; rerun install.sh or run safe doctor\n' >&2
    rm -rf "$scratch"
    return 30
  fi

  local -a warn_causes=()
  local socket_detail="" socket_pending=0
  verdict=$(jq -r '.verdict' <<<"$verdict_json")
  socket_line=$(jq -r '.lines.socket' <<<"$verdict_json")
  osv_line=$(jq -r '.lines.osv' <<<"$verdict_json")
  release_line=$(jq -r '.lines.release' <<<"$verdict_json")
  block_line=$(jq -r '.lines.block' <<<"$verdict_json")
  socket_detail=$(jq -r '.socket_detail' <<<"$verdict_json")
  if [[ "$(jq -r '.socket_pending' <<<"$verdict_json")" == "true" ]]; then
    socket_pending=1
  fi
  if [[ "$(jq -r '.release_exempt' <<<"$verdict_json")" == "true" ]]; then
    release_exempt=1
  fi
  while IFS= read -r cause_line; do
    [[ -n "$cause_line" ]] && warn_causes+=("$cause_line")
  done < <(jq -r '.causes[]?' <<<"$verdict_json")

  local warn_causes_json='[]'
  if (( ${#warn_causes[@]} > 0 )); then
    warn_causes_json=$(printf '%s\n' "${warn_causes[@]}" | jq -cR . | jq -cs .)
  fi

  local result_json resolved_versions_json='[]'
  if (( resolution_ok )); then
    resolved_versions_json=$(printf '%s\n' "${RESOLVED_VERSIONS[@]}" | jq -cR . | jq -cs .)
  fi
  local version_slug="${primary_version//[^0-9A-Za-z._-]/-}"
  result_json="$CHECKS_DIR/$(today_date)-$(slugify "$PKG_NAME")-${version_slug}.json"
  jq -n \
    --arg timestamp "$(now_iso)" \
    --arg spec "$spec" \
    --arg op "$op" \
    --arg ecosystem "$ecosystem" \
    --arg installer "$CHECK_INSTALLER" \
    --arg verdict "$verdict" \
    --arg socket_line "$socket_line" \
    --arg osv_line "$osv_line" \
    --arg block_line "$block_line" \
    --arg release_line "$release_line" \
    --arg release_age "$release_age" \
    --arg release_version "$release_version" \
    --arg release_published "$release_published" \
    --argjson cooldown_days "$cooldown_days" \
    --arg cooldown_security_fix "$cooldown_security_fix" \
    --arg release_security_fix_ids "$release_security_fix_ids" \
    --argjson release_exempt "$release_exempt" \
    --arg resolution_method "$RESOLUTION_METHOD" \
    --arg resolution_source "$RESOLUTION_SOURCE" \
    --arg resolution_range "$RESOLUTION_RANGE" \
    --arg resolution_status "$( (( resolution_ok )) && printf 'ok' || printf 'unresolved')" \
    --arg has_install_script "$has_install_script" \
    --argjson resolved_versions "$resolved_versions_json" \
    --argjson classification "$combined" \
    --argjson versions "$classifications" \
    --argjson warn_causes "$warn_causes_json" \
    --slurpfile socket "$socket_json" \
    --slurpfile osv "$osv_json" '
    {
      timestamp: $timestamp,
      spec: $spec,
      op: $op,
      ecosystem: $ecosystem,
      installer: $installer,
      verdict: $verdict,
      resolved_versions: $resolved_versions,
      resolution: {
        status: $resolution_status,
        method: $resolution_method,
        source: $resolution_source,
        range: $resolution_range
      },
      warn_causes: $warn_causes,
      has_install_script: (if $has_install_script == "" then null else ($has_install_script == "true") end),
      checks: {
        socket: $socket_line,
        osv: $osv_line,
        blocklist: $block_line,
        release_age: (if $release_line == "" then null else $release_line end)
      },
      release: (if $release_line == "" then null else {
        cooldown_days: $cooldown_days,
        security_fix_policy: $cooldown_security_fix,
        remediates: (if $release_security_fix_ids == "" then [] else ($release_security_fix_ids | split(", ")) end),
        cooldown_waived: ($release_exempt == 1),
        age_days: (if $release_age == "" then null else ($release_age | tonumber) end),
        version: (if $release_version == "" then null else $release_version end),
        published: (if $release_published == "" then null else $release_published end)
      } end),
      socket: ($socket[0] // {}),
      osv: (($osv[0] // {}) + {classification: $classification, versions: $versions})
    }' > "$result_json"

  if [[ "$json_mode" == "1" ]]; then
    cat "$result_json"
  else
    printf '[safe audit] checking %s (%s)\n\n' "$spec" "$ecosystem"
    if (( resolution_ok )); then
      local resolution_extra=""
      [[ -n "$RESOLUTION_RANGE" ]] && resolution_extra="; range ${RESOLUTION_RANGE}"
      printf 'Resolved:    %s (%s%s%s)\n' "$resolved_label" "$RESOLUTION_METHOD" "${RESOLUTION_SOURCE:+ via $RESOLUTION_SOURCE}" "$resolution_extra"
    else
      printf 'Resolved:    (unresolved — auditing at package level)\n'
    fi
    printf 'Socket:      %s\n' "$socket_line"
    printf 'OSV:         %s\n' "$osv_line"
    [[ -n "$release_line" ]] && printf 'Release age: %s\n' "$release_line"
    printf 'Blocklist:   %s\n' "$block_line"
    if (( custom_source )); then
      printf '\n[safe audit] custom source: %s — advisory evidence covers the public registry identity only\n' "$CHECK_EFFECTIVE_SOURCES"
    fi
    # Branch on the discriminated status first: a deliberate Socket-disabled
    # skip must not render as an outage.
    if [[ "$(jq -r '.available' "$socket_json" 2>/dev/null)" == "false" ]]; then
      printf '\n[safe audit] WARNING: socket CLI not available, skipping behavioral analysis\n'
      printf '[safe audit] Install: safe audit setup local\n'
    fi
    printf '\nVERDICT: %s\n' "$verdict"
    if [[ -z "$gate" && "$verdict" != "GO" ]]; then
      # Identical conditions used to print a bare VERDICT here while the
      # gate route explained itself — a direct check is the agent's
      # preflight and deserves the same next-step hints (contract-test
      # findings 5/7).
      gate_emit_refusal_hints "$ecosystem" "$PKG_NAME" "$primary_version" "$resolution_ok" "$aff_count" \
        "$socket_detail" "$release_security_fix_ids" "$([[ "$block_line" == PASS* ]] && printf 1 || printf 0)" \
        "$primary_version" \
        ${warn_causes[@]+"${warn_causes[@]}"}
      if [[ "$verdict" == "BLOCK" ]]; then
        printf 'safe audit: operator review required: safe audit package-audit %s --ecosystem %s --json\n' \
          "$( (( resolution_ok )) && printf '%s@%s' "$PKG_NAME" "$primary_version" || printf '%s' "$spec")" "$ecosystem" >&2
      fi
    fi
  fi

  # --- install-gate mode: apply allow policy, emit actionable hints
  if [[ "$gate" == "install" ]]; then
    local policy auto_allow gate_exit=-1
    policy=$(install_policy_json)
    auto_allow=$(jq -r 'if .auto_allow == false then "false" else "true" end' <<<"$policy")
    case "$verdict" in
      GO)
        if [[ "$auto_allow" == "true" ]] && (( resolution_ok )); then
          # A pending-score GO is not fully clean evidence: record it under a
          # distinct verdict so the offline stale-evidence fallback can never
          # treat incomplete Socket data as a clean check during an outage.
          local socket_reason="socket_ok"
          local known_verdict="GO"
          if (( socket_pending )); then
            socket_reason="socket_score_pending"
            known_verdict="GO_PENDING_SOCKET"
          elif [[ -n "$socket_skip_reason" ]]; then
            socket_reason="socket_disabled"
          fi
          mark_install_known "$ecosystem" "$PKG_NAME" "$primary_version" "$known_verdict" \
            "$(jq -cn --arg socket_reason "$socket_reason" \
              '["osv_clean_for_version",$socket_reason,"blocklist_pass"]')" "$result_json"
          printf '[safe audit] recorded clean check: %s:%s@%s (install-known)\n' \
            "$ecosystem" "$PKG_NAME" "$primary_version" >&2
        fi
        # Legibility, not policy: the install proceeds either way, but a
        # package that declares install scripts will land with them skipped
        # (global ignore-scripts). Name the operator command that authorizes
        # them, so a later "installed but broken" has a visible cause.
        if [[ "$ecosystem" == "npm" && "$has_install_script" == "true" ]] && (( resolution_ok )) \
          && ! scripts_allow_matches_resolved "$PKG_NAME" "$primary_version"; then
          printf '[safe audit] %s@%s declares install scripts — they will be SKIPPED (global ignore-scripts); if the tool needs them: safe run scripts-allow add %s@%s --reason "..." (operator, TTY)\n' \
            "$PKG_NAME" "$primary_version" "$PKG_NAME" "$primary_version" >&2
        fi
        gate_exit=0
        ;;
      WARN)
        # Adverse SECURITY knowledge (affecting advisory, blocklist hit, low
        # Socket score) supersedes recorded clean evidence BEFORE any
        # override decides this one invocation (delta finding 5).
        # Enumerated pure-infrastructure WARNs (socket/OSV outage) do not
        # revoke: the stale-evidence fallback exists precisely for those
        # windows.
        local adverse=0 adverse_cause
        (( aff_count > 0 )) && adverse=1
        [[ "$block_line" != PASS* ]] && adverse=1
        for adverse_cause in ${warn_causes[@]+"${warn_causes[@]}"}; do
          [[ "$adverse_cause" == "socket_low_score" \
            || "$adverse_cause" == "socket_critical_cve" \
            || "$adverse_cause" == "socket_high_alert" \
            || "$adverse_cause" == "release_too_new" ]] && adverse=1
        done
        if (( adverse )); then
          revoke_install_known "$ecosystem" "$PKG_NAME" "$primary_version" ${RESOLVED_VERSIONS[@]+"${RESOLVED_VERSIONS[@]}"}
        fi
        # A one-version operator pin may cover only the exact versions that
        # produced this WARN. If multiple adverse versions exist, the current
        # single-entry schema cannot authorize the aggregate operation.
        local -a host_allow_required_versions=()
        local host_allow_versions_json
        host_allow_versions_json=$(host_allow_required_versions_json \
          "$classifications" "$warn_causes_json" "$primary_version" "$resolved_versions_json")
        mapfile -t host_allow_required_versions < <(jq -r '.[]' <<<"$host_allow_versions_json")
        HOST_ALLOW_RESOLVED_VERSION=""
        if (( resolution_ok )) && host_allow_matches_resolved "$ecosystem" "$PKG_NAME" \
          "${host_allow_required_versions[@]}"; then
          printf '[safe audit] host-allow entry %s@%s matches every warned resolved version; allowing\n' \
            "$PKG_NAME" "$HOST_ALLOW_RESOLVED_VERSION" >&2
          gate_exit=0
        elif [[ "$auto_allow" == "true" ]] && (( resolution_ok )) && (( aff_count == 0 )) \
          && [[ "$block_line" == PASS* ]] && (( ${#warn_causes[@]} > 0 )) \
          && [[ "$(jq -r --argjson causes "$warn_causes_json" '((.auto_allow_tolerate // []) | map(tostring)) as $tol | $causes | all(. as $c | $tol | index($c) != null)' <<<"$policy")" == "true" ]]; then
          mark_install_known "$ecosystem" "$PKG_NAME" "$primary_version" "WARN_TOLERATED" \
            "$warn_causes_json" "$result_json"
          printf '[safe audit] WARN causes tolerated by install.auto_allow_tolerate (%s); allowing %s@%s\n' \
            "$(printf '%s,' "${warn_causes[@]}" | sed 's/,$//')" "$PKG_NAME" "$primary_version" >&2
          gate_exit=0
        else
          # A single host-allow entry can only authorize a one-version required
          # set; a ranged op (length > 1) is non-pinnable, so suppress the
          # dead-end `host-allow add` hint and let the tolerate/review lanes
          # carry the recovery (Fibery #106).
          local pin_hint=""
          (( ${#host_allow_required_versions[@]} == 1 )) && pin_hint="${host_allow_required_versions[0]}"
          gate_emit_refusal_hints "$ecosystem" "$PKG_NAME" "$primary_version" "$resolution_ok" "$aff_count" \
            "$socket_detail" "$release_security_fix_ids" "$([[ "$block_line" == PASS* ]] && printf 1 || printf 0)" \
            "$pin_hint" \
            "${warn_causes[@]}"
          gate_exit=10
        fi
        ;;
      BLOCK)
        local block_cause
        for block_cause in ${warn_causes[@]+"${warn_causes[@]}"}; do
          if [[ "$block_cause" == "osv_malware" ]]; then
            printf 'safe audit: known-malware record (OSV MAL-*) — do not install, do not pin around it; operator review only\n' >&2
            break
          fi
        done
        gate_emit_refusal_hints "$ecosystem" "$PKG_NAME" "$primary_version" "$resolution_ok" "$aff_count" \
          "$socket_detail" "" "$([[ "$block_line" == PASS* ]] && printf 1 || printf 0)" \
          "$primary_version" \
          "${warn_causes[@]}"
        printf 'safe audit: operator review required: safe audit package-audit %s --ecosystem %s --json\n' \
          "$( (( resolution_ok )) && printf '%s@%s' "$PKG_NAME" "$primary_version" || printf '%s' "$spec")" "$ecosystem" >&2
        revoke_install_known "$ecosystem" "$PKG_NAME" "$primary_version" ${RESOLVED_VERSIONS[@]+"${RESOLVED_VERSIONS[@]}"}
        gate_exit=20
        ;;
    esac
    if (( gate_exit >= 0 )); then
      rm -rf "$scratch"
      return "$gate_exit"
    fi
  fi

  rm -rf "$scratch"
  case "$verdict" in
    GO) return 0 ;;
    WARN) return 10 ;;
    BLOCK) return 20 ;;
    *) return 1 ;;
  esac
}

# Prints the pinned host-allow add command when the store supports this
# ecosystem (npm + python families today); returns 1 otherwise so the caller
# falls back to the operator-review hint instead of a command that dies.
gate_host_allow_add_cmd() {
  local name="$1" version="$2" ecosystem="$3" extra_flags="${4:-}"
  [[ -n "$extra_flags" ]] && extra_flags="${extra_flags} "
  case "$(host_allow_canonical_eco "$ecosystem")" in
    npm) printf 'safe run host-allow add %s@%s %s--reason "..."' "$name" "$version" "$extra_flags" ;;
    python) printf 'safe run host-allow add %s@%s --ecosystem python %s--reason "..."' "$name" "$version" "$extra_flags" ;;
    *) return 1 ;;
  esac
}

# Actionable refusal hints for install-gate mode, printed to stderr in cause
# priority order. Socket failures are infrastructure breakage — the wording
# must never read as a package vulnerability finding.
gate_emit_refusal_hints() {
  local ecosystem="$1" name="$2" primary_version="$3" resolution_ok="$4" aff_count="$5"
  local socket_detail="$6" cooldown_remediates="$7" blocklist_pass="$8" pin_version="$9"
  shift 9
  local -a causes=("${@}")
  # pin_version is the exact version a single host-allow entry would authorize
  # (the sole element of the required-versions set), or "" when no single pin
  # can cover the operation — a ranged op whose required set has >1 version.
  # Empty suppresses every `host-allow add` hint so the refusal never dangles a
  # pin that can never match (Fibery #106); the tolerate/review lanes remain.
  local cause has_socket_infra=0 has_unresolved=0 has_affecting=0 has_osv_down=0
  local has_low_score=0 has_socket_high=0 has_socket_critical_cve=0 has_socket_malware=0
  local has_socket_disabled=0 has_socket_not_found=0
  local has_custom_source=0 has_malware=0 has_too_new=0
  for cause in "${causes[@]}"; do
    case "$cause" in
      socket_unavailable|socket_auth_failed|socket_rate_limited|socket_error) has_socket_infra=1 ;;
      socket_not_found) has_socket_not_found=1 ;;
      socket_low_score) has_low_score=1 ;;
      socket_high_alert) has_socket_high=1 ;;
      socket_critical_cve) has_socket_critical_cve=1 ;;
      socket_malware) has_socket_malware=1 ;;
      socket_disabled) has_socket_disabled=1 ;;
      version_unresolved) has_unresolved=1 ;;
      osv_affecting) has_affecting=1 ;;
      osv_unavailable) has_osv_down=1 ;;
      custom_source) has_custom_source=1 ;;
      osv_malware) has_malware=1 ;;
      release_too_new) has_too_new=1 ;;
    esac
  done
  if (( has_too_new )); then
    printf 'safe audit: resolved version is younger than the release cooldown — waiting out install.cooldown_days is the default protection against compromised releases\n' >&2
    if [[ -n "$cooldown_remediates" ]]; then
      printf 'safe audit: NOTE this version remediates %s — install.cooldown_security_fix=exempt (the default) would let a security fix through; this refusal comes from the enforce setting\n' \
        "$cooldown_remediates" >&2
    fi
    local too_new_allow_cmd=""
    if [[ "$resolution_ok" == "1" && -n "$pin_version" ]]; then
      too_new_allow_cmd=$(gate_host_allow_add_cmd "$name" "$pin_version" "$ecosystem") || too_new_allow_cmd=""
    fi
    if [[ -n "$too_new_allow_cmd" ]]; then
      printf 'safe audit: operator overrides: %s / add release_too_new to install.auto_allow_tolerate\n' \
        "$too_new_allow_cmd" >&2
    else
      printf 'safe audit: operator override: add release_too_new to install.auto_allow_tolerate\n' >&2
    fi
  fi
  if (( has_malware )); then
    printf 'safe audit: known-malware record (OSV MAL-*) — do not install, do not pin around it; operator review only\n' >&2
  fi
  if (( has_socket_malware )); then
    printf 'safe audit: Socket reports a critical supply-chain-risk alert — do not install or pin around it; operator review only\n' >&2
  fi
  if (( has_socket_disabled )); then
    if [[ "$ecosystem" == "java" ]]; then
      printf 'safe audit: Socket has no Maven tier, so this check has no behavioral evidence — advisories, blocklist and release age still applied\n' >&2
      printf 'safe audit: JVM/Maven is OSV-covered but not auto-gated (declarative builds have no wrappable install verb); to run this posture routinely: add socket_disabled to install.auto_allow_tolerate\n' >&2
    else
      printf 'safe audit: the behavioral tier is off (install.socket.mode=never), so this check has no behavioral evidence — advisories, blocklist and release age still applied\n' >&2
      printf 'safe audit: to run this posture routinely: add socket_disabled to install.auto_allow_tolerate; to re-enable the tier: set install.socket.mode=auto\n' >&2
    fi
  fi
  if (( has_socket_not_found )); then
    printf 'safe audit: Socket has no record of this package — an absence of behavioral data, NOT an outage; advisories, blocklist and release age still applied\n' >&2
    local not_found_allow_cmd=""
    if [[ "$resolution_ok" == "1" && -n "$pin_version" ]]; then
      not_found_allow_cmd=$(gate_host_allow_add_cmd "$name" "$pin_version" "$ecosystem") || not_found_allow_cmd=""
    fi
    if [[ -n "$not_found_allow_cmd" ]]; then
      printf 'safe audit: operator overrides: %s / add socket_not_found to install.auto_allow_tolerate\n' \
        "$not_found_allow_cmd" >&2
    else
      printf 'safe audit: operator override: add socket_not_found to install.auto_allow_tolerate (the only lane for ecosystems Socket cannot host-allow, e.g. go, cargo)\n' >&2
    fi
  fi
  if (( has_custom_source )); then
    printf 'safe audit: custom package source — public advisory evidence cannot vouch for a private artifact\n' >&2
    printf 'safe audit: to trust this source permanently: add it to install.trusted_registries in ~/.config/safe/run/config.json (operator)\n' >&2
  fi
  if (( has_affecting )) && (( ! has_malware )); then
    local affecting_allow_cmd=""
    if [[ -n "$pin_version" ]]; then
      affecting_allow_cmd=$(gate_host_allow_add_cmd "$name" "$pin_version" "$ecosystem") || affecting_allow_cmd=""
    fi
    if [[ -n "$affecting_allow_cmd" ]]; then
      printf 'safe audit: to allow this exact version: %s\n' "$affecting_allow_cmd" >&2
    else
      printf 'safe audit: operator review: safe audit package-audit %s@<x.y.z> --ecosystem %s --json\n' \
        "$name" "$ecosystem" >&2
    fi
  fi
  if (( has_socket_infra )); then
    printf 'safe audit: socket score unavailable (%s) — infrastructure failure, NOT a package finding\n' \
      "${socket_detail:-unknown cause}" >&2
    printf 'safe audit: fix now: socket login (auth) / wait and retry (rate limit) / safe doctor (wiring); escalate to the operator if it persists\n' >&2
  fi
  if (( has_unresolved )); then
    printf 'safe audit: could not resolve the target version for %s — pin an exact version and retry\n' "$name" >&2
    printf 'safe audit: inspect: safe audit package-audit %s@<x.y.z> --ecosystem %s\n' "$name" "$ecosystem" >&2
  fi
  if (( has_osv_down )); then
    printf 'safe audit: OSV advisory service unreachable — retry; if persistent, operator review\n' >&2
  fi
  if (( has_low_score || has_socket_high || has_socket_critical_cve )); then
    printf 'safe audit: Socket reports behavioral risk — operator review required (not auto-allowable)\n' >&2
  fi
}

# --- Bun Security Scanner API backend ---------------------------------------
# Consumed by share/scanner.mjs under hosts implementing Bun's scanner
# contract (mise's embedded aube installer, bun >= 1.3): the resolved
# direct+transitive registry package set arrives as JSON on stdin and a
# Bun-shaped advisory array leaves on stdout. The host SIGKILLs the scanner
# at 30s, so audit depth is deliberately shallow — local blocklist plus
# version-scoped OSV querybatch (with per-advisory severity fetch); the
# Socket stays in the per-spec gate lane. Every infrastructure
# failure exits nonzero WITHOUT emitting advisories: the host's fail-closed
# contract blocks the install, and the stderr cause reads as
# breakage-to-fix, never as a package finding.
scanner_batch_command() {
  local input
  input=$(cat 2>/dev/null) || input=""
  # Names and versions must be whitespace/control-free: they travel through
  # line-oriented read loops (blocklist names, per-package severity scoping)
  # and into advisory descriptions, where an embedded newline would split
  # one value into separately-processed fragments — the same fragment
  # defect class as delta-2 F14.
  if ! jq -e '
    (.packages | type == "array") and (.packages | length > 0)
    and ([.packages[]
          | (type == "object")
            and ((.name? | type) == "string") and (.name | length > 0)
            and ((.name | test("[[:space:][:cntrl:]]")) | not)
            and ((.version? | type) == "string") and (.version | length > 0)
            and ((.version | test("[[:space:][:cntrl:]]")) | not)]
         | all)
  ' <<<"$input" >/dev/null 2>&1; then
    printf 'safe audit: scanner-batch: malformed input — expected {"packages":[{"name":…,"version":…},…]} on stdin\n' >&2
    return 2
  fi

  local scratch
  new_scratch_dir scratch || {
    printf 'safe audit: scanner-batch: could not create scratch dir\n' >&2
    return 4
  }

  local pkgs advisories='[]' name reason
  pkgs=$(jq -c '[.packages[] | {name, version}] | unique' <<<"$input")

  # A blocklist that exists but cannot be parsed is local audit-infrastructure
  # breakage, not "not blocked": blocked_entry_reason runs as a conditional,
  # where a jq failure is indistinguishable from a miss, and operator
  # blocklist evidence would vanish silently (PR#64 review F4).
  # #87 N2: validate every authority member searched (canonical + any redirected
  # store), not just the trust_store_file selection, so a malformed canonical
  # under a blessed redirect cannot pass as readable and hide a canonical block.
  if ! blocklist_authority_readable; then
    printf 'safe audit: scanner-batch: blocklist file unreadable (%s) — local audit-infrastructure breakage, not a package finding; repair or remove the file\n' "$BLOCKLIST_UNREADABLE_FILE" >&2
    return 4
  fi

  while IFS= read -r name; do
    if reason=$(blocked_entry_reason "$name"); then
      advisories=$(jq -c --arg p "$name" --arg d "blocklisted on this host: $reason" \
        '. + [{level:"fatal", package:$p, description:$d}]' <<<"$advisories")
    fi
  done < <(jq -r '.[].name' <<<"$pkgs" | sort -u)

  # One querybatch round-trip per 100 packages. The queries are
  # version-scoped, so OSV's server-side matching returns only advisories
  # affecting the resolved version — the same trust level `check` places in
  # its own version-scoped /v1/query.
  local total chunk_start chunk chunk_len body paired='[]'
  total=$(jq 'length' <<<"$pkgs")
  chunk_start=0
  while (( chunk_start < total )); do
    chunk=$(jq -c --argjson s "$chunk_start" '.[$s:$s+100]' <<<"$pkgs")
    chunk_len=$(jq 'length' <<<"$chunk")
    body=$(jq -c '{queries: [.[] | {package: {ecosystem: "npm", name: .name}, version: .version}]}' <<<"$chunk")
    if ! curl -fsS --max-time 10 https://api.osv.dev/v1/querybatch \
      -H 'content-type: application/json' -d "$body" > "$scratch/batch.json"; then
      printf 'safe audit: scanner-batch: OSV batch query failed (network/timeout/HTTP error) — audit-infrastructure breakage, not a package finding; check connectivity or run safe doctor\n' >&2
      return 4
    fi
    # A JSON *stream* is not a JSON response: jq validates every document
    # and reports the last one's status while the pairing below consumes
    # only the first — a two-document body would validate on its tail and
    # silently drop the advisories in it (PR#64 delta F10). Exactly one
    # document, then shape.
    if ! jq -es 'length == 1' "$scratch/batch.json" >/dev/null 2>&1; then
      printf 'safe audit: scanner-batch: malformed OSV batch response (not a single JSON document) — audit-infrastructure breakage, not a package finding\n' >&2
      return 4
    fi
    # Every result entry is validated to the shape the classification below
    # relies on BEFORE any optional iteration touches it: a null entry, a
    # non-array vulns, a vuln without a string id, or a token of the wrong
    # shape must fail closed here — optional iterators (`.vulns[]?`) would
    # otherwise read each of those as "no advisories" and exit 0 clean
    # (PR#64 review F2).
    if ! jq -e --argjson n "$chunk_len" '
      (.results | type == "array") and (.results | length == $n)
      and ([.results[]
            | (type == "object")
              and ((has("vulns") | not)
                   or (.vulns | (type == "array")
                       and ([.[] | (type == "object")
                             and ((.id? | type) == "string")
                             and (.id | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
                             and ((.id | test("[\\n\\r]")) | not)] | all)))
              and ((has("next_page_token") | not)
                   or (.next_page_token | (type == "string") and (length > 0)
                       and test("^[[:graph:]]+$")))
           ] | all)
    ' "$scratch/batch.json" >/dev/null 2>&1; then
      printf 'safe audit: scanner-batch: malformed OSV batch response — audit-infrastructure breakage, not a package finding\n' >&2
      return 4
    fi
    paired=$(jq -cn --argjson acc "$paired" --argjson chunk "$chunk" --slurpfile b "$scratch/batch.json" \
      '$acc + ([$chunk, $b[0].results] | transpose | map({pkg: .[0], res: .[1]}))')
    chunk_start=$((chunk_start + 100))
  done

  # querybatch truncates: a result carrying next_page_token has more
  # advisories than the page shows. Re-query that package through the
  # paginated single-query path and substitute its complete vuln set —
  # treating one page as the full answer would let findings ride through.
  local idx pkg_name pkg_version pagefile
  while IFS= read -r idx; do
    pkg_name=$(jq -r --argjson i "$idx" '.[$i].pkg.name' <<<"$paired")
    pkg_version=$(jq -r --argjson i "$idx" '.[$i].pkg.version' <<<"$paired")
    pagefile="$scratch/paged-$idx.json"
    osv_query_package_json npm "$pkg_name" "$pkg_version" "$pagefile"
    if ! jq -e '.status? != "error"' "$pagefile" >/dev/null 2>&1; then
      printf 'safe audit: scanner-batch: OSV pagination re-query failed for %s — audit-infrastructure breakage, not a package finding\n' "$pkg_name" >&2
      return 4
    fi
    # The paginated helper only guarantees vulns is an array; the entries
    # replace ALREADY-VALIDATED batch results, so the same id schema must
    # hold or a numeric/null id rides past the upfront guard as a
    # stringified warning (PR#64 delta F11).
    if ! jq -e '
      (.vulns // []) | (type == "array")
      and ([.[] | (type == "object")
            and ((.id? | type) == "string")
            and (.id | test("^[A-Za-z0-9][A-Za-z0-9._-]*$"))
            and ((.id | test("[\\n\\r]")) | not)] | all)
    ' "$pagefile" >/dev/null 2>&1; then
      printf 'safe audit: scanner-batch: malformed paginated OSV response for %s — audit-infrastructure breakage, not a package finding\n' "$pkg_name" >&2
      return 4
    fi
    paired=$(jq -c --argjson i "$idx" --slurpfile p "$pagefile" \
      '.[$i].res = {vulns: ($p[0].vulns // [])}' <<<"$paired")
  done < <(jq -r 'to_entries[] | select(.value.res.next_page_token? | strings | length > 0) | .key' <<<"$paired")

  # Advisory-id shape — MAL-* included — is enforced INSIDE the two schema
  # validators above (batch entries and pagination replacements): a
  # line-oriented bash loop over `jq -r` output validated embedded-newline
  # ids as separately valid fragments (PR#64 delta-2 F14). Every id that
  # reaches this point matches ^[A-Za-z0-9][A-Za-z0-9._-]*$ with no
  # CR/LF, so URL and output construction below are safe by construction.

  # Severity classification needs full records; querybatch returns only ids.
  # MAL-* ids are known-malware and need no fetch. Everything else is
  # fetched once per distinct id, the record validated as the advisory it
  # claims to be, and classified by the SAME most-severe-candidate-wins
  # ladder package_audit_command uses (qualitative labels + every CVSS v3/v4
  # vector) — the legacy substring matcher read a raw "CVSS:3.1/..." vector
  # as "low" and downgraded criticals to warn (PR#64 review F1). A record
  # that cannot be parsed is infrastructure breakage, never an
  # unknown-severity finding (PR#64 review F3).
  local sev_map='{}' label pkg_ref
  while IFS= read -r id; do
    if ! curl -fsS --max-time 8 "https://api.osv.dev/v1/vulns/$id" > "$scratch/vuln.json"; then
      printf 'safe audit: scanner-batch: OSV advisory fetch failed (%s) — audit-infrastructure breakage, not a package finding; check connectivity or run safe doctor\n' "$id" >&2
      return 4
    fi
    # Exactly one JSON document (a stream validates on its tail while the
    # extraction below concatenates one value per document — PR#64 delta
    # F10), an object, and a STRING id equal to the request (tostring let a
    # numeric 42 impersonate "42" — delta re-check F3).
    if ! jq -es 'length == 1' "$scratch/vuln.json" >/dev/null 2>&1 \
      || ! jq -e --arg id "$id" '(type == "object") and ((.id? | type) == "string") and (.id == $id)' \
        "$scratch/vuln.json" >/dev/null 2>&1; then
      printf 'safe audit: scanner-batch: OSV advisory record malformed (%s) — audit-infrastructure breakage, not a package finding\n' "$id" >&2
      return 4
    fi
    # Severity is scoped per QUERIED package, exactly as package_audit_command
    # scopes vuln_sev to matching_affected: whole-record aggregation
    # imported another affected package's critical into this package's
    # verdict (PR#64 delta F12). Top-level severity and
    # database_specific.severity stay record-global, as in check.
    while IFS= read -r pkg_ref; do
      if ! label=$(jq -r --arg name "$pkg_ref" "$JQ_SEVERITY_DEFS"'
        [ .affected[]? | select(((.package.ecosystem // "") == "npm") and ((.package.name // "") == $name)) ] as $aff
        | (
            [ .database_specific.severity? // empty | norm_qual ]
            + [ ((.severity // []) + ([ $aff[].severity? // empty ] | add // []))[]
                | select(.type == "CVSS_V3") | (.score // empty) | cvss3_band ]
            + [ ((.severity // []) + ([ $aff[].severity? // empty ] | add // []))[]
                | select(.type == "CVSS_V4")
                | ((try ((.score // "") | cvss4_band) catch empty) // "high") ]
            + [ $aff[].ecosystem_specific.severity? // empty | norm_qual ]
          ) as $cands
        | if ($cands | length) > 0 then ($cands | max_by(band_rank(.))) else "unknown" end
      ' "$scratch/vuln.json" 2>/dev/null) || [[ -z "$label" ]]; then
        printf 'safe audit: scanner-batch: OSV advisory severity unreadable (%s) — audit-infrastructure breakage, not a package finding\n' "$id" >&2
        return 4
      fi
      sev_map=$(jq -c --arg k "${id}|${pkg_ref}" --arg l "$label" '. + {($k): $l}' <<<"$sev_map")
    done < <(jq -r --arg id "$id" \
      '[.[] | select([.res.vulns[]? | .id] | index($id)) | .pkg.name] | unique | .[]' <<<"$paired")
  done < <(jq -r '[.[].res.vulns[]? | .id | strings | select(test("^MAL-") | not)] | unique | .[]' <<<"$paired")

  # install.block_severities (default ["critical"]) decides fatal vs warn —
  # the same knob `check` applies to affecting advisories. MAL-* records are
  # blocklist-class malware: fatal unconditionally, never severity-policy
  # business.
  local block_severities
  block_severities=$(install_policy_json | jq -c '.block_severities // ["critical"]')
  # Guarded: an assembly failure (including a missing severity entry, which
  # error() turns into one) must never fall through to printing the
  # blocklist-only accumulator as the complete answer.
  if ! advisories=$(jq -cn \
    --argjson base "$advisories" --argjson paired "$paired" \
    --argjson sev "$sev_map" --argjson block "$block_severities" '
    $base + ([ $paired[] | .pkg as $p | .res.vulns[]? | .id as $id
      | if ($id | test("^MAL-")) then
          {level: "fatal", package: $p.name,
           url: ("https://osv.dev/vulnerability/" + $id),
           description: ("known-malware record " + $id + " — do not install; operator review only")}
        else ($sev[$id + "|" + $p.name] // error("missing severity for " + $id)) as $label
          | {level: (if ($block | index($label)) then "fatal" else "warn" end),
             package: $p.name,
             url: ("https://osv.dev/vulnerability/" + $id),
             description: ($id + " (" + $label + ") affects " + $p.name + "@" + $p.version)}
        end ]) | unique' 2>/dev/null); then
    printf 'safe audit: scanner-batch: advisory assembly failed — audit-infrastructure breakage, not a package finding\n' >&2
    return 4
  fi
  printf '%s\n' "$advisories"
}

# release-review: the Go composite that reviews a whole release from one spec.
#
# Exec-passthrough by design. Every decision the composite makes — including
# which checks a build implements and how a spec is refused — belongs to
# safe-core, so bash carries only the lockstep pin that keeps a stale engine
# from deciding. Nothing on this path registers a scratch dir, so replacing the
# shell with exec strands no cleanup.
release_review_forward() {
  local safe_core_bin safe_core_reported
  safe_core_bin="${SAFE_CORE_BIN:-}"
  if [[ -z "$safe_core_bin" ]]; then
    safe_core_bin="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/safe-core"
  fi

  if [[ ! -x "$safe_core_bin" ]]; then
    printf 'safe audit: verdict engine missing (safe-core is not installed) — audit-infrastructure breakage, not a release finding; rerun install.sh\n' >&2
    return 30
  fi
  safe_core_reported=$("$safe_core_bin" --version 2>/dev/null) || safe_core_reported=""
  if [[ "$safe_core_reported" != "${SAFE_VERSION}" ]]; then
    printf 'safe audit: verdict engine version %s does not match safe %s — audit-infrastructure breakage, not a release finding; rerun install.sh\n' \
      "${safe_core_reported:-unknown}" "${SAFE_VERSION}" >&2
    return 30
  fi

  exec "$safe_core_bin" release-review "$@"
}

# binary-audit: everything that judges a distributed ARTIFACT rather than a
# dependency graph — release assets, signatures, TUF roots, and executing an
# unknown binary under observation.
binary_audit_command() {
  local sub="${1:-}"
  case "$sub" in
    # main() routes this before global init, so this arm is what a sourced
    # caller reaches; it keeps the subcommand table complete rather than
    # dying on a subcommand safe-audit plainly supports.
    release-review) shift; release_review_forward "$@" ;;
    *) die "unknown binary-audit subcommand: ${sub:-}" ;;
  esac
}

fetch_osv_vuln() {
  local ident="$1" output="$2"
  command -v curl >/dev/null 2>&1 || die "curl is required for advisory lookup"
  curl -fsS "https://api.osv.dev/v1/vulns/$ident" > "$output"
}

build_ioc_from_osv() {
  local ident="$1" advisory_json="$2" output="$3"
  jq -n --arg id "$ident" --slurpfile advisory "$advisory_json" '
    ($advisory[0] // {}) as $a |
    {
      id: $id,
      packages: [
        $a.affected[]? as $affected |
        {
          name: ($affected.package.name // "unknown"),
          versions_affected: (
            [$affected.ranges[]?.events[]? | .introduced // .fixed // .last_affected // empty] |
            if length == 0 then "*" else join(",") end
          )
        }
      ],
      files: [],
      strings: [],
      processes: [],
      dns: []
    }' > "$output"
}

fetch_cisa_kev_catalog() {
  local output="$1"
  command -v curl >/dev/null 2>&1 || die "curl is required for IOC updates"
  curl -fsS "$DEFAULT_CISA_KEV_URL" > "$output"
  jq -e '.vulnerabilities | type == "array"' "$output" >/dev/null 2>&1 || die "CISA KEV feed did not return the expected JSON shape"
}

build_ioc_from_cisa_kev() {
  local catalog_json="$1" output="$2" since="${3:-}"
  local cutoff_epoch="0" since_json
  if [[ -n "$since" ]]; then
    cutoff_epoch=$(epoch_from_since_spec "$since") || die "invalid --since duration: $since"
  fi
  since_json=$(json_string_or_null "$since")

  jq -n \
    --arg timestamp "$(now_iso)" \
    --arg source_url "$DEFAULT_CISA_KEV_URL" \
    --argjson cutoff_epoch "$cutoff_epoch" \
    --argjson since "$since_json" \
    --slurpfile catalog "$catalog_json" '
    ($catalog[0].vulnerabilities // []) as $vulns |
    (
      $vulns
      | map(
          select(
            $cutoff_epoch == 0
            or (((.dateAdded // "1970-01-01") + "T00:00:00Z" | fromdateiso8601) >= $cutoff_epoch)
          )
        )
      | sort_by(.dateAdded // "", .cveID // "")
    ) as $filtered |
    {
      id: "cisa-kev",
      source: {
        name: "CISA Known Exploited Vulnerabilities Catalog",
        url: $source_url
      },
      updated: $timestamp,
      since: $since,
      packages: [],
      files: [],
      strings: ($filtered | map(.cveID // empty) | unique),
      processes: [],
      dns: [],
      vulnerabilities: (
        $filtered | map({
          id: (.cveID // ""),
          vendor_project: (.vendorProject // ""),
          product: (.product // ""),
          name: (.vulnerabilityName // ""),
          date_added: (.dateAdded // ""),
          due_date: (.dueDate // ""),
          known_ransomware_campaign_use: (.knownRansomwareCampaignUse // ""),
          required_action: (.requiredAction // ""),
          notes: (.notes // ""),
          cwes: (.cwes // [])
        })
      )
    }' > "$output"
}

ioc_update_command() {
  local since="${1:-}" scan_targets="${2:-0}"
  local catalog_tmp ioc_tmp catalog_path ioc_path update_meta_path __scratch
  new_scratch_dir __scratch
  catalog_tmp="$__scratch/catalog"
  ioc_tmp="$__scratch/ioc"
  catalog_path="$IOC_CATALOG_DIR/cisa-kev.json"
  ioc_path="$IOC_DIR/cisa-kev-ioc.json"
  update_meta_path="$IOC_CATALOG_DIR/cisa-kev-update.json"

  fetch_cisa_kev_catalog "$catalog_tmp"
  build_ioc_from_cisa_kev "$catalog_tmp" "$ioc_tmp" "$since"

  cp "$catalog_tmp" "$catalog_path"
  cp "$ioc_tmp" "$ioc_path"
  jq -n \
    --arg timestamp "$(now_iso)" \
    --arg source "$DEFAULT_CISA_KEV_URL" \
    --arg catalog "$catalog_path" \
    --arg ioc "$ioc_path" \
    --argjson total "$(jq '.vulnerabilities | length' "$catalog_path")" \
    --argjson active "$(jq '.vulnerabilities | length' "$ioc_path")" '
    {
      timestamp: $timestamp,
      source: $source,
      catalog_path: $catalog,
      ioc_path: $ioc,
      total_vulnerabilities: $total,
      active_ioc_vulnerabilities: $active
    }' > "$update_meta_path"
  printf '%s\n' "$(now_iso)" > "$LAST_IOC_UPDATE"

  if [[ "$scan_targets" != "1" ]]; then
    printf 'Updated IOC catalog: %s\n' "$ioc_path"
    printf 'CISA KEV entries: %s total, %s active for scan\n' \
      "$(jq -r '.total_vulnerabilities' "$update_meta_path")" \
      "$(jq -r '.active_ioc_vulnerabilities' "$update_meta_path")"
    return 0
  fi

  ioc_run_scan "cisa-kev" "$ioc_path"
}

ioc_machine_scan() {
  local machine="$1" ioc_json="$2" output="$3"
  local search_root
  search_root="${SAFE_AUDIT_IOC_ROOT:-$DEFAULT_REMOTE_ROOT}"
  local package_hits="" file_hits="" string_hits="" process_hits=""
  local item output_chunk

  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    output_chunk=$(run_machine_capture "$machine" "
find ${search_root} -type f \\( -name 'package-lock.json' -o -name 'yarn.lock' -o -name 'pnpm-lock.yaml' -o -name 'bun.lock' -o -name 'uv.lock' -o -name 'poetry.lock' -o -name 'Pipfile.lock' -o -name 'composer.lock' -o -name 'Cargo.lock' -o -name 'go.sum' -o -name 'pom.xml' -o -name 'gradle.lockfile' \\) -print0 2>/dev/null | xargs -0 grep -nH -- $(printf '%q' "$item") 2>/dev/null || true
" || true)
    [[ -n "$output_chunk" ]] && package_hits+="${output_chunk}"$'\n'
  done < <(jq -r '.packages[]?.name' "$ioc_json")

  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    output_chunk=$(run_machine_capture "$machine" "
find ${search_root} -type f -name $(printf '%q' "$item") 2>/dev/null || true
" || true)
    [[ -n "$output_chunk" ]] && file_hits+="${output_chunk}"$'\n'
  done < <(jq -r '.files[]?' "$ioc_json")

  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    output_chunk=$(run_machine_capture "$machine" "
grep -R -nH --binary-files=without-match -- $(printf '%q' "$item") ${search_root} 2>/dev/null || true
" || true)
    [[ -n "$output_chunk" ]] && string_hits+="${output_chunk}"$'\n'
  done < <(jq -r '.strings[]?' "$ioc_json")

  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    output_chunk=$(run_machine_capture "$machine" "
ps aux | grep -F -- $(printf '%q' "$item") | grep -v grep || true
" || true)
    [[ -n "$output_chunk" ]] && process_hits+="${output_chunk}"$'\n'
  done < <(jq -r '.processes[]?' "$ioc_json")

  jq -n \
    --arg machine "$machine" \
    --arg timestamp "$(now_iso)" \
    --arg package_hits "$package_hits" \
    --arg file_hits "$file_hits" \
    --arg string_hits "$string_hits" \
    --arg process_hits "$process_hits" '
    {
      machine: $machine,
      timestamp: $timestamp,
      package_hits: ($package_hits | split("\n") | map(select(length > 0))),
      file_hits: ($file_hits | split("\n") | map(select(length > 0))),
      string_hits: ($string_hits | split("\n") | map(select(length > 0))),
      process_hits: ($process_hits | split("\n") | map(select(length > 0)))
    }' > "$output"
}

ioc_run_scan() {
  local ident="$1" ioc_json="$2"
  local result_path machine tmpfiles=() __scratch
  result_path="$IOC_DIR/$(today_date)-$(slugify "$ident").json"
  # One registered scratch dir for every per-machine scan file; the process-exit
  # trap reclaims the tree rather than leaving one temp per target behind.
  new_scratch_dir __scratch
  local __i=0
  for machine in "${MACHINE_TARGETS[@]}"; do
    local out="$__scratch/scan.$__i"
    __i=$((__i + 1))
    ioc_machine_scan "$machine" "$ioc_json" "$out"
    tmpfiles+=("$out")
  done

  jq -n \
    --arg timestamp "$(now_iso)" \
    --arg identifier "$ident" \
    --slurpfile ioc "$ioc_json" \
    --slurpfile scans <(jq -s '.' "${tmpfiles[@]}") '
    {
      timestamp: $timestamp,
      identifier: $identifier,
      ioc: ($ioc[0] // {}),
      scans: ($scans[0] // [])
    }' > "$result_path"

  printf '%s\n' "$result_path"
}

ioc_command() {
  local list_file="" ident="" update_mode=0 since=""
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list)
        [[ $# -lt 2 ]] && die "--list requires a JSON file"
        list_file="$2"
        shift 2
        ;;
      --update)
        update_mode=1
        shift
        ;;
      --since)
        [[ $# -lt 2 ]] && die "--since requires a duration"
        since="$2"
        shift 2
        ;;
      --all|--machine)
        args+=("$1")
        if [[ "$1" == "--machine" ]]; then
          [[ $# -lt 2 ]] && die "--machine requires a comma-separated list"
          args+=("$2")
          shift
        fi
        shift
        ;;
      -*)
        die "unknown ioc flag: $1"
        ;;
      *)
        ident="$1"
        shift
        ;;
    esac
  done

  if [[ "$update_mode" == "1" ]]; then
    if [[ -n "$ident" || -n "$list_file" ]]; then
      die "ioc --update cannot be combined with an identifier or --list"
    fi
    if [[ "${#args[@]}" -gt 0 ]]; then
      parse_machine_targets default "${args[@]}"
      ioc_update_command "$since" 1
    else
      ioc_update_command "$since" 0
    fi
    return 0
  fi

  parse_machine_targets default "${args[@]}"
  local ioc_json advisory_json __scratch
  new_scratch_dir __scratch
  advisory_json="$__scratch/advisory.json"
  ioc_json="$__scratch/ioc.json"
  if [[ -n "$list_file" ]]; then
    cp "$list_file" "$ioc_json"
    ident=$(jq -r '.id // "custom-ioc"' "$ioc_json")
  else
    [[ -n "$ident" ]] || die "usage: safe audit ioc <identifier> [--all|--machine ...]"
    fetch_osv_vuln "$ident" "$advisory_json"
    build_ioc_from_osv "$ident" "$advisory_json" "$ioc_json"
  fi

  ioc_run_scan "$ident" "$ioc_json"
}

core_scanner_tools() {
  printf '%s\n' osv-scanner grype syft
}

required_tools_for_machine() {
  core_scanner_tools
}

create_scanner_bundle() {
  local bundle_path="$1"
  [[ -n "$bundle_path" ]] || bundle_path="$DEFAULT_SCANNER_BUNDLE_PATH"
  local scratch bin_dir manifest
  new_scratch_dir scratch
  bin_dir="$scratch/bin"
  manifest="$scratch/manifest.json"
  mkdir -p "$bin_dir" "$(dirname "$bundle_path")"

  local tools=(osv-scanner syft grype) tool local_path version_output entries=()
  for tool in "${tools[@]}"; do
    local_path=$(local_scanner_path "$tool")
    [[ -n "$local_path" ]] || die "cannot create scanner bundle: $tool is not available locally"
    install -m 0755 "$local_path" "$bin_dir/$tool"
    version_output=$("$local_path" --version 2>&1 | head -n 1 || true)
    entries+=("$(jq -n --arg name "$tool" --arg source "$local_path" --arg version "$version_output" '{name:$name, source:$source, version:$version}')")
  done

  jq -n \
    --arg created "$(now_iso)" \
    --arg host "$(hostname 2>/dev/null || printf unknown)" \
    --slurpfile tools <(printf '%s\n' "${entries[@]}") '
    {
      created: $created,
      host: $host,
      format: "safe-audit-scanner-bundle-v1",
      tools: $tools
    }' > "$manifest"

  tar -C "$scratch" -czf "$bundle_path" manifest.json bin
  printf '%s\n' "$bundle_path"
}

resolve_scanner_bundle_path() {
  local bundle_path="${1:-}"
  case "$bundle_path" in
    ""|latest)
      printf '%s' "$DEFAULT_SCANNER_BUNDLE_PATH"
      ;;
    *)
      printf '%s' "$bundle_path"
      ;;
  esac
}

verify_installed_scanners_local() {
  local tool path version_output
  for tool in osv-scanner syft grype; do
    path=$(PATH="$BIN_DIR:$PATH" command -v "$tool" 2>/dev/null || true)
    [[ -n "$path" ]] || die "bundle install verification failed: $tool not found"
    version_output=$("$path" --version 2>&1 | head -n 1 || true)
    info "verified $tool: $path ${version_output:+($version_output)}"
  done
}

verify_installed_scanners_remote() {
  local machine="$1" host
  host=$(machine_host "$machine")
  ssh_batch "$host" 'PATH="$HOME/.local/bin:$PATH"; for t in osv-scanner syft grype; do p=$(command -v "$t" || true); [ -n "$p" ] || exit 20; v=$("$p" --version 2>&1 | head -n 1 || true); printf "%s\t%s\t%s\n" "$t" "$p" "$v"; done' \
    | while IFS=$'\t' read -r tool path version_output; do
        info "verified $machine:$tool: $path ${version_output:+($version_output)}"
      done
}

ensure_grype_db_for_machine() {
  local machine="$1"
  local grype
  grype=$(tool_cache_path "$machine" "grype")
  [[ -n "$grype" ]] || return 1

  if machine_grype_db_healthy "$machine"; then
    return 0
  fi

  info "$machine: updating Grype vulnerability database"
  if ! run_machine_capture "$machine" "PATH=\"\$HOME/.local/bin:\$PATH\" $(printf '%q' "$grype") db update" >/dev/null; then
    warn "$machine: Grype DB update failed"
    return 1
  fi

  if machine_grype_db_healthy "$machine"; then
    return 0
  fi

  warn "$machine: Grype DB is still unusable after update"
  return 1
}

install_scanner_bundle_local() {
  local bundle_path="$1"
  [[ -f "$bundle_path" ]] || die "scanner bundle not found: $bundle_path"
  mkdir -p "$BIN_DIR"
  tar -xzf "$bundle_path" -C "$BIN_DIR" --strip-components=1 'bin/osv-scanner' 'bin/syft' 'bin/grype'
  chmod 0755 "$BIN_DIR/osv-scanner" "$BIN_DIR/syft" "$BIN_DIR/grype" 2>/dev/null || true
  verify_installed_scanners_local
}

install_scanner_bundle_remote() {
  local machine="$1" bundle_path="$2"
  [[ -f "$bundle_path" ]] || die "scanner bundle not found: $bundle_path"
  local host remote_tmp
  host=$(machine_host "$machine")
  remote_tmp=$(ssh_batch "$host" 'tmp=$(mktemp -d); printf "%s" "$tmp"')
  [[ -n "$remote_tmp" ]] || return 1
  if ! scp_batch -q "$bundle_path" "$host:$remote_tmp/scanners.tar.gz"; then
    ssh_batch "$host" "rm -rf $(printf '%q' "$remote_tmp")" >/dev/null 2>&1 || true
    return 1
  fi
  if ! ssh_batch "$host" "mkdir -p \"\$HOME/.local/bin\" && tar -xzf $(printf '%q' "$remote_tmp/scanners.tar.gz") -C \"\$HOME/.local/bin\" --strip-components=1 bin/osv-scanner bin/syft bin/grype && chmod 0755 \"\$HOME/.local/bin/osv-scanner\" \"\$HOME/.local/bin/syft\" \"\$HOME/.local/bin/grype\""; then
    ssh_batch "$host" "rm -rf $(printf '%q' "$remote_tmp")" >/dev/null 2>&1 || true
    return 1
  fi
  ssh_batch "$host" "rm -rf $(printf '%q' "$remote_tmp")" >/dev/null 2>&1 || true
  verify_installed_scanners_remote "$machine"
}

setup_machine() {
  local machine="$1" bundle_path="${2:-}" validate_after="${3:-1}" prompt_before_install="${4:-1}"
  detect_machine_tools "$machine" 1

  if [[ -n "$bundle_path" ]]; then
    bundle_path=$(resolve_scanner_bundle_path "$bundle_path")
    info "$machine: installing scanner bundle $bundle_path"
    if [[ "$(machine_type "$machine")" == "local" ]]; then
      install_scanner_bundle_local "$bundle_path"
    else
      install_scanner_bundle_remote "$machine" "$bundle_path" || die "$machine: scanner bundle install failed"
    fi
    detect_machine_tools "$machine" 1
  fi

  local desired=()
  mapfile -t desired < <(required_tools_for_machine "$machine")

  local missing=() tool
  for tool in "${desired[@]}"; do
    [[ -n "$(tool_cache_path "$machine" "$tool")" ]] || missing+=("$tool")
  done

  if [[ "${#missing[@]}" -eq 0 ]]; then
    info "$machine: required tools already present"
  else
    printf '[safe audit] %s missing: %s\n' "$machine" "${missing[*]}"
    warn "$machine: setup no longer downloads or runs external installers"
    warn "$machine: install missing tools manually after verification, or provide a local scanner bundle with --bundle"
    warn "$machine: create bundles from an audited machine with: safe audit setup --create-bundle"
    return 1
  fi

  detect_machine_tools "$machine" 1
  local still_missing rc=0
  still_missing=$(machine_missing_tools_from_list "$machine" "${desired[@]}") || rc=$?
  (( rc == 0 )) || die_tool_cache_unusable
  if [[ -n "$still_missing" ]]; then
    warn "$machine: setup failed; still missing: $still_missing"
    return 1
  fi
  ensure_grype_db_for_machine "$machine" || return 1
  [[ "$validate_after" == "1" ]] || return 0

  local validate_target
  if [[ "$(machine_type "$machine")" == "local" ]]; then
    validate_target="${SAFE_AUDIT_SETUP_VALIDATE_PATH:-$PWD}"
  else
    validate_target="${SAFE_AUDIT_SETUP_VALIDATE_PATH:-$HOME}"
  fi
  scan_machine "$machine" "$validate_target"
}

diff_command() {
  local since="" project_target=""
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since)
        [[ $# -lt 2 ]] && die "--since requires a duration"
        since="$2"
        shift 2
        ;;
      --project)
        [[ $# -lt 2 ]] && die "--project requires a path"
        project_target="$2"
        shift 2
        ;;
      --all|--machine)
        args+=("$1")
        if [[ "$1" == "--machine" ]]; then
          [[ $# -lt 2 ]] && die "--machine requires a comma-separated list"
          args+=("$2")
          shift
        fi
        shift
        ;;
      *)
        die "unknown diff flag: $1"
        ;;
    esac
  done
  parse_machine_targets default "${args[@]}"
  local machine
  for machine in "${MACHINE_TARGETS[@]}"; do
    local latest previous
    latest=$(find "$SBOM_DIR/$machine" -maxdepth 1 -type f -name '*-sbom.cdx.json' 2>/dev/null | sort | tail -n 1 || true)
    if [[ -z "$latest" ]]; then
      if [[ -n "$project_target" ]]; then
        scan_machine "$machine" "$project_target"
      else
        scan_machine "$machine"
      fi
      latest=$(find "$SBOM_DIR/$machine" -maxdepth 1 -type f -name '*-sbom.cdx.json' 2>/dev/null | sort | tail -n 1 || true)
    fi
    previous=$(select_previous_sbom "$machine" "$latest" "$since")
    if [[ -z "$previous" ]]; then
      if [[ -n "$since" ]]; then
        warn "$machine: no previous SBOM at or before --since $since"
      else
        warn "$machine: no previous SBOM to diff"
      fi
      continue
    fi
    local added removed changed current_result previous_result new_cves host_allow_changes
    added=$(jq -n --slurpfile prev "$previous" --slurpfile cur "$latest" '
      ([($cur[0].components[]? | "\(.name)@\(.version // "unknown")")] - [($prev[0].components[]? | "\(.name)@\(.version // "unknown")")]) | length
    ')
    removed=$(jq -n --slurpfile prev "$previous" --slurpfile cur "$latest" '
      ([($prev[0].components[]? | "\(.name)@\(.version // "unknown")")] - [($cur[0].components[]? | "\(.name)@\(.version // "unknown")")]) | length
    ')
    changed=$(jq -n --slurpfile prev "$previous" --slurpfile cur "$latest" '
      ($prev[0].components // []) as $p |
      ($cur[0].components // []) as $c |
      [
        $c[]? as $cur_item |
        ($p[]? | select(.name == $cur_item.name) | .version) as $prev_ver |
        select($prev_ver != null and $prev_ver != ($cur_item.version // "unknown")) |
        "\($cur_item.name): \($prev_ver) -> \($cur_item.version // "unknown")"
      ] | unique
    ')
    current_result=$(scan_result_path_for "$machine" "$(basename "$latest" | sed 's/-sbom\.cdx\.json$//')")
    previous_result=$(scan_result_path_for "$machine" "$(basename "$previous" | sed 's/-sbom\.cdx\.json$//')")
    if [[ -f "$current_result" && -f "$previous_result" ]]; then
      new_cves=$(jq -n --slurpfile prev "$previous_result" --slurpfile cur "$current_result" '
        ([ $cur[0].cve_scan.findings[]?.id ] - [ $prev[0].cve_scan.findings[]?.id ]) | unique
      ')
    else
      new_cves='[]'
    fi
    if [[ -f "$HOST_ALLOW_LOG" ]]; then
      local cutoff_epoch
      cutoff_epoch=$(file_epoch "$previous")
      host_allow_changes=$(jq -s --argjson cutoff "$cutoff_epoch" '
        map(select(.timestamp?)) |
        map(select((.timestamp | strptime("%Y-%m-%dT%H:%M:%S%z") | mktime) >= $cutoff))
      ' "$HOST_ALLOW_LOG" 2>/dev/null || printf '[]')
    else
      host_allow_changes='[]'
    fi
    printf '=== SAFE-AUDIT DIFF - %s ===\n' "$machine"
    printf 'Current:  %s\n' "$latest"
    printf 'Previous: %s\n' "$previous"
    printf 'Added:    %s\n' "$added"
    printf 'Removed:  %s\n' "$removed"
    printf 'Changed:  %s\n' "$(jq 'length' <<<"$changed")"
    if [[ "$(jq 'length' <<<"$changed")" -gt 0 ]]; then
      jq -r '.[] | "  - " + .' <<<"$changed"
    fi
    printf 'New CVEs: %s\n' "$(jq 'length' <<<"$new_cves")"
    if [[ "$(jq 'length' <<<"$new_cves")" -gt 0 ]]; then
      jq -r '.[] | "  - " + .' <<<"$new_cves"
    fi
    if [[ "$(jq 'length' <<<"$host_allow_changes")" -gt 0 ]]; then
      printf 'Host-allow installs since previous snapshot:\n'
      jq -r '.[] | "  - \(.timestamp) \(.runner) \(.package)@\(.version)"' <<<"$host_allow_changes"
    fi
    printf '\n'
  done
}

# Shared by repo-audit and machine-audit: the flags that mean the same thing
# on both surfaces. Sets SCAN_MODE_PARSED and consumes what it recognizes,
# leaving anything else for the caller to reject in its own vocabulary.
SCAN_MODE_PARSED=""
SCAN_FLAG_SHIFT=0
scan_parse_shared_flag() {
  local flag="$1" next="${2-}" have_next="${3:-0}"
  SCAN_FLAG_SHIFT=0
  case "$flag" in
    --verbose)
      SAFE_AUDIT_VERBOSE=1
      SCAN_FLAG_SHIFT=1
      ;;
    --deps-only)
      [[ -z "$SCAN_MODE_PARSED" ]] || die "scan mode flags are mutually exclusive"
      SCAN_MODE_PARSED="deps"
      SCAN_FLAG_SHIFT=1
      ;;
    --full)
      [[ -z "$SCAN_MODE_PARSED" ]] || die "scan mode flags are mutually exclusive"
      SCAN_MODE_PARSED="full"
      SCAN_FLAG_SHIFT=1
      ;;
    --no-cache)
      SAFE_AUDIT_SCAN_NO_CACHE=1
      SCAN_FLAG_SHIFT=1
      ;;
    --allow-missing-tools)
      SAFE_AUDIT_ALLOW_MISSING_TOOLS=1
      SCAN_FLAG_SHIFT=1
      ;;
    --result-out)
      # Hand the caller its own copy of the result document. The published
      # per-day file is shared and can be replaced by a concurrent scan
      # before the caller reads it; this copy cannot.
      [[ "$have_next" == "1" ]] || die "--result-out requires a path"
      SCAN_RESULT_OUT="$next"
      SCAN_FLAG_SHIFT=2
      ;;
  esac
  return 0
}

# Validated before the scan runs: a caller that cannot receive the result must
# not learn this after several minutes of scanning.
scan_validate_result_out() {
  [[ -n "$SCAN_RESULT_OUT" ]] || return 0
  local result_out_dir
  result_out_dir="$(dirname -- "$SCAN_RESULT_OUT")"
  [[ -d "$result_out_dir" && -w "$result_out_dir" ]] || die "--result-out directory is not writable: $result_out_dir"
  # A directory (or anything that is not a regular file) would silently
  # become "a file created somewhere near where you asked".
  [[ ! -e "$SCAN_RESULT_OUT" || -f "$SCAN_RESULT_OUT" ]] || die "--result-out must name a regular file: $SCAN_RESULT_OUT"
  [[ ! -e "$SCAN_RESULT_OUT" || -w "$SCAN_RESULT_OUT" ]] || die "--result-out is not writable: $SCAN_RESULT_OUT"
}

# repo-audit: one project tree on this machine. The machine is resolved because
# scan_machine needs an execution context, never because the caller chose it —
# so no machine name appears in this surface's output. Auditing a project on a
# remote host is machine-audit --project <path> --machine <name>.
repo_audit_command() {
  local project_target=""
  SCAN_MODE_PARSED=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all|--machine)
        die "repo-audit audits one project on this machine; for a project on another host use: safe audit machine-audit --project <path> --machine <name>"
        ;;
      --project)
        die "repo-audit takes the project path as its argument: safe audit repo-audit [<path>]"
        ;;
      --*)
        local have_next=0
        [[ $# -ge 2 ]] && have_next=1
        scan_parse_shared_flag "$1" "${2-}" "$have_next"
        (( SCAN_FLAG_SHIFT > 0 )) || die "unknown repo-audit flag: $1"
        shift "$SCAN_FLAG_SHIFT"
        ;;
      *)
        [[ -z "$project_target" ]] || die "repo-audit takes a single project path"
        project_target="$1"
        shift
        ;;
    esac
  done
  [[ -n "$project_target" ]] || project_target="."
  [[ -d "$project_target" ]] || die "repo-audit target is not a directory: $project_target"
  SAFE_AUDIT_SCAN_MODE="${SCAN_MODE_PARSED:-${SAFE_AUDIT_SCAN_MODE:-source}}"
  scan_validate_result_out

  parse_machine_targets default
  local machine="${MACHINE_TARGETS[0]}"
  local target_label
  target_label="project $(printf '%q' "$project_target")"
  vinfo "repo-audit mode: $SAFE_AUDIT_SCAN_MODE"
  info "repo-audit: starting $target_label"
  local scan_rc=0
  if scan_machine "$machine" "$project_target" "$SAFE_AUDIT_SCAN_MODE"; then
    if [[ -n "$SCAN_DEGRADED_TIERS" ]]; then
      warn "repo-audit: finished $target_label with degraded coverage: $SCAN_DEGRADED_TIERS"
    else
      info "repo-audit: finished $target_label"
    fi
  else
    scan_rc=$?
    warn "repo-audit: failed $target_label"
    return "$scan_rc"
  fi
}

# machine-audit: whole machine roots across the fleet. The machine dimension is
# the point here, so it stays in the output.
machine_audit_command() {
  local project_target=""
  local args=()
  SCAN_MODE_PARSED=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)
        [[ $# -lt 2 ]] && die "--project requires a path"
        project_target="$2"
        shift 2
        ;;
      --all|--machine)
        args+=("$1")
        if [[ "$1" == "--machine" ]]; then
          [[ $# -lt 2 ]] && die "--machine requires a comma-separated list"
          args+=("$2")
          shift
        fi
        shift
        ;;
      *)
        local have_next=0
        [[ $# -ge 2 ]] && have_next=1
        scan_parse_shared_flag "$1" "${2-}" "$have_next"
        (( SCAN_FLAG_SHIFT > 0 )) || die "unknown machine-audit flag: $1"
        shift "$SCAN_FLAG_SHIFT"
        ;;
    esac
  done
  SAFE_AUDIT_SCAN_MODE="${SCAN_MODE_PARSED:-${SAFE_AUDIT_SCAN_MODE:-source}}"
  scan_validate_result_out

  parse_machine_targets default "${args[@]}"
  if [[ -n "$SCAN_RESULT_OUT" && "${#MACHINE_TARGETS[@]}" -gt 1 ]]; then
    die "--result-out writes one result document; it cannot be combined with a multi-machine scan"
  fi
  vinfo "machine-audit targets: ${MACHINE_TARGETS[*]}"
  vinfo "machine-audit mode: $SAFE_AUDIT_SCAN_MODE"
  local machine
  for machine in "${MACHINE_TARGETS[@]}"; do
    local target_label
    if [[ -n "$project_target" ]]; then
      target_label="project $(printf '%q' "$project_target")"
    else
      target_label="machine root $(printf '%q' "$(machine_scan_root "$machine")")"
    fi
    info "machine-audit: starting $machine $target_label"
    local scan_rc=0
    if scan_machine "$machine" "$project_target" "$SAFE_AUDIT_SCAN_MODE"; then
      if [[ -n "$SCAN_DEGRADED_TIERS" ]]; then
        warn "machine-audit: finished $machine $target_label with degraded coverage: $SCAN_DEGRADED_TIERS"
      else
        info "machine-audit: finished $machine $target_label"
      fi
    else
      scan_rc=$?
      warn "machine-audit: failed $machine $target_label"
      return "$scan_rc"
    fi
  done
}

setup_command() {
  local args=()
  local positional="" bundle_path="" create_bundle_path=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bundle)
        [[ $# -lt 2 ]] && die "--bundle requires a scanner bundle path"
        bundle_path="$2"
        shift 2
        ;;
      --create-bundle)
        if [[ $# -ge 2 && "$2" != -* ]]; then
          create_bundle_path="$2"
          shift 2
        else
          create_bundle_path="$DEFAULT_SCANNER_BUNDLE_PATH"
          shift
        fi
        ;;
      --all|--machine)
        args+=("$1")
        if [[ "$1" == "--machine" ]]; then
          [[ $# -lt 2 ]] && die "--machine requires a comma-separated list"
          args+=("$2")
          shift
        fi
        shift
        ;;
      -*)
        die "unknown setup flag: $1"
        ;;
      *)
        positional="$1"
        shift
      ;;
    esac
  done
  if [[ -n "$create_bundle_path" ]]; then
    [[ -z "$positional" && "${#args[@]}" -eq 0 && -z "$bundle_path" ]] || die "--create-bundle cannot be combined with machine targets or --bundle"
    create_scanner_bundle "$(resolve_scanner_bundle_path "$create_bundle_path")"
    return 0
  fi
  if [[ -n "$positional" ]]; then
    MACHINE_TARGETS=("$positional")
  else
    parse_machine_targets default "${args[@]}"
  fi
  local machine
  for machine in "${MACHINE_TARGETS[@]}"; do
    setup_machine "$machine" "$bundle_path"
  done
}

cmd_status() {
  local machine_count local_count ssh_count scanners last_scan last_machine

  machine_count=$(jq '.machines | length' "$MACHINES_FILE" 2>/dev/null || printf '0')
  local_count=$(jq '[.machines[] | select(.type == "local")] | length' "$MACHINES_FILE" 2>/dev/null || printf '0')
  ssh_count=$(jq '[.machines[] | select(.type == "ssh")] | length' "$MACHINES_FILE" 2>/dev/null || printf '0')
  scanners=$(jq -r '[to_entries[]? | .value | objects | to_entries[] | select(.value != null) | .key] | unique | join(", ")' "$TOOLS_FILE" 2>/dev/null || true)
  [[ -n "$scanners" ]] || scanners="none detected"

  last_scan=""
  last_machine=""
  if [[ -d "$RESULTS_DIR" ]]; then
    local latest
    latest=$(find "$RESULTS_DIR" -type f -name '*.json' -printf '%T@\t%p\n' 2>/dev/null | sort -nr | head -n 1 | cut -f2- || true)
    if [[ -n "$latest" ]]; then
      last_scan=$(basename "$latest" | sed -E 's/^([0-9]{4}-[0-9]{2}-[0-9]{2}).*/\1/')
      last_machine=$(basename "$(dirname "$latest")")
    fi
  fi
  [[ -n "$last_scan" ]] || last_scan="none"

  echo "safe audit $SAFE_AUDIT_VERSION"
  echo "config: $CONFIG_DIR"
  echo "data:   $DATA_DIR"
  echo
  printf "machines:       %d (%d local, %d ssh)\n" "$machine_count" "$local_count" "$ssh_count"
  printf "scanners:       %s\n" "$scanners"
  if [[ -n "$last_machine" ]]; then
    printf "last scan:      %s (%s)\n" "$last_scan" "$last_machine"
  else
    printf "last scan:      %s\n" "$last_scan"
  fi
}

show_usage() {
  cat <<'EOF'
safe audit: multi-machine audit tooling

USAGE
  safe audit capabilities [--json]

  package-audit — one package, before it is installed
  safe audit package-audit <pkg>@<version> [--ecosystem <name>] [--json]

  repo-audit — one project tree on this machine
  safe audit repo-audit [<path>] [--verbose] [--deps-only | --full] [--no-cache] [--result-out <file>] [--allow-missing-tools]

  machine-audit — whole machine roots, local or across the fleet
  safe audit machine-audit [--verbose] [--deps-only | --full] [--no-cache] [--result-out <file>] [--allow-missing-tools] [--project <path>] [--all | --machine <csv>]

  binary-audit — distributed artifacts: assets, signatures, TUF roots, execution
  safe audit binary-audit release-review --spec PATH   (whole release from one spec; composite)

  safe audit scanner-batch   (stdin: {"packages":[{"name","version"},…]} — Bun scanner API backend)
  safe audit lockfile-support [--json]   (which lockfile formats the installed osv-scanner still reads)
  safe audit ioc <identifier> [--all | --machine <csv>]
  safe audit ioc --list <ioc.json> [--all | --machine <csv>]
  safe audit ioc --update [--since <duration>] [--all | --machine <csv>]
  safe audit setup [<machine> | --all | --machine <csv>] [--bundle <scanners.tar.gz|latest>]
  safe audit setup --create-bundle [<scanners.tar.gz>]
  safe audit diff [--all | --machine <csv>] [--since <duration>]
  safe audit status

FILES
  ~/.config/safe/audit/machines.json
  ~/.config/safe/audit/tools.json
  ~/.local/share/safe/audit/results/
  ~/.local/share/safe/audit/sbom/
  ~/.local/share/safe/audit/checks/
  ~/.local/share/safe/audit/ioc/
  ~/.local/share/safe/audit/tool-bundles/scanners.tar.gz
EOF
}

main() {
  # release-review is routed before ensure_dependencies and ensure_dirs
  # because its entire dependency surface is safe-core's: it needs no jq, no
  # config/data tree, and no TTY. Routing it with the others would let a
  # bash-side dependency refuse a review the engine could have run, and would
  # create audit state the composite never reads.
  if [[ "${1:-}" == "binary-audit" && "${2:-}" == "release-review" ]]; then
    shift 2
    release_review_forward "$@"
    return
  fi

  ensure_dependencies
  local cmd="${1:-}"
  case "$cmd" in
    capabilities)
      shift
      capabilities_command "$@"
      return 0
      ;;
    effective-sources)
      shift
      effective_sources_command "$@"
      return 0
      ;;
    # Read-only probe: doctor calls it, and doctor must not create the
    # config/data tree as a side effect of reporting on it.
    lockfile-support)
      shift
      lockfile_support_command "$@"
      return 0
      ;;
  esac
  if [[ "$SAFE_AUDIT_NO_INIT" != "1" ]]; then
    ensure_dirs
  fi
  case "$cmd" in
    package-audit) shift; package_audit_command "$@" ;;
    repo-audit) shift; repo_audit_command "$@" ;;
    machine-audit) shift; machine_audit_command "$@" ;;
    binary-audit) shift; binary_audit_command "$@" ;;
    scanner-batch) shift; scanner_batch_command "$@" ;;
    ioc) shift; ioc_command "$@" ;;
    setup) shift; setup_command "$@" ;;
    diff) shift; diff_command "$@" ;;
    status) shift; cmd_status "$@" ;;
    help|--help|-h|"") show_usage ;;
    --version|-v) printf 'safe audit %s\n' "$SAFE_AUDIT_VERSION" ;;
    *)
      die "unknown command: $cmd"
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  install_process_cleanup_traps
fi

main "$@"
