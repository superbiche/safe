#!/usr/bin/env bash
# safe audit: multi-machine audit orchestrator for dependency and SBOM scanning.

set -euo pipefail

SAFE_AUDIT_VERSION="0.3.0"
# safe-audit is installed as its own executable and is a documented
# compatibility entry point, so it cannot rely on inheriting SAFE_VERSION
# from the dispatcher: invoked directly there is no parent to inherit from,
# and a conditional pin silently does not apply (delta review F2). It knows
# its own release and only defers to an inherited value when one exists.
# Guarded against the VERSION file by tests/contract/drift.sh.
SAFE_VERSION="${SAFE_VERSION:-1.57.0}"
SAFE_AUDIT_NO_INIT="${SAFE_AUDIT_NO_INIT:-0}"
SAFE_AUDIT_VERBOSE="${SAFE_AUDIT_VERBOSE:-0}"
SAFE_AUDIT_SCAN_MODE="${SAFE_AUDIT_SCAN_MODE:-source}"

CONFIG_DIR="${SAFE_AUDIT_CONFIG_DIR:-${SAFE_CONFIG_DIR:-$HOME/.config/safe}/audit}"
DATA_DIR="${SAFE_AUDIT_DATA_DIR:-${SAFE_DATA_DIR:-$HOME/.local/share/safe}/audit}"
BIN_DIR="${SAFE_AUDIT_BIN_DIR:-$HOME/.local/bin}"
MACHINES_FILE="$CONFIG_DIR/machines.json"
TOOLS_FILE="$CONFIG_DIR/tools.json"

RESULTS_DIR="$DATA_DIR/results"
SBOM_DIR="$DATA_DIR/sbom"
SCAN_CACHE_DIR="$DATA_DIR/scan-cache"
# A dependency-evidence scan is deterministic in its inputs, so an unchanged
# lockfile set within the TTL may reuse the previous verdict.
SCAN_CACHE_TTL_SECONDS="${SAFE_AUDIT_SCAN_CACHE_TTL_SECONDS:-86400}"
# Bump whenever the shape or the semantics of a scan result change: entries
# written by an older safe compute their verdict under different rules, so
# they must miss rather than replay.
SCAN_CACHE_SCHEMA=1
CHECKS_DIR="$DATA_DIR/checks"
SOCKET_CACHE_SCHEMA=1
SOCKET_CACHE_STALE_SCORE=""
SOCKET_CACHE_STALE_AGE_DAYS=""
IOC_DIR="$DATA_DIR/ioc"
IOC_CATALOG_DIR="$IOC_DIR/catalogs"
TOOL_BUNDLE_DIR="$DATA_DIR/tool-bundles"
DEFAULT_SCANNER_BUNDLE_PATH="$TOOL_BUNDLE_DIR/scanners.tar.gz"
HOST_ALLOW_LOG="$DATA_DIR/host-allow-log.jsonl"
LAST_IOC_UPDATE="$DATA_DIR/last-ioc-update"

SAFE_RUN_CONFIG_DIR="${SAFE_RUN_CONFIG_DIR:-${SAFE_CONFIG_DIR:-$HOME/.config/safe}/run}"
SAFE_RUN_BLOCKED_FILE="$SAFE_RUN_CONFIG_DIR/blocked.json"
# Trust anchor (#87). This audit child is the shared install-gate boundary
# (every `safe`/gate-lib install lane calls `safe-audit … --gate install`), so
# the canonical-store rule that bin/safe-run enforces for the run lane must hold
# here too, or a forged host-allow / emptied blocklist under a redirected
# SAFE_RUN_CONFIG_DIR / SAFE_CONFIG_DIR would authorize a host install (F1) or
# hide a canonical block (F2). A redirected root carries GRANT authority only
# under SAFE_RUN_TRUST_OVERRIDE; without it host-allow grants are declined. The
# blocklist is different: it is a malice signal, so the canonical store is
# ALWAYS unioned in (blessed or not) — the token blesses grants, never the
# suppression of a block (F2). Reads use the LITERAL canonical path (not the
# env-derived one) so a symlink flip on the config root cannot swap the store
# between check and use (F3). Mirror of bin/safe-run; the two share no sourced
# root.
SAFE_RUN_CANONICAL_CONFIG_DIR="$HOME/.config/safe/run"
_trust_norm_path() { realpath -m -- "$1" 2>/dev/null || printf '%s' "$1"; }
trust_store_is_canonical() {
  [[ "$(_trust_norm_path "$SAFE_RUN_CONFIG_DIR")" \
     == "$(_trust_norm_path "$SAFE_RUN_CANONICAL_CONFIG_DIR")" ]]
}
# Echoes the authoritative path for a trust/policy file: the literal canonical
# path unless a redirected root is blessed by the token (then the raw path).
trust_store_file() {
  local base="$1"
  if [[ "${SAFE_RUN_TRUST_OVERRIDE:-0}" == "1" ]] && ! trust_store_is_canonical; then
    printf '%s/%s' "$SAFE_RUN_CONFIG_DIR" "$base"
  else
    printf '%s/%s' "$SAFE_RUN_CANONICAL_CONFIG_DIR" "$base"
  fi
}
# 0 = honor a trust GRANT (canonical or blessed); 1 = decline (fail-safe).
trust_grant_ok() {
  local ctx="$1"
  trust_store_is_canonical && return 0
  if [[ "${SAFE_RUN_TRUST_OVERRIDE:-0}" == "1" ]]; then
    warn "trust store at non-canonical root honored via SAFE_RUN_TRUST_OVERRIDE ($ctx)"
    return 0
  fi
  warn "trust store at non-canonical root ignored for $ctx grant (set SAFE_RUN_TRUST_OVERRIDE=1 to honor)"
  return 1
}

DEFAULT_SCAN_ROOT="${SAFE_AUDIT_DEFAULT_SCAN_ROOT:-$HOME}"
DEFAULT_LOCAL_MACHINE="${SAFE_AUDIT_LOCAL_MACHINE:-local}"
DEFAULT_REMOTE_ROOT="${SAFE_AUDIT_REMOTE_ROOT:-\$HOME}"
DEFAULT_CISA_KEV_URL="${SAFE_AUDIT_CISA_KEV_URL:-https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json}"
GRYPE_DB_MAX_AGE_DAYS="${SAFE_AUDIT_GRYPE_DB_MAX_AGE_DAYS:-7}"
SSH_CONNECT_TIMEOUT="${SAFE_AUDIT_SSH_CONNECT_TIMEOUT:-10}"
GITHUB_HIGH_RISK_PATH_REGEX="${SAFE_AUDIT_GITHUB_HIGH_RISK_PATH_REGEX:-(^|/)\\.github/workflows/|(^|/)(install|setup|bootstrap|release|publish|sign|cosign|checksum|goreleaser)([^/]*)(\\.[^/]+)?$|(^|/)(Dockerfile|Makefile|magefile\\.go)$}"

# Every lockfile name safe hands osv-scanner, after translation. A scanner
# upgrade that drops an extractor silently strips the OSV tier for every repo
# using that format, so this is probed rather than inferred from the version.
declare -ar SAFE_AUDIT_OSV_LOCKFILE_FORMATS=(
  package-lock.json
  npm-shrinkwrap.json
  pnpm-lock.yaml
  yarn.lock
  bun.lock
  uv.lock
  poetry.lock
  Pipfile.lock
  composer.lock
  Cargo.lock
  go.mod
  pom.xml
  gradle.lockfile
)

# The release-review composite's advertised contract: the spec_version
# safe-core accepts and the report schema_version it emits. A consumer
# preflights both before writing a spec, so they are advertised alongside the
# capability key rather than left to be discovered from a refusal. Guarded
# against safe-core's own `release-review --versions` by
# tests/audit/release_review_forward.sh.
RELEASE_REVIEW_SPEC_VERSION=3
RELEASE_REVIEW_REPORT_SCHEMA_VERSION=1

# binary-audit is the release-review composite: one spec-driven command that
# replaced the six granular sub-lanes (release/vuln/verify*/exec). Their
# capability keys were withdrawn when their commands were deleted.
declare -ar SAFE_AUDIT_CAPABILITY_NAMES=(
  package-audit
  repo-audit
  machine-audit
  binary-audit.release-review
  ioc.lookup
  ioc.list
  ioc.update
  setup.machine
  setup.create-bundle
  diff
  status
)

declare -a MACHINE_TARGETS=()
declare -A PROJECT_ECOSYSTEMS=()
declare -A PROJECT_SCANNERS=()
declare -a PROJECT_IGNORES=()
LAST_SCAN_RESULT_PATH=""
# Private, immutable copy of the document a scan just produced. The shared
# per-day result file can be overwritten by a concurrent scan at any instant,
# so every consumer that DECIDES on a result (cache store, --result-out)
# reads the snapshot instead.
LAST_SCAN_RESULT_SNAPSHOT=""
SCAN_RESULT_OUT=""
# Which evidence tiers came back degraded on the last scan. The result JSON has
# carried this in tool_status all along, but the surface's closing line said
# "finished" either way, so a lost tier read as a completed audit.
SCAN_DEGRADED_TIERS=""
declare -a CURRENT_LOCKFILES=()
declare -a CURRENT_MANIFESTS=()
declare -a CURRENT_PROJECT_ROOTS=()
declare -a CURRENT_SOURCE_FILES=()
declare -a CURRENT_SYFT_EXCLUDES=()

declare -ar DEFAULT_DERIVED_EXCLUDES=(
  .git
  .hg
  .svn
  node_modules
  vendor
  .venv
  venv
  env
  .tox
  .nox
  __pycache__
  .pytest_cache
  .mypy_cache
  .ruff_cache
  .cache
  .parcel-cache
  .turbo
  .next
  .nuxt
  .vite
  dist
  build
  out
  coverage
  target
)

err()  { printf '\033[31msafe audit:\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[33msafe audit:\033[0m %s\n' "$*" >&2; }
info() { printf '\033[36msafe audit:\033[0m %s\n' "$*" >&2; }
vinfo() {
  [[ "${SAFE_AUDIT_VERBOSE:-0}" == "1" ]] || return 0
  printf '\033[36msafe audit:\033[0m verbose: %s\n' "$*" >&2
}
die()  { err "$@"; exit 1; }

verbose_paths() {
  [[ "${SAFE_AUDIT_VERBOSE:-0}" == "1" ]] || return 0
  local label="$1"
  shift || true
  local total="$#" limit=20 count=0 path
  vinfo "$label: $total"
  for path in "$@"; do
    if (( count >= limit )); then
      vinfo "$label: ... $((total - limit)) more"
      break
    fi
    vinfo "$label: $(printf '%q' "$path")"
    ((count += 1))
  done
}

is_tty() { [[ -t 0 && -t 1 ]]; }
now_iso() { date -Iseconds; }
today_date() { date +%F; }

ssh_batch() {
  ssh -o BatchMode=yes -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" -o ConnectionAttempts=1 "$@"
}

scp_batch() {
  scp -o BatchMode=yes -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" -o ConnectionAttempts=1 "$@"
}

descendant_pids() {
  local parent="$1"
  ps -eo pid=,ppid= | awk -v root="$parent" '
    {
      pid=$1
      ppid=$2
      children[ppid] = children[ppid] " " pid
    }
    function walk(pid, list, n, i, child) {
      n = split(children[pid], list, " ")
      for (i = 1; i <= n; i++) {
        child = list[i]
        if (child == "") {
          continue
        }
        print child
        walk(child)
      }
    }
    END {
      walk(root)
    }
  '
}

terminate_descendants() {
  local pids
  pids=$(descendant_pids "$$" | sort -rn | tr '\n' ' ')
  [[ -n "$pids" ]] || return 0
  kill $pids 2>/dev/null || true
  sleep 0.2
  pids=$(descendant_pids "$$" | sort -rn | tr '\n' ' ')
  [[ -n "$pids" ]] || return 0
  kill -KILL $pids 2>/dev/null || true
}

# Every scratch directory this process created, so one cleanup can remove them
# all. Call sites used to rm their own, and seven scan paths simply did not —
# any early return, refusal or die() left the tree behind. The leak was
# unbounded rather than cosmetic: 1382 orphaned scan scratches accumulated on
# one workstation, scanner bundles among them at hundreds of megabytes each,
# until /tmp hit its quota and every suite failed at once.
SAFE_AUDIT_SCRATCH_DIRS=()

# Usage: new_scratch_dir <varname>. The path comes back through a named
# variable rather than stdout on purpose: `dir=$(new_scratch_dir)` would run
# the function in a command-substitution subshell, the registry append would
# die with it, and cleanup would silently do nothing — which is the failure
# mode this whole mechanism exists to prevent.
new_scratch_dir() {
  local __scratch_out_var="$1" __scratch_dir
  __scratch_dir=$(mktemp -d) || return 1
  SAFE_AUDIT_SCRATCH_DIRS+=("$__scratch_dir")
  printf -v "$__scratch_out_var" '%s' "$__scratch_dir"
}

remove_scratch_dirs() {
  local dir
  for dir in ${SAFE_AUDIT_SCRATCH_DIRS[@]+"${SAFE_AUDIT_SCRATCH_DIRS[@]}"}; do
    [[ -n "$dir" && -d "$dir" ]] || continue
    rm -rf "$dir"
  done
  SAFE_AUDIT_SCRATCH_DIRS=()
}

handle_interrupt() {
  trap - INT TERM EXIT
  warn "interrupted; stopping active child processes"
  terminate_descendants
  remove_scratch_dirs
  exit 130
}

handle_exit() {
  local rc=$?
  trap - EXIT
  terminate_descendants
  remove_scratch_dirs
  exit "$rc"
}

install_process_cleanup_traps() {
  trap handle_interrupt INT TERM
  trap handle_exit EXIT
}

read_prompt_answer() {
  local answer
  if answer=$({ IFS= read -r line && printf '%s' "$line"; } 2>/dev/null </dev/tty); then
    printf '%s' "$answer"
    return 0
  fi
  IFS= read -r answer
  printf '%s' "$answer"
}

json_string_or_null() {
  local v="${1:-}"
  if [[ -z "$v" ]]; then
    printf 'null'
  else
    jq -Rn --arg v "$v" '$v'
  fi
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

slugify() {
  local raw="$1"
  raw="${raw//@/_at_}"
  raw="${raw//\//_}"
  raw="${raw//:/_}"
  raw="${raw// /_}"
  printf '%s' "$raw"
}

urlencode() {
  jq -nr --arg v "$1" '$v|@uri'
}

first_line_summary() {
  local text="$1" limit="${2:-240}"
  printf '%s' "$text" | tr '\r\n' '  ' | tr -s ' ' | cut -c1-"$limit"
}

matches_high_risk_path() {
  [[ "$1" =~ $GITHUB_HIGH_RISK_PATH_REGEX ]]
}

ensure_dependencies() {
  command -v bash >/dev/null 2>&1 || die "missing dependency: bash"
  command -v jq >/dev/null 2>&1 || die "missing dependency: jq"
}

default_machines_json() {
  cat <<'JSON'
{
  "machines": {
    "local": { "type": "local" }
  }
}
JSON
}

seed_file_if_missing() {
  local path="$1" content="$2"
  [[ -e "$path" ]] && return 0
  printf '%s\n' "$content" > "$path"
}

# A file holding exactly one top-level JSON object. `jq -e 'type=="object"'`
# will NOT do: jq reads a STREAM of documents and bases -e on the last one, so
# it accepts `[]\n{}` and other multi-object streams. A two-object tools.json
# then makes `.[$m] = $entry` apply to every document and `tool_cache_path`
# emit two newline-joined paths, which fail the executable check — the exact
# scanner-missing symptom the cache guard exists to prevent. Slurp and assert a
# single object instead.
json_is_single_object() {
  jq -e -s 'length == 1 and (.[0] | type == "object")' "$1" >/dev/null 2>&1
}

# tools.json is a re-derivable cache of per-machine scanner paths; detection
# re-probes whatever it does not find, so overwriting a broken cache loses
# nothing. A file that is absent, empty (a truncated write), or not a single
# JSON object breaks every jq cache op — and `seed_file_if_missing` guarded only
# absence, so a 0-byte file (an interrupted `mv`) silently poisoned every audit
# into "all scanners missing" with no recovery but a hand-edit. Normalize the
# cache here, before any read or write, so a poisoned file self-heals on the
# next run. `json_is_single_object` rejects empty, garbage, non-object (`[]`)
# and multi-document streams alike, so one predicate covers every broken shape.
#
# The reset is a self-heal, not a repair-anything: a path that cannot be
# written at all — a directory sitting where the cache belongs, an unwritable
# config dir — is local audit-infrastructure breakage, and an unguarded
# redirect would fail it with a raw shell error under `set -e`. Say what broke
# and how to fix it, in the same wording class every other infrastructure
# failure uses, so it can never read as a scanner or package finding.
ensure_tools_file() {
  json_is_single_object "$TOOLS_FILE" && return 0
  # stderr is silenced BEFORE stdout is opened, and the order is the whole
  # point: bash applies redirections left to right, so `> "$FILE" 2>/dev/null`
  # lets the failed open write its own diagnostic to a still-live stderr, and
  # the refusal arrives as two lines. The contract is one final line.
  printf '%s\n' '{}' 2>/dev/null > "$TOOLS_FILE" || die_tool_cache_unusable
}

# One wording for both halves of "the scanner cache is not usable": a read that
# jq cannot answer, and a reset that cannot be written. Neither is a missing
# scanner, and neither may be reported as one.
die_tool_cache_unusable() {
  die "scanner cache unusable ($TOOLS_FILE) — audit-infrastructure breakage, not a package finding; repair or remove the file, then rerun"
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$DATA_DIR" "$RESULTS_DIR" "$SBOM_DIR" "$CHECKS_DIR" "$IOC_DIR" "$IOC_CATALOG_DIR" "$TOOL_BUNDLE_DIR"
  seed_file_if_missing "$MACHINES_FILE" "$(default_machines_json)"
  ensure_tools_file
  touch "$HOST_ALLOW_LOG"
}

capabilities_payload_json() {
  local capabilities_json
  capabilities_json=$(
    printf '%s\n' "${SAFE_AUDIT_CAPABILITY_NAMES[@]}" \
      | jq -Rn '[inputs | select(length > 0)] | reduce .[] as $name ({}; .[$name] = true)'
  )

  jq -n \
    --argjson capabilities "$capabilities_json" \
    --argjson release_review_spec_version "$RELEASE_REVIEW_SPEC_VERSION" \
    --argjson release_review_report_schema_version "$RELEASE_REVIEW_REPORT_SCHEMA_VERSION" \
    '{
      capabilities: $capabilities,
      versions: {
        "binary-audit.release-review": {
          spec_version: $release_review_spec_version,
          report_schema_version: $release_review_report_schema_version
        }
      },
      groups: {
        top_level: {
          "package-audit": $capabilities["package-audit"],
          "repo-audit": $capabilities["repo-audit"],
          "machine-audit": $capabilities["machine-audit"],
          diff: $capabilities.diff,
          status: $capabilities.status
        },
        "binary-audit": {
          "release-review": $capabilities["binary-audit.release-review"]
        },
        ioc: {
          lookup: $capabilities["ioc.lookup"],
          list: $capabilities["ioc.list"],
          update: $capabilities["ioc.update"]
        },
        setup: {
          machine: $capabilities["setup.machine"],
          "create-bundle": $capabilities["setup.create-bundle"]
        }
      }
    }'
}

capabilities_command_json() {
  local payload_json
  payload_json=$(capabilities_payload_json)

  jq -n \
    --arg command "safe audit capabilities" \
    --arg version "$SAFE_AUDIT_VERSION" \
    --argjson payload "$payload_json" \
    '{
      command: $command,
      version: $version,
      capabilities: $payload.capabilities,
      versions: $payload.versions,
      groups: $payload.groups
    }'
}

print_capabilities_human() {
  local payload_json
  payload_json=$(capabilities_payload_json)

  printf 'safe audit %s\n' "$SAFE_AUDIT_VERSION"
  printf 'command: safe audit capabilities\n\n'
  jq -r '
    .groups
    | to_entries[]
    | .key + ":",
      (.value | keys_unsorted[] | "  - " + .),
      ""
  ' <<<"$payload_json"
}

capabilities_command() {
  local json_mode=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json_mode=1
        shift
        ;;
      -*)
        die "unknown capabilities flag: $1"
        ;;
      *)
        die "unexpected argument for capabilities: $1"
        ;;
    esac
  done

  if [[ "$json_mode" == "1" ]]; then
    capabilities_command_json
  else
    print_capabilities_human
  fi
}

machine_is_configured() {
  jq -e --arg m "$1" '.machines[$m]' "$MACHINES_FILE" >/dev/null 2>&1
}

machine_type() {
  if machine_is_configured "$1"; then
    jq -r --arg m "$1" '.machines[$m].type // empty' "$MACHINES_FILE"
  else
    printf 'ssh'
  fi
}

machine_host() {
  if machine_is_configured "$1"; then
    jq -r --arg m "$1" '.machines[$m].host // empty' "$MACHINES_FILE"
  else
    printf '%s' "$1"
  fi
}

machine_scan_root() {
  local machine="$1" root
  root=$(jq -r --arg m "$machine" '.machines[$m].scan_root // empty' "$MACHINES_FILE" 2>/dev/null || true)
  if [[ -n "$root" ]]; then
    printf '%s' "$root"
  else
    printf '%s' "$DEFAULT_SCAN_ROOT"
  fi
}

detect_local_machine_name() {
  local local_machine
  local_machine=$(jq -r '.machines | to_entries[] | select(.value.type == "local") | .key' "$MACHINES_FILE" | head -n 1)
  if [[ -n "$local_machine" ]]; then
    printf '%s' "$local_machine"
  else
    printf '%s' "$DEFAULT_LOCAL_MACHINE"
  fi
}

parse_machine_targets() {
  local mode="${1:-default}"
  shift || true
  local explicit_all=0 explicit_csv=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        explicit_all=1
        shift
        ;;
      --machine)
        [[ $# -lt 2 ]] && die "--machine requires a comma-separated list"
        explicit_csv="$2"
        shift 2
        ;;
      *)
        break
        ;;
    esac
  done

  MACHINE_TARGETS=()
  if [[ "$explicit_all" == "1" ]]; then
    mapfile -t MACHINE_TARGETS < <(jq -r '.machines | keys_unsorted[]' "$MACHINES_FILE")
  elif [[ -n "$explicit_csv" ]]; then
    IFS=',' read -r -a MACHINE_TARGETS <<<"$explicit_csv"
  else
    MACHINE_TARGETS=("$(detect_local_machine_name)")
  fi

  if [[ "${#MACHINE_TARGETS[@]}" -eq 0 ]]; then
    die "no target machines resolved"
  fi

  local m
  for m in "${MACHINE_TARGETS[@]}"; do
    [[ "$(machine_type "$m")" == "local" || "$(machine_type "$m")" == "ssh" ]] || die "unknown machine: $m"
  done
}

run_machine_capture() {
  local machine="$1" cmd="$2"
  if [[ "$(machine_type "$machine")" == "local" ]]; then
    bash -lc "$cmd"
  else
    local host
    host=$(machine_host "$machine")
    ssh_batch "$host" "bash -lc $(printf '%q' "$cmd")"
  fi
}

run_machine_stream() {
  local machine="$1" cmd="$2"
  if [[ "$(machine_type "$machine")" == "local" ]]; then
    bash -lc "$cmd"
  else
    local host
    host=$(machine_host "$machine")
    ssh -t -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" -o ConnectionAttempts=1 "$host" "bash -lc $(printf '%q' "$cmd")"
  fi
}

machine_reachable() {
  local machine="$1"
  [[ "$(machine_type "$machine")" == "ssh" ]] || return 0
  local host
  host=$(machine_host "$machine")
  ssh_batch "$host" true >/dev/null 2>&1
}

tool_cache_entry() {
  jq -r --arg m "$1" '.[$m] // empty' "$TOOLS_FILE"
}

# Lenient read, for callers that have a fallback: `resolve_local_tool` probes
# PATH and the standard install directories either way, so an unreadable cache
# costs it nothing but a slower answer.
tool_cache_path() {
  jq -r --arg m "$1" --arg t "$2" '.[$m][$t] // empty' "$TOOLS_FILE" 2>/dev/null || true
}

# Strict read, for the callers that DECIDE from the answer. jq exiting nonzero
# ("the cache could not be read") and jq exiting zero with no output ("the tool
# is not in the cache") are opposite facts, and the lenient read above flattens
# both to the empty string. Downstream that made an unreadable cache — a
# truncated file mid-replace, a directory in its place — report as "missing
# required scanners", which is a policy refusal wearing the costume of a
# scanner finding. Propagate jq's status instead and let the caller separate
# breakage from absence.
tool_cache_path_checked() {
  jq -r --arg m "$1" --arg t "$2" '.[$m][$t] // empty' "$TOOLS_FILE" 2>/dev/null
}

# The directories a scanner is expected to live in on a machine safe manages.
#
# A caller's PATH is not the machine's PATH. Agents, CI steps, Makefiles and
# `bash -c` children routinely run with a trimmed PATH that resolves none of
# these — and a scanner that does not resolve is reported missing, which
# degrades the verdict to WARN. The failure is silent and it looks exactly
# like a real finding, so every local resolution and the detection probe
# itself go through this set rather than the caller's bare PATH.
TOOL_PROBE_DIRS=(
  "$HOME/.local/bin"
  "$HOME/.npm-global/bin"
  "$HOME/go/bin"
  "$HOME/.cargo/bin"
  "$HOME/.local/share/mise/shims"
)

# Appended, never prepended: PATH order is the caller's expressed preference,
# and a test harness, a mise shim or a project-local build that puts a scanner
# earlier must keep winning. These directories are the fallback for a PATH that
# resolves nothing, not an override of one that does.
tool_probe_path() {
  local IFS=':'
  printf '%s:%s' "$PATH" "${TOOL_PROBE_DIRS[*]}"
}

# Resolve a tool on the local machine, in order of what the answer means:
#
#   1. the caller's PATH — an explicit PATH is an expressed preference, and a
#      mise shim, a test mock or a project-local build must keep winning;
#   2. tools.json — the absolute path captured when the machine was detected.
#      This is the step that makes a trimmed PATH survivable: without it, an
#      agent or CI step whose PATH resolves no scanner gets "tool missing",
#      which degrades the verdict to WARN and reads exactly like a finding;
#   3. the standard install directories, for a tool added since detection.
resolve_local_tool() {
  local tool="$1" machine="${2:-}" found cached
  found="$(command -v "$tool" 2>/dev/null || true)"
  if [[ -n "$found" ]]; then
    printf '%s' "$found"
    return 0
  fi
  [[ -n "$machine" ]] || machine=$(detect_local_machine_name)
  cached=$(tool_cache_path "$machine" "$tool")
  if [[ -n "$cached" && -x "$cached" ]]; then
    printf '%s' "$cached"
    return 0
  fi
  PATH="$(tool_probe_path)" command -v "$tool" 2>/dev/null || printf ''
}

tool_cache_set() {
  local machine="$1"
  local entry_json="$2"
  local tmp
  # Normalize first: on a 0-byte cache jq reads zero documents, never runs the
  # filter, and writes an EMPTY file while exiting 0 — so a check on jq's exit
  # status passes on the exact input that poisons the cache, and the empty
  # output then clobbers tools.json for good. Validate the OUTPUT is an object
  # instead, and only then replace; a failure here is a real anomaly (a full
  # disk, a broken jq), so surface it rather than leave a half-written cache.
  #
  # The temp file is allocated BESIDE the cache, never in $TMPDIR. tools.json
  # lives on the config filesystem while $TMPDIR is routinely a tmpfs, and a
  # cross-device `mv` is not a rename: it is copy-then-unlink, so a concurrent
  # reader observes the destination truncated. Every gated build's repo-audit
  # preflight writes this file, so "concurrent" is the normal case, and the
  # torn read then travelled the whole way to a fail-closed gate refusal —
  # ensure_tools_file resetting the half-written file to `{}`, the cache read
  # coming back empty, and the scan refusing with "missing required scanners"
  # while both scanners sat installed. Same filesystem makes the `mv` a
  # rename(2): readers see the old file or the new one, never half of either.
  ensure_tools_file
  tmp=$(mktemp "$CONFIG_DIR/.tools.json.XXXXXX") || die_tool_cache_unusable
  if jq --arg m "$machine" --argjson entry "$entry_json" '.[$m] = $entry' "$TOOLS_FILE" > "$tmp" \
     && json_is_single_object "$tmp"; then
    mv "$tmp" "$TOOLS_FILE"
  else
    rm -f "$tmp"
    die "failed to update the scanner cache ($TOOLS_FILE)"
  fi
}

build_tool_entry_json() {
  local osv="${1:-}" grype="${2:-}" syft="${3:-}" govulncheck="${4:-}" cargo_audit="${5:-}" pip_audit="${6:-}" socket="${7:-}"
  printf '{'
  printf '"osv-scanner":%s,' "$(json_string_or_null "$osv")"
  printf '"grype":%s,' "$(json_string_or_null "$grype")"
  printf '"syft":%s,' "$(json_string_or_null "$syft")"
  printf '"govulncheck":%s,' "$(json_string_or_null "$govulncheck")"
  printf '"cargo-audit":%s,' "$(json_string_or_null "$cargo_audit")"
  printf '"pip-audit":%s,' "$(json_string_or_null "$pip_audit")"
  printf '"socket":%s' "$(json_string_or_null "$socket")"
  printf '}'
}

detect_machine_tools() {
  local machine="$1"
  local refresh="${2:-0}"

  if [[ "$refresh" != "1" ]] && jq -e --arg m "$machine" '.[$m]' "$TOOLS_FILE" >/dev/null 2>&1; then
    return 0
  fi

  # Probes the same directory set as tool_probe_path. Detection runs remotely
  # too, so the list is spelled out here rather than shared through the array —
  # keep the two in sync.
  local output
  output=$(run_machine_capture "$machine" '
PATH="$PATH:$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/go/bin:$HOME/.cargo/bin:$HOME/.local/share/mise/shims"
for t in osv-scanner grype syft govulncheck cargo-audit pip-audit socket; do
  if command -v "$t" >/dev/null 2>&1; then
    printf "%s\t%s\n" "$t" "$(command -v "$t")"
  else
    printf "%s\t\n" "$t"
  fi
done
')

  local osv="" grype="" syft="" govulncheck="" cargo_audit="" pip_audit="" socket=""
  local line tool path
  while IFS=$'\t' read -r tool path; do
    case "$tool" in
      osv-scanner) osv="$path" ;;
      grype) grype="$path" ;;
      syft) syft="$path" ;;
      govulncheck) govulncheck="$path" ;;
      cargo-audit) cargo_audit="$path" ;;
      pip-audit) pip_audit="$path" ;;
      socket) socket="$path" ;;
    esac
  done <<<"$output"

  # A detection that found nothing must not erase a path that still works.
  # Otherwise one probe from a trimmed environment — an agent, a CI step, a
  # `bash -c` child — rewrites the machine's cache to nulls, and every later
  # scan reports the scanners missing until someone refreshes by hand. Only
  # the local machine can be checked this way; a remote tool that stopped
  # resolving is genuinely gone as far as this host can tell.
  if [[ "$(machine_type "$machine")" == "local" ]]; then
    local kept
    for tool in osv-scanner grype syft govulncheck cargo-audit pip-audit socket; do
      case "$tool" in
        osv-scanner) [[ -n "$osv" ]] && continue ;;
        grype) [[ -n "$grype" ]] && continue ;;
        syft) [[ -n "$syft" ]] && continue ;;
        govulncheck) [[ -n "$govulncheck" ]] && continue ;;
        cargo-audit) [[ -n "$cargo_audit" ]] && continue ;;
        pip-audit) [[ -n "$pip_audit" ]] && continue ;;
        socket) [[ -n "$socket" ]] && continue ;;
      esac
      kept=$(tool_cache_path "$machine" "$tool")
      [[ -n "$kept" && -x "$kept" ]] || continue
      vinfo "$machine: detection missed $tool; keeping cached $(printf '%q' "$kept")"
      case "$tool" in
        osv-scanner) osv="$kept" ;;
        grype) grype="$kept" ;;
        syft) syft="$kept" ;;
        govulncheck) govulncheck="$kept" ;;
        cargo-audit) cargo_audit="$kept" ;;
        pip-audit) pip_audit="$kept" ;;
        socket) socket="$kept" ;;
      esac
    done
  fi

  local entry_json cached_json
  entry_json=$(build_tool_entry_json "$osv" "$grype" "$syft" "$govulncheck" "$cargo_audit" "$pip_audit" "$socket")

  # Detection refreshes unconditionally on every scan, so in the steady state
  # this rewrote a file it had just reproduced byte for byte. The replace is
  # atomic now, so a write is no longer a correctness problem — but a write
  # that changes nothing is still churn on a file the whole fleet reads, and
  # skipping it makes the steady state genuinely quiet. This does NOT mean
  # writes stop: a machine whose PATH resolves a scanner to a different path
  # than the cache holds differs on every scan, and writes on every scan.
  #
  # jq equality, not string equality: the cached entry is pretty-printed by
  # the jq that wrote it while build_tool_entry_json emits compact JSON, so
  # every comparison would differ on whitespace alone and the skip would never
  # fire. Compare the VALUES — key order and formatting immaterial.
  if cached_json=$(tool_cache_entry "$machine" 2>/dev/null) && [[ -n "$cached_json" ]] \
     && jq -n -e --argjson cached "$cached_json" --argjson fresh "$entry_json" \
          '$cached == $fresh' >/dev/null 2>&1; then
    vinfo "$machine: scanner cache already current; not rewriting $TOOLS_FILE"
    return 0
  fi

  tool_cache_set "$machine" "$entry_json"
}

machine_missing_core_tools() {
  machine_missing_tools_from_list "$1" osv-scanner grype syft
}

# Prints the tools this machine's cache does not name. Returns
# TOOL_CACHE_UNREADABLE_RC instead when the cache could not be READ at all —
# there is no missing-tool list to print in that case, only breakage to fix,
# and every caller must say so rather than name scanners. Callers guard the
# command substitution (`x=$(...) || rc=$?`) so `set -e` cannot turn the
# breakage into a silent exit.
TOOL_CACHE_UNREADABLE_RC=3

machine_missing_tools_from_list() {
  local machine="$1"
  shift
  local missing=()
  local tool path
  for tool in "$@"; do
    path=$(tool_cache_path_checked "$machine" "$tool") || return "$TOOL_CACHE_UNREADABLE_RC"
    if [[ -z "$path" ]]; then
      missing+=("$tool")
    fi
  done
  printf '%s\n' "${missing[*]:-}"
}

install_hint_for_tool() {
  case "$1" in
    osv-scanner) printf 'install OSV-Scanner from a verified release, or provide it through an audited scanner bundle' ;;
    syft) printf 'install Syft from a verified release, or provide it through an audited scanner bundle' ;;
    grype) printf 'install Grype from a verified release, or provide it through an audited scanner bundle' ;;
    npm) printf 'install Node.js/npm from your trusted package manager; npm audit is provided by npm' ;;
    composer) printf 'install Composer from your trusted package manager or a verified Composer release' ;;
    cargo-audit) printf 'install RustSec cargo-audit after verification, for example: cargo install cargo-audit' ;;
    govulncheck) printf 'install govulncheck after verification, for example: go install golang.org/x/vuln/cmd/govulncheck@latest' ;;
    pip-audit) printf 'install pip-audit after verification, for example: python -m pipx install pip-audit' ;;
    *) printf 'install %s from a trusted, verified source' "$1" ;;
  esac
}

warn_install_hints_for_tools() {
  local tool
  for tool in "$@"; do
    [[ -n "$tool" ]] || continue
    warn "  - $tool: $(install_hint_for_tool "$tool")"
  done
}

warn_missing_scan_tools() {
  local machine="$1"
  local missing rc=0
  missing=$(machine_missing_core_tools "$machine") || rc=$?
  (( rc == 0 )) || die_tool_cache_unusable
  [[ -z "$missing" ]] && return 0
  warn "$machine missing required scanners: $missing"
  warn "$machine: install scanners manually after verification, or use a local bundle with: safe audit setup $(printf '%q' "$machine") --bundle <scanners.tar.gz>"
  warn_install_hints_for_tools $missing
}

confirm_scan_with_missing_tools() {
  local machine="$1"
  local project_target="${2:-}"
  local missing rc=0
  # An unreadable cache is not an empty cache: reporting it as missing
  # scanners would refuse the scan on a policy signal for what is really
  # local breakage, and would send the operator installing scanners that are
  # already there. Refuse on the breakage, with the repair.
  missing=$(machine_missing_core_tools "$machine") || rc=$?
  (( rc == 0 )) || die_tool_cache_unusable
  [[ -z "$missing" ]] && return 0

  local setup_cmd scan_cmd
  setup_cmd="safe audit setup $(printf '%q' "$machine")"
  scan_cmd="safe audit machine-audit --machine $(printf '%q' "$machine")"
  if [[ -n "$project_target" ]]; then
    scan_cmd+=" --project $(printf '%q' "$project_target")"
  fi

  warn "$machine missing required scanners: $missing"
  warn "$machine: install scanners manually after verification, or install an audited local bundle:"
  warn_install_hints_for_tools $missing
  warn "  $setup_cmd --bundle <scanners.tar.gz>"
  warn "  $scan_cmd"
  if ! is_tty; then
    warn "$machine: skipping scan because required scanners are missing in non-TTY mode"
    return 2
  fi

  printf 'Proceed with partial audit on %s, or skip? [y/N] ' "$machine" >&2
  local answer
  answer=$(read_prompt_answer)
  case "$answer" in
    "") warn "$machine: scan skipped"; return 2 ;;
    y|Y|yes) return 0 ;;
    n|N|no) warn "$machine: scan skipped"; return 2 ;;
    *) warn "$machine: unknown choice, scan skipped"; return 2 ;;
  esac
}

relative_to() {
  local base="$1" path="$2"
  if command -v realpath >/dev/null 2>&1; then
    realpath --relative-to="$base" "$path"
  elif command -v readlink >/dev/null 2>&1; then
    local base_abs path_abs
    base_abs=$(readlink -f "$base")
    path_abs=$(readlink -f "$path")
    printf '%s\n' "${path_abs#"$base_abs"/}"
  else
    local base_abs path_abs
    base_abs=$(cd "$base" && pwd -P)
    path_abs=$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")
    printf '%s\n' "${path_abs#"$base_abs"/}"
  fi
}

path_abs() {
  local path="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath "$path"
  elif command -v readlink >/dev/null 2>&1; then
    readlink -f "$path"
  else
    (cd "$(dirname "$path")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$path")")
  fi
}

reset_project_config() {
  PROJECT_IGNORES=()
  PROJECT_ECOSYSTEMS=(
    [npm]=""
    [python]=""
    [php]=""
    [rust]=""
    [go]=""
  )
  PROJECT_SCANNERS=(
    [python]="pip-audit"
    [npm]="npm-audit"
    [php]="composer-audit"
    [rust]="cargo-audit"
    [go]="govulncheck"
  )
}

parse_project_config() {
  local config="${1:-}"
  reset_project_config
  [[ -z "$config" || ! -f "$config" ]] && return 0

  local section="" raw line key value
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    line="${raw%%#*}"
    line="$(trim "$line")"
    [[ -z "$line" ]] && continue
    case "$line" in
      ecosystems:) section="ecosystems"; continue ;;
      scanners:) section="scanners"; continue ;;
      ignore:) section="ignore"; continue ;;
    esac
    case "$section" in
      ecosystems)
        if [[ "$line" =~ ^([A-Za-z0-9_-]+):[[:space:]]*(true|false)$ ]]; then
          key="${BASH_REMATCH[1]}"
          value="${BASH_REMATCH[2]}"
          PROJECT_ECOSYSTEMS["$key"]="$value"
        fi
        ;;
      scanners)
        if [[ "$line" =~ ^([A-Za-z0-9_-]+):[[:space:]]*([A-Za-z0-9._-]+)$ ]]; then
          key="${BASH_REMATCH[1]}"
          value="${BASH_REMATCH[2]}"
          PROJECT_SCANNERS["$key"]="$value"
        fi
        ;;
      ignore)
        if [[ "$line" =~ ^-[[:space:]]*(.+)$ ]]; then
          PROJECT_IGNORES+=("${BASH_REMATCH[1]}")
        fi
        ;;
    esac
  done <"$config"
}

lockfile_ecosystem() {
  local file
  file=$(basename "$1")
  case "$file" in
    package-lock.json|npm-shrinkwrap.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb) echo "npm" ;;
    uv.lock|poetry.lock|Pipfile.lock) echo "python" ;;
    composer.lock) echo "php" ;;
    Cargo.lock) echo "rust" ;;
    go.sum) echo "go" ;;
    pom.xml|gradle.lockfile) echo "java" ;;
    *) echo "unknown" ;;
  esac
}

manifest_matches() {
  local base
  base=$(basename "$1")
  case "$base" in
    package.json|package-lock.json|npm-shrinkwrap.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb|uv.lock|poetry.lock|Pipfile.lock|pyproject.toml|requirements*.txt|composer.json|composer.lock|Cargo.toml|Cargo.lock|go.mod|go.sum|pom.xml|gradle.lockfile|build.gradle|build.gradle.kts|.safe-audit)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

lockfile_matches() {
  local base
  base=$(basename "$1")
  case "$base" in
    package-lock.json|npm-shrinkwrap.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb|uv.lock|poetry.lock|Pipfile.lock|composer.lock|Cargo.lock|go.sum|pom.xml|gradle.lockfile)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

project_root_manifest_matches() {
  local base
  base=$(basename "$1")
  case "$base" in
    .safe-audit|package.json|package-lock.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb|uv.lock|poetry.lock|Pipfile.lock|pyproject.toml|requirements*.txt|composer.json|composer.lock|Cargo.toml|Cargo.lock|go.mod|go.sum|pom.xml|gradle.lockfile|build.gradle|build.gradle.kts)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

source_file_matches() {
  local base ext
  base=$(basename "$1")
  manifest_matches "$1" && return 0
  case "$base" in
    Dockerfile|Containerfile|Makefile|GNUmakefile|Gemfile|Rakefile|Procfile|Brewfile|Justfile|Taskfile.yml|Taskfile.yaml|Jenkinsfile|Vagrantfile|.envrc|.npmrc|.yarnrc|.yarnrc.yml|.pypirc|.gitignore|.dockerignore|.editorconfig)
      return 0
      ;;
  esac
  ext="${base##*.}"
  case "$ext" in
    sh|bash|zsh|fish|ps1|psm1|bat|cmd|js|mjs|cjs|jsx|ts|tsx|mts|cts|py|pyw|rb|php|go|rs|java|kt|kts|scala|c|cc|cpp|cxx|h|hh|hpp|cs|swift|m|mm|lua|pl|pm|r|R|dart|ex|exs|erl|hrl|clj|cljs|fs|fsx|sql|graphql|gql|html|htm|css|scss|sass|less|json|jsonc|json5|yaml|yml|toml|ini|cfg|conf|properties|xml|lock|md|mdx|rst|txt)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

path_matches_patterns() {
  local rel="$1"
  shift || true
  local pattern
  for pattern in "$@"; do
    [[ -z "$pattern" ]] && continue
    if [[ "$rel" == $pattern || "$rel" == */$pattern || "$rel" == $pattern/* || "$rel" == */$pattern/* ]]; then
      return 0
    fi
  done
  return 1
}

path_matches_ignore() {
  local rel="$1"
  path_matches_patterns "$rel" "${PROJECT_IGNORES[@]}"
}

path_matches_default_exclude() {
  local rel="$1"
  path_matches_patterns "$rel" "${DEFAULT_DERIVED_EXCLUDES[@]}"
}

append_syft_excludes_for_config() {
  local source_abs="$1" config="$2"
  [[ -f "$config" ]] || return 0
  local root rel_prefix pattern
  root=$(dirname "$config")
  rel_prefix=$(relative_to "$source_abs" "$root")
  [[ "$rel_prefix" == "." ]] && rel_prefix=""
  [[ -n "$rel_prefix" ]] && rel_prefix="${rel_prefix%/}/"

  parse_project_config "$config"
  for pattern in "${PROJECT_IGNORES[@]}"; do
    [[ -z "$pattern" ]] && continue
    CURRENT_SYFT_EXCLUDES+=("${rel_prefix}${pattern}")
    CURRENT_SYFT_EXCLUDES+=("${rel_prefix}${pattern}/**")
  done
}

syft_exclude_args_for_current_scan() {
  local pattern
  for pattern in "${CURRENT_SYFT_EXCLUDES[@]}"; do
    printf '%s\0%s\0' '--exclude' "$pattern"
  done
}

find_source_files_pruned() {
  local source_abs="$1"
  local root_config="$source_abs/.safe-audit"
  local root_ignores=()
  root_ignores=("${DEFAULT_DERIVED_EXCLUDES[@]}")
  if [[ -f "$root_config" ]]; then
    parse_project_config "$root_config"
    root_ignores+=("${PROJECT_IGNORES[@]}")
  fi

  local find_args=("$source_abs")
  local pattern clean_pattern first=1
  if [[ "${#root_ignores[@]}" -gt 0 ]]; then
    find_args+=("(")
    for pattern in "${root_ignores[@]}"; do
      [[ -z "$pattern" ]] && continue
      clean_pattern="${pattern#./}"
      clean_pattern="${clean_pattern%/}"
      [[ "$first" == "1" ]] || find_args+=("-o")
      if [[ "$clean_pattern" == */* ]]; then
        find_args+=("-path" "$source_abs/$clean_pattern" "-o" "-path" "$source_abs/$clean_pattern/*")
      else
        find_args+=("-name" "$clean_pattern" "-o" "-path" "$source_abs/$clean_pattern" "-o" "-path" "$source_abs/$clean_pattern/*")
      fi
      first=0
    done
    if [[ "$first" == "0" ]]; then
      find_args+=(")" "-prune" "-o")
    else
      find_args=("$source_abs")
    fi
  fi

  find "${find_args[@]}" -type f -print0 2>/dev/null
}

nearest_project_config() {
  local start="$1" stop="$2"
  local dir="$start"
  while [[ "$dir" == "$stop"* || "$dir" == "$HOME"* ]]; do
    if [[ -f "$dir/.safe-audit" ]]; then
      printf '%s\n' "$dir/.safe-audit"
      return 0
    fi
    [[ "$dir" == "/" || "$dir" == "$HOME" || "$dir" == "$stop" ]] && break
    dir=$(dirname "$dir")
  done
  return 1
}

file_ignored_by_nearest_project_config() {
  local source_abs="$1" file="$2"
  local project_cfg root rel
  project_cfg=$(nearest_project_config "$(dirname "$file")" "$source_abs" || true)
  [[ -n "$project_cfg" ]] || return 1
  root=$(dirname "$project_cfg")
  parse_project_config "$project_cfg"
  rel=$(relative_to "$root" "$file")
  path_matches_ignore "$rel"
}

file_under_current_project_roots() {
  local file="$1" root
  for root in "${CURRENT_PROJECT_ROOTS[@]}"; do
    if [[ "$file" == "$root" || "$file" == "$root"/* ]]; then
      return 0
    fi
  done
  return 1
}

collect_current_source_files() {
  local source="$1" scan_mode="${2:-source}"
  local source_abs
  source_abs=$(path_abs "$source")
  CURRENT_SOURCE_FILES=()

  case "$scan_mode" in
    deps)
      CURRENT_SOURCE_FILES=("${CURRENT_MANIFESTS[@]}")
      ;;
    source)
      local file
      while IFS= read -r -d '' file; do
        file_under_current_project_roots "$file" || continue
        source_file_matches "$file" || continue
        if file_ignored_by_nearest_project_config "$source_abs" "$file"; then
          continue
        fi
        CURRENT_SOURCE_FILES+=("$file")
      done < <(find_source_files_pruned "$source_abs")
      ;;
    full)
      CURRENT_SOURCE_FILES=()
      ;;
    *)
      die "unknown scan mode: $scan_mode"
      ;;
  esac

  vinfo "source collection: mode=$scan_mode files=${#CURRENT_SOURCE_FILES[@]}"
  verbose_paths "source file" "${CURRENT_SOURCE_FILES[@]}"
}

gather_scan_stage_from_current_files() {
  local source="$1" stage="$2" scan_mode="${3:-source}"
  local source_abs
  source_abs=$(path_abs "$source")
  mkdir -p "$stage"
  collect_current_source_files "$source_abs" "$scan_mode"

  local file rel file_list
  file_list=$(mktemp)
  for file in "${CURRENT_SOURCE_FILES[@]}"; do
    [[ -f "$file" ]] || continue
    rel=$(relative_to "$source_abs" "$file")
    printf './%s\0' "$rel" >> "$file_list"
  done

  if [[ -s "$file_list" ]]; then
    (cd "$source_abs" && tar --null -T "$file_list" -czf - 2>/dev/null) | tar -xzf - -C "$stage" 2>/dev/null || true
  else
    warn "bounded $scan_mode scan found no project files under $source"
  fi
  rm -f "$file_list"
}

gather_stage_locally() {
  local source="$1" stage="$2" scan_mode="${3:-source}" allow_source_fallback="${4:-1}"
  mkdir -p "$stage"
  local source_abs
  source_abs=$(path_abs "$source")
  vinfo "local staging: source=$(printf '%q' "$source_abs") stage=$(printf '%q' "$stage") mode=$scan_mode"
  if ! gather_projects_from_source "$source_abs" "$allow_source_fallback"; then
    warn "bounded project discovery failed for $source; falling back to manifest staging"
    (
      cd "$source_abs"
      find_source_files_pruned "$source_abs" | while IFS= read -r -d '' f; do f="./$(relative_to "$source_abs" "$f")"; manifest_matches "$f" && printf '%s\0' "$f"; done | tar --null -T - -czf - 2>/dev/null
    ) | tar -xzf - -C "$stage" 2>/dev/null || true
    return 0
  fi

  gather_scan_stage_from_current_files "$source_abs" "$stage" "$scan_mode"
}

gather_stage_remotely() {
  local machine="$1" target="$2" stage="$3" scan_mode="${4:-source}" allow_source_fallback="${5:-1}"
  mkdir -p "$stage"
  local host
  host=$(machine_host "$machine")
  vinfo "$machine: remote staging target=$(printf '%q' "$target") stage=$(printf '%q' "$stage") host=$(printf '%q' "$host") mode=$scan_mode fallback=$allow_source_fallback"
  local rc=0
  local statuses=()
  set +e
  remote_stage_helper_script | ssh_batch "$host" "bash -s -- $(printf '%q' "$target") $(printf '%q' "$scan_mode") $(printf '%q' "$allow_source_fallback")" | tar -xzf - -C "$stage" 2>/dev/null
  statuses=("${PIPESTATUS[@]}")
  set -e
  local status
  for status in "${statuses[@]}"; do
    [[ "$status" -ge 130 ]] && return "$status"
  done
  for ((i=${#statuses[@]} - 1; i >= 0; i--)); do
    if [[ "${statuses[$i]}" -ne 0 ]]; then
      rc="${statuses[$i]}"
      break
    fi
  done
  if [[ "$rc" -ne 0 ]]; then
    warn "$machine: bounded remote staging failed; falling back to manifest staging"
    set +e
    ssh_batch "$host" "cd $(printf '%q' "$target") && find . -type f \( -name '.safe-audit' -o -name 'package.json' -o -name 'package-lock.json' -o -name 'pnpm-lock.yaml' -o -name 'yarn.lock' -o -name 'bun.lock' -o -name 'bun.lockb' -o -name 'uv.lock' -o -name 'poetry.lock' -o -name 'Pipfile.lock' -o -name 'pyproject.toml' -o -name 'composer.json' -o -name 'composer.lock' -o -name 'Cargo.toml' -o -name 'Cargo.lock' -o -name 'go.mod' -o -name 'go.sum' -o -name 'pom.xml' -o -name 'gradle.lockfile' -o -name 'build.gradle' -o -name 'build.gradle.kts' -o -name 'requirements.txt' -o -name 'requirements-dev.txt' -o -name 'requirements.lock' \) -print0 | tar --null -T - -czf - 2>/dev/null" \
      | tar -xzf - -C "$stage" 2>/dev/null
    statuses=("${PIPESTATUS[@]}")
    set -e
    for status in "${statuses[@]}"; do
      [[ "$status" -ge 130 ]] && return "$status"
    done
  fi
}

gather_projects_from_source() {
  local source="$1" allow_source_fallback="${2:-1}"
  local source_abs
  source_abs=$(path_abs "$source")
  vinfo "project discovery: source=$(printf '%q' "$source_abs") fallback=$allow_source_fallback"
  CURRENT_LOCKFILES=()
  CURRENT_MANIFESTS=()
  CURRENT_PROJECT_ROOTS=()
  CURRENT_SOURCE_FILES=()
  CURRENT_SYFT_EXCLUDES=()
  declare -A seen_roots=()

  add_discovered_root() {
    local root="$1"
    [[ -n "$root" ]] || return 0
    if [[ -z "${seen_roots[$root]:-}" ]]; then
      seen_roots["$root"]=1
      CURRENT_PROJECT_ROOTS+=("$root")
    fi
  }

  local cfg
  while IFS= read -r -d '' cfg; do
    append_syft_excludes_for_config "$source_abs" "$cfg"
  done < <(find_source_files_pruned "$source_abs" | while IFS= read -r -d '' f; do [[ "$(basename "$f")" == ".safe-audit" ]] && printf '%s\0' "$f"; done)

  local file rel project_cfg root
  while IFS= read -r -d '' file; do
    manifest_matches "$file" || continue
    project_cfg=$(nearest_project_config "$(dirname "$file")" "$source_abs" || true)
    if [[ -n "$project_cfg" ]]; then
      root=$(dirname "$project_cfg")
      parse_project_config "$project_cfg"
      rel=$(relative_to "$root" "$file")
      if path_matches_ignore "$rel"; then
        continue
      fi
    else
      root=$(dirname "$file")
      rel=$(relative_to "$source_abs" "$file")
    fi
    CURRENT_MANIFESTS+=("$file")
    if project_root_manifest_matches "$file"; then
      add_discovered_root "$root"
    fi
    if lockfile_matches "$file"; then
        CURRENT_LOCKFILES+=("$file")
    fi
  done < <(find_source_files_pruned "$source_abs")

  if [[ "${#CURRENT_PROJECT_ROOTS[@]}" -eq 0 && "$allow_source_fallback" == "1" ]]; then
    CURRENT_PROJECT_ROOTS=("$source_abs")
  fi

  vinfo "project discovery: manifests=${#CURRENT_MANIFESTS[@]} lockfiles=${#CURRENT_LOCKFILES[@]} project_roots=${#CURRENT_PROJECT_ROOTS[@]} syft_excludes=${#CURRENT_SYFT_EXCLUDES[@]}"
  verbose_paths "project root" "${CURRENT_PROJECT_ROOTS[@]}"
  verbose_paths "lockfile" "${CURRENT_LOCKFILES[@]}"
  verbose_paths "manifest" "${CURRENT_MANIFESTS[@]}"
  verbose_paths "syft exclude" "${CURRENT_SYFT_EXCLUDES[@]}"
}

ecosystem_enabled() {
  local ecosystem="$1"
  local v="${PROJECT_ECOSYSTEMS[$ecosystem]:-}"
  [[ -z "$v" || "$v" == "true" ]]
}

project_ecosystem_detected() {
  local root="$1" ecosystem="$2"
  case "$ecosystem" in
    npm)
      [[ -f "$root/package.json" || -f "$root/package-lock.json" || -f "$root/pnpm-lock.yaml" || -f "$root/yarn.lock" || -f "$root/bun.lock" || -f "$root/bun.lockb" ]]
      ;;
    python)
      [[ -f "$root/pyproject.toml" || -f "$root/requirements.txt" || -f "$root/requirements-dev.txt" || -f "$root/requirements.lock" || -f "$root/uv.lock" || -f "$root/poetry.lock" || -f "$root/Pipfile.lock" ]]
      ;;
    php)
      [[ -f "$root/composer.json" || -f "$root/composer.lock" ]]
      ;;
    rust)
      [[ -f "$root/Cargo.toml" || -f "$root/Cargo.lock" ]]
      ;;
    go)
      [[ -f "$root/go.mod" || -f "$root/go.sum" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

project_ecosystem_should_audit() {
  local root="$1" ecosystem="$2"
  local configured="${PROJECT_ECOSYSTEMS[$ecosystem]:-}"
  [[ "$configured" == "false" ]] && return 1
  [[ "$configured" == "true" ]] && return 0
  project_ecosystem_detected "$root" "$ecosystem"
}

audit_command_for_project_scanner() {
  local scanner="$1"
  case "$scanner" in
    npm-audit) printf 'npm' ;;
    composer-audit) printf 'composer' ;;
    *) printf '%s' "$scanner" ;;
  esac
}

project_audit_tool_available() {
  command -v "$1" >/dev/null 2>&1
}

required_project_audit_tools_for_current_projects() {
  local root ecosystem scanner command
  declare -A seen=()
  for root in "${CURRENT_PROJECT_ROOTS[@]}"; do
    parse_project_config "$root/.safe-audit"
    for ecosystem in npm python php rust go; do
      project_ecosystem_should_audit "$root" "$ecosystem" || continue
      scanner="${PROJECT_SCANNERS[$ecosystem]:-}"
      command=$(audit_command_for_project_scanner "$scanner")
      [[ -n "$command" ]] || continue
      if [[ -z "${seen[$command]:-}" ]]; then
        seen["$command"]=1
        printf '%s\n' "$command"
      fi
    done
  done
}

missing_project_audit_tools_for_current_projects() {
  local tool
  while IFS= read -r tool; do
    [[ -n "$tool" ]] || continue
    if ! project_audit_tool_available "$tool"; then
      printf '%s\n' "$tool"
    fi
  done < <(required_project_audit_tools_for_current_projects)
}

confirm_scan_with_missing_project_audit_tools() {
  local machine="$1"
  local project_target="${2:-}"
  local -a missing=()
  mapfile -t missing < <(missing_project_audit_tools_for_current_projects)
  [[ "${#missing[@]}" -eq 0 ]] && return 0

  # A caller that gates on the RESULT (safe install --project, the PATH
  # wrapper preflight) needs the document, not an abort: the missing tools
  # come back as skipped records, the verdict warns, and that caller's own
  # policy decides. Without this, a Rust or Go project on a machine without
  # cargo-audit could not be audited at all from a non-interactive shell.
  if [[ "${SAFE_AUDIT_ALLOW_MISSING_TOOLS:-0}" == "1" ]]; then
    warn "$machine: continuing without ${missing[*]}; their coverage is reported as not run"
    return 0
  fi

  local scan_cmd
  scan_cmd="safe audit machine-audit --machine $(printf '%q' "$machine")"
  if [[ -n "$project_target" ]]; then
    scan_cmd+=" --project $(printf '%q' "$project_target")"
  fi

  warn "$machine missing project audit tools for discovered ecosystems: ${missing[*]}"
  warn "$machine: without these tools, ecosystem CVE counts would be incomplete."
  warn "$machine: install missing tools manually after verification:"
  warn_install_hints_for_tools "${missing[@]}"
  warn "$machine: then rerun:"
  warn "  $scan_cmd"
  if ! is_tty; then
    warn "$machine: skipping scan because project audit tools are missing in non-TTY mode"
    return 2
  fi

  printf 'Proceed with incomplete ecosystem audit on %s, or skip? [y/N] ' "$machine" >&2
  local answer
  answer=$(read_prompt_answer)
  case "$answer" in
    "") warn "$machine: scan skipped"; return 2 ;;
    y|Y|yes) return 0 ;;
    n|N|no) warn "$machine: scan skipped"; return 2 ;;
    *) warn "$machine: unknown choice, scan skipped"; return 2 ;;
  esac
}

scanner_path_for_machine() {
  local machine="$1" tool="$2"
  [[ "$(machine_type "$machine")" == "local" ]] || return 0
  resolve_local_tool "$tool" "$machine"
}

local_scanner_path() {
  resolve_local_tool "$1"
}

osv_scan_output_valid() {
  local output="$1"
  jq -e 'type == "object" and ((.results? // null) | type == "array")' "$output" >/dev/null 2>&1
}

# osv-scanner exits nonzero with empty stdout when every lockfile it read held
# zero packages — a dependency-free project, which is clean, not a failure. It
# says so on stderr ("No package sources found"), the same positive signal
# osv_probe_format_support reads as a healthy extractor; a real crash (an
# unreadable format, a missing path) prints a different error and never this
# phrase. Keying on the phrase means a future osv reword degrades SAFELY to
# today's conservative "osv-scanner failed" — it can never suppress a real
# error, only miss this clean case. Without it a project with no dependencies
# reads as a degraded scan (WARN), indistinguishable from a real finding.
osv_stderr_zero_packages() {
  local stderr_file="$1"
  [[ -f "$stderr_file" ]] && grep -qF 'No package sources found' "$stderr_file"
}

# osv-scanner picks an extractor by filename, and a file it has no extractor
# for is fatal for the WHOLE batch: exit 127, empty stdout, every sibling it
# already extracted discarded with it. Two files discovery finds hit that —
# `go.sum` (the Go extractor reads go.mod) and `bun.lockb` (binary, no
# extractor) — so a single Go or bun repo silently cost the entire OSV tier,
# npm results included. Discovery still tracks both as dependency evidence;
# this translates that set into what the scanner can actually read.
#
# A file with no parseable stand-in is dropped, which is real coverage lost —
# the caller reports it rather than letting it pass as a clean scan.
osv_lockfile_stand_in() {
  local lf="$1" base dir
  base=$(basename "$lf")
  dir=$(dirname "$lf")
  case "$base" in
    go.sum)
      [[ -f "$dir/go.mod" ]] && printf '%s' "$dir/go.mod"
      ;;
    bun.lockb)
      [[ -f "$dir/bun.lock" ]] && printf '%s' "$dir/bun.lock"
      ;;
    *)
      printf '%s' "$lf"
      ;;
  esac
  return 0
}

# Emits the translated set, NUL-separated and deduplicated: a repo carrying
# both bun.lockb and bun.lock resolves to one path, not two.
osv_scannable_lockfiles() {
  local lf sub
  local -A seen=()
  for lf in "$@"; do
    sub=$(osv_lockfile_stand_in "$lf")
    [[ -n "$sub" ]] || continue
    [[ -z "${seen[$sub]:-}" ]] || continue
    seen["$sub"]=1
    printf '%s\0' "$sub"
  done
}

# A consumer-facing note must never carry a path. `bin/safe`'s install gate
# decides "scanner broken" — exit 100, which not even --yes may accept — from a
# free-form regex over this note, so a project living under `error-pages/` or
# `failover/` turned a coverage gap into a hard refusal. Labels come from the
# fixed vocabulary of lockfile NAMES; the paths stay in the warn line and the
# verbose log, where nothing decides policy from them.
osv_uncovered_labels() {
  local lf out=""
  local -a labels=()
  local -A seen=()
  for lf in "$@"; do
    [[ -n "$lf" ]] || continue
    lf=$(basename "$lf")
    [[ -z "${seen[$lf]:-}" ]] || continue
    seen["$lf"]=1
    labels+=("$lf")
  done
  for lf in ${labels[@]+"${labels[@]}"}; do
    [[ -z "$out" ]] || out+=", "
    out+="$lf"
  done
  printf '%s' "$out"
}

# Coverage that was lost but still reads as a completed scan is the failure
# mode this whole path exists to prevent: `partial` keeps the results that
# survived while marking the tier non-ok, which is what turns the verdict to
# WARN and puts the tier in the degraded-coverage disclosure.
osv_mark_partial() {
  local output="$1" note="$2" tmp
  tmp="$output.partial"
  if jq --arg note "$note" '. + {partial: $note}' "$output" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$output"
  else
    rm -f "$tmp"
  fi
}

# Which lockfiles the per-file rescan could not read. Reported through a
# global rather than annotated in place: the caller also knows about files
# dropped in translation, and two annotations meant the second silently
# replaced the first, hiding one of two simultaneous coverage losses.
declare -a OSV_RESCAN_FAILED=()

# A batch that dies on one file still holds good evidence for every other one,
# so rescan file by file and merge what survives rather than losing the tier.
# Returns 1 when nothing survived, leaving the caller's error path in charge.
osv_scan_lockfiles_individually() {
  local machine="$1" osv="$2" output="$3"
  shift 3
  OSV_RESCAN_FAILED=()
  local -a parts=()
  local lf part rc index=0
  for lf in "$@"; do
    part="$output.part.$index"
    index=$((index + 1))
    rc=0
    set +e
    "$osv" scan source --format json "--lockfile=$lf" > "$part" 2>"$part.stderr"
    rc=$?
    set -e
    if osv_scan_output_valid "$part"; then
      parts+=("$part")
    elif osv_stderr_zero_packages "$part.stderr"; then
      # A 0-package lockfile among the batch: it contributes no results but is
      # not a coverage loss, so it merges as an empty valid part rather than
      # being reported as a file the rescan could not read.
      printf '{"results":[]}\n' > "$part"
      parts+=("$part")
    else
      vinfo "$machine: osv-scanner rescan failed for $(printf '%q' "$lf") (exit $rc)"
      OSV_RESCAN_FAILED+=("$lf")
    fi
  done
  [[ "${#parts[@]}" -gt 0 ]] || return 1
  local merged="$output.merged"
  jq -s '{results: (map(.results // []) | add // [])}' "${parts[@]}" > "$merged" 2>/dev/null || { rm -f "$merged"; return 1; }
  mv "$merged" "$output"
  return 0
}

osv_scan_lockfiles() {
  local machine="$1" output="$2"
  shift 2
  local lockfiles=("$@")
  local osv
  osv=$(scanner_path_for_machine "$machine" "osv-scanner")
  if [[ -z "$osv" || "${#lockfiles[@]}" -eq 0 ]]; then
    if [[ -z "$osv" ]]; then
      vinfo "$machine: osv-scanner skipped: scanner unavailable"
      printf '{"results":[],"skipped":"osv-scanner unavailable","skip_reason":"scanner_unavailable"}\n' > "$output"
    else
      vinfo "$machine: osv-scanner skipped: no lockfiles discovered"
      printf '{"results":[],"skipped":"no lockfiles discovered","skip_reason":"no_lockfiles"}\n' > "$output"
    fi
    return 0
  fi

  local -a scannable=() dropped=()
  mapfile -d '' -t scannable < <(osv_scannable_lockfiles "${lockfiles[@]}")
  local lf
  for lf in "${lockfiles[@]}"; do
    [[ -n "$(osv_lockfile_stand_in "$lf")" ]] || dropped+=("$lf")
  done
  local dropped_list=""
  if [[ "${#dropped[@]}" -gt 0 ]]; then
    dropped_list=$(printf '%s, ' "${dropped[@]}" | sed 's/, $//')
  fi

  if [[ "${#scannable[@]}" -eq 0 ]]; then
    vinfo "$machine: osv-scanner skipped: no discovered lockfile is in a format the scanner reads ($dropped_list)"
    warn "osv-scanner has no reader for the discovered lockfiles ($dropped_list); dependency coverage for them is missing"
    jq -n --arg note "no osv-parseable lockfile among those discovered: $(osv_uncovered_labels "${dropped[@]}")" \
      '{results: [], skipped: $note, skip_reason: "no_parseable_lockfiles"}' > "$output"
    return 0
  fi

  local args=(scan source --format json)
  for lf in "${scannable[@]}"; do
    args+=("--lockfile=$lf")
  done
  vinfo "$machine: osv-scanner=$(printf '%q' "$osv") lockfiles=${#scannable[@]} dropped=${#dropped[@]} output=$(printf '%q' "$output")"

  local rc=0
  OSV_RESCAN_FAILED=()
  set +e
  "$osv" "${args[@]}" > "$output" 2>"$output.stderr"
  rc=$?
  set -e
  # Judge the OUTPUT, never the exit status. osv-scanner exits nonzero when it
  # FINDS something, so status alone cannot mean failure — and a wrapper or a
  # future release can exit ZERO having written nothing, which read as a clean
  # empty scan when validity was only checked inside the nonzero branch.
  if osv_scan_output_valid "$output"; then
    [[ "$rc" -eq 0 ]] || vinfo "$machine: osv-scanner exited $rc after producing valid JSON; keeping result"
  elif osv_stderr_zero_packages "$output.stderr"; then
    # Checked before the rescan: an all-zero-package batch fails the per-file
    # rescan too (each part is the same empty non-JSON), which would land it in
    # the failure branch below. A clean empty result, no error, no partial —
    # translation-dropped files are still annotated further down.
    vinfo "$machine: osv-scanner found 0 packages in the scanned lockfiles; clean empty result"
    printf '{"results":[]}\n' > "$output"
  elif [[ "${#scannable[@]}" -gt 1 ]] && osv_scan_lockfiles_individually "$machine" "$osv" "$output" "${scannable[@]}"; then
    vinfo "$machine: osv-scanner batch produced no usable JSON (exit $rc); recovered by scanning each lockfile on its own"
  else
    warn "osv-scanner failed; details: $output.stderr"
    warn "osv-scanner stderr: $(first_line_summary "$(cat "$output.stderr" 2>/dev/null || true)" 240)"
    printf '{"results":[],"error":"osv-scanner failed"}\n' > "$output"
    return 0
  fi

  # One annotation covering every kind of loss. A file dropped in translation
  # and a file the rescan could not read are the same fact to the operator —
  # dependencies nothing looked at — and annotating them separately meant the
  # second write replaced the first.
  local -a uncovered=()
  uncovered+=(${dropped[@]+"${dropped[@]}"})
  uncovered+=(${OSV_RESCAN_FAILED[@]+"${OSV_RESCAN_FAILED[@]}"})
  if [[ "${#uncovered[@]}" -gt 0 ]]; then
    warn "osv-scanner could not read $(printf '%s, ' "${uncovered[@]}" | sed 's/, $//'); those dependencies are not covered by this scan"
    osv_mark_partial "$output" "osv-scanner could not read: $(osv_uncovered_labels "${uncovered[@]}")"
  fi
}

# osv-scanner picks its extractor from the filename before reading a byte, so
# "does this scanner still read format X" is answerable offline against an
# empty file. Against empty content a healthy scanner says one of two things —
# it ran an extractor and disliked the content, or it extracted no packages;
# a missing extractor says so outright.
#
# Support is asserted from that POSITIVE evidence, never from the absence of
# the missing-extractor phrase. Classifying "no error I recognize" as support
# would make a crashing scanner, a permission failure, or a future wording
# change report every format healthy — the precise opposite of what this guard
# exists to catch. Anything unrecognized is `unknown`, which fails the check
# loudly instead of passing it silently.
osv_probe_format_support() {
  local osv="$1" path="$2" out rc=0
  set +e
  out=$("$osv" scan source --offline --format json "--lockfile=$path" 2>&1 >/dev/null)
  rc=$?
  set -e
  if grep -qF 'could not determine extractor' <<<"$out"; then
    printf 'unsupported'
  elif grep -qE 'extraction failed on specified lockfile|No package sources found' <<<"$out"; then
    printf 'supported'
  else
    printf 'unknown %s %s' "$rc" "$(first_line_summary "$out" 120)"
  fi
  return 0
}

# Usage: osv_lockfile_support_json <varname>. The payload comes back through a
# named variable for the same reason new_scratch_dir does: called as
# `x=$(osv_lockfile_support_json)` the probe's scratch registration would die
# with the command-substitution subshell and the cleanup trap would never see
# the directory — which is exactly how the first version leaked it.
osv_lockfile_support_json() {
  local __support_out_var="$1"
  local osv probe name version verdict
  osv=$(local_scanner_path osv-scanner)
  local formats_json
  formats_json=$(printf '%s\n' "${SAFE_AUDIT_OSV_LOCKFILE_FORMATS[@]}" | jq -Rn '[inputs | select(length > 0)]')
  if [[ -z "$osv" ]]; then
    printf -v "$__support_out_var" '%s' "$(jq -n --argjson formats "$formats_json" \
      '{scanner: null, version: null, ok: false, formats: $formats, unsupported: [], unknown: [], note: "osv-scanner unavailable"}')"
    return 0
  fi
  version=$("$osv" --version 2>/dev/null | head -n 1 || true)
  # The shared registry, not a bare mktemp: an interrupt during any of the
  # eleven probe invocations exits through the cleanup trap, which only knows
  # about directories registered here.
  new_scratch_dir probe
  local -a unsupported=() unknown=()
  local note=""
  for name in "${SAFE_AUDIT_OSV_LOCKFILE_FORMATS[@]}"; do
    : > "$probe/$name"
    verdict=$(osv_probe_format_support "$osv" "$probe/$name")
    case "$verdict" in
      supported) ;;
      unsupported) unsupported+=("$name") ;;
      *)
        unknown+=("$name")
        [[ -n "$note" ]] || note="$name: probe returned ${verdict#unknown }"
        ;;
    esac
    rm -f "$probe/$name"
  done
  local unsupported_json='[]' unknown_json='[]'
  if [[ "${#unsupported[@]}" -gt 0 ]]; then
    unsupported_json=$(printf '%s\n' "${unsupported[@]}" | jq -Rn '[inputs | select(length > 0)]')
  fi
  if [[ "${#unknown[@]}" -gt 0 ]]; then
    unknown_json=$(printf '%s\n' "${unknown[@]}" | jq -Rn '[inputs | select(length > 0)]')
  fi
  printf -v "$__support_out_var" '%s' "$(jq -n --arg scanner "$osv" --arg version "$version" --arg note "$note" \
    --argjson formats "$formats_json" --argjson unsupported "$unsupported_json" \
    --argjson unknown "$unknown_json" \
    '{scanner: $scanner,
      version: (if $version == "" then null else $version end),
      ok: (($unsupported | length) == 0 and ($unknown | length) == 0),
      formats: $formats,
      unsupported: $unsupported,
      unknown: $unknown,
      note: (if $note == "" then null else $note end)}')"
}

lockfile_support_command() {
  local json_mode=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_mode=1; shift ;;
      *) die "unknown lockfile-support flag: $1" ;;
    esac
  done
  local payload=""
  osv_lockfile_support_json payload
  if [[ "$json_mode" == "1" ]]; then
    printf '%s\n' "$payload"
    return 0
  fi
  jq -r '
    "osv-scanner: " + (.scanner // "unavailable"),
    "version: " + (.version // "unknown"),
    (if .ok then "all " + ((.formats | length) | tostring) + " lockfile formats readable"
     else
       ([(if ((.unsupported // []) | length) > 0 then "UNREADABLE: " + (.unsupported | join(", ")) else empty end),
         (if ((.unknown // []) | length) > 0 then "INCONCLUSIVE: " + (.unknown | join(", ")) else empty end),
         (if (.note // "") != "" then "note: " + .note else empty end)]
        | join("\n"))
     end)
  ' <<<"$payload"
  jq -e '.ok' <<<"$payload" >/dev/null 2>&1
}

syft_generate_sbom() {
  local machine="$1" source="$2" sbom_path="$3"
  local syft
  syft=$(scanner_path_for_machine "$machine" "syft")
  if [[ -z "$syft" ]]; then
    vinfo "$machine: syft skipped: scanner unavailable for source=$(printf '%q' "$source")"
    printf '{"components":[],"metadata":{"tools":[{"name":"safe-audit","note":"syft unavailable"}]}}\n' > "$sbom_path"
    return 0
  fi
  local exclude_args=()
  mapfile -d '' -t exclude_args < <(syft_exclude_args_for_current_scan)
  vinfo "$machine: syft=$(printf '%q' "$syft") source=$(printf '%q' "$source") excludes=$((${#exclude_args[@]} / 2)) output=$(printf '%q' "$sbom_path")"
  if ! "$syft" "dir:$source" -o cyclonedx-json "${exclude_args[@]}" > "$sbom_path" 2>"$sbom_path.stderr"; then
    warn "syft failed for $source; details: $sbom_path.stderr"
    printf '{"components":[],"metadata":{"tools":[{"name":"safe-audit","note":"syft failed"}]}}\n' > "$sbom_path"
  fi
}

grype_scan_sbom() {
  local machine="$1" sbom_path="$2" output="$3"
  local grype
  grype=$(scanner_path_for_machine "$machine" "grype")
  if [[ -z "$grype" ]]; then
    vinfo "$machine: grype skipped: scanner unavailable for sbom=$(printf '%q' "$sbom_path")"
    printf '{"matches":[],"skipped":"grype unavailable"}\n' > "$output"
    return 0
  fi
  vinfo "$machine: grype=$(printf '%q' "$grype") sbom=$(printf '%q' "$sbom_path") output=$(printf '%q' "$output")"
  if ! "$grype" "sbom:$sbom_path" -o json -q > "$output" 2>"$output.stderr"; then
    warn "grype failed for $sbom_path; details: $output.stderr"
    printf '{"matches":[],"error":"grype failed"}\n' > "$output"
  fi
}

grype_db_health_json() {
  local machine="$1" output="$2"
  local grype=""
  if [[ "$(machine_type "$machine")" == "local" ]]; then
    grype=$(scanner_path_for_machine "$machine" "grype")
  else
    grype=$(tool_cache_path "$machine" "grype")
  fi
  if [[ -z "$grype" ]]; then
    printf '{"healthy":false,"status":"unavailable","note":"grype unavailable"}\n' > "$output"
    return 0
  fi

  # Registered scratch, not a bare mktemp: the raw status and its captured
  # stderr are this function's own working files. Hanging the stderr off the
  # caller's $output also left a `.stderr` sibling beside the caller's file on
  # every call; inside a registered dir the process-exit trap reclaims both.
  local __scratch
  new_scratch_dir __scratch
  local raw="$__scratch/raw" stderr="$__scratch/stderr"
  local rc=0
  run_machine_capture "$machine" "$(printf '%q' "$grype") db status -o json -q" > "$raw" 2>"$stderr" || rc=$?

  if ! jq -e 'type == "object"' "$raw" >/dev/null 2>&1; then
    jq -n --arg note "grype db status failed" --arg stderr "$(cat "$stderr" 2>/dev/null || true)" --argjson rc "$rc" '
      {healthy:false,status:"error",note:$note,exit_code:$rc,stderr:$stderr}
    ' > "$output"
    return 0
  fi

  jq -n \
    --argjson max_age_days "$GRYPE_DB_MAX_AGE_DAYS" \
    --argjson exit_code "$rc" \
    --slurpfile status "$raw" '
    ($status[0] // {}) as $s |
    (
      if ($s.built // "") == "" then null
      else (($s.built | fromdateiso8601? // null) as $built | if $built == null then null else ((now - $built) / 86400) end)
      end
    ) as $age_days |
    ($s.valid == true) as $valid |
    ($age_days == null or $age_days <= $max_age_days) as $fresh |
    {
      healthy: ($valid and $fresh),
      status: (if ($valid and $fresh) then "ok" elif ($valid | not) then "invalid" else "stale" end),
      valid: $valid,
      age_days: $age_days,
      max_age_days: $max_age_days,
      built: ($s.built // null),
      path: ($s.path // null),
      schema_version: ($s.schemaVersion // null),
      error: ($s.error // null),
      exit_code: $exit_code
    }
  ' > "$output"
}

machine_grype_db_healthy() {
  local machine="$1"
  local health status detail __scratch
  new_scratch_dir __scratch
  health="$__scratch/health"
  grype_db_health_json "$machine" "$health"
  if jq -e '.healthy == true' "$health" >/dev/null 2>&1; then
    return 0
  fi
  status=$(jq -r '.status // "unknown"' "$health" 2>/dev/null || printf 'unknown')
  detail=$(jq -r '
    if .built then "built=" + .built
    elif .error then .error
    elif .note then .note
    else "no usable db metadata"
    end
  ' "$health" 2>/dev/null || printf 'no usable db metadata')
  warn "$machine: grype db health check failed ($status, $detail)"
  return 1
}

count_sbom_packages() {
  jq '[.components[]? | select(.type != "file")] | length' "$1" 2>/dev/null || echo 0
}

count_sbom_ecosystem() {
  local sbom="$1" kind="$2"
  jq --arg kind "$kind" '
    [.components[]? | select(.purl? and (.purl | startswith("pkg:" + $kind + "/")))] | length
  ' "$sbom" 2>/dev/null || echo 0
}

severity_from_osv_entry() {
  local raw
  raw=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$raw" in
    critical*) echo "critical" ;;
    high*) echo "high" ;;
    moderate*|medium*) echo "medium" ;;
    low*) echo "low" ;;
    *9.*|*10.*) echo "critical" ;;
    *7.*|*8.*) echo "high" ;;
    *4.*|*5.*|*6.*) echo "medium" ;;
    *0.*|*1.*|*2.*|*3.*) echo "low" ;;
    *) echo "unknown" ;;
  esac
}

summarize_osv_counts() {
  local osv_json="$1"
  jq -r '
    [.results[]?.packages[]?.vulnerabilities[]? |
      (.database_specific.severity // .severity[0].score // "unknown")
    ] | @tsv
  ' "$osv_json" 2>/dev/null | tr '\t' '\n' | sed '/^$/d' || true
}

count_grype_severity() {
  local grype_json="$1" severity="$2"
  jq --arg s "$severity" '[.matches[]? | select((.vulnerability.severity // "" | ascii_downcase) == ($s | ascii_downcase))] | length' "$grype_json" 2>/dev/null || echo 0
}

render_ecosystem_audit_json() {
  local scanner="$1" status="$2" total="$3" critical="$4" high="$5" medium="$6" low="$7" note="${8:-}" unknown="${9:-0}"
  printf '{'
  printf '"scanner":%s,' "$(json_string_or_null "$scanner")"
  printf '"status":%s,' "$(json_string_or_null "$status")"
  printf '"total":%s,' "$total"
  printf '"critical":%s,' "$critical"
  printf '"high":%s,' "$high"
  printf '"medium":%s,' "$medium"
  printf '"low":%s,' "$low"
  printf '"unknown":%s,' "$unknown"
  printf '"note":%s' "$(json_string_or_null "$note")"
  printf '}'
}

# --- ecosystem audit normalizers (shared local/remote; keep both copies identical) ---
# Each runner turns one scanner's native output into the same record. Three
# rules, all learned the hard way:
#   1. A scanner's EXIT STATUS is retained. These tools exit nonzero when they
#      find something AND when they break, so the shape of the output decides:
#      output we can read is a result, anything else is `status:"error"`.
#      "Ran, failed, reported zero findings" is the one answer that must never
#      be produced — it is indistinguishable from a clean project.
#   2. Counts are ADVISORIES, not dependencies. pip-audit lists every dependency
#      with its own `vulns` array, and composer keys advisories by package;
#      counting the outer container turns a clean project into findings.
#   3. A severity that cannot be determined is `unknown`, never `medium`.
#      Unknown severities warn; they never manufacture a severity band.
# shellcheck disable=SC2016
ECO_AUDIT_JQ_DEFS='
def sev_norm:
  (tostring | ascii_downcase)
  | if . == "critical" then "critical"
    elif . == "high" then "high"
    elif . == "moderate" or . == "medium" then "medium"
    elif . == "low" then "low"
    else "unknown" end;
def audit_doc($scanner; $sevs):
  {
    scanner: $scanner,
    status: "ok",
    total: ($sevs | length),
    critical: ([$sevs[] | select(. == "critical")] | length),
    high: ([$sevs[] | select(. == "high")] | length),
    medium: ([$sevs[] | select(. == "medium")] | length),
    low: ([$sevs[] | select(. == "low")] | length),
    unknown: ([$sevs[] | select(. == "unknown")] | length),
    note: null
  };
'

# ecosystem_audit_error <scanner> <exit-code> <stderr-file> <output>
# The note always contains "failed": consumers key their infrastructure
# refusal off the status, older readers off the note. A scanner that exited 0
# and whose OUTPUT is what we could not read says so — "failed (exit 0)"
# contradicts itself and reads as the scanner having broken when it had not.
ecosystem_audit_error() {
  local scanner="$1" rc="$2" stderr_file="$3" output="$4"
  local detail=""
  if [[ -r "$stderr_file" ]]; then
    detail="$(tr -d '\r' < "$stderr_file" | grep -v '^[[:space:]]*$' | tail -n 1)"
    detail="${detail:0:160}"
  fi
  local reason="${scanner} failed (exit ${rc})"
  if (( rc == 0 )); then
    reason="${scanner} output validation failed (scanner exit 0)"
  fi
  printf '%s\n' "$(render_ecosystem_audit_json "$scanner" "error" 0 0 0 0 0 \
    "${reason}${detail:+: ${detail}}" 0)" > "$output"
}

run_npm_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v npm >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "npm-audit" "skipped" 0 0 0 0 0 "npm unavailable" 0)" > "$output"
    return 0
  fi
  # `npm audit` reads an npm lockfile and nothing else. That is not a broken
  # scanner — it is evidence npm cannot read — but the two cases behind it are
  # very different:
  #   - a pnpm or Yarn lockfile: osv-scanner audits that lockfile, so the
  #     project IS covered. Deterministic, decided by files that are in the
  #     cache key: "unsupported", no verdict change, still cacheable.
  #   - no lockfile at all: nothing covers these dependencies. Reporting GO
  #     would mean "we looked at nothing and found nothing".
  if [[ ! -f "$dir/package-lock.json" && ! -f "$dir/npm-shrinkwrap.json" ]]; then
    if [[ -f "$dir/pnpm-lock.yaml" || -f "$dir/yarn.lock" ]]; then
      printf '%s\n' "$(render_ecosystem_audit_json "npm-audit" "unsupported" 0 0 0 0 0 "npm audit cannot read pnpm/yarn lockfiles; osv-scanner covers that evidence" 0)" > "$output"
    else
      printf '%s\n' "$(render_ecosystem_audit_json "npm-audit" "unsupported" 0 0 0 0 0 "no lockfile: these npm dependencies are not audited" 0)" > "$output"
    fi
    return 0
  fi
  local rc=0
  (cd "$dir" && npm audit --json) > "$output.raw" 2>"$output.stderr" || rc=$?
  # npm audit exits 1 when it finds something, so only the shape can tell a
  # result from a failure.
  if ! jq -e '(.metadata.vulnerabilities | type) == "object"' "$output.raw" >/dev/null 2>&1; then
    ecosystem_audit_error "npm-audit" "$rc" "$output.stderr" "$output"
    return 0
  fi
  jq "$ECO_AUDIT_JQ_DEFS"'
    (.metadata.vulnerabilities) as $v
    | ( [ range(0; $v.critical // 0) | "critical" ]
      + [ range(0; $v.high // 0)     | "high" ]
      + [ range(0; $v.moderate // 0) | "medium" ]
      + [ range(0; $v.low // 0)      | "low" ]
      + [ range(0; $v.info // 0)     | "unknown" ] ) as $sevs
    | audit_doc("npm-audit"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "npm-audit" "$rc" "$output.stderr" "$output"
}

run_composer_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v composer >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "composer-audit" "skipped" 0 0 0 0 0 "composer unavailable" 0)" > "$output"
    return 0
  fi
  local rc=0
  (cd "$dir" && composer audit --format=json) > "$output.raw" 2>"$output.stderr" || rc=$?
  # composer keys advisories BY PACKAGE: {"advisories":{"vendor/pkg":[...]}}.
  # Read as a flat array it finds nothing at all.
  if ! jq -e 'has("advisories")' "$output.raw" >/dev/null 2>&1; then
    ecosystem_audit_error "composer-audit" "$rc" "$output.stderr" "$output"
    return 0
  fi
  jq "$ECO_AUDIT_JQ_DEFS"'
    ( .advisories // {} ) as $a
    | [ if ($a | type) == "object" then ($a[] | .[]?) else ($a[]?) end ] as $adv
    | [ $adv[] | ((.severity // "unknown") | sev_norm) ] as $sevs
    | audit_doc("composer-audit"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "composer-audit" "$rc" "$output.stderr" "$output"
}

run_cargo_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v cargo-audit >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "cargo-audit" "skipped" 0 0 0 0 0 "cargo-audit unavailable" 0)" > "$output"
    return 0
  fi
  local rc=0
  (cd "$dir" && cargo audit --json) > "$output.raw" 2>"$output.stderr" || rc=$?
  if ! jq -e '(.vulnerabilities.list | type) == "array"' "$output.raw" >/dev/null 2>&1; then
    ecosystem_audit_error "cargo-audit" "$rc" "$output.stderr" "$output"
    return 0
  fi
  # RustSec advisories carry a CVSS vector far more often than a severity
  # word; scoring the vector is the only way most of them get a band at all.
  jq "$JQ_SEVERITY_DEFS$ECO_AUDIT_JQ_DEFS"'
    [ .vulnerabilities.list[]?
      | .advisory as $a
      | ( [ ($a.severity // empty | sev_norm) ]
        + [ ($a.cvss // empty | cvss3_band | sev_norm) ] ) as $cands
      | ( [ $cands[] | select(. != "unknown") ] + ["unknown"] )[0]
    ] as $sevs
    | audit_doc("cargo-audit"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "cargo-audit" "$rc" "$output.stderr" "$output"
}

run_govulncheck_dir() {
  local dir="$1" output="$2"
  if ! command -v govulncheck >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "govulncheck" "skipped" 0 0 0 0 0 "govulncheck unavailable" 0)" > "$output"
    return 0
  fi
  local rc=0
  (cd "$dir" && govulncheck -json ./...) > "$output.raw" 2>"$output.stderr" || rc=$?
  # In -json mode govulncheck reports findings IN the stream and exits 0; a
  # nonzero exit means the run itself failed (module loading, database), and
  # the stream it already wrote may be a complete-looking prefix.
  if (( rc != 0 )); then
    ecosystem_audit_error "govulncheck" "$rc" "$output.stderr" "$output"
    return 0
  fi
  # The stream is CONCATENATED JSON DOCUMENTS, pretty-printed across many lines
  # each — not NDJSON. `jq -s` slurps that shape natively (compact documents
  # too), and jq refusing the stream is the property to keep: a run that died
  # halfway leaves a truncated document, so "config record written, findings
  # lost" can never be read as a confident "zero findings". The stream must
  # also look like govulncheck: at least one record it actually emits.
  jq -s "$ECO_AUDIT_JQ_DEFS"'
    . as $docs
    | if ($docs | length) == 0 then error("empty govulncheck stream") else . end
    | if ([ $docs[] | select(type == "object")
            | select(has("config") or has("progress") or has("osv") or has("finding")) ] | length) == 0
      then error("stream is not govulncheck output") else . end
    | ( [ $docs[] | select(type == "object") | select(has("finding"))
          | (.finding.osv // "unknown") ] | unique ) as $ids
    | [ $ids[] | "unknown" ] as $sevs
    | audit_doc("govulncheck"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "govulncheck" "$rc" "$output.stderr" "$output"
}

run_pip_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v pip-audit >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "pip-audit" "skipped" 0 0 0 0 0 "pip-audit unavailable" 0)" > "$output"
    return 0
  fi

  # EVERY declared target is audited, not the first one found: a vulnerable
  # dependency that appears only in requirements-dev.txt was never submitted
  # when the loop stopped at requirements.txt. A bare `pip-audit -f json`
  # audits the ACTIVE PYTHON ENVIRONMENT rather than the project, so a
  # pyproject is audited by path.
  local -a invocations=()
  local candidate
  for candidate in requirements.txt requirements-dev.txt; do
    [[ -f "$dir/$candidate" ]] && invocations+=("-r|$dir/$candidate")
  done
  [[ -f "$dir/pyproject.toml" ]] && invocations+=("project|$dir")

  if [[ "${#invocations[@]}" -eq 0 ]]; then
    printf '%s\n' "$(render_ecosystem_audit_json "pip-audit" "skipped" 0 0 0 0 0 "no supported python audit target found" 0)" > "$output"
    return 0
  fi

  local rc=0 invocation kind value index=0 last_rc=0
  local -a parts=()
  local -a failed=()
  for invocation in "${invocations[@]}"; do
    kind="${invocation%%|*}"
    value="${invocation#*|}"
    index=$((index + 1))
    rc=0
    if [[ "$kind" == "-r" ]]; then
      pip-audit -r "$value" -f json > "$output.raw.$index" 2>"$output.stderr" || rc=$?
    else
      pip-audit -f json "$value" > "$output.raw.$index" 2>"$output.stderr" || rc=$?
    fi
    # Both shapes are valid pip-audit: a bare list of dependencies, or
    # {"dependencies":[...]}. Either way the advisories live in each
    # dependency's `vulns` — the outer length is a package count, and counting
    # it made every clean Python project a pile of medium findings.
    if jq -e 'type == "array" or ((.dependencies | type) == "array")' "$output.raw.$index" >/dev/null 2>&1; then
      parts+=("$output.raw.$index")
    else
      # One target failing must not erase what another target FOUND: a
      # critical from requirements.txt has to survive requirements-dev.txt
      # breaking, or a real finding disappears behind an unrelated failure.
      failed+=("$(basename -- "$value") (exit ${rc})")
      last_rc="$rc"
    fi
  done

  if [[ "${#parts[@]}" -eq 0 ]]; then
    ecosystem_audit_error "pip-audit" "$last_rc" "$output.stderr" "$output"
    return 0
  fi

  # Advisories are merged across targets and deduplicated by package+id: the
  # same dependency pinned in two requirements files is one advisory. If some
  # target failed, the counts are real but incomplete: "partial" keeps them
  # counted while still telling every consumer that coverage is missing.
  local partial_note=""
  local audit_status="ok"
  if [[ "${#failed[@]}" -gt 0 ]]; then
    audit_status="partial"
    partial_note="pip-audit failed for: ${failed[*]}"
  fi
  jq -s --arg status "$audit_status" --arg note "$partial_note" "$ECO_AUDIT_JQ_DEFS"'
    [ .[]
      | (if type == "array" then . else (.dependencies // []) end)
      | .[]?
      | . as $dep
      | (.vulns // [])[]?
      | { key: (($dep.name // "?") + "@" + ($dep.version // "?") + "/" + (.id // "?")),
          severity: ((.severity // "unknown") | sev_norm) }
    ] as $all
    | ( $all | group_by(.key) | map(.[0].severity) ) as $sevs
    | audit_doc("pip-audit"; $sevs)
    | .status = $status
    | .note = (if $note == "" then null else $note end)
  ' "${parts[@]}" > "$output" 2>/dev/null || ecosystem_audit_error "pip-audit" "$last_rc" "$output.stderr" "$output"
}
# --- end ecosystem audit normalizers ---

run_project_ecosystem_audits() {
  local project_root="$1" output_dir="$2"
  mkdir -p "$output_dir"
  local audits=()
  local ecosystem scanner output
  parse_project_config "$project_root/.safe-audit"

  for ecosystem in npm python php rust go; do
    if ! project_ecosystem_should_audit "$project_root" "$ecosystem"; then
      continue
    fi
    scanner="${PROJECT_SCANNERS[$ecosystem]}"
    output="$output_dir/${ecosystem}.json"
    case "$scanner" in
      npm-audit) run_npm_audit_dir "$project_root" "$output" ;;
      pip-audit) run_pip_audit_dir "$project_root" "$output" ;;
      composer-audit) run_composer_audit_dir "$project_root" "$output" ;;
      cargo-audit) run_cargo_audit_dir "$project_root" "$output" ;;
      govulncheck) run_govulncheck_dir "$project_root" "$output" ;;
      *)
        printf '%s\n' "$(render_ecosystem_audit_json "$scanner" "error" 0 0 0 0 0 "unknown scanner ${scanner}: audit configuration failed" 0)" > "$output"
        ;;
    esac
    audits+=("$output")
  done

  if [[ "${#audits[@]}" -eq 0 ]]; then
    printf '[]\n'
    return 0
  fi
  jq -s '.' "${audits[@]}"
}

write_empty_source_scan() {
  local output="$1" status="${2:-skipped}" note="${3:-}"
  jq -n \
    --arg status "$status" \
    --arg note "$note" \
    '{status:$status,note:(if $note == "" then null else $note end),scanned_files:0,total:0,findings:[]}' > "$output"
}

source_scan_rule() {
  local source="$1" findings_file="$2" rule="$3" severity="$4" summary="$5" regex="$6"
  local file line_no text rel
  while IFS= read -r -d '' file; do
    while IFS=: read -r line_no text; do
      [[ -n "$line_no" && "$line_no" =~ ^[0-9]+$ ]] || continue
      rel=$(relative_to "$source" "$file")
      jq -n \
        --arg rule "$rule" \
        --arg severity "$severity" \
        --arg summary "$summary" \
        --arg file "$rel" \
        --argjson line "$line_no" \
        --arg text "$(first_line_summary "$text" 180)" \
        '{rule:$rule,severity:$severity,summary:$summary,file:$file,line:$line,text:$text}' >> "$findings_file"
    done < <(LC_ALL=C grep -I -nE -- "$regex" "$file" 2>/dev/null || true)
  done < <(find "$source" -type f -print0 2>/dev/null)
}

run_source_risk_scan() {
  local source="$1" output="$2" scan_mode="${3:-source}"
  if [[ "$scan_mode" == "deps" ]]; then
    write_empty_source_scan "$output" "skipped" "source scan disabled in deps-only mode"
    return 0
  fi
  if [[ ! -d "$source" ]]; then
    write_empty_source_scan "$output" "skipped" "source directory unavailable"
    return 0
  fi

  local findings_file findings_json scanned_files
  findings_file=$(mktemp)
  : > "$findings_file"
  scanned_files=$(find "$source" -type f 2>/dev/null | wc -l | tr -d '[:space:]')

  source_scan_rule "$source" "$findings_file" "remote_download_to_shell" "WARN" "remote download piped or chained to an interpreter" \
    '(curl|wget)[^|;]*(https?|ftp)://[^|;]*(\||;[[:space:]]*)[[:space:]]*(sudo[[:space:]]+)?(sh|bash|zsh|python|node|perl|ruby)'
  source_scan_rule "$source" "$findings_file" "remote_shell_exec" "WARN" "shell execution fetches a remote payload" \
    '(sh|bash|zsh)[[:space:]]+-c[^#]*(curl|wget)[^#]*(https?|ftp)://'
  source_scan_rule "$source" "$findings_file" "node_remote_exec" "WARN" "Node child_process call references a remote payload" \
    'child_process\.(exec|execSync|spawn|spawnSync)[^#]*(curl|wget|https?://)'
  source_scan_rule "$source" "$findings_file" "dynamic_eval_loader" "WARN" "dynamic evaluation references loader primitives" \
    '(eval|new[[:space:]]+Function)[[:space:]]*\([^#]*(fetch|axios|atob|Buffer\.from)'
  source_scan_rule "$source" "$findings_file" "credential_network_use" "WARN" "credential-like environment variable appears near network code" \
    '((GITHUB_TOKEN|NPM_TOKEN|OPENAI_API_KEY|ANTHROPIC_API_KEY|AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|SSH_AUTH_SOCK)[^#]*(fetch|axios|curl|wget|https?://))|((fetch|axios|curl|wget|https?://)[^#]*(GITHUB_TOKEN|NPM_TOKEN|OPENAI_API_KEY|ANTHROPIC_API_KEY|AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|SSH_AUTH_SOCK))'

  if [[ -s "$findings_file" ]]; then
    findings_json=$(jq -s 'unique_by(.rule + ":" + .file + ":" + (.line|tostring))' "$findings_file")
  else
    findings_json='[]'
  fi

  jq -n \
    --argjson scanned_files "$scanned_files" \
    --argjson findings "$findings_json" \
    '{status:"ok",note:null,scanned_files:$scanned_files,total:($findings | length),findings:$findings}' > "$output"
  rm -f "$findings_file"
}

latest_previous_result() {
  local machine="$1" current="$2"
  find "$RESULTS_DIR/$machine" -maxdepth 1 -type f -name '*-scan.json' ! -path "$current" 2>/dev/null | sort | tail -n 1 || true
}

latest_previous_sbom() {
  local machine="$1" current="$2"
  find "$SBOM_DIR/$machine" -maxdepth 1 -type f -name '*-sbom.cdx.json' ! -path "$current" 2>/dev/null | sort | tail -n 1 || true
}

scan_result_path_for() {
  local machine="$1" stamp="$2"
  printf '%s/%s/%s-scan.json' "$RESULTS_DIR" "$machine" "$stamp"
}

scan_sbom_path_for() {
  local machine="$1" stamp="$2"
  printf '%s/%s/%s-sbom.cdx.json' "$SBOM_DIR" "$machine" "$stamp"
}

epoch_from_since_spec() {
  local spec="$1"
  case "$spec" in
    *[!0-9smhdw-]*)
      date -d "$spec" +%s 2>/dev/null || return 1
      ;;
    [0-9]*s)
      date -d "${spec%s} seconds ago" +%s 2>/dev/null || return 1
      ;;
    [0-9]*m)
      date -d "${spec%m} minutes ago" +%s 2>/dev/null || return 1
      ;;
    [0-9]*h)
      date -d "${spec%h} hours ago" +%s 2>/dev/null || return 1
      ;;
    [0-9]*d)
      date -d "${spec%d} days ago" +%s 2>/dev/null || return 1
      ;;
    [0-9]*w)
      date -d "$(( ${spec%w} * 7 )) days ago" +%s 2>/dev/null || return 1
      ;;
    *)
      date -d "$spec" +%s 2>/dev/null || return 1
      ;;
  esac
}

file_epoch() {
  stat -c %Y "$1"
}

select_previous_sbom() {
  local machine="$1" latest="$2" since="${3:-}"
  if [[ -z "$since" ]]; then
    find "$SBOM_DIR/$machine" -maxdepth 1 -type f -name '*-sbom.cdx.json' ! -path "$latest" 2>/dev/null | sort | tail -n 1 || true
    return 0
  fi

  local cutoff
  cutoff=$(epoch_from_since_spec "$since") || die "unsupported --since value: $since"
  local candidate="" file epoch
  while IFS= read -r file; do
    [[ -z "$file" || "$file" == "$latest" ]] && continue
    epoch=$(file_epoch "$file")
    if (( epoch <= cutoff )); then
      candidate="$file"
    fi
  done < <(find "$SBOM_DIR/$machine" -maxdepth 1 -type f -name '*-sbom.cdx.json' 2>/dev/null | sort)
  printf '%s' "$candidate"
}

build_delta_json() {
  # $2 is the path the finished result WILL occupy (excluded when looking for
  # the previous scan); $4 (default $2) is where its content is read from,
  # which during a build is the private in-progress document.
  local machine="$1" result_path="$2" sbom_path="$3" current_doc="${4:-$2}" current_sbom="${5:-$3}"
  local previous_result previous_sbom
  previous_result=$(latest_previous_result "$machine" "$result_path")
  previous_sbom=$(latest_previous_sbom "$machine" "$sbom_path")
  if [[ -z "$previous_result" || -z "$previous_sbom" ]]; then
    printf '{"previous_scan":null,"packages_added":0,"packages_removed":0,"new_cves":[]}\n'
    return 0
  fi

  local added removed new_cves previous_scan
  added=$(jq -n --slurpfile prev "$previous_sbom" --slurpfile cur "$current_sbom" '
    ([($cur[0].components[]? | "\(.name)@\(.version // "unknown")")] - [($prev[0].components[]? | "\(.name)@\(.version // "unknown")")]) | length
  ')
  removed=$(jq -n --slurpfile prev "$previous_sbom" --slurpfile cur "$current_sbom" '
    ([($prev[0].components[]? | "\(.name)@\(.version // "unknown")")] - [($cur[0].components[]? | "\(.name)@\(.version // "unknown")")]) | length
  ')
  previous_scan=$(jq -r '.date // .timestamp // empty' "$previous_result" 2>/dev/null || true)
  [[ -z "$previous_scan" ]] && previous_scan=$(basename "$previous_result" | sed 's/-scan\.json$//')
  new_cves=$(jq -n --slurpfile prev "$previous_result" --slurpfile cur "$current_doc" '
    ([ $cur[0].cve_scan.findings[]?.id ] - [ $prev[0].cve_scan.findings[]?.id ]) | unique
  ')

  jq -n \
    --arg previous_scan "$previous_scan" \
    --argjson added "$added" \
    --argjson removed "$removed" \
    --argjson new_cves "$new_cves" \
    '{
      previous_scan: ($previous_scan | select(length > 0) // null),
      packages_added: $added,
      packages_removed: $removed,
      new_cves: $new_cves
    }'
}

render_scan_summary() {
  # $1 is read for the numbers; $2 (default $1) is the path shown to a human.
  # They differ while a scan renders its private snapshot but points the reader
  # at the published per-day result file.
  local result_path="$1"
  local display_path="${2:-$1}"
  local machine
  machine=$(jq -r '.machine' "$result_path")
  printf '=== SAFE-AUDIT SCAN - %s - %s ===\n\n' \
    "$machine" "$(jq -r '.date' "$result_path")"
  printf 'Mode: %s (%s)\n' \
    "$(jq -r '.scan_mode // "source"' "$result_path")" \
    "$(jq -r '.strategy' "$result_path")"
  printf 'SBOM: %s packages cataloged (npm: %s, python: %s, go: %s, php: %s, rust: %s)\n\n' \
    "$(jq -r '.summary.packages_total' "$result_path")" \
    "$(jq -r '.summary.ecosystems.npm' "$result_path")" \
    "$(jq -r '.summary.ecosystems.python' "$result_path")" \
    "$(jq -r '.summary.ecosystems.go' "$result_path")" \
    "$(jq -r '.summary.ecosystems.php' "$result_path")" \
    "$(jq -r '.summary.ecosystems.rust' "$result_path")"
  printf 'CVE SCAN (osv-scanner + grype):\n'
  printf '  CRITICAL: %s\n' "$(jq -r '.cve_scan.critical' "$result_path")"
  printf '  HIGH: %s\n' "$(jq -r '.cve_scan.high' "$result_path")"
  printf '  MEDIUM: %s\n' "$(jq -r '.cve_scan.medium' "$result_path")"
  printf '  LOW: %s\n' "$(jq -r '.cve_scan.low' "$result_path")"
  # Ecosystem audits report their own advisories; without this line a
  # govulncheck or cargo-audit finding appears in the totals and the verdict
  # while every printed bucket reads zero.
  local eco_summary
  eco_summary="$(jq -r '
    [ .audit_totals.ecosystem[]?
      | select((.total // 0) > 0)
      | .scanner + " " + (.total | tostring)
        + " (critical " + ((.critical // 0) | tostring)
        + ", high " + ((.high // 0) | tostring)
        + ", medium " + ((.medium // 0) | tostring)
        + ", low " + ((.low // 0) | tostring)
        + ", unknown " + ((.unknown // 0) | tostring) + ")"
    ] | join("; ")
  ' "$result_path" 2>/dev/null || printf '')"
  [[ -n "$eco_summary" ]] && printf '  ECOSYSTEM AUDITS: %s\n' "$eco_summary"
  printf '\n'
  jq -r '
    .tool_status // {} |
    to_entries[]? |
    select((.value.status // "ok") != "ok") |
    "  \(.key): \(.value.status)" + (if (.value.note // "") != "" then " (" + .value.note + ")" else "" end)
  ' "$result_path"
  if jq -e '(.tool_status // {} | to_entries | map(select((.value.status // "ok") != "ok")) | length) > 0' "$result_path" >/dev/null; then
    printf '\n'
  fi
  printf 'ECOSYSTEM AUDITS:\n'
  jq -r '
    .ecosystem_audits[]? |
    if (.status // "ok") == "ok" then
      "  \(.scanner): \(.total) advisories (\(.critical) critical, \(.high) high, \(.medium) medium, \(.low) low)"
    else
      "  \(.scanner): \(.status // "skipped")" + (if (.note // "") != "" then " (" + .note + ")" else "" end)
    end
  ' "$result_path"
  printf '\nSOURCE SCAN:\n'
  printf '  %s files scanned; %s suspicious patterns\n' \
    "$(jq -r '.source_scan.scanned_files // 0' "$result_path")" \
    "$(jq -r '.source_scan.total // 0' "$result_path")"
  jq -r '
    .source_scan.findings[:5][]? |
    "  - [" + .severity + "] " + .rule + " " + .file + ":" + (.line|tostring) + " - " + .summary
  ' "$result_path"
  if jq -e '.delta.previous_scan != null' "$result_path" >/dev/null 2>&1; then
    printf '\nDELTA vs last scan (%s):\n' "$(jq -r '.delta.previous_scan' "$result_path")"
    printf '  +%s packages added\n' "$(jq -r '.delta.packages_added' "$result_path")"
    printf '  -%s packages removed\n' "$(jq -r '.delta.packages_removed' "$result_path")"
    printf '  +%s new CVEs (%s)\n' \
      "$(jq -r '.delta.new_cves | length' "$result_path")" \
      "$(jq -r '.delta.new_cves[:5] | join(", ")' "$result_path")"
  fi
  printf '\nVERDICT: %s\n\n' "$(jq -r '.verdict' "$result_path")"
  printf 'Details: %s\n' "$display_path"
}

build_scan_result_from_artifacts() {
  local machine="$1" original_target="$2" strategy="$3" sbom_src="$4" osv_json="$5" grype_json="$6" ecosystem_audits_file="$7" scan_mode="${8:-source}" source_scan_file="${9:-}"
  local stamp result_path sbom_path build_tmp
  stamp="$(today_date)"
  mkdir -p "$RESULTS_DIR/$machine" "$SBOM_DIR/$machine"
  result_path=$(scan_result_path_for "$machine" "$stamp")
  build_tmp=$(mktemp)
  sbom_path=$(scan_sbom_path_for "$machine" "$stamp")
  # The SBOM is shared per machine per day exactly like the result document
  # beside it, so it is published the same way. A bare `cp` fills the live
  # path in place, and `safe audit diff` or any external reader landing in
  # that window parses a partial document.
  publish_json_atomically "$sbom_src" "$sbom_path" \
    || die "cannot publish the SBOM to $sbom_path"

  local ecosystem_audits_json
  if [[ -f "$ecosystem_audits_file" ]]; then
    ecosystem_audits_json=$(jq -c '.' "$ecosystem_audits_file")
  else
    ecosystem_audits_json='[]'
  fi

  local source_scan_json
  if [[ -n "$source_scan_file" && -f "$source_scan_file" ]]; then
    source_scan_json=$(jq -c '.' "$source_scan_file")
  else
    source_scan_json='{"status":"skipped","note":"source scan unavailable","scanned_files":0,"total":0,"findings":[]}'
  fi

  local tool_status_json
  tool_status_json=$(jq -n --slurpfile osv "$osv_json" --slurpfile grype "$grype_json" --slurpfile sbom "$sbom_src" '
    def osv_status($doc):
      if (($doc.error // "") != "") then
        {status:"error", note:$doc.error}
      elif (($doc.partial // "") != "") then
        {status:"partial", note:$doc.partial}
      elif (($doc.skip_reason // "") == "scanner_unavailable") then
        {status:"skipped", note:($doc.skipped // "scanner unavailable")}
      elif (($doc.skip_reason // "") == "no_lockfiles") then
        {status:"ok", note:$doc.skipped}
      elif (($doc.skipped // "") != "") then
        {status:"skipped", note:$doc.skipped}
      else
        {status:"ok", note:null}
      end;
    def scan_status($doc):
      if (($doc.error // "") != "") then
        {status:"error", note:$doc.error}
      elif (($doc.skipped // "") != "") then
        {status:"skipped", note:$doc.skipped}
      else
        {status:"ok", note:null}
      end;
    def syft_status($doc):
      ([
        (
          if (($doc.metadata.tools? // null) | type) == "array" then
            $doc.metadata.tools[]?
          elif (($doc.metadata.tools.components? // null) | type) == "array" then
            $doc.metadata.tools.components[]?
          else
            empty
          end
        )
        | select(type == "object")
        | select((.name // "") == "safe-audit")
        | (.note // empty)
      ][0] // "") as $note |
      # A syft that RAN and failed left the "syft failed" marker: its SBOM is
      # empty, so grype then scans nothing — that is breakage (status "error",
      # refused), not a skipped tier. Only "syft unavailable" (absent) is a
      # skip. Distinguishing them is load-bearing: the install gate refuses on
      # "error" but discloses+WARNs a skip, so collapsing both to "skipped" let
      # a real syft failure pass under --yes.
      if ($note | test("failed"; "i")) then
        {status:"error", note:$note}
      elif ($note | test("unavailable"; "i")) then
        {status:"skipped", note:$note}
      else
        {status:"ok", note:(if $note == "" then null else $note end)}
      end;
    {
      "osv-scanner": osv_status($osv[0] // {}),
      syft: syft_status($sbom[0] // {}),
      grype: scan_status($grype[0] // {})
    }
  ')

  SCAN_DEGRADED_TIERS=$(jq -r '
    to_entries
    | map(select((.value.status // "ok") != "ok")
          | .key + " " + (.value.status // "ok")
            + (if (.value.note // "") != "" then " (" + .value.note + ")" else "" end))
    | join("; ")
  ' <<<"$tool_status_json")

  local critical high medium low severity
  critical=$(count_grype_severity "$grype_json" critical)
  high=$(count_grype_severity "$grype_json" high)
  medium=$(count_grype_severity "$grype_json" medium)
  low=$(count_grype_severity "$grype_json" low)
  while IFS= read -r severity; do
    severity=$(severity_from_osv_entry "$severity")
    case "$severity" in
      critical) critical=$((critical + 1)) ;;
      high) high=$((high + 1)) ;;
      medium|unknown) medium=$((medium + 1)) ;;
      low) low=$((low + 1)) ;;
    esac
  done < <(summarize_osv_counts "$osv_json")

  local findings_json
  findings_json=$(jq -n --slurpfile osv "$osv_json" --slurpfile grype "$grype_json" '
    def osv_severity:
      if ((.database_specific.severity? // "") != "") then .database_specific.severity
      elif ((.severity? | type) == "array") then (.severity[0].score // .severity[0].type // "unknown")
      elif ((.severity? | type) == "string") then .severity
      else "unknown"
      end;
    (
      [
        (($osv[0].results // [])[]? | (.packages // [])[]? | select(type == "object")) as $pkg
        | ($pkg.package.name // $pkg.name // "unknown") as $name
        | ($pkg.package.version // $pkg.version // "unknown") as $version
        | ($pkg.vulnerabilities // [])[]?
        | select(type == "object")
        | {
            source: "osv",
            id: (.id // .aliases[0] // "unknown"),
            severity: osv_severity,
            package: $name,
            version: $version
          }
      ] +
      [
        ($grype[0].matches // [])[]?
        | select(type == "object")
        | {
            source: "grype",
            id: (.vulnerability.id // "unknown"),
            severity: (.vulnerability.severity // "unknown"),
            package: (.artifact.name // "unknown"),
            version: (.artifact.version // "unknown")
          }
      ]
    ) | unique_by(.source + ":" + .id + ":" + .package + ":" + .version)
  ' 2>/dev/null || printf '[]')

  local packages_total npm_total python_total php_total rust_total go_total verdict
  packages_total=$(count_sbom_packages "$sbom_src")
  npm_total=$(count_sbom_ecosystem "$sbom_src" npm)
  python_total=$(count_sbom_ecosystem "$sbom_src" pypi)
  php_total=$(count_sbom_ecosystem "$sbom_src" composer)
  rust_total=$(count_sbom_ecosystem "$sbom_src" cargo)
  go_total=$(count_sbom_ecosystem "$sbom_src" golang)

  verdict="GO"
  if (( critical > 0 )); then
    verdict="WARN"
  elif (( high > 0 || medium > 0 || low > 0 )); then
    verdict="WARN"
  fi
  if [[ "$(jq -r '.total // 0' <<<"$source_scan_json")" -gt 0 ]]; then
    verdict="WARN"
  fi
  # Coverage that is missing because something BROKE, or because a tool the
  # project needs is not installed, is not a clean verdict. (A broken scanner
  # used to require its note to say "unavailable" to count, so a scanner that
  # ran and failed left the scan at GO.)
  #
  # Evidence a scanner structurally cannot audit — npm audit facing a pnpm
  # lockfile — is a third thing: reported as not run, no verdict change.
  # Warning on it would put every pnpm project behind an operator prompt for
  # a tool that was never going to say anything.
  if jq -e '
    [ .[]?
      | select((.status // "ok") != "ok")
      | select((.status == "error") or (.status == "partial")
               or (((.note // "") | test("unavailable|missing"; "i"))))
    ] | length > 0
  ' <<<"$ecosystem_audits_json" >/dev/null; then
    verdict="WARN"
  fi

  # "unsupported" means a scanner cannot read this project's evidence. That is
  # fine when something else can — osv-scanner reads the pnpm lockfile npm
  # audit refuses — and it is a false clean when nothing can. A package.json
  # with no lockfile at all has no npm coverage from any scanner, so GO would
  # mean "we looked at nothing".
  local npm_lockfiles=0 file
  for file in ${CURRENT_LOCKFILES[@]+"${CURRENT_LOCKFILES[@]}"}; do
    case "$(basename -- "$file")" in
      # bun.lock counts because osv-scanner reads it, so the dependencies ARE
      # covered and `npm audit: unsupported` is the same non-event it is for a
      # pnpm project. bun.lockb does not: nothing reads the binary format, so a
      # project carrying only that one really is uncovered and must still WARN.
      package-lock.json|npm-shrinkwrap.json|pnpm-lock.yaml|yarn.lock|bun.lock)
        npm_lockfiles=$((npm_lockfiles + 1)) ;;
    esac
  done
  if (( npm_lockfiles == 0 )) && jq -e '
    [ .[]? | select(.status == "unsupported") | select((.scanner // "") == "npm-audit") ] | length > 0
  ' <<<"$ecosystem_audits_json" >/dev/null; then
    verdict="WARN"
  fi
  if jq -e '[to_entries[]? | select((.value.status // "ok") != "ok")] | length > 0' <<<"$tool_status_json" >/dev/null; then
    verdict="WARN"
  fi

  # `cve_scan` counts only what osv-scanner and grype found. The ecosystem
  # audits (npm audit, composer audit, cargo-audit, govulncheck) report their
  # own advisory counts and were never folded in, so a critical seen only by
  # npm audit left the verdict at GO. `audit_totals` is the aggregate every
  # gating consumer reads: CVE scan + every ecosystem audit that actually ran.
  #
  # These are SCANNER REPORTS, not distinct advisories: only osv and grype
  # carry ids we can compare, so one advisory reported by three scanners
  # counts three times. The aggregate decides "is there a critical anywhere",
  # which double counting cannot change; consumers that show a number to a
  # human show the per-source breakdown instead.
  local audit_totals_json
  audit_totals_json=$(jq -n \
    --argjson critical "$critical" --argjson high "$high" \
    --argjson medium "$medium" --argjson low "$low" \
    --argjson audits "$ecosystem_audits_json" '
    def counted: (.status // "") as $s | ($s == "ok") or ($s == "partial");
    def sum(f): ([$audits[]? | select(counted) | (f // 0)] | add) // 0;
    {
      critical: ($critical + sum(.critical)),
      high: ($high + sum(.high)),
      medium: ($medium + sum(.medium)),
      low: ($low + sum(.low)),
      unknown: sum(.unknown),
      cve_scan: {critical: $critical, high: $high, medium: $medium, low: $low},
      ecosystem: [$audits[]? | select(counted)
                  | {scanner, status, total, critical, high, medium, low, unknown: (.unknown // 0)}],
      deduplicated: false
    }' 2>/dev/null || printf '{"critical":%s,"high":%s,"medium":%s,"low":%s,"unknown":0,"deduplicated":false}' \
      "$critical" "$high" "$medium" "$low")
  if jq -e '(.critical + .high + .medium + .low + (.unknown // 0)) > 0' <<<"$audit_totals_json" >/dev/null 2>&1; then
    verdict="WARN"
  fi

  jq -n \
    --arg machine "$machine" \
    --arg date "$(today_date)" \
    --arg timestamp "$(now_iso)" \
    --arg target "$original_target" \
    --arg strategy "$strategy" \
    --arg scan_mode "$scan_mode" \
    --arg sbom "$sbom_path" \
    --argjson packages_total "$packages_total" \
    --argjson npm_total "$npm_total" \
    --argjson python_total "$python_total" \
    --argjson php_total "$php_total" \
    --argjson rust_total "$rust_total" \
    --argjson go_total "$go_total" \
    --argjson critical "$critical" \
    --argjson high "$high" \
    --argjson medium "$medium" \
    --argjson low "$low" \
    --arg verdict "$verdict" \
    --argjson ecosystem_audits "$ecosystem_audits_json" \
    --argjson source_scan "$source_scan_json" \
    --argjson tool_status "$tool_status_json" \
    --argjson audit_totals "$audit_totals_json" \
    --argjson findings "$findings_json" \
    '{
      machine: $machine,
      date: $date,
      timestamp: $timestamp,
      target: $target,
      strategy: $strategy,
      scan_mode: $scan_mode,
      sbom: $sbom,
      summary: {
        packages_total: $packages_total,
        ecosystems: {
          npm: $npm_total,
          python: $python_total,
          php: $php_total,
          rust: $rust_total,
          go: $go_total
        }
      },
      cve_scan: {
        critical: $critical,
        high: $high,
        medium: $medium,
        low: $low,
        findings: $findings
      },
      audit_totals: $audit_totals,
      tool_status: $tool_status,
      ecosystem_audits: $ecosystem_audits,
      source_scan: $source_scan,
      verdict: $verdict
    }' > "$build_tmp"

  # The document is assembled in a private file and only then published to the
  # shared per-day path: `<date>-scan.json` is one file per machine per day, so
  # a concurrent scan of another project can replace it between any two reads.
  # Nothing that decides anything may re-read the shared path.
  local delta_json snapshot __scratch
  delta_json=$(build_delta_json "$machine" "$result_path" "$sbom_path" "$build_tmp" "$sbom_src")
  # Registered scratch: the snapshot outlives this function — it is cached and
  # rendered later in the run through LAST_SCAN_RESULT_SNAPSHOT — so a
  # function-local rm cannot reclaim it, but the process-exit trap can.
  new_scratch_dir __scratch
  snapshot="$__scratch/snapshot"
  jq --argjson delta "$delta_json" '. + {delta: $delta}' "$build_tmp" > "$snapshot"
  rm -f "$build_tmp"
  # Publishing is a replace of a SHARED path, so it gets the same treatment as
  # every other one: stage beside the destination, then rename. A bare `cp`
  # onto the live path leaves it truncated for as long as the copy takes, and
  # `safe audit status` and the next scan's delta both read it.
  publish_json_atomically "$snapshot" "$result_path" \
    || die "cannot publish the scan result to $result_path"

  LAST_SCAN_RESULT_PATH="$result_path"
  LAST_SCAN_RESULT_SNAPSHOT="$snapshot"
  write_scan_result_out "$snapshot"
  # Rendered from the snapshot, addressed as the shared path: the numbers are
  # this scan's, the path a human can open afterwards.
  render_scan_summary "$snapshot" "$result_path"
}

# --------------------------------------------------------------------------
# Scan cache (deps-only)
#
# A --deps-only scan is keyed by the dependency evidence it reads: the
# lockfiles and manifests, each hashed by content. An unchanged evidence set
# inside the TTL replays the recorded result instead of re-running scanners.
#
# Discipline: the cache may only ever SKIP work, never invent a verdict. Every
# failure mode here — missing jq, unreadable entry, corrupt JSON, malformed
# timestamp, envelope belonging to another request, entry written by an older
# safe, empty evidence — falls through to a real scan, and never aborts the
# scan it was supposed to accelerate.
#
# What the key does NOT cover, and how each gap is handled:
#   - Source files. govulncheck reads `./...`, not just go.mod/go.sum, so a
#     result containing a govulncheck run is never stored (see
#     scan_cache_result_is_cacheable).
#   - Advisory databases. npm/composer/cargo audits and OSV consult live data
#     that can gain an advisory while an entry is fresh. That window is exactly
#     the TTL and is the deliberate cost of the cache: `--no-cache` (and the
#     TTL knob) is the escape hatch, and a hit says so on stdout.
#   - Full/source scans, which stage arbitrary files no evidence hash captures:
#     never cached at all.
# --------------------------------------------------------------------------

# Replace a shared path with a document, atomically. The staging file is
# allocated in the DESTINATION's directory, never $TMPDIR: `mv` is a rename
# only within one filesystem, and $TMPDIR is routinely a tmpfs while the paths
# published here are not. Across filesystems `mv` degrades to copy-then-unlink
# and a concurrent reader sees the destination truncated.
#
# It validates nothing: the caller owns the document's format. That is what
# lets the result document and the CycloneDX SBOM share one publisher without
# either of them being checked against the other's schema.
publish_json_atomically() {
  local source_doc="$1" dest="$2"
  local dir tmp
  dir="$(dirname -- "$dest")"
  tmp="$(mktemp "$dir/.safe-publish.XXXXXX")" || return 1
  if ! cp "$source_doc" "$tmp" || ! mv "$tmp" "$dest"; then
    rm -f "$tmp"
    return 1
  fi
  return 0
}

# Deliver the caller's copy atomically: a reader watching the path sees either
# no file or a complete document, never half of one.
write_scan_result_out() {
  local source_doc="$1"
  [[ -n "$SCAN_RESULT_OUT" ]] || return 0
  publish_json_atomically "$source_doc" "$SCAN_RESULT_OUT" \
    || die "cannot write scan result to $SCAN_RESULT_OUT"
  return 0
}

scan_cache_ttl_seconds() {
  local ttl="${SCAN_CACHE_TTL_SECONDS:-}"
  # A malformed TTL disables the cache rather than defaulting silently: the
  # operator asked for a specific window and we could not honor it.
  [[ "$ttl" =~ ^[0-9]+$ ]] || return 1
  (( 10#$ttl > 0 )) || return 1
  printf '%s' "$((10#$ttl))"
}

scan_cache_enabled() {
  local scan_mode="$1"
  [[ "$scan_mode" == "deps" ]] || return 1
  [[ "${SAFE_AUDIT_SCAN_NO_CACHE:-0}" != "1" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  command -v sha256sum >/dev/null 2>&1 || return 1
  scan_cache_ttl_seconds >/dev/null || return 1
  return 0
}

# A result is replayable only if every scanner that contributed to it read
# nothing outside the hashed evidence, and only if the scanner set itself was
# complete. Three exclusions:
#   - govulncheck at all (any status): it analyses Go SOURCE, which the key
#     does not cover, and if it was merely absent, installing it later must
#     not be masked by a replay of the run that lacked it.
#   - any ecosystem audit that did not return "ok": a tool that was missing
#     or broken is coverage the key cannot represent, so the next scan runs
#     for real rather than replaying a partial answer.
#   - any core tool (osv-scanner, syft, grype) in a non-ok state, for the
#     same reason.
scan_cache_result_is_cacheable() {
  local result="$1"
  jq -e '
    ([.ecosystem_audits[]? | select((.scanner // "") == "govulncheck")] | length == 0)
    and ([.ecosystem_audits[]?
          | select((.status // "ok") != "ok")
          | select((.status // "") != "unsupported")] | length == 0)
    and ([.tool_status // {} | to_entries[]? | select((.value.status // "ok") != "ok")] | length == 0)
  ' "$result" >/dev/null 2>&1
}

# Every input a scanner reads must be in the key, and discovery is not that
# list: it walks regular files, so a lockfile that exists as a SYMLINK is read
# by `npm audit` while being invisible to the hash, and it has no reason to
# track files that are not dependency evidence but still change what a scanner
# asks (`.npmrc` selects the registry npm audit queries; `.safe-audit` decides
# which ecosystems are audited at all). This enumerates both.
SCAN_CACHE_EXTRA_EVIDENCE=(
  package.json package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock bun.lock bun.lockb .npmrc
  requirements.txt requirements-dev.txt pyproject.toml uv.lock poetry.lock Pipfile.lock
  composer.json composer.lock Cargo.toml Cargo.lock go.mod go.sum
  pom.xml gradle.lockfile build.gradle build.gradle.kts .safe-audit
)

# The scanner set is an input too. Install pip-audit and a project that was
# GO gains Python coverage; remove it and that coverage disappears — neither
# touches a single evidence file, so without this the cache would replay a
# verdict produced by a different set of tools.
#
# Identity is path + size + mtime: no subprocess, and an upgrade in place
# changes it. Nothing here is secret — only whether a tool exists and which
# build it is.
scan_cache_scanner_fingerprint() {
  local tool path
  for tool in osv-scanner syft grype npm composer cargo cargo-audit govulncheck pip-audit; do
    path="$(command -v "$tool" 2>/dev/null || true)"
    if [[ -n "$path" && -e "$path" ]]; then
      printf '%s\t%s\n' "$tool" "$(stat -Lc '%s:%Y:%n' "$path" 2>/dev/null || printf '%s' "$path")"
    else
      printf '%s\t<absent>\n' "$tool"
    fi
  done
}

scan_cache_evidence_paths() {
  local root name path
  for path in ${CURRENT_LOCKFILES[@]+"${CURRENT_LOCKFILES[@]}"} \
              ${CURRENT_MANIFESTS[@]+"${CURRENT_MANIFESTS[@]}"}; do
    [[ -n "$path" ]] && printf '%s\n' "$path"
  done
  for root in ${CURRENT_PROJECT_ROOTS[@]+"${CURRENT_PROJECT_ROOTS[@]}"}; do
    for name in "${SCAN_CACHE_EXTRA_EVIDENCE[@]}"; do
      path="$root/$name"
      # -e follows symlinks, and so does the hash: what the scanner will read
      # is what gets hashed.
      [[ -e "$path" ]] && printf '%s\n' "$path"
    done
  done
}

# sha256 over machine, target, mode, and every evidence file's own sha256.
# Empty evidence is NOT cacheable: there would be nothing to invalidate on.
#
# Paths enter the key RELATIVE to the scan root. A remote scan stages its files
# into a fresh mktemp directory every run, so absolute paths would make two
# scans of an unchanged remote target hash differently and the cache would
# never hit where it is most expensive to miss.
scan_cache_key() {
  local machine="$1" target="$2" scan_mode="$3" root="$4"
  shift 4
  local tmp file digest rel
  tmp=$(mktemp) || return 1
  printf '%s\n%s\n%s\n' "$machine" "$target" "$scan_mode" > "$tmp"
  scan_cache_scanner_fingerprint >> "$tmp"
  local -a evidence=()
  mapfile -t evidence < <(printf '%s\n' "$@" | LC_ALL=C sort -u)
  local counted=0
  for file in "${evidence[@]}"; do
    [[ -n "$file" ]] || continue
    if [[ ! -r "$file" ]]; then
      rm -f "$tmp"
      return 1
    fi
    rel="$file"
    [[ -n "$root" ]] && rel="${file#"$root"/}"
    printf '%s  %s\n' "$(sha256sum "$file" | awk '{print $1}')" "$rel" >> "$tmp"
    counted=$((counted + 1))
  done
  if (( counted == 0 )); then
    rm -f "$tmp"
    return 1
  fi
  digest=$(sha256sum "$tmp" | awk '{print $1}')
  rm -f "$tmp"
  [[ -n "$digest" ]] || return 1
  printf '%s' "$digest"
}

scan_cache_human_age() {
  local seconds="$1"
  if (( seconds < 60 )); then
    printf '%ds' "$seconds"
  elif (( seconds < 3600 )); then
    printf '%dm' "$((seconds / 60))"
  else
    printf '%dh %dm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
  fi
}

# Replay a cached result. Returns 1 for ANY doubt so the caller runs a real
# scan; returns 0 only after rendering a valid, fresh entry that belongs to
# THIS request. Every check is inside one jq predicate on purpose: bash
# arithmetic on a value taken from a cache file is itself an abort risk
# (`$((now - 08))` is a fatal "value too great for base"), and an aborted
# scan reads to a caller as "scan failed", not as "no cache".
scan_cache_replay() {
  local key="$1" machine="$2" target="$3" scan_mode="$4"
  local path="$SCAN_CACHE_DIR/$key.json"
  [[ -n "$key" && -r "$path" ]] || return 1

  local ttl
  ttl="$(scan_cache_ttl_seconds)" || return 1

  jq -e \
    --arg key "$key" --arg machine "$machine" --arg target "$target" \
    --arg mode "$scan_mode" --argjson ttl "$ttl" --argjson schema "$SCAN_CACHE_SCHEMA" '
    (._cache // {}) as $c
    | ($c.schema == $schema)
      and ($c.key == $key)
      and ($c.machine == $machine)
      and ($c.target == $target)
      and ($c.mode == $mode)
      and (($c.created_epoch | type) == "number")
      and ($c.created_epoch <= now)
      and ((now - $c.created_epoch) < $ttl)
      and ((.verdict | type) == "string")
      and ((.verdict == "GO") or (.verdict == "WARN") or (.verdict == "BLOCK"))
      and ((.summary | type) == "object")
      and ((.cve_scan | type) == "object")
      and ((.cve_scan.critical | type) == "number")
      and ((.cve_scan.high | type) == "number")
      and ((.cve_scan.medium | type) == "number")
      and ((.cve_scan.low | type) == "number")
      and ((.audit_totals | type) == "object")
      and ((.audit_totals.critical | type) == "number")
      and ((.ecosystem_audits | type) == "array")
      and ((.tool_status | type) == "object")
  ' "$path" >/dev/null 2>&1 || return 1

  local age
  age="$(jq -r '((now - ._cache.created_epoch) | floor)' "$path" 2>/dev/null || true)"
  [[ "$age" =~ ^[0-9]+$ ]] || return 1

  printf '[safe audit] scan cache hit (%s old) — dependency evidence unchanged; --no-cache forces a fresh scan\n' \
    "$(scan_cache_human_age "$((10#$age))")"
  LAST_SCAN_RESULT_PATH="$path"
  LAST_SCAN_RESULT_SNAPSHOT="$path"
  write_scan_result_out "$path" || return 1
  render_scan_summary "$path"
}

# Cache writes never fail a scan: a full result was already produced.
scan_cache_store() {
  local key="$1" result="$2" machine="$3" target="$4" scan_mode="$5"
  [[ -n "$key" && -n "$result" && -r "$result" ]] || return 0
  scan_cache_result_is_cacheable "$result" || {
    vinfo "scan cache: result reads beyond the hashed evidence; not stored"
    return 0
  }
  mkdir -p "$SCAN_CACHE_DIR" 2>/dev/null || return 0
  local tmp
  tmp=$(mktemp "$SCAN_CACHE_DIR/.tmp.XXXXXX" 2>/dev/null) || return 0
  if jq --arg k "$key" --arg m "$machine" --arg t "$target" --arg mode "$scan_mode" \
      --argjson schema "$SCAN_CACHE_SCHEMA" --argjson epoch "$(date +%s)" \
      '. + {_cache: {schema: $schema, key: $k, machine: $m, target: $t, mode: $mode, created_epoch: $epoch}}' \
      "$result" > "$tmp" 2>/dev/null; then
    mv "$tmp" "$SCAN_CACHE_DIR/$key.json" 2>/dev/null || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
  return 0
}

scan_source_into_result() {
  local machine="$1" source="$2" original_target="$3" strategy="$4" scan_mode="${5:-source}" allow_source_fallback="${6:-1}"
  vinfo "$machine: scan source=$(printf '%q' "$source") target=$(printf '%q' "$original_target") strategy=$strategy mode=$scan_mode fallback=$allow_source_fallback"
  gather_projects_from_source "$source" "$allow_source_fallback"

  local cache_key=""
  local -a cache_evidence=()
  if scan_cache_enabled "$scan_mode"; then
    mapfile -t cache_evidence < <(scan_cache_evidence_paths)
    cache_key="$(scan_cache_key "$machine" "$original_target" "$scan_mode" "$source" \
      ${cache_evidence[@]+"${cache_evidence[@]}"} || true)"
    vinfo "$machine: scan cache key=${cache_key:-<none>}"
    if [[ -n "$cache_key" ]] && scan_cache_replay "$cache_key" "$machine" "$original_target" "$scan_mode"; then
      return 0
    fi
  fi

  detect_machine_tools "$machine"
  local project_tools_rc
  confirm_scan_with_missing_project_audit_tools "$machine" "$original_target"
  project_tools_rc=$?
  case "$project_tools_rc" in
    0) ;;
    2) return 2 ;;
    *) return "$project_tools_rc" ;;
  esac

  local scratch osv_json grype_json sbom_tmp audits_tmp source_scan_tmp syft_source
  new_scratch_dir scratch
  vinfo "$machine: scan scratch=$(printf '%q' "$scratch")"
  osv_json="$scratch/osv.json"
  grype_json="$scratch/grype.json"
  sbom_tmp="$scratch/sbom.json"
  audits_tmp="$scratch/ecosystem-audits.json"
  source_scan_tmp="$scratch/source-scan.json"

  syft_source="$source"
  if [[ "$scan_mode" != "full" ]]; then
    syft_source="$scratch/source-stage"
    gather_scan_stage_from_current_files "$source" "$syft_source" "$scan_mode"
  fi

  osv_scan_lockfiles "$machine" "$osv_json" "${CURRENT_LOCKFILES[@]}"
  run_source_risk_scan "$syft_source" "$source_scan_tmp" "$scan_mode"
  syft_generate_sbom "$machine" "$syft_source" "$sbom_tmp"
  grype_scan_sbom "$machine" "$sbom_tmp" "$grype_json"

  local root project_audits_files=()
  for root in "${CURRENT_PROJECT_ROOTS[@]}"; do
    parse_project_config "$root/.safe-audit"
    vinfo "$machine: ecosystem audits root=$(printf '%q' "$root")"
    run_project_ecosystem_audits "$root" "$scratch/$(slugify "$root")" > "$scratch/$(slugify "$root").audits.json"
    project_audits_files+=("$scratch/$(slugify "$root").audits.json")
  done

  if [[ "${#project_audits_files[@]}" -eq 0 ]]; then
    printf '[]\n' > "$audits_tmp"
  else
    jq -s 'add' "${project_audits_files[@]}" > "$audits_tmp"
  fi

  local build_rc=0
  build_scan_result_from_artifacts "$machine" "$original_target" "$strategy" "$sbom_tmp" "$osv_json" "$grype_json" "$audits_tmp" "$scan_mode" "$source_scan_tmp" || build_rc=$?
  if [[ -n "$cache_key" && "$build_rc" -eq 0 ]]; then
    # The key was computed before the scanners ran. If the evidence changed
    # underneath them, this result describes bytes that are no longer on disk
    # and must not be filed under the original key — that is how a clean
    # verdict ends up answering for a vulnerable lockfile.
    local verify_key=""
    local -a verify_evidence=()
    mapfile -t verify_evidence < <(scan_cache_evidence_paths)
    verify_key="$(scan_cache_key "$machine" "$original_target" "$scan_mode" "$source" \
      ${verify_evidence[@]+"${verify_evidence[@]}"} || true)"
    # The path SET is compared too: a `.safe-audit` created mid-scan changes
    # which ecosystems ran while every previously-known file still hashes the
    # same, and the frozen list would never notice.
    local before after
    before="$(printf '%s\n' ${cache_evidence[@]+"${cache_evidence[@]}"} | LC_ALL=C sort -u)"
    after="$(printf '%s\n' ${verify_evidence[@]+"${verify_evidence[@]}"} | LC_ALL=C sort -u)"
    if [[ -n "$verify_key" && "$verify_key" == "$cache_key" && "$before" == "$after" ]]; then
      scan_cache_store "$cache_key" "$LAST_SCAN_RESULT_SNAPSHOT" "$machine" "$original_target" "$scan_mode"
    else
      vinfo "$machine: evidence changed during the scan; result not cached"
    fi
  fi
  return "$build_rc"
}

scan_source_with_external_sbom_into_result() {
  local machine="$1" source="$2" original_target="$3" strategy="$4" sbom_src="$5" scan_mode="${6:-source}" allow_source_fallback="${7:-1}"
  vinfo "$machine: scan source=$(printf '%q' "$source") target=$(printf '%q' "$original_target") strategy=$strategy mode=$scan_mode external_sbom=$(printf '%q' "$sbom_src")"
  gather_projects_from_source "$source" "$allow_source_fallback"

  local scratch osv_json grype_json audits_tmp source_scan_tmp local_machine
  local_machine=$(detect_local_machine_name)
  detect_machine_tools "$local_machine" 1
  local project_tools_rc
  confirm_scan_with_missing_project_audit_tools "$local_machine" "$original_target"
  project_tools_rc=$?
  case "$project_tools_rc" in
    0) ;;
    2) return 2 ;;
    *) return "$project_tools_rc" ;;
  esac

  new_scratch_dir scratch
  vinfo "$machine: scan scratch=$(printf '%q' "$scratch") local_scanner_machine=$local_machine"
  osv_json="$scratch/osv.json"
  grype_json="$scratch/grype.json"
  audits_tmp="$scratch/ecosystem-audits.json"
  source_scan_tmp="$scratch/source-scan.json"

  osv_scan_lockfiles "$local_machine" "$osv_json" "${CURRENT_LOCKFILES[@]}"
  run_source_risk_scan "$source" "$source_scan_tmp" "$scan_mode"
  grype_scan_sbom "$local_machine" "$sbom_src" "$grype_json"

  local root project_audits_files=()
  for root in "${CURRENT_PROJECT_ROOTS[@]}"; do
    parse_project_config "$root/.safe-audit"
    vinfo "$machine: ecosystem audits root=$(printf '%q' "$root")"
    run_project_ecosystem_audits "$root" "$scratch/$(slugify "$root")" > "$scratch/$(slugify "$root").audits.json"
    project_audits_files+=("$scratch/$(slugify "$root").audits.json")
  done

  if [[ "${#project_audits_files[@]}" -eq 0 ]]; then
    printf '[]\n' > "$audits_tmp"
  else
    jq -s 'add' "${project_audits_files[@]}" > "$audits_tmp"
  fi

  build_scan_result_from_artifacts "$machine" "$original_target" "$strategy" "$sbom_src" "$osv_json" "$grype_json" "$audits_tmp" "$scan_mode" "$source_scan_tmp"
}

machine_supports_remote_direct_scan() {
  local machine="$1"
  [[ "$(machine_type "$machine")" == "ssh" ]] || return 1
  [[ -n "$(tool_cache_path "$machine" "osv-scanner")" ]] || return 1
  [[ -n "$(tool_cache_path "$machine" "syft")" ]] || return 1
  [[ -n "$(tool_cache_path "$machine" "grype")" ]] || return 1
  machine_grype_db_healthy "$machine" || return 1
}

remote_scan_helper_script() {
  cat <<'EOF'
set -euo pipefail
target="$1"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

if [[ -n "${SAFE_AUDIT_SCANNER_DIR:-}" ]]; then
  PATH="$SAFE_AUDIT_SCANNER_DIR:$PATH"
  export PATH
fi

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

collect_syft_exclude_args() {
  local cfg root rel_prefix raw line section="" pattern
  while IFS= read -r -d '' cfg; do
    root=$(dirname "$cfg")
    rel_prefix="${root#"$target"/}"
    [[ "$rel_prefix" == "$root" || "$rel_prefix" == "." ]] && rel_prefix=""
    [[ -n "$rel_prefix" ]] && rel_prefix="${rel_prefix%/}/"
    section=""
    while IFS= read -r raw || [[ -n "$raw" ]]; do
      line="${raw%%#*}"
      line="$(trim "$line")"
      [[ -z "$line" ]] && continue
      case "$line" in
        ecosystems:|scanners:) section=""; continue ;;
        ignore:) section="ignore"; continue ;;
      esac
      if [[ "$section" == "ignore" && "$line" =~ ^-[[:space:]]*(.+)$ ]]; then
        pattern="${BASH_REMATCH[1]}"
        printf '%s\0%s\0' '--exclude' "${rel_prefix}${pattern}"
        printf '%s\0%s\0' '--exclude' "${rel_prefix}${pattern}/**"
      fi
    done <"$cfg"
  done < <(find "$target" -type f -name '.safe-audit' -print0 2>/dev/null)
}

if [[ "${SAFE_AUDIT_REMOTE_SBOM_ONLY:-0}" == "1" ]]; then
  if command -v syft >/dev/null 2>&1; then
    exclude_args=()
    mapfile -d '' -t exclude_args < <(collect_syft_exclude_args)
    if ! syft "dir:$target" -o cyclonedx-json "${exclude_args[@]}" > "$scratch/sbom.json" 2>"$scratch/sbom.stderr"; then
      printf '{"components":[],"metadata":{"tools":[{"name":"safe-audit","note":"syft failed"}]}}\n' > "$scratch/sbom.json"
    fi
  else
    printf '{"components":[],"metadata":{"tools":[{"name":"safe-audit","note":"syft unavailable"}]}}\n' > "$scratch/sbom.json"
  fi
  tar -C "$scratch" -czf - sbom.json
  exit 0
fi

slugify() {
  local raw="$1"
  raw="${raw//@/_at_}"
  raw="${raw//\//_}"
  raw="${raw//:/_}"
  raw="${raw// /_}"
  printf '%s' "$raw"
}

json_string_or_null() {
  local v="${1:-}"
  if [[ -z "$v" ]]; then
    printf 'null'
  else
    jq -Rn --arg v "$v" '$v'
  fi
}

render_ecosystem_audit_json() {
  local scanner="$1" status="$2" total="$3" critical="$4" high="$5" medium="$6" low="$7" note="${8:-}" unknown="${9:-0}"
  printf '{'
  printf '"scanner":%s,' "$(json_string_or_null "$scanner")"
  printf '"status":%s,' "$(json_string_or_null "$status")"
  printf '"total":%s,' "$total"
  printf '"critical":%s,' "$critical"
  printf '"high":%s,' "$high"
  printf '"medium":%s,' "$medium"
  printf '"low":%s,' "$low"
  printf '"unknown":%s,' "$unknown"
  printf '"note":%s' "$(json_string_or_null "$note")"
  printf '}'
}

relative_to() {
  local base="$1" path="$2"
  path="${path#"$base"/}"
  printf '%s' "$path"
}

declare -a PROJECT_IGNORES=()
declare -A PROJECT_ECOSYSTEMS=()
declare -A PROJECT_SCANNERS=()

reset_project_config() {
  PROJECT_IGNORES=()
  PROJECT_ECOSYSTEMS=([npm]="" [python]="" [php]="" [rust]="" [go]="")
  PROJECT_SCANNERS=([python]="pip-audit" [npm]="npm-audit" [php]="composer-audit" [rust]="cargo-audit" [go]="govulncheck")
}

parse_project_config() {
  local config="${1:-}"
  reset_project_config
  [[ -f "$config" ]] || return 0
  local section="" raw line key value
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    line="${raw%%#*}"
    line="$(trim "$line")"
    [[ -z "$line" ]] && continue
    case "$line" in
      ecosystems:) section="ecosystems"; continue ;;
      scanners:) section="scanners"; continue ;;
      ignore:) section="ignore"; continue ;;
    esac
    case "$section" in
      ecosystems)
        if [[ "$line" =~ ^([A-Za-z0-9_-]+):[[:space:]]*(true|false)$ ]]; then
          PROJECT_ECOSYSTEMS["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
        fi
        ;;
      scanners)
        if [[ "$line" =~ ^([A-Za-z0-9_-]+):[[:space:]]*([A-Za-z0-9._-]+)$ ]]; then
          PROJECT_SCANNERS["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
        fi
        ;;
      ignore)
        if [[ "$line" =~ ^-[[:space:]]*(.+)$ ]]; then
          PROJECT_IGNORES+=("${BASH_REMATCH[1]}")
        fi
        ;;
    esac
  done <"$config"
}

ecosystem_enabled() {
  local ecosystem="$1"
  local v="${PROJECT_ECOSYSTEMS[$ecosystem]:-}"
  [[ -z "$v" || "$v" == "true" ]]
}

project_ecosystem_detected() {
  local root="$1" ecosystem="$2"
  case "$ecosystem" in
    npm)
      [[ -f "$root/package.json" || -f "$root/package-lock.json" || -f "$root/pnpm-lock.yaml" || -f "$root/yarn.lock" || -f "$root/bun.lock" || -f "$root/bun.lockb" ]]
      ;;
    python)
      [[ -f "$root/pyproject.toml" || -f "$root/requirements.txt" || -f "$root/requirements-dev.txt" || -f "$root/requirements.lock" || -f "$root/uv.lock" || -f "$root/poetry.lock" || -f "$root/Pipfile.lock" ]]
      ;;
    php)
      [[ -f "$root/composer.json" || -f "$root/composer.lock" ]]
      ;;
    rust)
      [[ -f "$root/Cargo.toml" || -f "$root/Cargo.lock" ]]
      ;;
    go)
      [[ -f "$root/go.mod" || -f "$root/go.sum" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

project_ecosystem_should_audit() {
  local root="$1" ecosystem="$2"
  local configured="${PROJECT_ECOSYSTEMS[$ecosystem]:-}"
  [[ "$configured" == "false" ]] && return 1
  [[ "$configured" == "true" ]] && return 0
  project_ecosystem_detected "$root" "$ecosystem"
}

path_matches_ignore() {
  local rel="$1" pattern
  for pattern in "${PROJECT_IGNORES[@]}"; do
    if [[ "$rel" == $pattern || "$rel" == */$pattern || "$rel" == $pattern/* || "$rel" == */$pattern/* ]]; then
      return 0
    fi
  done
  return 1
}

nearest_project_config() {
  local start="$1" stop="$2" dir
  dir="$start"
  while [[ "$dir" == "$stop"* ]]; do
    if [[ -f "$dir/.safe-audit" ]]; then
      printf '%s\n' "$dir/.safe-audit"
      return 0
    fi
    [[ "$dir" == "$stop" || "$dir" == "/" ]] && break
    dir=$(dirname "$dir")
  done
  return 1
}

# The remote payload is a standalone script: it carries its own copy of the
# severity primitives and of the normalizers below. Both copies are compared
# by tests/audit/scan_cache.sh, so an edit to one must be made to the other.
# shellcheck disable=SC2016
JQ_SEVERITY_DEFS='
def band_rank(b): ({critical: 4, high: 3, moderate: 2, low: 1}[b]) // 0;
def norm_qual:
  (tostring | ascii_downcase)
  | (if . == "medium" then "moderate" else . end)
  | select(. == "critical" or . == "high" or . == "moderate" or . == "low");
def cvss3_metrics: split("/") | map(split(":") | select(length == 2) | {(.[0]): .[1]}) | add // {};
def cvss3_band:
  cvss3_metrics as $m
  | ({N: 0.85, A: 0.62, L: 0.55, P: 0.2}[$m["AV"]?]) as $av
  | ({L: 0.77, H: 0.44}[$m["AC"]?]) as $ac
  | ({N: 0.85, R: 0.62}[$m["UI"]?]) as $ui
  | ($m["S"]? == "C") as $chg
  | ((if $chg then {N: 0.85, L: 0.68, H: 0.5} else {N: 0.85, L: 0.62, H: 0.27} end)[$m["PR"]?]) as $pr
  | ({H: 0.56, L: 0.22, N: 0}[$m["C"]?]) as $c
  | ({H: 0.56, L: 0.22, N: 0}[$m["I"]?]) as $i
  | ({H: 0.56, L: 0.22, N: 0}[$m["A"]?]) as $a
  | if ($av == null or $ac == null or $ui == null or $pr == null or $c == null or $i == null or $a == null)
    then empty
    else
      (1 - ((1 - $c) * (1 - $i) * (1 - $a))) as $iss
      | (if $chg then (7.52 * ($iss - 0.029)) - (3.25 * pow($iss - 0.02; 15)) else 6.42 * $iss end) as $impact
      | (8.22 * $av * $ac * $pr * $ui) as $expl
      | (if $impact <= 0 then 0
         else
           (($impact + $expl) * (if $chg then 1.08 else 1 end)) as $sum
           | (if $sum < 10 then $sum else 10 end)
         end) as $rawscore
      | ((($rawscore * 10) | ceil) / 10) as $score
      | (if $score >= 9 then "critical"
         elif $score >= 7 then "high"
         elif $score >= 4 then "moderate"
         elif $score > 0 then "low"
         else empty
         end)
    end;
