def cvss4_max_composed: {
  eq1: {
    "0": ["AV:N/PR:N/UI:N/"],
    "1": ["AV:A/PR:N/UI:N/", "AV:N/PR:L/UI:N/", "AV:N/PR:N/UI:P/"],
    "2": ["AV:P/PR:N/UI:N/", "AV:A/PR:L/UI:P/"]
  },
  eq2: {
    "0": ["AC:L/AT:N/"],
    "1": ["AC:H/AT:N/", "AC:L/AT:P/"]
  },
  eq3: {
    "0": {
      "0": ["VC:H/VI:H/VA:H/CR:H/IR:H/AR:H/"],
      "1": ["VC:H/VI:H/VA:L/CR:M/IR:M/AR:H/", "VC:H/VI:H/VA:H/CR:M/IR:M/AR:M/"]
    },
    "1": {
      "0": ["VC:L/VI:H/VA:H/CR:H/IR:H/AR:H/", "VC:H/VI:L/VA:H/CR:H/IR:H/AR:H/"],
      "1": ["VC:L/VI:H/VA:L/CR:H/IR:M/AR:H/", "VC:L/VI:H/VA:H/CR:H/IR:M/AR:M/", "VC:H/VI:L/VA:H/CR:M/IR:H/AR:M/", "VC:H/VI:L/VA:L/CR:M/IR:H/AR:H/", "VC:L/VI:L/VA:H/CR:H/IR:H/AR:M/"]
    },
    "2": {"1": ["VC:L/VI:L/VA:L/CR:H/IR:H/AR:H/"]}
  },
  eq4: {
    "0": ["SC:H/SI:S/SA:S/"],
    "1": ["SC:H/SI:H/SA:H/"],
    "2": ["SC:L/SI:L/SA:L/"]
  },
  eq5: {"0": ["E:A/"], "1": ["E:P/"], "2": ["E:U/"]}
};
def cvss4_max_severity: {
  eq1: {"0": 1, "1": 4, "2": 5},
  eq2: {"0": 1, "1": 2},
  eq3eq6: {"0": {"0": 7, "1": 6}, "1": {"0": 8, "1": 8}, "2": {"1": 10}},
  eq4: {"0": 6, "1": 5, "2": 4}
};
def cvss4_order: [
  "AV", "AC", "AT", "PR", "UI", "VC", "VI", "VA", "SC", "SI", "SA",
  "E", "CR", "IR", "AR", "MAV", "MAC", "MAT", "MPR", "MUI", "MVC", "MVI", "MVA", "MSC", "MSI", "MSA",
  "S", "AU", "R", "V", "RE", "U"
];
def cvss4_values: {
  AV: ["N", "A", "L", "P"], AC: ["L", "H"], AT: ["N", "P"], PR: ["N", "L", "H"], UI: ["N", "P", "A"],
  VC: ["H", "L", "N"], VI: ["H", "L", "N"], VA: ["H", "L", "N"],
  SC: ["H", "L", "N"], SI: ["H", "L", "N"], SA: ["H", "L", "N"],
  E: ["X", "A", "P", "U"], CR: ["X", "H", "M", "L"], IR: ["X", "H", "M", "L"], AR: ["X", "H", "M", "L"],
  MAV: ["X", "N", "A", "L", "P"], MAC: ["X", "L", "H"], MAT: ["X", "N", "P"],
  MPR: ["X", "N", "L", "H"], MUI: ["X", "N", "P", "A"],
  MVC: ["X", "H", "L", "N"], MVI: ["X", "H", "L", "N"], MVA: ["X", "H", "L", "N"],
  MSC: ["X", "H", "L", "N"], MSI: ["X", "S", "H", "L", "N"], MSA: ["X", "S", "H", "L", "N"],
  S: ["X", "N", "P"], AU: ["X", "N", "Y"], R: ["X", "A", "U", "I"], V: ["X", "D", "C"],
  RE: ["X", "L", "M", "H"], U: ["X", "Clear", "Green", "Amber", "Red"]
};
def cvss4_parse:
  select(type == "string")
  | split("/") as $parts
  | select(($parts | length) >= 12 and $parts[0] == "CVSS:4.0")
  | ($parts[1:] | map(split(":"))) as $pairs
  | select(all($pairs[]; length == 2))
  | cvss4_order as $order
  | cvss4_values as $values
  | ($pairs | map(.[0])) as $keys
  | select($keys[0:11] == $order[0:11])
  | select(($keys | length) == ($keys | unique | length))
  | select([ $pairs[] as $p | (($values[$p[0]] // []) | index($p[1])) != null ] | all)
  | [ $pairs[] as $p | ($order | index($p[0])) ] as $positions
  | select([ $positions[] | . != null ] | all)
  | select([ range(1; $positions | length) as $i | $positions[$i] > $positions[$i - 1] ] | all)
  | reduce $pairs[] as $p (
      {E: "X", CR: "X", IR: "X", AR: "X", MAV: "X", MAC: "X", MAT: "X", MPR: "X", MUI: "X",
       MVC: "X", MVI: "X", MVA: "X", MSC: "X", MSI: "X", MSA: "X",
       S: "X", AU: "X", R: "X", V: "X", RE: "X", U: "X"};
      .[$p[0]] = $p[1]
    );
def cvss4_m($metric):
  . as $m
  | ("M" + $metric) as $modified
  | if $metric == "E" and $m[$metric] == "X" then "A"
    elif ($metric == "CR" or $metric == "IR" or $metric == "AR") and $m[$metric] == "X" then "H"
    elif $m[$modified]? != null and $m[$modified] != "X" then $m[$modified]
    else $m[$metric]
    end;
def cvss4_macro:
  . as $m
  | ($m | cvss4_m("AV")) as $av
  | ($m | cvss4_m("AC")) as $ac
  | ($m | cvss4_m("AT")) as $at
  | ($m | cvss4_m("PR")) as $pr
  | ($m | cvss4_m("UI")) as $ui
  | ($m | cvss4_m("VC")) as $vc
  | ($m | cvss4_m("VI")) as $vi
  | ($m | cvss4_m("VA")) as $va
  | ($m | cvss4_m("SC")) as $sc
  | ($m | cvss4_m("SI")) as $si
  | ($m | cvss4_m("SA")) as $sa
  | ($m | cvss4_m("MSI")) as $msi
  | ($m | cvss4_m("MSA")) as $msa
  | ($m | cvss4_m("E")) as $e
  | ($m | cvss4_m("CR")) as $cr
  | ($m | cvss4_m("IR")) as $ir
  | ($m | cvss4_m("AR")) as $ar
  | (if $av == "N" and $pr == "N" and $ui == "N" then "0"
     elif ($av == "N" or $pr == "N" or $ui == "N") and $av != "P" then "1"
     else "2" end) as $eq1
  | (if $ac == "L" and $at == "N" then "0" else "1" end) as $eq2
  | (if $vc == "H" and $vi == "H" then "0"
     elif $vc == "H" or $vi == "H" or $va == "H" then "1"
     else "2" end) as $eq3
  | (if $msi == "S" or $msa == "S" then "0"
     elif $sc == "H" or $si == "H" or $sa == "H" then "1"
     else "2" end) as $eq4
  | (if $e == "A" then "0" elif $e == "P" then "1" else "2" end) as $eq5
  | (if ($cr == "H" and $vc == "H") or ($ir == "H" and $vi == "H") or ($ar == "H" and $va == "H")
     then "0" else "1" end) as $eq6
  | $eq1 + $eq2 + $eq3 + $eq4 + $eq5 + $eq6;
def cvss4_piece_metrics:
  [ split("/")[] | select(length > 0) | split(":") | {(.[0]): .[1]} ] | add // {};
def cvss4_levels: {
  AV: {N: 0, A: 0.1, L: 0.2, P: 0.3}, PR: {N: 0, L: 0.1, H: 0.2}, UI: {N: 0, P: 0.1, A: 0.2},
  AC: {L: 0, H: 0.1}, AT: {N: 0, P: 0.1},
  VC: {H: 0, L: 0.1, N: 0.2}, VI: {H: 0, L: 0.1, N: 0.2}, VA: {H: 0, L: 0.1, N: 0.2},
  SC: {H: 0.1, L: 0.2, N: 0.3}, SI: {S: 0, H: 0.1, L: 0.2, N: 0.3}, SA: {S: 0, H: 0.1, L: 0.2, N: 0.3},
  CR: {H: 0, M: 0.1, L: 0.2}, IR: {H: 0, M: 0.1, L: 0.2}, AR: {H: 0, M: 0.1, L: 0.2}
};
def cvss4_distances($m; $max):
  cvss4_levels as $levels
  | reduce ["AV", "PR", "UI", "AC", "AT", "VC", "VI", "VA", "SC", "SI", "SA", "CR", "IR", "AR"][] as $metric
      ({}; .[$metric] = ($levels[$metric][($m | cvss4_m($metric))] - $levels[$metric][$max[$metric]]));
def cvss4_key($parts): $parts | map(tostring) | join("");
def cvss4_score_with($lookup; $max_composed; $max_severity):
  cvss4_parse as $m
  | if (["VC", "VI", "VA", "SC", "SI", "SA"] | all(. as $metric | ($m | cvss4_m($metric)) == "N")) then 0
    else
      ($m | cvss4_macro) as $macro
      | $lookup[$macro] as $value
      | select($value != null)
      | $macro[0:1] as $eq1 | $macro[1:2] as $eq2 | $macro[2:3] as $eq3
      | $macro[3:4] as $eq4 | $macro[4:5] as $eq5 | $macro[5:6] as $eq6
      | [
          $max_composed.eq1[$eq1][] as $a
          | $max_composed.eq2[$eq2][] as $b
          | $max_composed.eq3[$eq3][$eq6][] as $c
          | $max_composed.eq4[$eq4][] as $d
          | $max_composed.eq5[$eq5][] as $e
          | $a + $b + $c + $d + $e
        ] as $max_vectors
      | ([ $max_vectors[]
           | cvss4_piece_metrics as $max
           | cvss4_distances($m; $max) as $dist
           | select([ $dist[] | . >= 0 ] | all)
           | $dist ] | first) as $dist
      | select($dist != null)
      | ($dist.AV + $dist.PR + $dist.UI) as $distance_eq1
      | ($dist.AC + $dist.AT) as $distance_eq2
      | ($dist.VC + $dist.VI + $dist.VA + $dist.CR + $dist.IR + $dist.AR) as $distance_eq3eq6
      | ($dist.SC + $dist.SI + $dist.SA) as $distance_eq4
      | (if $eq3 == "0" and $eq6 == "0" then
           ([ $lookup[cvss4_key([$eq1, $eq2, $eq3, $eq4, $eq5, 1])],
              $lookup[cvss4_key([$eq1, $eq2, 1, $eq4, $eq5, $eq6])] ]
            | map(select(. != null)) | max // null)
         elif ($eq3 == "0" and $eq6 == "1") or ($eq3 == "1" and $eq6 == "1") then
           $lookup[cvss4_key([$eq1, $eq2, ($eq3 | tonumber) + 1, $eq4, $eq5, $eq6])]
         elif $eq3 == "1" and $eq6 == "0" then
           $lookup[cvss4_key([$eq1, $eq2, $eq3, $eq4, $eq5, 1])]
         else
           $lookup[cvss4_key([$eq1, $eq2, ($eq3 | tonumber) + 1, $eq4, $eq5, ($eq6 | tonumber) + 1])]
         end) as $lower_eq3eq6
      | [
          {score: $lookup[cvss4_key([($eq1 | tonumber) + 1, $eq2, $eq3, $eq4, $eq5, $eq6])], distance: $distance_eq1, depth: ($max_severity.eq1[$eq1] * 0.1)},
          {score: $lookup[cvss4_key([$eq1, ($eq2 | tonumber) + 1, $eq3, $eq4, $eq5, $eq6])], distance: $distance_eq2, depth: ($max_severity.eq2[$eq2] * 0.1)},
          {score: $lower_eq3eq6, distance: $distance_eq3eq6, depth: ($max_severity.eq3eq6[$eq3][$eq6] * 0.1)},
          {score: $lookup[cvss4_key([$eq1, $eq2, $eq3, ($eq4 | tonumber) + 1, $eq5, $eq6])], distance: $distance_eq4, depth: ($max_severity.eq4[$eq4] * 0.1)},
          {score: $lookup[cvss4_key([$eq1, $eq2, $eq3, $eq4, ($eq5 | tonumber) + 1, $eq6])], distance: 0, depth: 1}
        ]
      | map(select(.score != null) | (($value - .score) * (.distance / .depth))) as $normalized
      | ($value - (if ($normalized | length) == 0 then 0 else (($normalized | add) / ($normalized | length)) end)) as $score
      | (if $score < 0 then 0 elif $score > 10 then 10 else $score end)
      | ((. * 10) | round) / 10
    end;
def cvss4_score:
  cvss4_lookup as $lookup
  | cvss4_max_composed as $max_composed
  | cvss4_max_severity as $max_severity
  | cvss4_score_with($lookup; $max_composed; $max_severity);
def cvss4_score_band:
  if . >= 9 then "critical"
  elif . >= 7 then "high"
  elif . >= 4 then "moderate"
  elif . > 0 then "low"
  else "none"
  end;
def cvss4_band: cvss4_score | cvss4_score_band;
'
# --- ecosystem audit normalizers (shared local/remote; keep both copies identical) ---
# Each runner turns one scanner's native output into the same record. Three
# rules, all learned the hard way:
#   1. A scanner's EXIT STATUS is retained. These tools exit nonzero when they
#      find something AND when they break, so the shape of the output decides:
#      output we can read is a result, anything else is `status:"error"`.
#      "Ran, failed, reported zero findings" is the one answer that must never
#      be produced — it is indistinguishable from a clean project.
#   2. Counts are ADVISORIES, not dependencies. pip-audit lists every dependency
#      with its own `vulns` array, and composer keys advisories by package;
#      counting the outer container turns a clean project into findings.
#   3. A severity that cannot be determined is `unknown`, never `medium`.
#      Unknown severities warn; they never manufacture a severity band.
# shellcheck disable=SC2016
ECO_AUDIT_JQ_DEFS='
def sev_norm:
  (tostring | ascii_downcase)
  | if . == "critical" then "critical"
    elif . == "high" then "high"
    elif . == "moderate" or . == "medium" then "medium"
    elif . == "low" then "low"
    else "unknown" end;
def audit_doc($scanner; $sevs):
  {
    scanner: $scanner,
    status: "ok",
    total: ($sevs | length),
    critical: ([$sevs[] | select(. == "critical")] | length),
    high: ([$sevs[] | select(. == "high")] | length),
    medium: ([$sevs[] | select(. == "medium")] | length),
    low: ([$sevs[] | select(. == "low")] | length),
    unknown: ([$sevs[] | select(. == "unknown")] | length),
    note: null
  };
'

# ecosystem_audit_error <scanner> <exit-code> <stderr-file> <output>
# The note always contains "failed": consumers key their infrastructure
# refusal off the status, older readers off the note. A scanner that exited 0
# and whose OUTPUT is what we could not read says so — "failed (exit 0)"
# contradicts itself and reads as the scanner having broken when it had not.
ecosystem_audit_error() {
  local scanner="$1" rc="$2" stderr_file="$3" output="$4"
  local detail=""
  if [[ -r "$stderr_file" ]]; then
    detail="$(tr -d '\r' < "$stderr_file" | grep -v '^[[:space:]]*$' | tail -n 1)"
    detail="${detail:0:160}"
  fi
  local reason="${scanner} failed (exit ${rc})"
  if (( rc == 0 )); then
    reason="${scanner} output validation failed (scanner exit 0)"
  fi
  printf '%s\n' "$(render_ecosystem_audit_json "$scanner" "error" 0 0 0 0 0 \
    "${reason}${detail:+: ${detail}}" 0)" > "$output"
}

run_npm_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v npm >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "npm-audit" "skipped" 0 0 0 0 0 "npm unavailable" 0)" > "$output"
    return 0
  fi
  # `npm audit` reads an npm lockfile and nothing else. That is not a broken
  # scanner — it is evidence npm cannot read — but the two cases behind it are
  # very different:
  #   - a pnpm or Yarn lockfile: osv-scanner audits that lockfile, so the
  #     project IS covered. Deterministic, decided by files that are in the
  #     cache key: "unsupported", no verdict change, still cacheable.
  #   - no lockfile at all: nothing covers these dependencies. Reporting GO
  #     would mean "we looked at nothing and found nothing".
  if [[ ! -f "$dir/package-lock.json" && ! -f "$dir/npm-shrinkwrap.json" ]]; then
    if [[ -f "$dir/pnpm-lock.yaml" || -f "$dir/yarn.lock" ]]; then
      printf '%s\n' "$(render_ecosystem_audit_json "npm-audit" "unsupported" 0 0 0 0 0 "npm audit cannot read pnpm/yarn lockfiles; osv-scanner covers that evidence" 0)" > "$output"
    else
      printf '%s\n' "$(render_ecosystem_audit_json "npm-audit" "unsupported" 0 0 0 0 0 "no lockfile: these npm dependencies are not audited" 0)" > "$output"
    fi
    return 0
  fi
  local rc=0
  (cd "$dir" && npm audit --json) > "$output.raw" 2>"$output.stderr" || rc=$?
  # npm audit exits 1 when it finds something, so only the shape can tell a
  # result from a failure.
  if ! jq -e '(.metadata.vulnerabilities | type) == "object"' "$output.raw" >/dev/null 2>&1; then
    ecosystem_audit_error "npm-audit" "$rc" "$output.stderr" "$output"
    return 0
  fi
  jq "$ECO_AUDIT_JQ_DEFS"'
    (.metadata.vulnerabilities) as $v
    | ( [ range(0; $v.critical // 0) | "critical" ]
      + [ range(0; $v.high // 0)     | "high" ]
      + [ range(0; $v.moderate // 0) | "medium" ]
      + [ range(0; $v.low // 0)      | "low" ]
      + [ range(0; $v.info // 0)     | "unknown" ] ) as $sevs
    | audit_doc("npm-audit"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "npm-audit" "$rc" "$output.stderr" "$output"
}

run_composer_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v composer >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "composer-audit" "skipped" 0 0 0 0 0 "composer unavailable" 0)" > "$output"
    return 0
  fi
  local rc=0
  (cd "$dir" && composer audit --format=json) > "$output.raw" 2>"$output.stderr" || rc=$?
  # composer keys advisories BY PACKAGE: {"advisories":{"vendor/pkg":[...]}}.
  # Read as a flat array it finds nothing at all.
  if ! jq -e 'has("advisories")' "$output.raw" >/dev/null 2>&1; then
    ecosystem_audit_error "composer-audit" "$rc" "$output.stderr" "$output"
    return 0
  fi
  jq "$ECO_AUDIT_JQ_DEFS"'
    ( .advisories // {} ) as $a
    | [ if ($a | type) == "object" then ($a[] | .[]?) else ($a[]?) end ] as $adv
    | [ $adv[] | ((.severity // "unknown") | sev_norm) ] as $sevs
    | audit_doc("composer-audit"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "composer-audit" "$rc" "$output.stderr" "$output"
}

run_cargo_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v cargo-audit >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "cargo-audit" "skipped" 0 0 0 0 0 "cargo-audit unavailable" 0)" > "$output"
    return 0
  fi
  local rc=0
  (cd "$dir" && cargo audit --json) > "$output.raw" 2>"$output.stderr" || rc=$?
  if ! jq -e '(.vulnerabilities.list | type) == "array"' "$output.raw" >/dev/null 2>&1; then
    ecosystem_audit_error "cargo-audit" "$rc" "$output.stderr" "$output"
    return 0
  fi
  # RustSec advisories carry a CVSS vector far more often than a severity
  # word; scoring the vector is the only way most of them get a band at all.
  jq "$JQ_SEVERITY_DEFS$ECO_AUDIT_JQ_DEFS"'
    [ .vulnerabilities.list[]?
      | .advisory as $a
      | ( [ ($a.severity // empty | sev_norm) ]
        + [ ($a.cvss // empty | cvss3_band | sev_norm) ] ) as $cands
      | ( [ $cands[] | select(. != "unknown") ] + ["unknown"] )[0]
    ] as $sevs
    | audit_doc("cargo-audit"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "cargo-audit" "$rc" "$output.stderr" "$output"
}

run_govulncheck_dir() {
  local dir="$1" output="$2"
  if ! command -v govulncheck >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "govulncheck" "skipped" 0 0 0 0 0 "govulncheck unavailable" 0)" > "$output"
    return 0
  fi
  local rc=0
  (cd "$dir" && govulncheck -json ./...) > "$output.raw" 2>"$output.stderr" || rc=$?
  # In -json mode govulncheck reports findings IN the stream and exits 0; a
  # nonzero exit means the run itself failed (module loading, database), and
  # the stream it already wrote may be a complete-looking prefix.
  if (( rc != 0 )); then
    ecosystem_audit_error "govulncheck" "$rc" "$output.stderr" "$output"
    return 0
  fi
  # The stream is CONCATENATED JSON DOCUMENTS, pretty-printed across many lines
  # each — not NDJSON. `jq -s` slurps that shape natively (compact documents
  # too), and jq refusing the stream is the property to keep: a run that died
  # halfway leaves a truncated document, so "config record written, findings
  # lost" can never be read as a confident "zero findings". The stream must
  # also look like govulncheck: at least one record it actually emits.
  jq -s "$ECO_AUDIT_JQ_DEFS"'
    . as $docs
    | if ($docs | length) == 0 then error("empty govulncheck stream") else . end
    | if ([ $docs[] | select(type == "object")
            | select(has("config") or has("progress") or has("osv") or has("finding")) ] | length) == 0
      then error("stream is not govulncheck output") else . end
    | ( [ $docs[] | select(type == "object") | select(has("finding"))
          | (.finding.osv // "unknown") ] | unique ) as $ids
    | [ $ids[] | "unknown" ] as $sevs
    | audit_doc("govulncheck"; $sevs)
  ' "$output.raw" > "$output" 2>/dev/null || ecosystem_audit_error "govulncheck" "$rc" "$output.stderr" "$output"
}

run_pip_audit_dir() {
  local dir="$1" output="$2"
  if ! command -v pip-audit >/dev/null 2>&1; then
    printf '%s\n' "$(render_ecosystem_audit_json "pip-audit" "skipped" 0 0 0 0 0 "pip-audit unavailable" 0)" > "$output"
    return 0
  fi

  # EVERY declared target is audited, not the first one found: a vulnerable
  # dependency that appears only in requirements-dev.txt was never submitted
  # when the loop stopped at requirements.txt. A bare `pip-audit -f json`
  # audits the ACTIVE PYTHON ENVIRONMENT rather than the project, so a
  # pyproject is audited by path.
  local -a invocations=()
  local candidate
  for candidate in requirements.txt requirements-dev.txt; do
    [[ -f "$dir/$candidate" ]] && invocations+=("-r|$dir/$candidate")
  done
  [[ -f "$dir/pyproject.toml" ]] && invocations+=("project|$dir")

  if [[ "${#invocations[@]}" -eq 0 ]]; then
    printf '%s\n' "$(render_ecosystem_audit_json "pip-audit" "skipped" 0 0 0 0 0 "no supported python audit target found" 0)" > "$output"
    return 0
  fi

  local rc=0 invocation kind value index=0 last_rc=0
  local -a parts=()
  local -a failed=()
  for invocation in "${invocations[@]}"; do
    kind="${invocation%%|*}"
    value="${invocation#*|}"
    index=$((index + 1))
    rc=0
    if [[ "$kind" == "-r" ]]; then
      pip-audit -r "$value" -f json > "$output.raw.$index" 2>"$output.stderr" || rc=$?
    else
      pip-audit -f json "$value" > "$output.raw.$index" 2>"$output.stderr" || rc=$?
    fi
    # Both shapes are valid pip-audit: a bare list of dependencies, or
    # {"dependencies":[...]}. Either way the advisories live in each
    # dependency's `vulns` — the outer length is a package count, and counting
    # it made every clean Python project a pile of medium findings.
    if jq -e 'type == "array" or ((.dependencies | type) == "array")' "$output.raw.$index" >/dev/null 2>&1; then
      parts+=("$output.raw.$index")
    else
      # One target failing must not erase what another target FOUND: a
      # critical from requirements.txt has to survive requirements-dev.txt
      # breaking, or a real finding disappears behind an unrelated failure.
      failed+=("$(basename -- "$value") (exit ${rc})")
      last_rc="$rc"
    fi
  done

  if [[ "${#parts[@]}" -eq 0 ]]; then
    ecosystem_audit_error "pip-audit" "$last_rc" "$output.stderr" "$output"
    return 0
  fi

  # Advisories are merged across targets and deduplicated by package+id: the
  # same dependency pinned in two requirements files is one advisory. If some
  # target failed, the counts are real but incomplete: "partial" keeps them
  # counted while still telling every consumer that coverage is missing.
  local partial_note=""
  local audit_status="ok"
  if [[ "${#failed[@]}" -gt 0 ]]; then
    audit_status="partial"
    partial_note="pip-audit failed for: ${failed[*]}"
  fi
  jq -s --arg status "$audit_status" --arg note "$partial_note" "$ECO_AUDIT_JQ_DEFS"'
    [ .[]
      | (if type == "array" then . else (.dependencies // []) end)
      | .[]?
      | . as $dep
      | (.vulns // [])[]?
      | { key: (($dep.name // "?") + "@" + ($dep.version // "?") + "/" + (.id // "?")),
          severity: ((.severity // "unknown") | sev_norm) }
    ] as $all
    | ( $all | group_by(.key) | map(.[0].severity) ) as $sevs
    | audit_doc("pip-audit"; $sevs)
    | .status = $status
    | .note = (if $note == "" then null else $note end)
  ' "${parts[@]}" > "$output" 2>/dev/null || ecosystem_audit_error "pip-audit" "$last_rc" "$output.stderr" "$output"
}
# --- end ecosystem audit normalizers ---

run_project_ecosystem_audits() {
  local project_root="$1" output_dir="$2"
  mkdir -p "$output_dir"
  local audits=() ecosystem scanner output
  parse_project_config "$project_root/.safe-audit"
  for ecosystem in npm python php rust go; do
    project_ecosystem_should_audit "$project_root" "$ecosystem" || continue
    scanner="${PROJECT_SCANNERS[$ecosystem]}"
    output="$output_dir/${ecosystem}.json"
    case "$scanner" in
      npm-audit) run_npm_audit_dir "$project_root" "$output" ;;
      pip-audit) run_pip_audit_dir "$project_root" "$output" ;;
      composer-audit) run_composer_audit_dir "$project_root" "$output" ;;
      cargo-audit) run_cargo_audit_dir "$project_root" "$output" ;;
      govulncheck) run_govulncheck_dir "$project_root" "$output" ;;
      *) printf '%s\n' "$(render_ecosystem_audit_json "$scanner" "error" 0 0 0 0 0 "unknown scanner ${scanner}: audit configuration failed" 0)" > "$output" ;;
    esac
    audits+=("$output")
  done
  if [[ "${#audits[@]}" -eq 0 ]]; then
    printf '[]\n'
  else
    jq -s '.' "${audits[@]}"
  fi
}

declare -a lockfiles=() roots=() audit_files=()
declare -A seen_roots=()

while IFS= read -r -d '' file; do
  cfg=$(nearest_project_config "$(dirname "$file")" "$target" || true)
  if [[ -n "$cfg" ]]; then
    root=$(dirname "$cfg")
    parse_project_config "$cfg"
    rel=$(relative_to "$root" "$file")
    if path_matches_ignore "$rel"; then
      continue
    fi
  else
    root=$(dirname "$file")
  fi
  case "$(basename "$file")" in
    package-lock.json|npm-shrinkwrap.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb|uv.lock|poetry.lock|Pipfile.lock|composer.lock|Cargo.lock|go.sum|pom.xml|gradle.lockfile)
      lockfiles+=("$file")
      if [[ -z "${seen_roots[$root]:-}" ]]; then
        seen_roots["$root"]=1
        roots+=("$root")
      fi
      ;;
  esac
done < <(find "$target" -type f \( -name 'package-lock.json' -o -name 'pnpm-lock.yaml' -o -name 'yarn.lock' -o -name 'bun.lock' -o -name 'bun.lockb' -o -name 'uv.lock' -o -name 'poetry.lock' -o -name 'Pipfile.lock' -o -name 'composer.lock' -o -name 'Cargo.lock' -o -name 'go.sum' -o -name 'pom.xml' -o -name 'gradle.lockfile' \) -print0)

if [[ "${#roots[@]}" -eq 0 ]]; then
  roots=("$target")
fi

# Mirrors osv_uncovered_labels: the note a consumer reads carries lockfile
# NAMES, never paths — the install gate infers "scanner broken" from a regex
# over this string, so a project under error-pages/ must not read as one.
uncovered_labels() {
  local lf out=""
  local -A seen=()
  for lf in "$@"; do
    [[ -n "$lf" ]] || continue
    lf="$(basename "$lf")"
    [[ -z "${seen[$lf]:-}" ]] || continue
    seen["$lf"]=1
    [[ -z "$out" ]] || out+=", "
    out+="$lf"
  done
  printf '%s' "$out"
}

# Mirrors osv_lockfile_stand_in on the orchestrator side: osv-scanner aborts
# the whole batch on a file it has no extractor for, so go.sum resolves to its
# sibling go.mod and bun.lockb to its sibling bun.lock, or it is dropped.
declare -a scannable=() dropped=()
declare -A seen_scannable=()
for lf in ${lockfiles[@]+"${lockfiles[@]}"}; do
  sub=""
  case "$(basename "$lf")" in
    go.sum) [[ -f "$(dirname "$lf")/go.mod" ]] && sub="$(dirname "$lf")/go.mod" ;;
    bun.lockb) [[ -f "$(dirname "$lf")/bun.lock" ]] && sub="$(dirname "$lf")/bun.lock" ;;
    *) sub="$lf" ;;
  esac
  if [[ -z "$sub" ]]; then
    dropped+=("$lf")
    continue
  fi
  if [[ -z "${seen_scannable[$sub]:-}" ]]; then
    seen_scannable["$sub"]=1
    scannable+=("$sub")
  fi
done

if command -v osv-scanner >/dev/null 2>&1 && [[ "${#scannable[@]}" -gt 0 ]]; then
  args=(scan source --format json)
  for lf in "${scannable[@]}"; do args+=("--lockfile=$lf"); done
  set +e
  osv-scanner "${args[@]}" > "$scratch/osv.json" 2>"$scratch/osv.stderr"
  osv_rc=$?
  set -e
  # Validity is judged on the output alone, exactly as on the orchestrator
  # side: a nonzero exit with good JSON means findings, and a zero exit with
  # no JSON is still a lost tier.
  if ! jq -e 'type == "object" and ((.results? // null) | type == "array")' "$scratch/osv.json" >/dev/null 2>&1; then
    # This is a generated, single-quoted heredoc shipped to run standalone on a
    # remote host, so it CANNOT call osv_stderr_zero_packages (defined only in
    # the parent dispatcher). The benign-zero-packages test is inlined here as
    # the same literal grep the parent's helper uses; the two must stay in sync
    # (a regression over this generated helper guards against divergence).
    if grep -qF 'No package sources found' "$scratch/osv.stderr" 2>/dev/null; then
      # Every scanned lockfile held zero packages: a clean, dependency-free
      # project, not a lost tier. Mirrors the orchestrator-side handling so the
      # two osv paths cannot disagree about what an empty scan means.
      printf '{"results":[]}\n' > "$scratch/osv.json"
    else
      parts=()
      failed=()
      index=0
      for lf in "${scannable[@]}"; do
        part="$scratch/osv.part.$index"
        index=$((index + 1))
        set +e
        osv-scanner scan source --format json "--lockfile=$lf" > "$part" 2>"$part.stderr"
        set -e
        if jq -e 'type == "object" and ((.results? // null) | type == "array")' "$part" >/dev/null 2>&1; then
          parts+=("$part")
        elif grep -qF 'No package sources found' "$part.stderr" 2>/dev/null; then
          printf '{"results":[]}\n' > "$part"
          parts+=("$part")
        else
          failed+=("$lf")
        fi
      done
      if [[ "${#parts[@]}" -gt 0 ]] && jq -s '{results: (map(.results // []) | add // [])}' "${parts[@]}" > "$scratch/osv.merged" 2>/dev/null; then
        mv "$scratch/osv.merged" "$scratch/osv.json"
        dropped+=(${failed[@]+"${failed[@]}"})
      else
        rm -f "$scratch/osv.merged"
        printf '{"results":[],"error":"osv-scanner failed"}\n' > "$scratch/osv.json"
        dropped=()
      fi
    fi
  fi
  if [[ "${#dropped[@]}" -gt 0 ]]; then
    note="osv-scanner could not read: $(uncovered_labels "${dropped[@]}")"
    if jq --arg note "$note" '. + {partial: $note}' "$scratch/osv.json" > "$scratch/osv.annotated" 2>/dev/null; then
      mv "$scratch/osv.annotated" "$scratch/osv.json"
    else
      rm -f "$scratch/osv.annotated"
    fi
  fi
elif ! command -v osv-scanner >/dev/null 2>&1; then
  printf '{"results":[],"skipped":"osv-scanner unavailable","skip_reason":"scanner_unavailable"}\n' > "$scratch/osv.json"
elif [[ "${#dropped[@]}" -gt 0 ]]; then
  jq -n --arg note "no osv-parseable lockfile among those discovered: $(uncovered_labels "${dropped[@]}")" \
    '{results: [], skipped: $note, skip_reason: "no_parseable_lockfiles"}' > "$scratch/osv.json"
else
  printf '{"results":[],"skipped":"no lockfiles discovered","skip_reason":"no_lockfiles"}\n' > "$scratch/osv.json"
fi

if command -v syft >/dev/null 2>&1; then
  exclude_args=()
  mapfile -d '' -t exclude_args < <(collect_syft_exclude_args)
  if ! syft "dir:$target" -o cyclonedx-json "${exclude_args[@]}" > "$scratch/sbom.json" 2>"$scratch/sbom.stderr"; then
    printf '{"components":[],"metadata":{"tools":[{"name":"safe-audit","note":"syft failed"}]}}\n' > "$scratch/sbom.json"
  fi
else
  printf '{"components":[],"metadata":{"tools":[{"name":"safe-audit","note":"syft unavailable"}]}}\n' > "$scratch/sbom.json"
fi

if command -v grype >/dev/null 2>&1; then
  if ! grype "sbom:$scratch/sbom.json" -o json -q > "$scratch/grype.json" 2>"$scratch/grype.stderr"; then
    printf '{"matches":[],"error":"grype failed"}\n' > "$scratch/grype.json"
  fi
else
  printf '{"matches":[],"skipped":"grype unavailable"}\n' > "$scratch/grype.json"
fi

for root in "${roots[@]}"; do
  parse_project_config "$root/.safe-audit"
  run_project_ecosystem_audits "$root" "$scratch/$(slugify "$root")" > "$scratch/$(slugify "$root").audits.json"
  audit_files+=("$scratch/$(slugify "$root").audits.json")
done

if [[ "${#audit_files[@]}" -eq 0 ]]; then
  printf '[]\n' > "$scratch/ecosystem-audits.json"
else
  jq -s 'add' "${audit_files[@]}" > "$scratch/ecosystem-audits.json"
fi

tar -C "$scratch" -czf - osv.json grype.json sbom.json ecosystem-audits.json
EOF
}

remote_stage_helper_script() {
  cat <<'EOF'
set -euo pipefail
target="$1"
scan_mode="${2:-source}"
allow_source_fallback="${3:-1}"
cd "$target"

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

declare -a ignores=(
  .git
  .hg
  .svn
  node_modules
  vendor
  .venv
  venv
  env
  .tox
  .nox
  __pycache__
  .pytest_cache
  .mypy_cache
  .ruff_cache
  .cache
  .parcel-cache
  .turbo
  .next
  .nuxt
  .vite
  dist
  build
  out
  coverage
  target
)

find_pruned_files() {
  find . \( \
    -name '.git' -o \
    -name '.hg' -o \
    -name '.svn' -o \
    -name 'node_modules' -o \
    -name 'vendor' -o \
    -name '.venv' -o \
    -name 'venv' -o \
    -name 'env' -o \
    -name '.tox' -o \
    -name '.nox' -o \
    -name '__pycache__' -o \
    -name '.pytest_cache' -o \
    -name '.mypy_cache' -o \
    -name '.ruff_cache' -o \
    -name '.cache' -o \
    -name '.parcel-cache' -o \
    -name '.turbo' -o \
    -name '.next' -o \
    -name '.nuxt' -o \
    -name '.vite' -o \
    -name 'dist' -o \
    -name 'build' -o \
    -name 'out' -o \
    -name 'coverage' -o \
    -name 'target' \
  \) -prune -o -type f -print0 2>/dev/null
}

find_all_files() {
  find . -type f -print0 2>/dev/null
}

if [[ "$scan_mode" != "full" ]]; then
  while IFS= read -r -d '' cfg; do
    root=$(dirname "$cfg")
    rel_prefix="${root#./}"
    [[ "$rel_prefix" == "." ]] && rel_prefix=""
    [[ -n "$rel_prefix" ]] && rel_prefix="${rel_prefix%/}/"
    section=""
    while IFS= read -r raw || [[ -n "$raw" ]]; do
      line="${raw%%#*}"
      line="$(trim "$line")"
      [[ -z "$line" ]] && continue
      case "$line" in
        ecosystems:|scanners:) section=""; continue ;;
        ignore:) section="ignore"; continue ;;
      esac
      if [[ "$section" == "ignore" && "$line" =~ ^-[[:space:]]*(.+)$ ]]; then
        ignores+=("${rel_prefix}${BASH_REMATCH[1]}")
      fi
    done <"$cfg"
  done < <(find_pruned_files | while IFS= read -r -d '' f; do [[ "$(basename "$f")" == ".safe-audit" ]] && printf '%s\0' "$f"; done)
fi

matches_ignore() {
  local rel="${1#./}" pattern
  for pattern in "${ignores[@]}"; do
    if [[ "$rel" == $pattern || "$rel" == */$pattern || "$rel" == $pattern/* || "$rel" == */$pattern/* ]]; then
      return 0
    fi
  done
  return 1
}

manifest_matches() {
  case "$(basename "$1")" in
    package.json|package-lock.json|npm-shrinkwrap.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb|uv.lock|poetry.lock|Pipfile.lock|pyproject.toml|requirements*.txt|composer.json|composer.lock|Cargo.toml|Cargo.lock|go.mod|go.sum|pom.xml|gradle.lockfile|build.gradle|build.gradle.kts|.safe-audit)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

lockfile_matches() {
  case "$(basename "$1")" in
    package-lock.json|npm-shrinkwrap.json|pnpm-lock.yaml|yarn.lock|bun.lock|bun.lockb|uv.lock|poetry.lock|Pipfile.lock|composer.lock|Cargo.lock|go.sum|pom.xml|gradle.lockfile)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

project_root_manifest_matches() {
  manifest_matches "$1"
}

source_file_matches() {
  local base ext
  base=$(basename "$1")
  manifest_matches "$1" && return 0
  case "$base" in
    Dockerfile|Containerfile|Makefile|GNUmakefile|Gemfile|Rakefile|Procfile|Brewfile|Justfile|Taskfile.yml|Taskfile.yaml|Jenkinsfile|Vagrantfile|.envrc|.npmrc|.yarnrc|.yarnrc.yml|.pypirc|.gitignore|.dockerignore|.editorconfig)
      return 0
      ;;
  esac
  ext="${base##*.}"
  case "$ext" in
    sh|bash|zsh|fish|ps1|psm1|bat|cmd|js|mjs|cjs|jsx|ts|tsx|mts|cts|py|pyw|rb|php|go|rs|java|kt|kts|scala|c|cc|cpp|cxx|h|hh|hpp|cs|swift|m|mm|lua|pl|pm|r|R|dart|ex|exs|erl|hrl|clj|cljs|fs|fsx|sql|graphql|gql|html|htm|css|scss|sass|less|json|jsonc|json5|yaml|yml|toml|ini|cfg|conf|properties|xml|lock|md|mdx|rst|txt)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

declare -a manifests=() roots=()
declare -A seen_roots=()

add_root() {
  local root="${1#./}"
  [[ -n "$root" && "$root" != "." ]] || root="."
  if [[ -z "${seen_roots[$root]:-}" ]]; then
    seen_roots["$root"]=1
    roots+=("$root")
  fi
}

under_root() {
  local rel="${1#./}" root
  for root in "${roots[@]}"; do
    root="${root#./}"
    if [[ "$root" == "." || "$rel" == "$root" || "$rel" == "$root"/* ]]; then
      return 0
    fi
  done
  return 1
}

list=$(mktemp)
if [[ "$scan_mode" != "full" ]]; then
  while IFS= read -r -d '' file; do
    if matches_ignore "$file"; then
      continue
    fi
    if manifest_matches "$file"; then
      manifests+=("$file")
    fi
    if project_root_manifest_matches "$file"; then
      add_root "$(dirname "$file")"
    fi
  done < <(find_pruned_files)
fi

if [[ "${#roots[@]}" -eq 0 && "$allow_source_fallback" == "1" ]]; then
  roots=(".")
fi

case "$scan_mode" in
  deps)
    for file in "${manifests[@]}"; do
      printf '%s\0' "$file" >> "$list"
    done
    ;;
  source)
    while IFS= read -r -d '' file; do
      matches_ignore "$file" && continue
      under_root "$file" || continue
      source_file_matches "$file" || continue
      printf '%s\0' "$file" >> "$list"
    done < <(find_pruned_files)
    ;;
  full)
    find_all_files >> "$list"
    ;;
  *)
    for file in "${manifests[@]}"; do
      printf '%s\0' "$file" >> "$list"
    done
    ;;
esac

if [[ -s "$list" ]]; then
  tar --null -T "$list" -czf - 2>/dev/null
else
  tar -czf - --files-from /dev/null
fi
EOF
}

machine_supports_remote_tunneled_scan() {
  local machine="$1"
  [[ "$(machine_type "$machine")" == "ssh" ]] || return 1
  [[ -n "$(local_scanner_path "syft")" ]] || return 1
  [[ -n "$(local_scanner_path "osv-scanner")" ]] || return 1
  [[ -n "$(local_scanner_path "grype")" ]] || return 1
}

scan_remote_with_local_bundles_into_result() {
  local machine="$1" target="$2" scan_mode="${3:-full}" allow_source_fallback="${4:-1}"
  local host scratch remote_tmp rc source
  local statuses=()
  host=$(machine_host "$machine")
  new_scratch_dir scratch
  new_scratch_dir source
  vinfo "$machine: trying tunneled remote scan target=$(printf '%q' "$target") host=$(printf '%q' "$host")"

  remote_tmp=$(ssh_batch "$host" 'tmp=$(mktemp -d); mkdir -p "$tmp/bin"; printf "%s" "$tmp"')
  [[ -n "$remote_tmp" ]] || return 1

  if ! scp_batch -q \
    "$(local_scanner_path "syft")" \
    "$host:$remote_tmp/bin/"; then
    ssh_batch "$host" "rm -rf $(printf '%q' "$remote_tmp")" >/dev/null 2>&1 || true
    return 1
  fi

  set +e
  remote_scan_helper_script \
    | ssh_batch "$host" "SAFE_AUDIT_SCANNER_DIR=$(printf '%q' "$remote_tmp/bin") SAFE_AUDIT_REMOTE_SBOM_ONLY=1 bash -s -- $(printf '%q' "$target")" \
    | tar -xzf - -C "$scratch"
  statuses=("${PIPESTATUS[@]}")
  set -e
  ssh_batch "$host" "rm -rf $(printf '%q' "$remote_tmp")" >/dev/null 2>&1 || true
  local status
  for status in "${statuses[@]}"; do
    [[ "$status" -ge 130 ]] && return "$status"
  done
  rc=0
  for ((i=${#statuses[@]} - 1; i >= 0; i--)); do
    if [[ "${statuses[$i]}" -ne 0 ]]; then
      rc="${statuses[$i]}"
      break
    fi
  done
  if [[ "$rc" -ne 0 ]]; then
    warn "$machine: tunneled remote scan failed, falling back"
    return 1
  fi

  gather_stage_remotely "$machine" "$target" "$source" "$scan_mode" "$allow_source_fallback"
  scan_source_with_external_sbom_into_result \
    "$machine" "$source" "$target" "ssh-remote-tunneled" "$scratch/sbom.json" "$scan_mode" "$allow_source_fallback"
}

scan_remote_direct_into_result() {
  local machine="$1" target="$2" scan_mode="${3:-full}"
  local host scratch rc
  local statuses=()
  host=$(machine_host "$machine")
  new_scratch_dir scratch
  vinfo "$machine: trying remote direct scan target=$(printf '%q' "$target") host=$(printf '%q' "$host")"

  set +e
  remote_scan_helper_script | ssh_batch "$host" "bash -s -- $(printf '%q' "$target")" | tar -xzf - -C "$scratch"
  statuses=("${PIPESTATUS[@]}")
  set -e
  local status
  for status in "${statuses[@]}"; do
    [[ "$status" -ge 130 ]] && return "$status"
  done
  rc=0
  for ((i=${#statuses[@]} - 1; i >= 0; i--)); do
    if [[ "${statuses[$i]}" -ne 0 ]]; then
      rc="${statuses[$i]}"
      break
    fi
  done
  if [[ "$rc" -ne 0 ]]; then
    warn "$machine: remote direct scan failed, falling back to staged local scan"
    return 1
  fi

  build_scan_result_from_artifacts \
    "$machine" "$target" "ssh-remote-direct" \
    "$scratch/sbom.json" "$scratch/osv.json" "$scratch/grype.json" "$scratch/ecosystem-audits.json" "$scan_mode"
}

scan_machine() {
  local machine="$1" project_target="${2:-}" scan_mode="${3:-$SAFE_AUDIT_SCAN_MODE}"
  SCAN_DEGRADED_TIERS=""
  vinfo "$machine: configured type=$(machine_type "$machine") host=$(printf '%q' "$(machine_host "$machine")") project_target=$(printf '%q' "$project_target")"
  if ! machine_reachable "$machine"; then
    warn "$machine: host unreachable; skipping scan"
    return 0
  fi
  detect_machine_tools "$machine" 1
  local confirm_rc
  confirm_scan_with_missing_tools "$machine" "$project_target"
  confirm_rc=$?
  case "$confirm_rc" in
    0) ;;
    2) return 2 ;;
    *) return "$confirm_rc" ;;
  esac

  local target="${project_target:-$(machine_scan_root "$machine")}"
  local strategy="" source=""
  local allow_source_fallback=0
  [[ -n "$project_target" ]] && allow_source_fallback=1
  vinfo "$machine: resolved target=$(printf '%q' "$target")"
  if [[ "$(machine_type "$machine")" == "local" ]]; then
    source=$(path_abs "$target")
    strategy="local-direct"
    vinfo "$machine: using local direct scan source=$(printf '%q' "$source")"
  elif [[ "$scan_mode" == "full" ]] && machine_supports_remote_direct_scan "$machine"; then
    if scan_remote_direct_into_result "$machine" "$target" "$scan_mode"; then
      return 0
    fi
    if machine_supports_remote_tunneled_scan "$machine" && scan_remote_with_local_bundles_into_result "$machine" "$target" "$scan_mode" "$allow_source_fallback"; then
      return 0
    fi
    new_scratch_dir source
    gather_stage_remotely "$machine" "$target" "$source" "$scan_mode" "$allow_source_fallback"
    strategy="ssh-stage-local"
    vinfo "$machine: using staged remote scan source=$(printf '%q' "$source")"
  elif [[ "$scan_mode" == "full" ]] && machine_supports_remote_tunneled_scan "$machine"; then
    if scan_remote_with_local_bundles_into_result "$machine" "$target" "$scan_mode" "$allow_source_fallback"; then
      return 0
    fi
    new_scratch_dir source
    gather_stage_remotely "$machine" "$target" "$source" "$scan_mode" "$allow_source_fallback"
    strategy="ssh-stage-local"
    vinfo "$machine: using staged remote scan source=$(printf '%q' "$source")"
  else
    new_scratch_dir source
    gather_stage_remotely "$machine" "$target" "$source" "$scan_mode" "$allow_source_fallback"
    strategy="ssh-stage-local"
    vinfo "$machine: using staged remote scan source=$(printf '%q' "$source")"
  fi
  scan_source_into_result "$machine" "$source" "$target" "$strategy" "$scan_mode" "$allow_source_fallback"
}

guess_ecosystem_from_spec() {
  local spec="$1"
  if [[ "$spec" == @*/* ]]; then
    echo "npm"
  elif [[ "$spec" == *"::"* || "$spec" == *"-"* && "$spec" != *"@"* ]]; then
    echo "python"
  elif [[ "$spec" == *"/"* ]]; then
    echo "go"
  else
    echo "npm"
  fi
}

parse_pkg_spec() {
  local spec="$1"
  if [[ "$spec" == @*/*@* ]]; then
    PKG_NAME="${spec%@*}"
    PKG_VERSION="${spec##*@}"
  elif [[ "$spec" == @* ]]; then
    # A bare scoped name (@scope/pkg) has no version separator — its
    # leading @ is part of the name, not a split point (delta-6, exposed by
    # the scoped-key resolution tests).
    PKG_NAME="$spec"
    PKG_VERSION="latest"
  elif [[ "$spec" == *@* ]]; then
    PKG_NAME="${spec%@*}"
    PKG_VERSION="${spec##*@}"
  else
    PKG_NAME="$spec"
    PKG_VERSION="latest"
  fi
}

# The blocklist files that carry authority for the current root, in search
# order (populates BLOCKLIST_AUTHORITY_FILES). Canonical is ALWAYS included
# (fail-closed doctrine + standing operator ruling "fail-closed stays for malice
# signals — blocklist ...": a redirected root — blessed OR not — may ADD blocks
# but must never HIDE a canonical one; the SAFE_RUN_TRUST_OVERRIDE token blesses
# trust GRANTS, never the suppression of a block, #87 F2). A non-canonical root
# also searches its redirected store; canonical is the literal $HOME-anchored
# path (symlink-flip immune, F3). The reader (blocked_entry_reason) and the
# fail-closed validity gate (blocklist_authority_readable) MUST consume this
# SAME list — a member validated-but-not-searched, or searched-but-not-validated,
# reopens the N2 hole.
blocklist_authority_files() {
  BLOCKLIST_AUTHORITY_FILES=("$SAFE_RUN_CANONICAL_CONFIG_DIR/blocked.json")
  trust_store_is_canonical || BLOCKLIST_AUTHORITY_FILES+=("$SAFE_RUN_BLOCKED_FILE")
}

# Fail-closed validity across EVERY authority member actually searched. Absent
# is legitimate (relocation / not-yet-seeded), but a present member that cannot
# be read or does not validate is breakage — return 1 (names it in
# BLOCKLIST_UNREADABLE_FILE) so the decision layer demotes to WARN rather than
# treating a hidden or garbled block as "not blocked" (#87 N2).
blocklist_authority_readable() {
  local f
  blocklist_authority_files
  for f in "${BLOCKLIST_AUTHORITY_FILES[@]}"; do
    # Present (`-e`), not "regular file" (`-f`): a non-regular node at the path
    # (e.g. a directory at canonical blocked.json) must fail closed like any
    # unreadable member, matching the run lane's in_blocked. Only a genuinely
    # ABSENT member is skipped as legitimate relocation (#87 N2 lane parity).
    [[ -e "$f" ]] || continue
    if ! jq -e '
      (type == "object") and ((.packages // {}) | type == "object")
      and ((.packages // {}) | [to_entries[] | .value | type == "object"] | all)
    ' "$f" >/dev/null 2>&1; then
      BLOCKLIST_UNREADABLE_FILE="$f"
      return 1
    fi
  done
  return 0
}

blocked_entry_reason() {
  local pkg="$1"
  blocklist_authority_files
  local f entry
  for f in "${BLOCKLIST_AUTHORITY_FILES[@]}"; do
    [[ -f "$f" ]] || continue
    entry=$(jq -r --arg p "$pkg" '.packages[$p] // empty' "$f")
    if [[ -n "$entry" ]]; then
      printf '%s' "$(printf '%s' "$entry" | jq -r '.reason // "blocked"')"
      return 0
    fi
    if [[ "$pkg" == @*/* ]]; then
      local wildcard="${pkg%%/*}/*"
      entry=$(jq -r --arg p "$wildcard" '.packages[$p] // empty' "$f")
      if [[ -n "$entry" ]]; then
        printf '%s' "$(printf '%s' "$entry" | jq -r '.reason // "blocked"')"
        return 0
      fi
    fi
  done
  return 1
}

socket_timeout_value_ok() {
  [[ "$1" =~ ^[1-9][0-9]{0,4}$ ]]
}

socket_fresh_scan_budget_seconds() {
  local budget="${SAFE_AUDIT_SOCKET_FRESH_SCAN_TIMEOUT:-}"
  if [[ -z "$budget" ]]; then
    budget=$(install_policy_json | jq -r '.socket.fresh_scan_budget_seconds // 90' 2>/dev/null || true)
  fi
  socket_timeout_value_ok "$budget" || budget=90
  printf '%s\n' "$budget"
}

socket_cache_ttl_seconds() {
  local days
  days=$(install_policy_json | jq -r '.socket.cache_ttl_days // 7' 2>/dev/null || true)
  [[ "$days" =~ ^[0-9]{1,4}$ ]] || days=7
  (( days > 0 )) || { printf '0\n'; return 0; }
  printf '%s\n' "$(( days * 86400 ))"
}

# Resolve the Socket cache root. Env override wins (tests, ad-hoc), then the
# first-class install.socket.cache_dir, then the per-user default. A leading
# ~ / ~/ in the config value expands to $HOME so a synced path reads naturally.
socket_cache_dir() {
  if [[ -n "${SAFE_AUDIT_SOCKET_CACHE_DIR:-}" ]]; then
    printf '%s\n' "$SAFE_AUDIT_SOCKET_CACHE_DIR"
    return 0
  fi
  local dir
  dir=$(install_policy_json | jq -r '.socket.cache_dir // empty' 2>/dev/null || true)
  case "$dir" in
    "~") dir="$HOME" ;;
    "~/"*) dir="$HOME/${dir#\~/}" ;;
  esac
  [[ -n "$dir" ]] || dir="$HOME/.cache/safe/socket"
  printf '%s\n' "$dir"
}

# A RECOGNIZED success envelope: everything the verdict is derived from must
# be present and well-typed, and every alert must be classifiable — an alert
# whose severity is outside Socket's enum is an unknown class that must WARN,
# never count as clean (the malice BLOCK below reads this same array).
#
# Deliberately silent about `.data.transitively`: the verdict never reads the
# dependency tree (that is the project-scan lane's job), so asserting its shape
# here would let a future Socket schema change turn every check into an
# infra-WARN for no gain. Its shape is pinned in tests/live/socket_envelope.sh
# instead, where a drift is a loud test failure rather than a live outage.
socket_envelope_valid() {
  jq -e '
    (.ok == true)
    and (.data | type == "object")
    and (.data.self | type == "object")
    and (.data.self.score | type == "object")
    and (.data.self.score.overall | type == "number")
    and (.data.self.alerts | type == "array")
    and ([.data.self.alerts[]
          | select((type == "object")
            and ((.name | type) == "string" and (.name | length) > 0)
            and ((.severity | type) == "string"
                 and (.severity as $severity
                      | ["critical", "high", "middle", "low"] | index($severity)))
            and ((.category | type) == "string" and (.category | length) > 0))]
         | length) == (.data.self.alerts | length)
  ' "$1" >/dev/null 2>&1
}

# Classify one validated Socket result into exactly one verdict-bearing class.
# EXHAUSTIVE by construction: `unmapped` catches any alert severe enough to
# matter whose category safe does not know. Socket can add a category at any
# time, and an unknown class must never fall through to clean — that is the
# same principle the severity enum enforces in socket_envelope_valid, applied
# one field over (review F3: a critical alert in a new category reached PASS).
#
# Precedence, strongest first: malware, unmapped-critical, critical CVE,
# high, low score, clean.
socket_classify() {
  jq -r '
    [.raw.data.self.alerts[]?] as $alerts
    | ($alerts | map(select(.severity == "critical"))) as $critical
    | if ($critical | map(select(.category == "supplyChainRisk")) | length) > 0 then "malware"
      elif ($critical | map(select(.category != "supplyChainRisk"
                                   and .category != "vulnerability")) | length) > 0 then "unmapped"
      elif ($critical | map(select(.category == "vulnerability")) | length) > 0 then "critical_cve"
      elif ($alerts | map(select(.severity == "high")) | length) > 0 then "high"
      elif (.raw.data.self.score.overall < 70) then "low_score"
      else "clean"
      end
  ' "$1" 2>/dev/null || printf 'unmapped'
}

socket_cache_identity_json() {
  local ecosystem="$1" name="$2" version="$3"
  jq -cn --arg ecosystem "$ecosystem" --arg name "$name" --arg version "$version" \
    '{schema:1,source:{name:"socket",envelope:1},identity:{ecosystem:$ecosystem,name:$name,version:$version}}'
}

socket_cache_key() {
  local identity_json="$1" material
  material=$(jq -cnS --argjson identity "$identity_json" '$identity' 2>/dev/null) || return 1
  printf '%s' "$material" | sha256sum 2>/dev/null | awk '{print $1}'
}

socket_cache_replay() {
  local ecosystem="$1" name="$2" version="$3" output="$4"
  SOCKET_CACHE_STALE_SCORE=""
  SOCKET_CACHE_STALE_AGE_DAYS=""
  local ttl identity key entry fetched age now cache_dir
  ttl=$(socket_cache_ttl_seconds)
  (( ttl > 0 )) || return 1
  identity=$(socket_cache_identity_json "$ecosystem" "$name" "$version") || return 1
  key=$(socket_cache_key "$identity") || return 1
  cache_dir=$(socket_cache_dir)
  entry="$cache_dir/$key.json"
  [[ -f "$entry" ]] || return 1
  fetched=$(jq -r --argjson identity "$identity" --argjson schema "$SOCKET_CACHE_SCHEMA" '
    if .schema == $schema and .source == $identity.source and .identity == $identity.identity
       and (.fetched_at | type == "number")
       and (.fetched_at >= 0 and .fetched_at == (.fetched_at | floor))
    then .fetched_at else empty end
  ' "$entry" 2>/dev/null) || return 1
  [[ "$fetched" =~ ^[0-9]+$ ]] || return 1
  local cached_result
  cached_result=$(mktemp "${TMPDIR:-/tmp}/safe-socket-cache.XXXXXX") || return 1
  if ! jq '.result // {}' "$entry" > "$cached_result" \
    || ! socket_envelope_valid "$cached_result"; then
    rm -f "$cached_result"
    return 1
  fi
  now=$(date +%s)
  age=$(( now - fetched ))
  (( age >= 0 )) || age=0
  if (( age > ttl )); then
    SOCKET_CACHE_STALE_SCORE=$(jq -r '.data.self.score.overall // empty' "$cached_result" 2>/dev/null || true)
    [[ "$SOCKET_CACHE_STALE_SCORE" =~ ^[0-9]+([.][0-9]+)?$ ]] || SOCKET_CACHE_STALE_SCORE=""
    SOCKET_CACHE_STALE_AGE_DAYS=$(( (age + 86399) / 86400 ))
    rm -f "$cached_result"
    return 1
  fi
  jq -n --slurpfile entry "$entry" --argjson age "$age" '
    {available:true,status:"ok",note:null,cached:true,cache_age_seconds:$age,
     raw:($entry[0].result // {})}
  ' > "$output" || return 1
  rm -f "$cached_result"
  socket_envelope_valid <(jq '.raw' "$output") || return 1
}

socket_cache_store() {
  local ecosystem="$1" name="$2" version="$3" raw="$4"
  local ttl identity key tmp cache_dir
  ttl=$(socket_cache_ttl_seconds)
  (( ttl > 0 )) || return 0
  socket_envelope_valid "$raw" || return 0
  identity=$(socket_cache_identity_json "$ecosystem" "$name" "$version") || return 0
  key=$(socket_cache_key "$identity") || return 0
  cache_dir=$(socket_cache_dir)
  umask 077
  mkdir -p "$cache_dir" 2>/dev/null || return 0
  chmod 700 "$cache_dir" 2>/dev/null || return 0
  tmp=$(mktemp "$cache_dir/.${key}.XXXXXX") || return 0
  if jq -n --argjson schema "$SOCKET_CACHE_SCHEMA" --argjson identity "$identity" \
      --argjson fetched_at "$(date +%s)" --slurpfile result "$raw" '
      {schema:$schema,source:$identity.source,identity:$identity.identity,
       fetched_at:$fetched_at,result:($result[0] // {})}
    ' > "$tmp"; then
    chmod 600 "$tmp" && mv -f "$tmp" "$cache_dir/$key.json"
  else
    rm -f "$tmp"
  fi
}

socket_score_json() {
  local ecosystem="$1" spec="$2" output="$3" socket_budget="${4:-${SAFE_AUDIT_SOCKET_TIMEOUT:-30}}"
  local cache_name="${5:-}" cache_version="${6:-}"
  if [[ -n "$cache_name" && -n "$cache_version" ]] \
    && socket_cache_replay "$ecosystem" "$cache_name" "$cache_version" "$output"; then
    return 0
  fi
  # Socket has no Maven/JVM tier: a java score would purl as pkg:java/... and
  # 400. Skip honestly with the same envelope install.socket.mode=never uses, so
  # the verdict layer keeps advisories/blocklist/release-age and WARNs — never a
  # false GO, and never the infra-outage wording a 400 would otherwise produce.
  if [[ "$ecosystem" == "java" ]]; then
    jq -n '{available:null,status:"skipped",note:"Socket has no Maven tier"}' > "$output"
    return 0
  fi
  # The socket CLI takes a purl type, not safe's ecosystem name. Only npm
  # coincides: "python"/"rust"/"go"/"php" produced pkg:python/... etc., which
  # the API rejects with 400 Bad Request — every non-npm score has been
  # degrading to an infra-WARN since the socket path landed.
  local purl_type
  case "$ecosystem" in
    python) purl_type="pypi" ;;
    rust) purl_type="cargo" ;;
    go) purl_type="golang" ;;
    php) purl_type="composer" ;;
    *) purl_type="$ecosystem" ;;
  esac
  local socket_cmd
  # Resolved through the tool cache, not a bespoke PATH: socket is commonly a
  # mise shim, which the old two-directory prepend never covered, so a caller
  # whose PATH lacked the shim dir got "socket CLI not available" — a WARN
  # that reads like a supply-chain signal rather than a missing binary.
  socket_cmd=$(resolve_local_tool socket)
  if [[ -z "$socket_cmd" ]]; then
    printf '{"available":false,"status":"error","note":"socket CLI not available"}\n' > "$output"
    return 0
  fi
  # Socket needs SOCKET_SECURITY_API_TOKEN for authenticated package scores.
  # Interactive shells get it from the socket() zsh wrapper, but safe invokes
  # the CLI binary directly — inject it from Bitwarden via bw-env-run when the
  # helper and its mapping file exist and the token is not already in the env.
  local bw_env_run socket_mapping="$HOME/.config/setup-new-machines/bw-env.d/socket.env"
  bw_env_run=$(PATH="$HOME/.local/bin:$PATH" command -v bw-env-run 2>/dev/null || true)
  local can_inject=false
  [[ -n "$bw_env_run" && -f "$socket_mapping" ]] && can_inject=true

  local -a socket_invocation=("$socket_cmd")
  local injected=false
  if [[ -z "${SOCKET_SECURITY_API_TOKEN:-}" && "$can_inject" == "true" ]]; then
    socket_invocation=("$bw_env_run" --file "$socket_mapping" -- "$socket_cmd")
    injected=true
  fi
  # stdin closed: stdout/stderr go to files, so any interactive prompt from the
  # invocation (socket itself, or bw-env-run's master-password fallback when the
  # session cache fails) would otherwise hang invisibly waiting on the terminal.
  # With EOF stdin those paths fail fast and the error lands in $output.stderr.
  # The call is also WALL-CLOCK bounded: the gate wrapper hands this probe a
  # 15s sub-budget via SAFE_AUDIT_SOCKET_TIMEOUT and leashes the whole check
  # with a computed backstop that exceeds the sum of all component budgets
  # (safe_gate_audit_leash_seconds in lib/gate-lib.sh) — this budget is the
  # operative bound, never the gate leash. A direct `safe-audit package-audit` had no
  # bound at all, and an
  # intermittently wedged socket CLI hung it for minutes with zero output —
  # which reads as breakage and teaches an agent to route around the gate
  # (contract-test finding 1). A timeout is an infrastructure failure like any
  # other socket failure: legible note, WARN, never a package finding.
  local -a socket_leash=()
  if command -v timeout >/dev/null 2>&1; then
    # --kill-after: a TERM-resistant socket child would otherwise outlive
    # its budget indefinitely (same class as the gate leash, PR#65 delta N2).
    socket_leash=(timeout --kill-after=2s "$socket_budget")
  else
    # No way to bound the call: refusing to start it is the only shape
    # that cannot hang. The WARN says exactly what coverage was lost and
    # why — never a package finding (PR7 review F2). Every other network
    # primitive in a check is individually curl --max-time bounded, so
    # this was the last unboundable call.
    printf '{"available":true,"status":"error","reason":"unbounded","note":"socket score skipped: no timeout binary to bound the call (install coreutils)"}\n' > "$output"
    return 0
  fi
  local score_ok=true score_rc=0
  # Group stderr to /dev/null: the child's own stderr already goes to a
  # file, so this discards only the SHELL's job-death diagnostic when the
  # KILL escalation fires (timeout signals its own group — PR#65 delta-2 N3).
  { "${socket_leash[@]}" "${socket_invocation[@]}" package score "$purl_type" "$spec" --json > "$output.raw" 2>"$output.stderr" </dev/null || { score_rc=$?; score_ok=false; }; } 2>/dev/null
  if [[ "$score_ok" == "false" && ( "$score_rc" == "124" || "$score_rc" == "137" ) ]]; then
    printf '%s\n' "$(jq -n --arg note "socket score timed out after ${socket_budget}s" '{available:true,status:"error",reason:"timeout",timeout:true,note:$note}')" > "$output"
    return 0
  fi

  # An ambient SOCKET_SECURITY_API_TOKEN can be stale (e.g. a long-lived shell
  # still exporting a pre-rotation value). If we trusted it and socket failed
  # on auth, retry once with the vault-injected token.
  if [[ "$score_ok" == "false" && "$injected" == "false" && "$can_inject" == "true" ]] \
    && grep -qiE "token|api key|auth" "$output.raw" "$output.stderr" 2>/dev/null; then
    local retry_rc=0 retry_ok=true
    # Same group-stderr silencing as the first attempt (delta-2 N3).
    { "${socket_leash[@]}" env -u SOCKET_SECURITY_API_TOKEN "$bw_env_run" --file "$socket_mapping" -- \
      "$socket_cmd" package score "$purl_type" "$spec" --json \
      > "$output.raw" 2>"$output.stderr" </dev/null || { retry_rc=$?; retry_ok=false; }; } 2>/dev/null
    if [[ "$retry_ok" == "true" ]]; then
      score_ok=true
    else
      # A retry that hit the leash must keep the timeout diagnosis: the
      # generic path below would read the (empty) kill-time output and
      # report a bare "socket command failed" (PR7 review F1).
      if [[ "$retry_rc" == "124" || "$retry_rc" == "137" ]]; then
        printf '%s\n' "$(jq -n --arg note "socket score timed out after ${socket_budget}s" '{available:true,status:"error",reason:"timeout",timeout:true,note:$note}')" > "$output"
        return 0
      fi
    fi
  fi

  if [[ "$score_ok" == "false" ]]; then
    # Provider error bodies can carry account context (operator identity, org
    # name) and, if the vendor ever reflects it, credential material. Classify
    # the failure here into a FIXED reason code and discard the text: the
    # response body must never reach stdout, stderr, a receipt, a cache, or a
    # log (review F5). Callers switch on .reason, never on prose.
    local probe reason note
    probe=$( { jq -r '[.message?, .cause?] | map(select(type == "string")) | join(" ")' \
                 "$output.raw" 2>/dev/null; cat "$output.stderr" 2>/dev/null; } | tr '\n' ' ' || true)
    case "$probe" in
      # 429 first: its body never mentions auth, and a bare "API" match used to
      # relabel any failure (even spinner text) as an auth problem.
      *"Too Many Requests"*|*" 429"*|*"rate limit"*) reason="rate_limited"; note="socket rate-limited" ;;
      *Unauthorized*|*" 401"*|*token*|*Token*|*"api key"*|*"API key"*) reason="auth"; note="socket authentication required" ;;
      *"Not Found"*|*" 404"*) reason="not_found"; note="socket has no record of this package version" ;;
      *) reason="error"; note="socket command failed" ;;
    esac
    unset probe
    printf '%s\n' "$(jq -n --arg reason "$reason" --arg note "$note" \
      '{available:true,status:"error",reason:$reason,note:$note}')" > "$output"
    return 0
  fi
  if ! socket_envelope_valid "$output.raw"; then
    printf '{"available":true,"status":"error","reason":"malformed","note":"socket returned an unrecognized result shape"}\n' > "$output"
    return 0
  fi
  jq -n --slurpfile data "$output.raw" '
    ($data[0] // {}) as $r |
    {
      available: true,
      status: "ok",
      note: null,
      cached: false,
      cache_age_seconds: null,
      raw: $r
    }
  ' > "$output"
  if [[ -n "$cache_name" && -n "$cache_version" ]]; then
    socket_cache_store "$ecosystem" "$cache_name" "$cache_version" "$output.raw"
  fi
}

# Release-age lookup for the cooldown check: the minimum age (days) across
# the resolved versions, from the public registry's publish timestamps.
# Best-effort cache plumbing for a WARN-tier heuristic: rc=1 (lookup failed)
# means the cooldown is skipped with a disclosed note, never a refusal.
# rc=2: no publish-time source for this ecosystem — check not applicable.
# stdout on success: "<age_days>\t<version>\t<published_iso>\t<ages_json>"
# where ages_json maps EVERY resolved version to its age — the security-fix
# exemption must know the full young set, not just the youngest member.
release_min_age_days() {
  local ecosystem="$1" name="$2" scratch="$3"
  shift 3
  local -a versions=()
  local v
  versions=("$@")
  local encoded_name meta now_epoch published epoch age
  local min_age="" min_version="" min_published=""
  local -a age_entries=()
  now_epoch=$(date +%s)
  encoded_name=$(urlencode "$name")
  case "$ecosystem" in
    npm)
      meta="$scratch/release-times.json"
      curl -fsSL --max-time 5 "https://registry.npmjs.org/${encoded_name}" \
        -o "$meta" 2>/dev/null || return 1
      for v in "${versions[@]}"; do
        published=$(jq -r --arg v "$v" '.time[$v] // empty | strings' "$meta" 2>/dev/null || true)
        [[ -n "$published" ]] || return 1
        epoch=$(date -d "$published" +%s 2>/dev/null) || return 1
        age=$(( (now_epoch - epoch) / 86400 ))
        (( age < 0 )) && age=0
        age_entries+=("$v"$'\t'"$age")
        if [[ -z "$min_age" ]] || (( age < min_age )); then
          min_age="$age"; min_version="$v"; min_published="$published"
        fi
      done
      ;;
    python)
      local slot=0
      for v in "${versions[@]}"; do
        meta="$scratch/release-times-${slot}.json"
        slot=$((slot + 1))
        curl -fsSL --max-time 5 "https://pypi.org/pypi/${encoded_name}/$(urlencode "$v")/json" \
          -o "$meta" 2>/dev/null || return 1
        # The NEWEST distribution upload anchors the age: PyPI releases can
        # gain files after first publish, and pip may select exactly the
        # fresh artifact — an old sdist must not lend its age to a
        # yesterday wheel (PR#60 review F1).
        published=$(jq -r '[.urls[]?.upload_time_iso_8601 | strings] | max // empty' "$meta" 2>/dev/null || true)
        [[ -n "$published" ]] || return 1
        epoch=$(date -d "$published" +%s 2>/dev/null) || return 1
        age=$(( (now_epoch - epoch) / 86400 ))
        (( age < 0 )) && age=0
        age_entries+=("$v"$'\t'"$age")
        if [[ -z "$min_age" ]] || (( age < min_age )); then
          min_age="$age"; min_version="$v"; min_published="$published"
        fi
      done
      ;;
    *) return 2 ;;
  esac
  [[ -n "$min_age" ]] || return 1
  local ages_json
  ages_json=$(printf '%s\n' "${age_entries[@]}" \
    | jq -Rcn '[inputs | split("\t") | {(.[0]): (.[1] | tonumber)}] | add // {}' 2>/dev/null) \
    || return 1
  printf '%s\t%s\t%s\t%s\n' "$min_age" "$min_version" "$min_published" "$ages_json"
}

osv_write_package_query_result() {
  local output="$1" status="$2" note="$3" vulns_file="$4"
  jq -cn --arg status "$status" --arg note "$note" --slurpfile v "$vulns_file" \
    '{status:$status, note:(if $note == "" then null else $note end), vulns:($v[0] // [])}' > "$output"
}

osv_query_package_json() {
  local ecosystem="$1" name="$2" version="$3" output="$4"
  local vulns_file="$output.vulns.json"
  printf '[]\n' > "$vulns_file"
  if ! command -v curl >/dev/null 2>&1; then
    osv_write_package_query_result "$output" error "curl not available" "$vulns_file"
    return 0
  fi
  local eco
  case "$ecosystem" in
    npm) eco="npm" ;;
    python) eco="PyPI" ;;
    php) eco="Packagist" ;;
    rust) eco="crates.io" ;;
    go) eco="Go" ;;
    java) eco="Maven" ;;
    *) eco="$ecosystem" ;;
  esac
  # /v1/query is paginated: a successful page may carry only next_page_token
  # with the findings on a later page. Treating one page as the full answer
  # would let a token-only page read as "zero advisories" — follow the token
  # chain, merge, and fail closed on any anomaly (bad page, non-array vulns,
  # repeated token, unbounded chain). The accumulating data stays in a file:
  # package-level OSV answers can exceed Linux's per-argument size limit.
  local base_body body page_token="" pages=0 seen_tokens=""
  if [[ -n "$version" && "$version" != "latest" ]]; then
    base_body=$(jq -n --arg eco "$eco" --arg name "$name" --arg version "$version" '{package:{ecosystem:$eco,name:$name},version:$version}')
  else
    # Package-only query: returns every advisory ever filed for the package.
    # Only used on the degraded path when no target version could be resolved.
    base_body=$(jq -n --arg eco "$eco" --arg name "$name" '{package:{ecosystem:$eco,name:$name}}')
  fi
  while :; do
    pages=$((pages + 1))
    if (( pages > 10 )); then
      osv_write_package_query_result "$output" error "OSV pagination exceeded 10 pages" "$vulns_file"
      return 0
    fi
    if [[ -n "$page_token" ]]; then
      body=$(jq -cn --argjson base "$base_body" --arg token "$page_token" '$base + {page_token: $token}')
    else
      body="$base_body"
    fi
    if ! curl -fsS --max-time 8 https://api.osv.dev/v1/query \
      -H 'content-type: application/json' \
      -d "$body" \
      > "$output.raw"; then
      osv_write_package_query_result "$output" error "OSV query failed" "$vulns_file"
      return 0
    fi
    # A JSON stream is a malformed response: plain jq validates every
    # document and reports the last one's status while the merge below
    # slurps only the first — later documents' advisories would vanish
    # into a clean answer (PR#64 delta-2 F13; same class as the
    # querybatch/detail guards).
    if ! jq -es 'length == 1' "$output.raw" >/dev/null 2>&1; then
      osv_write_package_query_result "$output" error "OSV response is not a single JSON document" "$vulns_file"
      return 0
    fi
    # Validation is two-stage with the merge in between (delta-2 F1): the
    # vulns payload is judged first, its records merged into the
    # accumulator, and only THEN is the pagination token judged — so a
    # malformed token can never discard the evidence its own page carried.
    # A page must be an object and vulns (when present) an array.
    if ! jq -e '
      (type == "object")
      and ((has("vulns") | not) or (.vulns | type == "array"))
    ' "$output.raw" >/dev/null 2>&1; then
      osv_write_package_query_result "$output" error "OSV response malformed" "$vulns_file"
      return 0
    fi
    if ! jq -cn --slurpfile acc "$vulns_file" --slurpfile r "$output.raw" \
      '($acc[0] // []) + (($r[0].vulns) // [])' > "$vulns_file.next" 2>/dev/null; then
      osv_write_package_query_result "$output" error "OSV response merge failed" "$vulns_file"
      return 0
    fi
    mv "$vulns_file.next" "$vulns_file"
    # next_page_token (when present) must be a non-empty string — any other
    # shape (false, numbers, objects) is malformed and must not read as
    # "complete". Tokens travel through shell command substitution, which is
    # lossy for whitespace/control characters (a "\n" token would strip to
    # empty and read as end-of-pagination): only accept a bounded token that
    # survives the trip intact. The byte cap is checked before shell capture,
    # so a malformed response cannot inflate argv or shell state.
    if ! jq -e '
      (has("next_page_token") | not)
      or (.next_page_token
          | (type == "string") and (length > 0) and (utf8bytelength <= 4096)
            and (test("^[[:graph:]]+$")))
    ' "$output.raw" >/dev/null 2>&1; then
      osv_write_package_query_result "$output" error "OSV pagination token malformed" "$vulns_file"
      return 0
    fi
    local next_token
    next_token=$(jq -r '.next_page_token // empty' "$output.raw" 2>/dev/null || true)
    [[ -z "$next_token" ]] && break
    case " ${seen_tokens:-} " in
      *" $next_token "*)
        osv_write_package_query_result "$output" error "OSV pagination token repeated" "$vulns_file"
        return 0
        ;;
    esac
    seen_tokens="${seen_tokens:-} $next_token"
    page_token="$next_token"
  done
  osv_write_package_query_result "$output" ok "" "$vulns_file"
}

# ---------------------------------------------------------------------------
# Target-version resolution and version-aware advisory matching.
#
# `safe audit package-audit` used to post version:"latest" to OSV, which cannot parse
# it and returns every advisory ever filed for the package — so the verdict
# was a version-blind count that WARN-blocked the very bumps remediating a
# CVE. The resolver below determines the version the package manager would
# actually install; advisories are then matched per-version against their
# affected ranges. When resolution fails the check degrades to a package-only
# query with a WARN floor (reason: version_unresolved) — never a silent GO.
# ---------------------------------------------------------------------------

SAFE_RUN_CONFIG_FILE="$SAFE_RUN_CONFIG_DIR/config.json"
SAFE_RUN_HOST_ALLOW_FILE="$SAFE_RUN_CONFIG_DIR/host-allow.json"
SAFE_RUN_SCRIPTS_ALLOW_FILE="$SAFE_RUN_CONFIG_DIR/scripts-allow.json"
INSTALL_KNOWN_FILE="$SAFE_RUN_CONFIG_DIR/install-known.json"

# Shared jq prelude: semver-ish comparison usable for npm/PyPI/crates/go
# release versions. Prerelease versions sort before their release
# ([x,y,z,0,"pre"] < [x,y,z,1,""]); build metadata is ignored.
JQ_VSEMVER='
def vparse:
  tostring
  | sub("^[vV]"; "")
  | split("+")[0]
  | split("-") as $p
  # Core segments convert only on the strict numeric grammar; anything else
  # maps to -1 so a malformed core ("0e0.0.0") can never outrank a valid
  # version — jq tonumber would read "0e0" as numeric 0 (delta-3 finding 4).
  # Selection paths additionally validate their candidates upfront
  # (npm_max_satisfying, resolve_target_versions); a hard error here instead
  # would fail closed on every annotation over PEP440-style OSV event
  # versions ("1.0.post1"), which are annotation-only and server-authoritative.
  | ((($p[0] | split(".") | map(if test("^(0|[1-9][0-9]*)$") then tonumber else -1 end)) + [0, 0, 0])[0:3])
    + [if ($p | length) > 1 then 0 else 1 end]
    + [if ($p | length) > 1
       # SemVer prerelease precedence is identifier-by-identifier: numeric
       # identifiers compare numerically and rank below alphanumeric ones,
       # and a shorter identifier list ranks below its extension. jq array
       # comparison over (number|string) elements matches all three rules
       # (numbers sort before strings; arrays compare element-wise with
       # shorter-prefix-first) — a single lexical string did not
       # (alpha.10 < alpha.2, PR#29 delta finding 4). Convert ONLY on the
       # SemVer numeric grammar (0|[1-9][0-9]*): jq numbers are broader, so
       # tonumber? would type "1e-2" numeric while npm treats it as
       # alphanumeric (delta-2 finding 4).
       then ($p[1:] | join("-") | split(".")
             | map(if test("^(0|[1-9][0-9]*)$") then tonumber else . end))
       else []
       end];
def vlt($a; $b): ($a | vparse) < ($b | vparse);
def vle($a; $b): ($a | vparse) <= ($b | vparse);
def vge($a; $b): ($a | vparse) >= ($b | vparse);
def vgt($a; $b): ($a | vparse) > ($b | vparse);
def veq($a; $b): ($a | vparse) == ($b | vparse);
'

install_policy_json() {
  jq -c '.install // {}' "$SAFE_RUN_CONFIG_FILE" 2>/dev/null || printf '{}'
}

# A source is trusted when it is the ecosystem's default public registry or
# the operator listed it in install.trusted_registries. Anything else changes
# artifact identity: public advisory data cannot vouch for a private artifact
# of the same name@version.
registry_is_trusted() {
  local url="${1%/}" ecosystem="$2"
  # Origin-boundary matching only: a glob like pypi.org* would trust
  # pypi.org.evil.example and https://pypi.org@evil.example (userinfo trick).
  case "${ecosystem}:${url}" in
    npm:https://registry.npmjs.org) return 0 ;;
    python:https://pypi.org|python:https://pypi.org/*) return 0 ;;
  esac
  local trusted
  while IFS= read -r trusted; do
    [[ -n "$trusted" ]] || continue
    trusted="${trusted%/}"
    if [[ "$url" == "$trusted" || "$url" == "$trusted"/* ]]; then
      return 0
    fi
  done < <(install_policy_json | jq -r '(.trusted_registries // [])[]' 2>/dev/null || true)
  return 1
}

# Full SemVer 2.0.0 grammar for the semver ecosystems: no leading zeros in
# core or numeric prerelease identifiers, no empty dot-separated identifiers
# — npm/cargo/composer selectors reject those outright, so accepting them
# here would audit a version the manager never installs (delta-4 finding 4).
SEMVER_STRICT_RE='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'

# node-semver refuses versions longer than 256 characters and numeric core
# components above Number.MAX_SAFE_INTEGER — npm classifies anything beyond
# as a dist-TAG, so accepting it as a version here audits a string npm
# resolves to a different artifact (delta-5 finding 4). npm-only: other
# ecosystems' parsers have different limits.
npm_semver_within_limits() {
  local version="$1"
  (( ${#version} <= 256 )) || return 1
  local core="${version%%[-+]*}" c
  local IFS='.'
  for c in $core; do
    if (( ${#c} > 16 )) || { (( ${#c} == 16 )) && [[ "$c" > "9007199254740991" ]]; }; then
      return 1
    fi
  done
  return 0
}

version_is_exact() {
  local ecosystem="$1" version="$2"
  case "$ecosystem" in
    npm)
      # node-semver measures its 256-char ceiling on the RAW input, before
      # the v prefix is stripped (delta-6 finding 4).
      (( ${#version} <= 256 )) \
        && [[ "${version#v}" =~ $SEMVER_STRICT_RE ]] \
        && npm_semver_within_limits "${version#v}"
      ;;
    rust|php)
      [[ "${version#v}" =~ $SEMVER_STRICT_RE ]]
      ;;
    python)
      [[ "$version" =~ ^[0-9]+(\.[0-9]+)*((a|b|rc)[0-9]+)?(\.post[0-9]+)?(\.dev[0-9]+)?$ ]]
      ;;
    go)
      [[ "$version" == v* && "${version#v}" =~ $SEMVER_STRICT_RE ]]
      ;;
    *)
      [[ "$version" =~ ^v?[0-9]+(\.[0-9]+)+$ ]]
      ;;
  esac
}

strip_trailing_slashes() {
  local v="$1"
  while [[ "$v" == */ ]]; do v="${v%/}"; done
  printf '%s' "$v"
}

# Canonical source form for identities, receipts, trust matching, and every
# printed message: trailing slashes stripped, and for URLs the userinfo,
# query string, and fragment dropped — index URLs routinely carry inline
# credentials (userinfo or ?token= query values) and those must never reach
# refusal output, install-known.json, or config.json trust entries (delta-5
# finding N2; delta-6 extended to query/fragment). Operational fetch URLs
# keep their credentials — ONLY identities and sinks go through here
# (delta-6: the wrappers no longer pre-redact, which broke authenticated
# packument fetches). A scoped selector token (@scope:registry=URL) keeps
# its key and canonicalizes its URL part.
canonicalize_source() {
  local v="$1" scoped_prefix=""
  if [[ "$v" == @*:registry=* ]]; then
    scoped_prefix="${v%%=*}="
    v="${v#*=}"
  fi
  if [[ "$v" == *://* ]]; then
    v="${v%%\#*}"
    v="${v%%\?*}"
    if [[ "$v" =~ ^([a-zA-Z][a-zA-Z0-9+.-]*://)([^/@]+@)(.+)$ ]]; then
      v="${BASH_REMATCH[1]}${BASH_REMATCH[3]}"
    fi
  fi
  v=$(strip_trailing_slashes "$v")
  printf '%s%s' "$scoped_prefix" "$v"
}

# The URL half of a source element: scoped selector tokens carry their key
# inline; trust decisions apply to the endpoint itself.
source_element_url() {
  local v="$1"
  [[ "$v" == @*:registry=* ]] && v="${v#*=}"
  printf '%s' "$v"
}

# Canonicalize a space-separated source set: strip trailing slashes per
# element and keep the LAST occurrence of a repeated element — npm options
# are last-wins, so ordering carries meaning for resolution while the trust
# sweep stays order-independent (delta-4 findings 3.1 and N1: writer and
# readers must derive byte-identical identities for the same invocation).
normalize_source_set() {
  local out="" w x kept
  for w in $1; do
    w=$(canonicalize_source "$w")
    [[ -n "$w" ]] || continue
    kept=""
    for x in $out; do
      [[ "$x" == "$w" ]] || kept="${kept:+$kept }$x"
    done
    out="${kept:+$kept }$w"
  done
  printf '%s' "$out"
}

# The user-level npm config file: an argv --userconfig (threaded as a PATH
# via --npm-userconfig, never flattened into values — delta-7 finding 3.2b)
# wins, then the env forms (lowercase first, npm's own env precedence),
# then the default. The global tier is analogous, with no default file
# modeled (npm's builtin /usr/etc/npmrc is operator-owned machine state).
# Config paths anchor a leading dash to ./ — a file literally named "-q"
# is a valid config target to npm but reads as an OPTION to grep/awk,
# silently yielding no sources (fail-open; delta-8 finding 3.2b).
anchor_path() {
  local p="$1"
  [[ "$p" == -* ]] && p="./$p"
  printf '%s' "$p"
}

npm_user_rc() {
  if [[ -n "${CHECK_NPM_USERCONFIG:-}" ]]; then
    anchor_path "$CHECK_NPM_USERCONFIG"
  elif [[ -n "${npm_config_userconfig:-}" ]]; then
    anchor_path "$npm_config_userconfig"
  elif [[ -n "${NPM_CONFIG_USERCONFIG:-}" ]]; then
    anchor_path "$NPM_CONFIG_USERCONFIG"
  else
    printf '%s' "$HOME/.npmrc"
  fi
}

npm_global_rc() {
  if [[ -n "${CHECK_NPM_GLOBALCONFIG:-}" ]]; then
    anchor_path "$CHECK_NPM_GLOBALCONFIG"
  elif [[ -n "${npm_config_globalconfig:-}" ]]; then
    anchor_path "$npm_config_globalconfig"
  elif [[ -n "${NPM_CONFIG_GLOBALCONFIG:-}" ]]; then
    anchor_path "$NPM_CONFIG_GLOBALCONFIG"
  fi
}

npm_registry_url() {
  local name="${1:-${PKG_NAME:-}}"
  # A scope-specific registry beats every generic source INCLUDING a
  # generic --registry: npm resolves the @scope:registry config KEY, which
  # a generic selector never sets (delta-4 finding 3.2). Key precedence
  # follows npm: CLI scoped selectors (threaded as @scope:registry=URL
  # tokens in CHECK_REGISTRY, LAST occurrence wins — delta-6 finding 3.2b),
  # then env (lowercase first), then project rc, then the user rc (which
  # --userconfig's env forms replace).
  local scope=""
  [[ "$name" == @*/* ]] && scope="${name%%/*}"
  if [[ -n "$scope" ]]; then
    local scoped_src="" src_word
    for src_word in ${CHECK_REGISTRY:-}; do
      [[ "$src_word" == "${scope}:registry="* ]] && scoped_src="${src_word#*=}"
    done
    [[ -n "$scoped_src" ]] || scoped_src=$(printenv "npm_config_${scope}:registry" 2>/dev/null || true)
    [[ -n "$scoped_src" ]] || scoped_src=$(printenv "NPM_CONFIG_${scope}:registry" 2>/dev/null || true)
    if [[ -z "$scoped_src" ]]; then
      local rc line scope_re="${scope//./\\.}"
      for rc in "${CHECK_PROJECT_DIR:-.}/.npmrc" "$(npm_user_rc)" "$(npm_global_rc)"; do
        [[ -n "$rc" && -f "$rc" ]] || continue
        line=$(grep -E "^[[:space:]]*${scope_re}:registry[[:space:]]*=" "$rc" 2>/dev/null | tail -n 1 || true)
        if [[ -n "$line" ]]; then
          scoped_src=$(trim "${line#*=}")
          break
        fi
      done
    fi
    if [[ -n "$scoped_src" ]]; then
      strip_trailing_slashes "$scoped_src"
      return 0
    fi
  fi
  # Generic --registry from the audited command line wins over env/rc:
  # auditing the default registry while npm installs from another one audits
  # the wrong artifact (PR#29 review finding 3). npm options are LAST-wins —
  # with repeated --registry flags npm fetches from the final one (delta-3
  # finding 3.1); scoped tokens carry a different KEY and never participate
  # in the generic selection. The custom-source floor still checks every
  # seen selector.
  if [[ -n "${CHECK_REGISTRY:-}" ]]; then
    local last_src="" src_word
    for src_word in ${CHECK_REGISTRY}; do
      [[ "$src_word" == @*:registry=* ]] && continue
      last_src="$src_word"
    done
    if [[ -n "$last_src" ]]; then
      strip_trailing_slashes "$last_src"
      return 0
    fi
  fi
  # npm reads its config environment case-insensitively and the LOWERCASE
  # form wins when both are set (verified against npm's own resolution,
  # delta-5 finding 3.2) — matching that order is load-bearing: auditing
  # the uppercase value while npm fetches from the lowercase one audits
  # the wrong artifact.
  if [[ -n "${npm_config_registry:-}" ]]; then
    strip_trailing_slashes "$npm_config_registry"
    return 0
  fi
  if [[ -n "${NPM_CONFIG_REGISTRY:-}" ]]; then
    strip_trailing_slashes "$NPM_CONFIG_REGISTRY"
    return 0
  fi
  local rc line
  for rc in "${CHECK_PROJECT_DIR:-.}/.npmrc" "$(npm_user_rc)" "$(npm_global_rc)"; do
    [[ -n "$rc" && -f "$rc" ]] || continue
    line=$(grep -E '^[[:space:]]*registry[[:space:]]*=' "$rc" 2>/dev/null | tail -n 1 || true)
    if [[ -n "$line" ]]; then
      printf '%s' "$(trim "${line#*=}")" | sed 's:/*$::'
      return 0
    fi
  done
  printf 'https://registry.npmjs.org'
}

# Recognized python source controls outside argv: pip/uv environment
# variables plus the pip config files pip itself merges (PIP_CONFIG_FILE,
# then venv, then user; index-url is last-wins per file precedence,
# extra-index-url accumulates). uv.toml / pyproject [tool.uv] index tables
# and system-level /etc pip.conf are NOT swept: TOML parsing on one side,
# operator-owned machine state on the other — argv + env + these files are
# the surfaces a hostile project or environment can silently inject
# (delta-4 finding 3.2).
# pip's boolean vocabulary, case-insensitive, one variable at a time —
# concatenating variables invented truth from "False"/"0 0" pairs (delta-6
# finding N3: a false value must preserve default-source UX).
python_bool_truthy() {
  local v
  v=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$v" in
    1|true|t|yes|y|on) return 0 ;;
  esac
  return 1
}

# Effective value lines for one key from a pip config file, with
# pip/configparser semantics (delta-6 finding 3.2c; delta-7 tightened):
# '=' and ':' delimiters, comments, indented continuation lines (multi-line
# find-links lists are idiomatic), option names normalized the way pip does
# (ASCII lowercase, '_' -> '-'), and SECTION precedence — [install] (the
# audited command's section) overrides [global] regardless of file order;
# within a section a later duplicate key wins. Other sections do not apply
# to installs and are ignored.
pip_config_values() {
  local rc_file="$1" key="$2"
  [[ -f "$rc_file" ]] || return 0
  awk -v key="$key" '
    # pip _normalize_name: ASCII lowercase, underscores to hyphens, and ONE
    # leading -- removed ("--index-url =" is a valid pip config key,
    # delta-8 finding 3.2c).
    function norm(s) { s = tolower(s); gsub(/_/, "-", s); sub(/^--/, "", s); return s }
    function trimmed(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
    function indent_of(s) { match(s, /^[ \t]*/); return RLENGTH }
    BEGIN { sect = ""; grab = 0; grabind = -1 }
    {
      raw = $0
      line = trimmed(raw)
      if (line == "") next
      # Full-line comments are dropped everywhere, indented or not, without
      # ending a value block (ConfigParser semantics).
      if (line ~ /^[#;]/) next
      ind = indent_of(raw)
      # ConfigParser: a line continues a value only when indented DEEPER
      # than its option line; options themselves may sit at any base
      # indent (delta-8 finding 3.2c — leading whitespace is not, by
      # itself, a continuation marker).
      if (grab && ind > grabind) {
        vals[grabsect] = vals[grabsect] "\n" line
        next
      }
      grab = 0
      if (line ~ /^\[/) {
        sub(/^\[/, "", line); sub(/\].*$/, "", line)
        sect = tolower(trimmed(line))
        next
      }
      p = index(line, "="); c = index(line, ":")
      d = p
      if (d == 0 || (c > 0 && c < p)) d = c
      if (d == 0) next
      k = substr(line, 1, d - 1); sub(/[ \t]+$/, "", k)
      if (norm(k) == key && (sect == "global" || sect == "install")) {
        grab = 1
        grabind = ind
        grabsect = sect
        vals[sect] = trimmed(substr(line, d + 1))
      }
    }
    END {
      out = ("install" in vals) ? vals["install"] : (("global" in vals) ? vals["global"] : "")
      n = split(out, a, "\n")
      for (i = 1; i <= n; i++) if (a[i] != "") print a[i]
    }
  ' "$rc_file" 2>/dev/null || true
}

python_env_sources() {
  local out="" v
  for v in ${PIP_INDEX_URL:-} ${PIP_EXTRA_INDEX_URL:-} ${UV_DEFAULT_INDEX:-} ${UV_INDEX_URL:-} ${UV_INDEX:-} \
    ${PIP_FIND_LINKS:-} ${UV_FIND_LINKS:-} ${UV_EXTRA_INDEX_URL:-}; do
    out="${out:+$out }$v"
  done
  # no-index flips resolution to find-links/local sources entirely; the
  # sentinel mirrors the argv scanner's marker (delta-5 finding 3.2).
  if python_bool_truthy "${PIP_NO_INDEX:-}" || python_bool_truthy "${UV_NO_INDEX:-}"; then
    out="${out:+$out }local:no-index"
  fi
  # Config paths are iterated as a quoted array: word-splitting an injected
  # PIP_CONFIG_FILE containing spaces silently missed the file entirely
  # (delta-7 finding 3.2c).
  local -a py_rc_files=()
  [[ -n "${PIP_CONFIG_FILE:-}" ]] && py_rc_files+=("$(anchor_path "$PIP_CONFIG_FILE")")
  [[ -n "${VIRTUAL_ENV:-}" ]] && py_rc_files+=("$(anchor_path "$VIRTUAL_ENV")/pip.conf")
  py_rc_files+=("$HOME/.config/pip/pip.conf" "$HOME/.pip/pip.conf")
  local rc val
  if [[ -z "${PIP_INDEX_URL:-}" ]]; then
    for rc in "${py_rc_files[@]}"; do
      [[ -f "$rc" ]] || continue
      val=$(pip_config_values "$rc" index-url | tail -n 1)
      if [[ -n "$val" ]]; then
        out="${out:+$out }$val"
        break
      fi
    done
  fi
  for rc in "${py_rc_files[@]}"; do
    [[ -f "$rc" ]] || continue
    while IFS= read -r val; do
      [[ -n "$val" ]] && out="${out:+$out }$val"
    done < <(pip_config_values "$rc" extra-index-url; pip_config_values "$rc" find-links)
    val=$(pip_config_values "$rc" no-index | tail -n 1)
    if [[ -n "$val" ]] && python_bool_truthy "$val"; then
      out="${out:+$out }local:no-index"
    fi
  done
  printf '%s' "$out"
}

# GOPROXY is a comma/pipe-separated fallback chain; anything that is not
# the public proxy or a keyword changes where modules come from.
go_env_sources() {
  local out="" part proxy="${GOPROXY:-}"
  for part in ${proxy//[,|]/ }; do
    case "$part" in
      https://proxy.golang.org|https://proxy.golang.org/|direct|off) ;;
      *) out="${out:+$out }$part" ;;
    esac
  done
  printf '%s' "$out"
}

# Cargo's registry selection is single-valued: --registry NAME / --index URL
# on argv (the gate threads both; mise's cargo backend passes its
# registry_name setting the same way), else the registry.default key — env
# CARGO_REGISTRY_DEFAULT redirects `cargo install` on its own (verified in
# cargo's command_prelude/install source). A NAME maps to its index URL via
# registries.<name>.index, whose env form uppercases the name and turns -/.
# into _ (cargo context/key.rs) — so my-reg and my_reg collide, which cargo
# itself cannot distinguish either. A selected name with no env-defined
# index may still resolve from a config.toml safe does not read: it becomes
# the opaque identity cargo-registry:<name> — floors like any custom source
# and is trustable verbatim in install.trusted_registries. The literal name
# crates-io short-circuits inside cargo to the built-in source (even
# registries.crates-io.index is a no-op), so selecting it is the default
# source, not a custom one. [source] replacement and registry.default in
# config.toml files are NOT env-settable (cargo docs: "Environment: not
# supported") and stay behind the reviewed config-file boundary — CARGO_HOME
# and --config included (the gate refuses --config on installs).
# Defined-but-unselected CARGO_REGISTRIES_* variables are inert: defining a
# registry does not select it.
cargo_registry_env_name() {
  local name="${1//-/_}"
  name="${name//./_}"
  printf 'CARGO_REGISTRIES_%s_INDEX' "$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"
}

# Prints the source identity for a selected cargo registry NAME; returns 1
# for the built-in default.
cargo_source_for_name() {
  local name="$1" idx
  [[ "$name" == "crates-io" ]] && return 1
  idx=$(printenv "$(cargo_registry_env_name "$name")" 2>/dev/null || true)
  if [[ -n "$idx" ]]; then
    printf '%s' "$idx"
  else
    printf 'cargo-registry:%s' "$name"
  fi
}

# Composer's home directory, mirroring Factory::getHomeDir(): an explicit
# COMPOSER_HOME wins; otherwise the XDG candidate applies when any XDG_*
# variable is exported or /etc/xdg exists, and the first candidate that
# EXISTS as a directory is chosen (that existence probe is what decides on
# machines having both ~/.config/composer and ~/.composer), falling back to
# the first candidate.
composer_home_dir() {
  if [[ -n "${COMPOSER_HOME:-}" ]]; then
    printf '%s' "$COMPOSER_HOME"
    return 0
  fi
  local -a candidates=()
  if compgen -e 2>/dev/null | grep -q '^XDG_' || [[ -d /etc/xdg ]]; then
    candidates+=("${XDG_CONFIG_HOME:-$HOME/.config}/composer")
  fi
  candidates+=("$HOME/.composer")
  local c
  for c in "${candidates[@]}"; do
    if [[ -d "$c" ]]; then
      printf '%s' "$c"
      return 0
    fi
  done
  printf '%s' "${candidates[0]}"
}

# Repositories from $COMPOSER_HOME/config.json — composer merges that file's
# repositories key into EVERY install/update/require run, global and
# per-project alike (Factory.php loads it unconditionally). Array and
# (deprecated) object-map shapes both occur; a single-key entry set to false
# disables a named repository, and a disabled packagist with no replacement
# is itself source-changing, so it emits a sentinel. Project composer.json
# repositories stay behind the reviewed boundary: committed project
# architecture, not injectable state. COMPOSER_AUTH is credentials only and
# never names a source; the COMPOSER_REPOSITORIES variable the gate once
# guarded does not exist in composer at all (verified against composer
# main). A config.json composer itself cannot parse aborts the install, so
# an unreadable file contributes nothing here.
composer_env_sources() {
  local cfg
  cfg="$(composer_home_dir)/config.json"
  [[ -f "$cfg" ]] || return 0
  # Every endpoint a repository can fetch from is emitted, not the first
  # one found: an inline package definition carries dist AND source URLs
  # and composer can select either (--prefer-source, dist fallback), and
  # the `package` value is an object OR an array of definitions — an
  # elif chain over those shapes left endpoints out of the trust floor
  # (PR6 review round 1, findings 1-2).
  jq -r '
    (.repositories // empty)
    | (if type == "array" then to_entries | map({key: (.value.name // (.key | tostring)), value: .value})
       elif type == "object" then to_entries
       else [] end)
    | .[]
    | if (.value | type) == "boolean" and (.value | not) then
        (if (.key == "packagist.org" or .key == "packagist") then "local:packagist-disabled" else empty end)
      elif (.value | type) == "object" then
        (if ((.value | keys) | length) == 1 and ((.value | to_entries[0].value) == false) then
           (if ((.value | to_entries[0].key) == "packagist.org" or (.value | to_entries[0].key) == "packagist")
            then "local:packagist-disabled" else empty end)
         else
           (
             (.value.url? | select(type == "string")),
             (.value.package?
              | (if type == "object" then [.] elif type == "array" then . else [] end)
              | .[]
              | select(type == "object")
              | ((.dist?.url? | select(type == "string")),
                 (.source?.url? | select(type == "string"))))
           )
         end)
      else empty end
  ' "$cfg" 2>/dev/null | tr '\n' ' ' || true
}

# bun's user-level npmrc: $XDG_CONFIG_HOME/.npmrc when XDG_CONFIG_HOME is
# set, else ~/.npmrc — bun's own loader order, which diverges from npm
# (npm always reads ~/.npmrc). bun reads exactly two npmrc files (project,
# then user) and no globalconfig, and ignores npm's --userconfig overrides.
bun_user_rc() {
  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    printf '%s' "${XDG_CONFIG_HOME}/.npmrc"
  else
    printf '%s' "$HOME/.npmrc"
  fi
}

# Effective registry for a bun-driven install (--installer bun). A SCOPED
# registry beats every generic selector INCLUDING the CLI --registry, in
# bun exactly as in npm: bun's CLI flag rewrites only the default scope
# (PackageManagerOptions.rs — `cli.registry` assigns `self.scope`), while
# scoped registries live in a separate map that `scope_for_package_name`
# consults first and the CLI never touches. Generic precedence per bun's
# source (REGISTRY_KEYS + the npmrc loader): CLI --registry, then
# BUN_CONFIG_REGISTRY / NPM_CONFIG_REGISTRY / npm_config_registry — that
# order, upper BEFORE lower, the reverse of npm's own env precedence —
# each honored only when it starts with http:// or https:// (bun silently
# ignores other shapes), then project .npmrc, then bun's user npmrc.
# Scoped @scope:registry keys come from CLI tokens and npmrc files only
# (bun has no scoped env form). bunfig.toml (install.registry,
# install.scopes) is TOML and stays un-swept — the same reviewed boundary
# as uv.toml; documented in install-wrappers.md.
bun_registry_url() {
  local name="${1:-${PKG_NAME:-}}"
  local scope=""
  [[ "$name" == @*/* ]] && scope="${name%%/*}"
  if [[ -n "$scope" ]]; then
    local scoped_src="" src_word
    for src_word in ${CHECK_REGISTRY:-}; do
      [[ "$src_word" == "${scope}:registry="* ]] && scoped_src="${src_word#*=}"
    done
    if [[ -z "$scoped_src" ]]; then
      local rc line scope_re="${scope//./\\.}"
      for rc in "${CHECK_PROJECT_DIR:-.}/.npmrc" "$(bun_user_rc)"; do
        [[ -n "$rc" && -f "$rc" ]] || continue
        line=$(grep -E "^[[:space:]]*${scope_re}:registry[[:space:]]*=" "$rc" 2>/dev/null | tail -n 1 || true)
        if [[ -n "$line" ]]; then
          scoped_src=$(trim "${line#*=}")
          break
        fi
      done
    fi
    if [[ -n "$scoped_src" ]]; then
      strip_trailing_slashes "$scoped_src"
      return 0
    fi
  fi
  if [[ -n "${CHECK_REGISTRY:-}" ]]; then
    local last_src="" src_word
    for src_word in ${CHECK_REGISTRY}; do
      [[ "$src_word" == @*:registry=* ]] && continue
      last_src="$src_word"
    done
    if [[ -n "$last_src" ]]; then
      strip_trailing_slashes "$last_src"
      return 0
    fi
  fi
  local v
  for v in "${BUN_CONFIG_REGISTRY:-}" "${NPM_CONFIG_REGISTRY:-}" "${npm_config_registry:-}"; do
    if [[ "$v" == http://* || "$v" == https://* ]]; then
      strip_trailing_slashes "$v"
      return 0
    fi
  done
  local rc line
  for rc in "${CHECK_PROJECT_DIR:-.}/.npmrc" "$(bun_user_rc)"; do
    [[ -n "$rc" && -f "$rc" ]] || continue
    line=$(grep -E '^[[:space:]]*registry[[:space:]]*=' "$rc" 2>/dev/null | tail -n 1 || true)
    if [[ -n "$line" ]]; then
      printf '%s' "$(trim "${line#*=}")" | sed 's:/*$::'
      return 0
    fi
  done
  printf 'https://registry.npmjs.org'
}

# Which installer performs the install this check gates. Source selectors
# key off the INSTALLER, not the ecosystem — bun installs npm packages but
# reads different source config, and applying bun's selectors to an npm
# install removed the gate from artifacts safe can model (PR#30 delta-4
# finding F4). The gate passes --installer when it knows; the ecosystem
# default covers direct invocations.
default_installer_for() {
  case "$1" in
    npm) printf 'npm' ;;
    python) printf 'pip' ;;
    rust) printf 'cargo' ;;
    php) printf 'composer' ;;
    go) printf 'go' ;;
    *) printf '%s' "$1" ;;
  esac
}

validate_installer() {
  case "$1" in
    npm|pnpm|yarn|bun|pip|pip3|uv|pipx|cargo|go|composer) return 0 ;;
    *) return 1 ;;
  esac
}

# Effective sources for this check: the normalized argv set plus manager
# sources that act outside argv (env, rc files). Computed on EVERY check —
# exact-pin resolution shortcuts must not skip the trust floor (delta-3/4
# finding 3.2). This is the single derivation behind the trust floor, the
# receipt writer, and (via the effective-sources plumbing command) every
# stale-evidence reader; sweeping config-file surfaces we cannot represent
# (cargo config.toml — CARGO_HOME and --config included, bunfig.toml,
# repositories declared by a project's own composer.json, uv.toml) stays
# out by design — TOML parsing on one side, operator-committed project
# architecture on the other; the injectable surfaces are argv + env + the
# parseable config files swept here.
derive_effective_sources() {
  local ecosystem="$1" name="$2"
  local extra="" rw tok mapped
  CHECK_EFFECTIVE_SOURCES=$(normalize_source_set "${CHECK_REGISTRY:-}")
  case "$ecosystem" in
    npm)
      # The effective endpoint for THIS package, resolved with npm's config
      # tiers (argv/env-selected alternate config files included via
      # npm_user_rc/npm_global_rc). All-keys sweeps of alternate files were
      # both wrong-precedence and over-flooring (delta-7 finding 3.2b).
      # A bun-driven install reads bun's config surface for the same
      # ecosystem — selectors key off the installer (delta-4 finding F4).
      if [[ "${CHECK_INSTALLER:-npm}" == "bun" ]]; then
        extra=$(bun_registry_url "$name")
      else
        extra=$(npm_registry_url "$name")
      fi
      ;;
    python) extra=$(python_env_sources) ;;
    go) extra=$(go_env_sources) ;;
    rust)
      # Rewrite pass over the argv set: --registry carries a NAME, --index a
      # URL. Names resolve through their env-defined index or become opaque
      # cargo-registry:<name> identities; an explicit crates-io selection is
      # the built-in default source, not a custom one, and drops out.
      rw=""
      for tok in ${CHECK_EFFECTIVE_SOURCES}; do
        if [[ "$tok" == *://* || "$tok" == local:* || "$tok" == cargo-registry:* ]]; then
          rw="${rw:+$rw }$tok"
        elif mapped=$(cargo_source_for_name "$tok"); then
          rw="${rw:+$rw }${mapped}"
        fi
      done
      CHECK_EFFECTIVE_SOURCES=$(normalize_source_set "$rw")
      # registry.default applies only when argv selected NOTHING — judged
      # on the RAW argv set, not the rewritten one: an explicit
      # `--registry crates-io` rewrites to empty (it IS the default
      # source) yet still overrides an ambient registry.default, and
      # treating the empty rewrite as no-selection reapplied the env
      # default cargo ignores (PR6 review round 1, finding 4).
      if [[ -z "${CHECK_REGISTRY:-}" && -n "${CARGO_REGISTRY_DEFAULT:-}" ]]; then
        if mapped=$(cargo_source_for_name "$CARGO_REGISTRY_DEFAULT"); then
          CHECK_EFFECTIVE_SOURCES=$(normalize_source_set "$mapped")
        fi
      fi
      ;;
    php) extra=$(composer_env_sources) ;;
  esac
  local w existing seen
  for w in $extra; do
    w=$(canonicalize_source "$w")
    [[ -n "$w" ]] || continue
    # The ecosystem default never makes an identity explicit.
    case "${ecosystem}:${w}" in
      npm:https://registry.npmjs.org) continue ;;
      python:https://pypi.org|python:https://pypi.org/simple) continue ;;
      # A composer repo redefining packagist by its own URL triggers
      # composer's packagist auto-disable and replaces it with the same
      # endpoint — the default source either way.
      php:https://repo.packagist.org|php:https://packagist.org) continue ;;
    esac
    # Membership is endpoint-level: a scoped token already carrying this
    # URL must not gain a redundant bare twin (the effective npm source of
    # a scoped package IS that token's URL).
    seen=0
    for existing in ${CHECK_EFFECTIVE_SOURCES}; do
      if [[ "$(source_element_url "$existing")" == "$(source_element_url "$w")" ]]; then
        seen=1
        break
      fi
    done
    (( seen )) || CHECK_EFFECTIVE_SOURCES="${CHECK_EFFECTIVE_SOURCES:+${CHECK_EFFECTIVE_SOURCES} }${w}"
  done
}

source_identity() {
  if [[ -n "${CHECK_EFFECTIVE_SOURCES:-}" ]]; then
    printf 'explicit:%s' "$CHECK_EFFECTIVE_SOURCES"
  else
    printf 'implicit-default'
  fi
}

# Desugar one npm range token (^1.2.3, ~1.2, >=1.0.0, 1.x, 1.2, 2, =1.0.0)
# into JSON [{op,v}] constraints. Fails (return 1) on anything it cannot
# faithfully express — the caller then degrades to the unresolved path.
npm_desugar_token() {
  local t op v
  t=$(trim "$1")
  case "$t" in
    ">="*) op="ge"; v="${t#>=}" ;;
    "<="*) op="le"; v="${t#<=}" ;;
    ">"*)  op="gt"; v="${t#>}" ;;
    "<"*)  op="lt"; v="${t#<}" ;;
    "="*)  op="eq"; v="${t#=}" ;;
    "^"*)  op="caret"; v="${t:1}" ;;
    "~"*)  op="tilde"; v="${t:1}" ;;
    *)     op="plain"; v="$t" ;;
  esac
  v=$(trim "$v")
  v="${v#v}"
  local maj min pat rest
  IFS='.' read -r maj min pat rest <<<"$v"
  [[ -n "$rest" ]] && return 1
  local pat_num="${pat%%[-+]*}"
  # wild = index of first wildcard/missing segment (3 = fully specified)
  local wild=3
  if [[ -z "$min" || "$min" == "x" || "$min" == "X" || "$min" == "*" ]]; then
    wild=1
  elif [[ -z "$pat" || "$pat" == "x" || "$pat" == "X" || "$pat" == "*" ]]; then
    wild=2
  fi
  [[ "$maj" =~ ^[0-9]+$ ]] || return 1
  if (( wild == 3 )); then
    [[ "$min" =~ ^[0-9]+$ && "$pat_num" =~ ^[0-9]+$ ]] || return 1
  elif (( wild == 2 )); then
    [[ "$min" =~ ^[0-9]+$ ]] || return 1
  fi
  local lo hi
  case "$op" in
    plain|eq)
      case "$wild" in
        3) jq -cn --arg v "$v" '[{op:"eq", v:$v}]'; return 0 ;;
        2) lo="$maj.$min.0"; hi="$maj.$((min + 1)).0" ;;
        1) lo="$maj.0.0"; hi="$((maj + 1)).0.0" ;;
      esac
      ;;
    ge)
      case "$wild" in
        3) jq -cn --arg v "$v" '[{op:"ge", v:$v}]'; return 0 ;;
        2) jq -cn --arg v "$maj.$min.0" '[{op:"ge", v:$v}]'; return 0 ;;
        1) jq -cn --arg v "$maj.0.0" '[{op:"ge", v:$v}]'; return 0 ;;
      esac
      ;;
    gt)
      case "$wild" in
        3) jq -cn --arg v "$v" '[{op:"gt", v:$v}]'; return 0 ;;
        2) jq -cn --arg v "$maj.$((min + 1)).0" '[{op:"ge", v:$v}]'; return 0 ;;
        1) jq -cn --arg v "$((maj + 1)).0.0" '[{op:"ge", v:$v}]'; return 0 ;;
      esac
      ;;
    le)
      case "$wild" in
        3) jq -cn --arg v "$v" '[{op:"le", v:$v}]'; return 0 ;;
        2) jq -cn --arg v "$maj.$((min + 1)).0" '[{op:"lt", v:$v}]'; return 0 ;;
        1) jq -cn --arg v "$((maj + 1)).0.0" '[{op:"lt", v:$v}]'; return 0 ;;
      esac
      ;;
    lt)
      case "$wild" in
        3) jq -cn --arg v "$v" '[{op:"lt", v:$v}]'; return 0 ;;
        2) jq -cn --arg v "$maj.$min.0" '[{op:"lt", v:$v}]'; return 0 ;;
        1) jq -cn --arg v "$maj.0.0" '[{op:"lt", v:$v}]'; return 0 ;;
      esac
      ;;
    caret)
      case "$wild" in
        3)
          lo="$v"
          if (( maj > 0 )); then
            hi="$((maj + 1)).0.0"
          elif (( min > 0 )); then
            hi="0.$((min + 1)).0"
          else
            hi="0.0.$((pat_num + 1))"
          fi
          ;;
        2)
          lo="$maj.$min.0"
          if (( maj > 0 )); then hi="$((maj + 1)).0.0"; else hi="0.$((min + 1)).0"; fi
          ;;
        1) lo="$maj.0.0"; hi="$((maj + 1)).0.0" ;;
      esac
      ;;
    tilde)
      case "$wild" in
        3) lo="$v"; hi="$maj.$((min + 1)).0" ;;
        2) lo="$maj.$min.0"; hi="$maj.$((min + 1)).0" ;;
        1) lo="$maj.0.0"; hi="$((maj + 1)).0.0" ;;
      esac
      ;;
  esac
  jq -cn --arg lo "$lo" --arg hi "$hi" '[{op:"ge", v:$lo}, {op:"lt", v:$hi}]'
}

# Desugar a full npm range expression into a JSON constraint conjunction.
# `||` alternatives, git/file/workspace specs, and unknown syntax fail.
npm_desugar_range() {
  local raw
  raw=$(trim "$1")
  [[ "$raw" == *"||"* ]] && return 1
  case "$raw" in
    ""|\*|x|X|latest) printf '[]'; return 0 ;;
    *:*|git+*|http://*|https://*|github:*|file:*|link:*|workspace:*) return 1 ;;
  esac
  if [[ "$raw" == *" - "* ]]; then
    local lo_part hi_part lo_cons hi_cons
    lo_part="${raw%% - *}"
    hi_part="${raw#* - }"
    lo_cons=$(npm_desugar_token ">=$lo_part") || return 1
    hi_cons=$(npm_desugar_token "<=$hi_part") || return 1
    jq -cn --argjson a "$lo_cons" --argjson b "$hi_cons" '$a + $b'
    return 0
  fi
  local token cons
  # read -a splits without pathname expansion: `for token in $raw` would glob
  # a range like `1.*` against files in the cwd (PR#29 review finding 4).
  local -a tokens=() all=()
  read -r -a tokens <<<"$raw"
  for token in "${tokens[@]}"; do
    cons=$(npm_desugar_token "$token") || return 1
    all+=("$cons")
  done
  (( ${#all[@]} > 0 )) || return 1
  printf '%s\n' "${all[@]}" | jq -cs 'add'
}

# Version an npm range resolves to from a packument. npm's selector prefers
# the dist-tag latest version whenever it satisfies the range (npm-pick-
# manifest semantics), falling back to the max satisfying stable version —
# picking plain-max here would audit a version npm does not install
# (PR#29 review finding 4).
npm_max_satisfying() {
  local packument="$1" constraints="$2"
  jq -r --argjson cons "$constraints" "
    $JQ_VSEMVER
    # Packument keys and dist-tags are registry-writable data: only strict
    # full-grammar SemVer participates in selection, matching npm's own
    # selector, which rejects malformed cores (\"0e0.0.0\") AND malformed
    # prereleases — leading-zero numeric identifiers (\"1.0.0-01\") and
    # empty identifiers (\"1.0.0-alpha..1\") — outright (delta-4 finding 4).
    # node-semver limits mirror npm_semver_within_limits: <=256 chars and
    # numeric core components <= Number.MAX_SAFE_INTEGER (as strings — jq
    # numbers lose precision exactly at that boundary; delta-5 finding 4).
    def semver_ok:
      (length <= 256)
      and test(\"^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)([-](0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)([.](0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?([+][0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?\$\")
      and ((split(\"+\")[0] | split(\"-\")[0] | split(\".\"))
           | all((length < 16) or ((length == 16) and (. <= \"9007199254740991\"))));
    def satisfies(\$ver):
      all(\$cons[];
        . as \$c |
        if   \$c.op == \"ge\" then vge(\$ver; \$c.v)
        elif \$c.op == \"gt\" then vgt(\$ver; \$c.v)
        elif \$c.op == \"le\" then vle(\$ver; \$c.v)
        elif \$c.op == \"lt\" then vlt(\$ver; \$c.v)
        elif \$c.op == \"eq\" then veq(\$ver; \$c.v)
        else false
        end);
    (.\"dist-tags\".latest // \"\") as \$latest
    | if (\$latest != \"\") and (\$latest | semver_ok) and ((.versions // {}) | has(\$latest)) and satisfies(\$latest)
      then \$latest
      else
        [ (.versions // {}) | keys[]
          | select(semver_ok)
          | select(contains(\"-\") | not)
          | select(satisfies(.)) ]
        | sort_by(vparse) | last // empty
      end
  " "$packument"
}

# Ranges constraining a package in the project: package.json declared deps
# plus dependent ranges recorded in package-lock.json / npm-shrinkwrap.
# The project dir defaults to the cwd but follows --project-dir/--prefix.
npm_project_ranges() {
  local name="$1" dir="${CHECK_PROJECT_DIR:-.}"
  {
    if [[ -f "$dir/package.json" ]]; then
      jq -r --arg n "$name" '
        [.dependencies, .devDependencies, .optionalDependencies, .peerDependencies]
        | map(select(. != null) | .[$n] // empty)
        | .[]' "$dir/package.json" 2>/dev/null || true
    fi
    local lockfile
    for lockfile in "$dir/npm-shrinkwrap.json" "$dir/package-lock.json"; do
      [[ -f "$lockfile" ]] || continue
      jq -r --arg n "$name" '
        [ (.packages // {}) | to_entries[]
          | (.value.dependencies[$n]?, .value.devDependencies[$n]?, .value.optionalDependencies[$n]?)
          | select(. != null and type == "string") ]
        | .[]' "$lockfile" 2>/dev/null || true
      break
    done
  } | sort -u | grep -v '^$' || true
}

# A root `overrides` entry mentioning the package can force npm to install a
# version (or a different package) our resolver cannot predict — degrade to
# the unresolved path instead of auditing a guess (PR#29 review finding 4).
npm_overrides_mention() {
  local name="$1" dir="${CHECK_PROJECT_DIR:-.}"
  [[ -f "$dir/package.json" ]] || return 1
  # Override keys can be version-qualified specs ("demo@^2.0.0" targets
  # package demo); match on the parsed package name, not literal keys.
  jq -e --arg n "$name" '
    (.overrides // {})
    | [.. | objects | keys[]]
    | any(. == $n or startswith($n + "@"))
  ' "$dir/package.json" >/dev/null 2>&1
}

# The predictable override subset: a single top-level exact-version string
# override, not scoped or qualified anywhere else, and not conflicting with a
# declared direct dependency (npm refuses to install on such a conflict, so
# nothing would land). npm forces that version for every instance in the
# tree — resolving it is reading the manifest, not guessing.
npm_override_exact_pin() {
  local name="$1" dir="${CHECK_PROJECT_DIR:-.}"
  [[ -f "$dir/package.json" ]] || return 1
  local pin
  pin=$(jq -r --arg n "$name" '
    (.overrides // {}) as $o
    | ($o[$n] // empty) as $top
    | select(($top | type) == "string")
    | select(([$o | .. | objects | keys[] | select(. == $n or startswith($n + "@"))]
              | length) == 1)
    | ([.dependencies, .devDependencies, .optionalDependencies, .peerDependencies]
       | map(select(. != null) | .[$n] // empty)) as $declared
    | select($declared | all(. == $top))
    | $top
  ' "$dir/package.json" 2>/dev/null) || return 1
  [[ -n "$pin" ]] || return 1
  version_is_exact npm "$pin" || return 1
  printf '%s\n' "$pin"
}

# Resolve the versions the package manager would actually install.
# Sets RESOLVED_VERSIONS (unique, max 4), RESOLUTION_METHOD, RESOLUTION_SOURCE,
# RESOLUTION_RANGE. Returns 1 when resolution is not possible.
resolve_target_versions() {
  local ecosystem="$1" name="$2" requested="$3" op="$4" scratch="$5"
  RESOLVED_VERSIONS=()
  RESOLUTION_METHOD=""
  RESOLUTION_SOURCE=""
  RESOLUTION_RANGE=""
  if [[ -n "$requested" && "$requested" != "latest" ]] && version_is_exact "$ecosystem" "$requested"; then
    # node-semver accepts a leading v, but npm's packument keys and Socket's
    # exact-version lookup use the canonical version without it.
    if [[ "$ecosystem" == "npm" ]]; then
      RESOLVED_VERSIONS=("${requested#v}")
    else
      RESOLVED_VERSIONS=("$requested")
    fi
    RESOLUTION_METHOD="exact"
    return 0
  fi
  command -v curl >/dev/null 2>&1 || return 1
  case "$ecosystem" in
    npm) resolve_npm_versions "$name" "$requested" "$op" "$scratch" || return 1 ;;
    python) resolve_registry_latest "$requested" "https://pypi.org/pypi/${name}/json" '.info.version // empty' pypi.org "$scratch" || return 1 ;;
    rust)
      # An effective custom source — argv, env-selected registry.default, or
      # a gate-threaded mise registry name — means this default-registry
      # lookup would resolve against the wrong source: degrade to the
      # package-level path, the same rule the argv selector always had.
      # (python/go keep their reviewed argv-only degrade semantics.)
      [[ -z "${CHECK_EFFECTIVE_SOURCES:-}" ]] || return 1
      resolve_registry_latest "$requested" "https://crates.io/api/v1/crates/${name}" '.crate.max_stable_version // .crate.newest_version // empty' crates.io "$scratch" || return 1 ;;
    php)
      [[ -z "${CHECK_EFFECTIVE_SOURCES:-}" ]] || return 1
      resolve_registry_latest "$requested" "https://repo.packagist.org/p2/${name}.json" --arg-name "$name" packagist.org "$scratch" || return 1 ;;
    go) resolve_registry_latest "$requested" "https://proxy.golang.org/${name}/@latest" '.Version // empty' proxy.golang.org "$scratch" || return 1 ;;
    *) return 1 ;;
  esac
  # Every registry-supplied target (dist-tag value, range-resolved candidate,
  # registry latest) must satisfy the same version grammar an exact pin does:
  # this data is registry-writable, and a malformed selected target means we
  # no longer model the manager's selector — degrade (delta-3 finding 4).
  local rv
  for rv in ${RESOLVED_VERSIONS[@]+"${RESOLVED_VERSIONS[@]}"}; do
    version_is_exact "$ecosystem" "$rv" || return 1
  done
  return 0
}

resolve_registry_latest() {
  local requested="$1" url="$2" filter="$3" source_label="$4" scratch="$5"
  local pkg_name=""
  if [[ "$filter" == "--arg-name" ]]; then
    pkg_name="$4"
    source_label="$5"
    scratch="$6"
  fi
  # A custom index/registry on the command line means this default-registry
  # lookup would audit the wrong source — degrade to the unresolved path.
  [[ -z "${CHECK_REGISTRY:-}" ]] || return 1
  # Only an unpinned request can resolve to "latest"; ranges are unresolvable
  # here in v1 and degrade to the package-level audit.
  [[ -z "$requested" || "$requested" == "latest" ]] || return 1
  local out="$scratch/resolve.json"
  curl -fsS --max-time 5 "$url" -o "$out" 2>/dev/null || return 1
  local version
  if [[ -n "$pkg_name" ]]; then
    version=$(jq -r --arg n "$pkg_name" '.packages[$n][0].version // empty' "$out" 2>/dev/null || true)
    version="${version#v}"
  else
    version=$(jq -r "$filter" "$out" 2>/dev/null || true)
  fi
  [[ -n "$version" ]] || return 1
  RESOLVED_VERSIONS=("$version")
  RESOLUTION_METHOD="registry-latest"
  RESOLUTION_SOURCE="$source_label"
  return 0
}

resolve_npm_versions() {
  local name="$1" requested="$2" op="$3" scratch="$4"
  local registry packument enc_name
  # Root overrides can force npm to a version (or package) this resolver
  # cannot predict: degrade rather than audit a guess. Exception: the
  # predictable subset (npm_override_exact_pin) resolves without a fetch —
  # but only when no explicit constraint was requested, since a requested
  # range interacting with an override is back in unpredictable territory.
  if npm_overrides_mention "$name"; then
    local override_pin=""
    if [[ -z "$requested" || "$requested" == "latest" ]]; then
      override_pin=$(npm_override_exact_pin "$name") || override_pin=""
    fi
    if [[ -n "$override_pin" ]]; then
      RESOLVED_VERSIONS=("$override_pin")
      RESOLUTION_METHOD="override-pin"
      RESOLUTION_RANGE="$override_pin"
      RESOLUTION_SOURCE="package.json overrides"
      return 0
    fi
    return 1
  fi
  # A bun-driven install fetches from bun's effective registry (bun
  # registries speak the npm packument protocol, so resolution works the
  # same way against it).
  if [[ "${CHECK_INSTALLER:-npm}" == "bun" ]]; then
    registry=$(bun_registry_url "$name")
  else
    registry=$(npm_registry_url "$name")
  fi
  packument="$scratch/packument.json"
  enc_name="${name//\//%2F}"
  curl -fsS --max-time 5 -H 'Accept: application/vnd.npm.install-v1+json' \
    "$registry/$enc_name" -o "$packument" 2>/dev/null || return 1
  # The fetch keeps any inline credentials; the receipt/display field never
  # does (delta-5 finding N2).
  RESOLUTION_SOURCE=$(canonicalize_source "$registry")
  local -a ranges=()
  if [[ -n "$requested" && "$requested" != "latest" ]]; then
    local tag_version
    tag_version=$(jq -r --arg t "$requested" '."dist-tags"[$t] // empty' "$packument" 2>/dev/null || true)
    if [[ -n "$tag_version" ]]; then
      RESOLVED_VERSIONS=("$tag_version")
      RESOLUTION_METHOD="dist-tag"
      RESOLUTION_RANGE="$requested"
      return 0
    fi
    ranges=("$requested")
    RESOLUTION_METHOD="range"
  elif [[ "$op" == "update" ]]; then
    local range
    while IFS= read -r range; do
      [[ -n "$range" ]] && ranges+=("$range")
    done < <(npm_project_ranges "$name")
    if (( ${#ranges[@]} == 0 )); then
      # Not declared in the project: `npm update <pkg>` is then a no-op or
      # behaves like an install; audit the dist-tag as the outer bound.
      RESOLUTION_METHOD="dist-tag"
    else
      RESOLUTION_METHOD="project-range"
    fi
  else
    RESOLUTION_METHOD="dist-tag"
  fi
  if [[ "$RESOLUTION_METHOD" == "dist-tag" ]]; then
    # An explicit --tag on the command line changes what an unversioned
    # install targets; audit that tag, not latest.
    local tag_name="${CHECK_DIST_TAG:-latest}" latest_version
    latest_version=$(jq -r --arg t "$tag_name" '."dist-tags"[$t] // empty' "$packument" 2>/dev/null || true)
    [[ -n "$latest_version" ]] || return 1
    RESOLUTION_RANGE="$tag_name"
    RESOLVED_VERSIONS=("$latest_version")
    return 0
  fi
  RESOLUTION_RANGE=$(printf '%s, ' "${ranges[@]}")
  RESOLUTION_RANGE="${RESOLUTION_RANGE%, }"
  local r cons v
  local -a resolved=()
  for r in "${ranges[@]}"; do
    cons=$(npm_desugar_range "$r") || return 1
    v=$(npm_max_satisfying "$packument" "$cons" 2>/dev/null || true)
    [[ -n "$v" ]] || return 1
    resolved+=("$v")
  done
  local seen=""
  RESOLVED_VERSIONS=()
  for v in "${resolved[@]}"; do
    case " $seen " in
      *" $v "*) continue ;;
    esac
    seen="$seen $v"
    RESOLVED_VERSIONS+=("$v")
  done
  # A wall of distinct in-range targets means we no longer understand what
  # the resolver will do; degrade instead of pretending.
  (( ${#RESOLVED_VERSIONS[@]} <= 4 )) || return 1
  return 0
}

# Severity primitives, shared by the OSV classifier and the ecosystem-audit
# normalizers so a CVSS vector means the same thing wherever it appears.
# shellcheck disable=SC2016
JQ_SEVERITY_DEFS='
def band_rank(b): ({critical: 4, high: 3, moderate: 2, low: 1}[b]) // 0;
def norm_qual:
  (tostring | ascii_downcase)
  | (if . == "medium" then "moderate" else . end)
  | select(. == "critical" or . == "high" or . == "moderate" or . == "low");
def cvss3_metrics: split("/") | map(split(":") | select(length == 2) | {(.[0]): .[1]}) | add // {};
def cvss3_band:
  cvss3_metrics as $m
  | ({N: 0.85, A: 0.62, L: 0.55, P: 0.2}[$m["AV"]?]) as $av
  | ({L: 0.77, H: 0.44}[$m["AC"]?]) as $ac
  | ({N: 0.85, R: 0.62}[$m["UI"]?]) as $ui
  | ($m["S"]? == "C") as $chg
  | ((if $chg then {N: 0.85, L: 0.68, H: 0.5} else {N: 0.85, L: 0.62, H: 0.27} end)[$m["PR"]?]) as $pr
  | ({H: 0.56, L: 0.22, N: 0}[$m["C"]?]) as $c
  | ({H: 0.56, L: 0.22, N: 0}[$m["I"]?]) as $i
  | ({H: 0.56, L: 0.22, N: 0}[$m["A"]?]) as $a
  | if ($av == null or $ac == null or $ui == null or $pr == null or $c == null or $i == null or $a == null)
    then empty
    else
      (1 - ((1 - $c) * (1 - $i) * (1 - $a))) as $iss
      | (if $chg then (7.52 * ($iss - 0.029)) - (3.25 * pow($iss - 0.02; 15)) else 6.42 * $iss end) as $impact
      | (8.22 * $av * $ac * $pr * $ui) as $expl
      | (if $impact <= 0 then 0
         else
           (($impact + $expl) * (if $chg then 1.08 else 1 end)) as $sum
           | (if $sum < 10 then $sum else 10 end)
         end) as $rawscore
      | ((($rawscore * 10) | ceil) / 10) as $score
      | (if $score >= 9 then "critical"
         elif $score >= 7 then "high"
         elif $score >= 4 then "moderate"
         elif $score > 0 then "low"
         else empty
         end)
    end;
# FIRST CVSS v4.0 calculator, commit c5b0d409ae9f57c44264c6ce5f27d89298e1d32a (BSD-2-Clause).
def cvss4_lookup:
{
  "000000": 10,
  "000001": 9.9,
  "000010": 9.8,
  "000011": 9.5,
  "000020": 9.5,
  "000021": 9.2,
  "000100": 10,
  "000101": 9.6,
  "000110": 9.3,
  "000111": 8.7,
  "000120": 9.1,
  "000121": 8.1,
  "000200": 9.3,
  "000201": 9,
  "000210": 8.9,
  "000211": 8,
  "000220": 8.1,
  "000221": 6.8,
  "001000": 9.8,
  "001001": 9.5,
  "001010": 9.5,
  "001011": 9.2,
  "001020": 9,
  "001021": 8.4,
  "001100": 9.3,
  "001101": 9.2,
  "001110": 8.9,
  "001111": 8.1,
  "001120": 8.1,
  "001121": 6.5,
  "001200": 8.8,
  "001201": 8,
  "001210": 7.8,
  "001211": 7,
  "001220": 6.9,
